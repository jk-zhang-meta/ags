#!/usr/bin/env bash
set -euo pipefail

export PATH="${PATH:+$PATH:}$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

store="${AGENT_SESSION_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ags/snapshots}"
state="${AGENT_SESSION_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ags}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
key="${AGENT_SESSION_IDENTITY_FILE:-}"
ssh_key="${AGENT_SESSION_SSH_KEY:-$HOME/.ssh/id_ed25519}"
codex_home="${CODEX_HOME:-$HOME/.codex}"
claude_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
local_checkpoints="${AGENT_SESSION_LOCAL_DIR:-$state/checkpoints}"
storage_config="$state/storage.json"
cloud_password_file="$state/cloud-password.age"
remote_password_dir="$state/remote-passwords"
trusted_binary_dir="$state/trusted-binaries"
# What a launch prints about pending updates, and when the check behind it last
# finished. Two plain files rather than one JSON object: the content is the
# lines to print and the second they were found, so there is no schema to
# validate and the launch path needs no `jq` it could fail on.
update_check_lines="$state/update-check.lines"
update_check_stamp="$state/update-check.stamp"
update_decline_file="$state/update-declined.lines"
# 自动 gc：上一次跑完的时刻，和它删掉了什么。
#
# 和 update-check 一样分成两个纯文本文件而不是一个 JSON：启动那条路读它，读的东西
# 越简单越好——那条路上任何一个 `jq` 失败都挡在用户和 Agent 之间。
auto_gc_stamp="$state/auto-gc.stamp"
auto_gc_report="$state/auto-gc.report"
auto_gc_log="$state/auto-gc.log"
managed_identity_file="$config_home/ags/identity.agekey"
default_vault="$data_home/ags/checkpoints"
remote_store_prefix="ags-v1"
remote_retirement_marker=".ags-retired/ags-v1.retired"
remote_retirement_pending_marker=".ags-retired/ags-v1.retiring"
declare -A merge_verified_revision=()
declare -a terminal_menu_ids=() terminal_menu_labels=()
# Parallel to the two above: the Agent arguments each row was saved with, as the
# JSON array the manifest stores, plus the one-line form the menu draws. Bash has
# no array of arrays, so the argv stays encoded until the row is actually chosen.
declare -a terminal_menu_args=() terminal_menu_details=()
terminal_menu_selected=
terminal_menu_selected_agent=
terminal_menu_selected_args='[]'
terminal_menu_agents=()
terminal_menu_header=
terminal_menu_notice=
ags_state_lock_depth=0
ags_consolidation_lock_depth=0
ags_remote_operation_lock_depth=0
ags_remote_operation_lock_name=
ags_remote_operation_lock_fd=
ags_checkpoint_lock_depth=0
ags_checkpoint_lock_root=
ags_converter_version="${AGS_CONVERTER_VERSION:-unknown}"
platform="$(uname -s)"

log() { printf '[ags] %s\n' "$*" >&2; }
die() {
    local message="$*"
    log "error: $message"
    exit 1
}
need() { command -v "$1" >/dev/null || die "missing command: $1"; }

resolve_utf8_locale() {
    local candidate charmap
    for candidate in "${LC_ALL:-}" "${LC_CTYPE:-}" "${LANG:-}" \
        C.UTF-8 C.utf8 en_US.UTF-8 UTF-8; do
        [[ -n "$candidate" ]] || continue
        charmap="$(LC_ALL="$candidate" locale charmap 2>/dev/null)" || continue
        case "${charmap^^}" in
            UTF-8|UTF8)
                printf '%s\n' "$candidate"
                return 0
                ;;
        esac
    done
    return 1
}

render_columns() {
    local utf8_locale
    if command -v column >/dev/null 2>&1; then
        utf8_locale="$(resolve_utf8_locale || true)"
        if [[ -n "$utf8_locale" ]]; then
            LC_ALL="$utf8_locale" column "$@"
            return
        fi
    fi
    sed $'s/\t/  /g'
}

# Everything that decorates terminal output resolves its escape sequences here,
# so no other function carries one and there is a single place that answers
# "is this a terminal that should be decorated at all".
#
# Colour is off unless stdout is a terminal that advertises it, and NO_COLOR
# always wins (https://no-color.org). The glyphs need a UTF-8 locale for the
# same reason render_columns does: without one they print as mojibake.
init_terminal_style() {
    local colors
    [[ -z "${ags_style_ready:-}" ]] || return 0
    ags_style_ready=1
    style_reset= style_dim= style_bold= style_accent= style_select=
    style_pointer='> ' style_rule='-' style_separator='  ' style_more='...'
    style_hint_move='Up/Down move' style_hint_open='Enter open'
    style_hint_page='Left/Right page'
    if [[ -n "$(resolve_utf8_locale || true)" ]]; then
        style_pointer='❯ '
        style_rule='─'
        style_separator='   '
        style_more='⋯'
        style_hint_move='↑↓ move'
        style_hint_page='←→ page'
        style_hint_open='⏎ open'
    fi
    [[ -z "${NO_COLOR:-}" && -t 1 && "${TERM:-dumb}" != dumb ]] || return 0
    colors="$(tput colors 2>/dev/null || printf 0)"
    [[ "$colors" =~ ^[0-9]+$ ]] && (( colors >= 8 )) || return 0
    style_reset=$'\033[0m'
    style_dim=$'\033[2m'
    style_bold=$'\033[1m'
    style_accent=$'\033[36m'
    # Reverse video rather than a chosen background colour: it inverts whichever
    # palette the terminal already uses, so the selected row stays legible on a
    # light theme and a dark one alike without AGS guessing which is in use.
    style_select=$'\033[7m'
    style_pointer="$style_accent$style_pointer$style_reset"
}

# Terminal columns available for output, or 0 when that cannot be established.
# COLUMNS first because a caller may set it deliberately, including the tests.
terminal_width() {
    local width="${COLUMNS:-}"
    if [[ ! "$width" =~ ^[0-9]+$ ]] && [[ -t 1 ]] && command -v tput >/dev/null; then
        width="$(tput cols 2>/dev/null || true)"
    fi
    [[ "$width" =~ ^[0-9]+$ ]] && (( width >= 40 )) || width=0
    printf '%s\n' "$width"
}

# Terminal rows available for output. Unlike the width, a wrong answer here only
# costs layout, so an unknowable terminal falls back to the classic 24 rather
# than to "unlimited" — which would scroll the frame off the top.
terminal_height() {
    local height="${LINES:-}"
    if [[ ! "$height" =~ ^[0-9]+$ ]] && [[ -t 1 ]] && command -v tput >/dev/null; then
        height="$(tput lines 2>/dev/null || true)"
    fi
    [[ "$height" =~ ^[0-9]+$ ]] && (( height >= 10 )) || height=24
    printf '%s\n' "$height"
}

# Repeat the rule glyph. Width is a count of terminal columns, and every glyph
# this draws with is single-width, so the count is also the byte-safe repeat.
style_rule_line() {
    local width="$1" line=
    (( width > 0 )) || return 0
    printf -v line '%*s' "$width" ''
    printf '%s' "${line// /$style_rule}"
}

if [[ "$platform" == Darwin ]]; then
    homebrew_prefix="${AGENT_SESSION_HOMEBREW_PREFIX:-}"
    if [[ -z "$homebrew_prefix" ]] && command -v brew >/dev/null; then
        homebrew_prefix="$(brew --prefix 2>/dev/null || true)"
    fi
    [[ "$homebrew_prefix" == /* && -x "$homebrew_prefix/bin/bash" ]] ||
        die "macOS runtime is incomplete; reinstall AGS with Homebrew available"
    [[ -x "$homebrew_prefix/opt/util-linux/bin/column" ]] ||
        die "macOS runtime is incomplete; reinstall AGS with Homebrew util-linux available"
    export PATH="$homebrew_prefix/opt/coreutils/libexec/gnubin:$homebrew_prefix/opt/findutils/libexec/gnubin:$homebrew_prefix/opt/gnu-tar/libexec/gnubin:$homebrew_prefix/bin:$homebrew_prefix/opt/util-linux/bin:$PATH"
elif [[ "$platform" != Linux ]]; then
    die "unsupported operating system: $platform"
fi
(( BASH_VERSINFO[0] >= 4 )) ||
    die "Bash 4 or newer is required"

machine_id_fragment() {
    local identifier=
    if [[ -r /etc/machine-id ]]; then
        head -c 8 /etc/machine-id
        return
    fi
    if [[ "$platform" == Darwin ]] && command -v ioreg >/dev/null; then
        identifier="$(
            ioreg -rd1 -c IOPlatformExpertDevice 2>/dev/null |
                sed -n 's/.*"IOPlatformUUID" = "\([^"]*\)".*/\1/p' |
                head -n 1
        )"
        identifier="${identifier//-/}"
    fi
    [[ -n "$identifier" ]] || identifier="$(hostname -s):$(id -u)"
    printf '%s' "$identifier" | sha256sum | cut -c1-8
}

# 帮助分两层。
#
# 顶层动词有 30 个，全印出来是 76 行；而日常真正会用到的是最上面那几条。76 行里找
# 5 条，本身就是"这工具好复杂"的主要来源——不是命令多，是每次都要从头读一遍。
#
# 所以默认只印常用的，全部放在 `ags help all` 后面。**一条都没删**，只是分了层。
usage() {
    if [[ "${1:-}" == all ]]; then
        usage_all
        return 0
    fi
    cat <<'EOF'
用法:
  ags                          接上最近还活着的会话
  ags codex [--id 名字]        起一个 Codex 会话
  ags claude [--id 名字]       起一个 Claude 会话
  ags ls [-a]                  列出会话，挑一个接着干（-a 连存档一起列）
                               名字是模型在后台起的，不用管；AGS_AUTO_SUMMARY=0 关掉
                               回车之后先选权限档位（yolo/bypass 在最上面），
                               预选上次用的那一档；AGS_PERMISSION_PROMPT=0 关掉
  ags save "描述"              把这个会话导出成一份存档
  ags resume N|ID              接着第 N 号会话干，或者打开一份存档
  ags store                    记录存在哪：本机目录 / git / sftp
  ags sync                     和当前那个 store 对一遍
  ags update                   更新到最新版

  给 Agent 的参数写在 -- 之后：ags codex -- --model o3
  不写 --id 就自动起一个（<目录>-<年.月.日>-<时.分.秒>），启动时会印出来
  全部命令： ags help all
EOF
}

usage_all() {
    cat <<'EOF' 
Usage:
  ags                                  Choose an Agent and start it
  ags [--id NAME] claude [-- CLAUDE_ARGS...]
                                       Start Claude
  ags [--id NAME] [--account EMAIL|--pick-account] codex [-- CODEX_ARGS...]
                                       Start Codex; ags options go before
                                       the command, agent args after it.
                                       They work on claude and resume too
  ags context review-codex             Open Codex's official hook review UI
  ags init [--identity ABSOLUTE_FILE]  Initialize storage and encryption identity
  ags codex-init                       Configure the codext credential pool
  ags codex-pool                       Show the credential pool this machine uses
  ags ls | ags list [-a]               Pick one of this machine's Agent sessions
                                       and carry on with it. Every workspace,
                                       ordered by the day it was last active,
                                       and within one day by when it started —
                                       a minute-level ACTIVE order would reshuffle
                                       today's rows on every run.
                                       -a also lists the archives `ags save`
                                       wrote, in the same view.
                                       The leading `#` is this machine's short
                                       number for that session: `ags resume 7`.
                                       It is stable, so a number stays with the
                                       session it was handed to.
                                       (Up/Down or j/k, Enter open, a edit the
                                       Agent arguments, p pin, s save, Del
                                       delete, Esc quit)
                                       Rows are named by a model in the
                                       background so the list reads as prose,
                                       not hex. Claude Code names its own
                                       sessions and those are left alone; Codex
                                       names none. Nothing to run: `ags ls`
                                       starts it when rows are unnamed, at most
                                       once every AGS_AUTO_SUMMARY_INTERVAL
                                       (900s). AGS_AUTO_SUMMARY=0 turns it off,
                                       AGS_SUMMARY_CMD replaces `codex exec`.
                                       Sessions with no name from any source are
                                       not listed at all: an empty window is
                                       nothing you can recognise, and `ags gc`
                                       deletes them.
                                       Enter asks for a permission level before
                                       the Agent starts — most permissive first
                                       (Codex `--dangerously-bypass-approvals-
                                       and-sandbox`, Claude
                                       `--dangerously-skip-permissions`) down to
                                       plan/read-only, plus `keep`. It
                                       preselects whatever that
                                       session used last time, so the usual path
                                       is a second Enter; Esc goes back to the
                                       list. `keep` changes nothing rather than
                                       stripping a flag already there.
                                       AGS_PERMISSION_PROMPT=0 turns it off.
  ags set retention [--agent codex|claude] DAYS
                                       One retention period for both Agents.
                                       Setting one turns on the automatic sweep
                                       described under `ags gc`.
                                       Claude Code has its own cleanup, so this
                                       writes `cleanupPeriodDays` into its
                                       settings and lets it do the deleting;
                                       Codex has none, so `ags gc` does it.
  ags gc [--agent codex|claude] [--yes]
                                       Delete Codex sessions past the retention
                                       period, plus any session with no
                                       description at all (an empty window that
                                       `ags ls` already hides) once it has been
                                       idle for AGS_GC_EMPTY_IDLE_SECONDS
                                       (3600s). Typing it is a dry-run unless
                                       --yes, and it never touches a pinned
                                       session, one that has been saved, or
                                       anything AGS does not recognise.
                                       Once a retention period is set, starting
                                       an Agent also runs this in the background
                                       at most once every AGS_AUTO_GC_INTERVAL
                                       (86400s), and the next start reports what
                                       it deleted. AGS_AUTO_GC=0 turns that off;
                                       no retention period means it never runs.
  ags show ID|AGENT/RECORD_ID          Show complete local archive details
  ags save [--id ID] DESCRIPTION       Export this active Codex or Claude session
                                       The ID is fixed when the session starts;
                                       --id only to branch a new work line
  ags save --session PROVIDER/SESSION_ID [DESCRIPTION]
                                       Export any session `ags ls` lists, whether
                                       or not AGS started it and whether or not
                                       it is still running
  ags resume ID|AGENT/RECORD_ID [AGENT_ARGS...]
             [-- --to codex|claude --cwd PATH --profile NAME --no-agent-args]
                                       Restore and launch a local archive
  ags resume live:PROVIDER/SESSION_ID [AGENT_ARGS...]
                                       Carry on with a session that still
                                       exists, by handing it to the Agent's own
                                       resume. Nothing is restored and nothing
                                       in the Agent's home is written. This is
                                       what Enter does in `ags ls`.
  ags delete ID|AGENT/RECORD_ID        Move a local checkpoint to recoverable trash
  ags update [--check]                 Update to the latest release (--check only reports)
                                       Launching an Agent reports a pending update once a
                                       day, from a cached answer; AGS_UPDATE_CHECK=0 turns
                                       that off, AGS_UPDATE_CHECK_INTERVAL sets the seconds

Stores — where records live. The backend is settled when you add one; after
that every command only ever names the store:
  ags store                            List them; * marks the one in use
  ags store add local ABSOLUTE_DIR     A directory on this machine
  ags store add NAME git URL [--branch BRANCH]
  ags store add NAME sftp://USER@HOST:PORT/PATH [--known-hosts FILE]
                 [--key FILE|--agent|--password]
  ags store use NAME|local             Make one of them the current store
  ags store show NAME|local
  ags store remove NAME
  ags store merge --into NAME|local [SOURCE...]
  ags store retire SOURCE --into NAME|local
  ags sync [STORE]                     Plan, pull, then push
  ags sync --dry-run [STORE]           Just the plan; nothing moves
                                       (`ags push` and `ags pull` still do one
                                       direction each when you need it)

Local storage must be an absolute, dedicated directory on the local filesystem.
SFTP_URL must be sftp://USER@HOST:PORT/ABSOLUTE/PATH. SFTP remotes require
verified SSH host-key material. GitHub is configured as a normal Git remote.
Plaintext FTP and embedded Git passwords are rejected. Descriptions accept any
language. IDs use letters, numbers, dots, underscores, and hyphens.
When an ID is ambiguous, copy an AGENT/RECORD_ID selector printed by AGS.
Public-IP location is best effort and is stored only inside the encrypted checkpoint.
After `ags claude` or `ags codex`, every argument belongs to that Agent. For
`ags resume`, AGS options go before `--`; every argument after `--` belongs to
the restored Agent. AGS rejects Agent options that would disable its own tooling.
A checkpoint remembers the Agent arguments its session was started with, and
`ags resume` replays them. Pass `--` to decide instead: with arguments after it
they replace the saved ones, and with nothing after it the session starts with
none. `ags show` prints what a checkpoint carries.
A checkpoint also remembers the directory its session was working in. When that
is not the directory you are resuming from, `ags resume` shows both and asks
which to open in; `--cwd PATH` answers it in advance. Without a terminal to ask
on, the recorded directory is used.
Claude `--settings` may contain only provider authentication and model fields.
EOF
}

lock() {
    if (( ags_state_lock_depth > 0 )); then
        ags_state_lock_depth=$((ags_state_lock_depth + 1))
        return
    fi
    mkdir -p "$state" || die "cannot create AGS state directory: $state"
    if ! exec 9>"$state/lock"; then
        die "cannot open AGS state lock: $state/lock"
    fi
    flock 9 || die "cannot acquire AGS state lock: $state/lock"
    ags_state_lock_depth=1
}

unlock() {
    if (( ags_state_lock_depth > 1 )); then
        ags_state_lock_depth=$((ags_state_lock_depth - 1))
        return
    fi
    (( ags_state_lock_depth == 1 )) || return 0
    ags_state_lock_depth=0
    flock -u 9 2>/dev/null || true
    exec 9>&-
}

lock_storage_consolidation() {
    if (( ags_consolidation_lock_depth > 0 )); then
        ags_consolidation_lock_depth=$((ags_consolidation_lock_depth + 1))
        return
    fi
    mkdir -p "$state" || die "cannot create AGS state directory: $state"
    if ! exec 6>"$state/storage-consolidation.lock"; then
        die "cannot open storage consolidation lock"
    fi
    flock 6 || die "cannot acquire storage consolidation lock"
    ags_consolidation_lock_depth=1
}

unlock_storage_consolidation() {
    if (( ags_consolidation_lock_depth > 1 )); then
        ags_consolidation_lock_depth=$((ags_consolidation_lock_depth - 1))
        return
    fi
    (( ags_consolidation_lock_depth == 1 )) || return 0
    ags_consolidation_lock_depth=0
    flock -u 6 2>/dev/null || true
    exec 6>&-
}

lock_remote_operation() {
    local name="$1" directory
    validate_remote_name "$name"
    if (( ags_remote_operation_lock_depth > 0 )); then
        [[ "$ags_remote_operation_lock_name" == "$name" ]] ||
            die "cannot nest operations for different remotes"
        ags_remote_operation_lock_depth=$((ags_remote_operation_lock_depth + 1))
        return
    fi
    directory="$state/remote-locks"
    storage_path_has_safe_components "$state" ||
        die "AGS state path is unsafe for remote locking"
    if [[ ! -e "$state" && ! -L "$state" ]]; then
        install -d -m700 -- "$state" ||
            die "cannot create AGS state directory: $state"
    fi
    [[ -d "$state" && ! -L "$state" ]] &&
        storage_path_has_safe_components "$state" ||
        die "AGS state path changed while preparing a remote lock"
    if [[ -e "$directory" || -L "$directory" ]]; then
        [[ -d "$directory" && ! -L "$directory" ]] ||
            die "remote lock directory is unsafe"
    else
        install -d -m700 -- "$directory" ||
            die "cannot create remote lock directory"
    fi
    storage_path_has_safe_components "$directory" ||
        die "remote lock directory contains a symbolic link"
    if ! exec {ags_remote_operation_lock_fd}>"$directory/$name.lock"; then
        die "cannot open operation lock for remote $name"
    fi
    flock "$ags_remote_operation_lock_fd" ||
        die "cannot acquire operation lock for remote $name"
    ags_remote_operation_lock_name="$name"
    ags_remote_operation_lock_depth=1
}

unlock_remote_operation() {
    if (( ags_remote_operation_lock_depth > 1 )); then
        ags_remote_operation_lock_depth=$((ags_remote_operation_lock_depth - 1))
        return
    fi
    (( ags_remote_operation_lock_depth == 1 )) || return 0
    ags_remote_operation_lock_depth=0
    ags_remote_operation_lock_name=
    flock -u "$ags_remote_operation_lock_fd" 2>/dev/null || true
    exec {ags_remote_operation_lock_fd}>&-
    ags_remote_operation_lock_fd=
}

load_encryption_identity() {
    [[ -z "${encryption_recipient:-}" ]] || return 0
    if [[ -z "$key" && -s "$storage_config" ]]; then
        need jq
        jq -e 'type == "object"' "$storage_config" >/dev/null ||
            die "invalid storage configuration: $storage_config"
        if jq -e '.encryption != null' "$storage_config" >/dev/null; then
            key="$(jq -er '
                .encryption |
                select(type == "object" and .type == "age-x25519") |
                .identity_file |
                select(type == "string" and startswith("/"))
            ' "$storage_config")" ||
                die "invalid encryption configuration in $storage_config"
        fi
    fi
    [[ -n "$key" ]] || key="$ssh_key"
    [[ "$key" == /* && -f "$key" && -r "$key" ]] ||
        die "encryption identity is not readable: $key"

    need age-keygen
    need ssh-keygen
    if encryption_recipient="$(age-keygen -y "$key" 2>/dev/null)"; then
        :
    elif encryption_recipient="$(ssh-keygen -y -f "$key" 2>/dev/null)"; then
        :
    else
        die "unsupported encryption identity: $key"
    fi
    [[ -n "$encryption_recipient" ]] ||
        die "encryption identity has no recipient: $key"
}

write_age_recipient_file() {
    local destination="$1"
    load_encryption_identity
    printf '%s\n' "$encryption_recipient" > "$destination"
}

age_decrypt() {
    load_encryption_identity
    if [[ "$ssh_key" != "$key" && "$ssh_key" == /* &&
          -f "$ssh_key" && -r "$ssh_key" ]]; then
        if age -d -i "$key" "$@" 2>/dev/null; then
            return 0
        fi
        age -d -i "$ssh_key" "$@"
    else
        age -d -i "$key" "$@"
    fi
}

validate_storage_directory_path() {
    local path="$1"
    [[ "$path" == /* && "$path" != *$'\t'* &&
       "$path" != *$'\n'* && "$path" != *$'\r'* ]] ||
        die "storage path must be an absolute path without control characters"
    [[ "$path" != /mnt/[A-Za-z] && "$path" != /mnt/[A-Za-z]/* ]] ||
        die "local storage must use a local filesystem, not a Windows mount"
    case "$path" in
        /|/work|/mnt|/mnt/[A-Za-z]|"$HOME")
            die "choose a dedicated storage subdirectory"
            ;;
    esac
}

storage_path_has_safe_components() {
    local path="$1" component current=/
    local -a components=()
    [[ "$path" == /* ]] || return 1
    IFS=/ read -ra components <<< "${path#/}"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        [[ "$component" != . && "$component" != .. ]] || return 1
        if [[ "$current" == / ]]; then
            current="/$component"
        else
            current="$current/$component"
        fi
        [[ ! -L "$current" ]] || return 1
        [[ ! -e "$current" || -d "$current" ]] || return 1
    done
}







sha256_text() {
    local text="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$text" | sha256sum | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "$text" | shasum -a 256 | awk '{print $1}'
    else
        return 1
    fi
}

sha256_file() {
    local file="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -- "$file" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 -- "$file" | awk '{print $1}'
    else
        return 1
    fi
}









































































initialize_ags() {
    local import_identity= import_recipient= configured_identity=
    local selected_identity="$managed_identity_file"
    local vault vault_parent recipient identity_tmp config_tmp vault_created=0
    umask 077
    need age-keygen
    case "${1:-}" in
        '')
            (( $# == 0 )) || die "usage: ags init [--identity ABSOLUTE_FILE]"
            ;;
        --identity)
            (( $# == 2 )) || die "--identity requires one absolute age identity path"
            import_identity="$2"
            [[ "$import_identity" == /* && -f "$import_identity" &&
               -r "$import_identity" ]] ||
                die "age identity is not readable: $import_identity"
            import_recipient="$(age-keygen -y "$import_identity" 2>/dev/null)" ||
                die "invalid age identity: $import_identity"
            ;;
        *) die "usage: ags init [--identity ABSOLUTE_FILE]" ;;
    esac

    [[ "$managed_identity_file" == /* && "$default_vault" == /* &&
       "$storage_config" == /* ]] ||
        die "HOME and XDG directories must resolve to absolute paths"
    need cmp
    need flock
    need jq
    need realpath

    validate_storage_directory_path "$state"
    validate_storage_directory_path "$(dirname "$managed_identity_file")"
    storage_path_has_safe_components "$state" &&
        storage_path_has_safe_components "$(dirname "$managed_identity_file")" ||
        die "AGS state and identity directories cannot contain symbolic links"
    install -d -m700 "$state" "$(dirname "$managed_identity_file")"
    storage_path_has_safe_components "$state" &&
        storage_path_has_safe_components "$(dirname "$managed_identity_file")" ||
        die "AGS state and identity directories changed during initialization"
    chmod 700 "$state" "$(dirname "$managed_identity_file")"
    lock

    # Validate every existing AGS storage and identity input before anything
    # touches either agent. The remaining work after that succeeds is
    # limited to creating new state and same-filesystem atomic replacements.
    if [[ -e "$storage_config" ]]; then
        [[ -f "$storage_config" && -s "$storage_config" ]] ||
            die "invalid storage configuration: $storage_config"
        jq -e 'type == "object"' "$storage_config" >/dev/null ||
            die "invalid storage configuration: $storage_config"
        vault="$(jq -er --arg default "$default_vault" '
            (.local_path // .paths.local // $default) |
            select(type == "string" and startswith("/"))
        ' "$storage_config")" ||
            die "local storage path is invalid in $storage_config"
        if jq -e '.encryption != null' "$storage_config" >/dev/null; then
            configured_identity="$(jq -er '
                .encryption |
                select(type == "object" and .type == "age-x25519") |
                .identity_file |
                select(type == "string" and startswith("/"))
            ' "$storage_config")" ||
                die "invalid encryption configuration in $storage_config"
            [[ -f "$configured_identity" && -r "$configured_identity" ]] ||
                die "configured age identity is not readable: $configured_identity"
            recipient="$(age-keygen -y "$configured_identity" 2>/dev/null)" ||
                die "configured age identity is invalid: $configured_identity"
            if [[ -n "$import_identity" && "$import_recipient" != "$recipient" ]]; then
                if [[ "$configured_identity" == "$managed_identity_file" ]]; then
                    die "refusing to replace the existing identity: $managed_identity_file"
                fi
                die "refusing to replace the configured identity: $configured_identity"
            fi
            selected_identity="$configured_identity"
        fi
    else
        vault="$default_vault"
    fi
    validate_storage_directory_path "$vault"
    storage_path_has_safe_components "$vault" ||
        die "storage path cannot contain symbolic links or traversal: $vault"
    if [[ -e "$vault" ]]; then
        [[ -d "$vault" && -r "$vault" && -w "$vault" && -x "$vault" ]] ||
            die "storage directory must be readable and writable: $vault"
    else
        vault_parent="$vault"
        while [[ ! -e "$vault_parent" ]]; do
            [[ "$vault_parent" != / ]] ||
                die "cannot find a writable parent for storage: $vault"
            vault_parent="$(dirname "$vault_parent")"
        done
        [[ -d "$vault_parent" && -w "$vault_parent" && -x "$vault_parent" ]] ||
            die "storage parent directory must be writable: $vault_parent"
    fi

    if [[ "$selected_identity" == "$managed_identity_file" ]]; then
        if [[ -e "$managed_identity_file" ]]; then
            [[ -f "$managed_identity_file" && ! -L "$managed_identity_file" &&
               -r "$managed_identity_file" ]] ||
                die "managed age identity is not a readable regular file: $managed_identity_file"
            recipient="$(age-keygen -y "$managed_identity_file" 2>/dev/null)" ||
                die "managed age identity is invalid: $managed_identity_file"
            if [[ -n "$import_identity" && "$import_recipient" != "$recipient" ]]; then
                die "refusing to replace the existing identity: $managed_identity_file"
            fi
            chmod 600 "$managed_identity_file"
        fi
    fi

    # maintain：`ags init` 可以被反复运行，所以这里只补一个空缺的名字，绝不
    # 取代已经在的那个。取代是安装期的事，见 `ags codex-name`。
    reconcile_codex_binary_name maintain

    if [[ ! -e "$vault" ]]; then
        install -d -m700 "$vault"
        vault_created=1
    fi
    storage_path_has_safe_components "$vault" ||
        die "storage path changed during initialization: $vault"
    vault="$(realpath -e -- "$vault")"
    validate_storage_directory_path "$vault"
    (( vault_created == 0 )) || chmod 700 "$vault"

    if [[ "$selected_identity" == "$managed_identity_file" ]]; then
        if [[ ! -e "$managed_identity_file" ]]; then
            identity_tmp="$managed_identity_file.tmp.$$"
            rm -f -- "$identity_tmp"
            if [[ -n "$import_identity" ]]; then
                install -m600 "$import_identity" "$identity_tmp"
            elif ! age-keygen -o "$identity_tmp" >/dev/null 2>&1; then
                rm -f -- "$identity_tmp"
                die "cannot generate age identity"
            fi
            chmod 600 "$identity_tmp"
            recipient="$(age-keygen -y "$identity_tmp" 2>/dev/null)" || {
                rm -f -- "$identity_tmp"
                die "generated age identity is invalid"
            }
            mv -- "$identity_tmp" "$managed_identity_file"
        fi
    fi

    config_tmp="$storage_config.tmp.$$"
    if [[ -s "$storage_config" ]]; then
        jq --arg vault "$vault" --arg identity "$selected_identity" '
            .version = 4 |
            .local_path = $vault |
            .encryption = {type:"age-x25519", identity_file:$identity} |
            del(.active, .paths)
        ' "$storage_config" > "$config_tmp"
    else
        jq -n --arg vault "$vault" --arg identity "$selected_identity" '
            {
                version:4,
                local_path:$vault,
                encryption:{type:"age-x25519", identity_file:$identity}
            }
        ' > "$config_tmp"
    fi
    chmod 600 "$config_tmp"
    mv -- "$config_tmp" "$storage_config"
    unlock

    printf 'status=initialized\nvault=%s\nidentity=%s\nrecipient=%s\n' \
        "$vault" "$selected_identity" "$recipient"
    log "Back up this identity separately; losing it makes encrypted records unrecoverable: $selected_identity"

    # Last, and outside the lock: this one talks to the network and asks the
    # user questions. Nothing above depends on it, so a declined or failed pool
    # setup must not make `ags init` look like it failed.
    offer_codex_pool
}

lock_checkpoint_root() {
    local root="$1"
    [[ -d "$root" ]] || die "checkpoint directory is unavailable: $root"
    if (( ags_checkpoint_lock_depth > 0 )); then
        [[ "$ags_checkpoint_lock_root" == "$root" ]] ||
            die "cannot nest checkpoint locks for different storage roots"
        ags_checkpoint_lock_depth=$((ags_checkpoint_lock_depth + 1))
        return
    fi
    if ! exec 8>"$root/.ags.lock"; then
        die "cannot open checkpoint lock: $root/.ags.lock"
    fi
    flock 8 || die "cannot acquire checkpoint lock: $root/.ags.lock"
    ags_checkpoint_lock_root="$root"
    ags_checkpoint_lock_depth=1
}

unlock_checkpoint_root() {
    if (( ags_checkpoint_lock_depth > 1 )); then
        ags_checkpoint_lock_depth=$((ags_checkpoint_lock_depth - 1))
        return
    fi
    (( ags_checkpoint_lock_depth == 1 )) || return 0
    ags_checkpoint_lock_depth=0
    ags_checkpoint_lock_root=
    flock -u 8 2>/dev/null || true
    exec 8>&-
}

trap_cleanup_dirs() {
    local path quoted command=
    for path in "$@"; do
        [[ -n "$path" ]] || continue
        printf -v quoted '%q' "$path"
        command+="rm -rf -- $quoted; "
    done
    trap "$command" EXIT
}

configure_local_storage() {
    local requested="${1:-}" canonical probe temporary existing= pending= pending_dir
    (( $# == 1 )) || die "usage: ags set ABSOLUTE_DIR"
    need flock; need jq; need realpath
    validate_storage_directory_path "$requested"
    storage_path_has_safe_components "$requested" ||
        die "storage path cannot contain symbolic links or traversal: $requested"
    mkdir -p -- "$requested" || die "cannot create storage directory: $requested"
    storage_path_has_safe_components "$requested" ||
        die "storage path changed while it was being created: $requested"
    canonical="$(realpath -e -- "$requested")"
    validate_storage_directory_path "$canonical"
    [[ -d "$canonical" && -r "$canonical" && -w "$canonical" && -x "$canonical" ]] ||
        die "storage directory must be readable and writable: $canonical"
    probe="$(mktemp "$canonical/.agent-session-write-test.XXXXXX")" ||
        die "storage directory is not writable: $canonical"
    rm -f -- "$probe"

    lock_storage_consolidation
    lock
    if [[ -s "$storage_config" ]]; then
        jq -e 'type == "object"' "$storage_config" >/dev/null ||
            die "invalid storage configuration: $storage_config"
        existing="$(jq -r '.local_path // .paths.local // empty' \
            "$storage_config")"
    fi
    if [[ -n "$existing" && "$existing" != "$canonical" ]]; then
        for pending_dir in "$state/pending" "$state/pending-sync"; do
            [[ -d "$pending_dir" ]] || continue
            pending="$(
                find "$pending_dir" -type f -name '*.json' -print -quit
            )"
            [[ -z "$pending" ]] || break
        done
        if [[ -n "$pending" ]]; then
            unlock
            unlock_storage_consolidation
            die "cannot change local storage while a checkpoint or synchronization is pending; run ags flush first"
        fi
    fi
    temporary="$storage_config.tmp.$$"
    if [[ -s "$storage_config" ]]; then
        jq --arg path "$canonical" \
            '.version = 4 | .local_path = $path | del(.active, .paths)' \
            "$storage_config" > "$temporary"
    else
        jq -n --arg path "$canonical" '{version: 4, local_path: $path}' > "$temporary"
    fi
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    unlock
    unlock_storage_consolidation
    printf 'status=configured\npath=%s\n' "$canonical"
}

load_local_storage() {
    need jq
    if [[ -n "${AGENT_SESSION_LOCAL_DIR:-}" ]]; then
        active_root="$AGENT_SESSION_LOCAL_DIR"
    else
        [[ -s "$storage_config" ]] ||
            die "local storage is not configured; run ags set ABSOLUTE_DIR"
        active_root="$(jq -er '
            (.local_path // .paths.local) |
            select(type == "string" and startswith("/"))
        ' "$storage_config")" || die "local storage path is missing in $storage_config"
    fi
    [[ "$active_root" != /mnt/[A-Za-z] && "$active_root" != /mnt/[A-Za-z]/* ]] ||
        die "local storage must use a local filesystem, not a Windows mount"
    [[ -d "$active_root" && -r "$active_root" && -x "$active_root" ]] ||
        die "local storage directory is unavailable: $active_root"
    local_checkpoints="$active_root"
}

parse_sftp_url() {
    local url="${1:-}" rest authority host_port
    [[ "$url" != *$'\n'* && "$url" != *$'\r'* && "$url" != *$'\t'* ]] ||
        die "SFTP URL cannot contain control characters"
    [[ "$url" == sftp://* ]] || die "store URL must use sftp://"
    [[ "$url" != *'?'* && "$url" != *'#'* ]] ||
        die "SFTP URL cannot contain query strings or fragments"
    rest="${url#sftp://}"
    [[ "$rest" == */* ]] || die "SFTP URL must include an absolute remote path"
    authority="${rest%%/*}"
    cloud_path="/${rest#*/}"
    [[ "$authority" == *@* ]] || die "SFTP URL must include USER@HOST:PORT"
    cloud_user="${authority%@*}"
    host_port="${authority#*@}"
    [[ "$cloud_user" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid SFTP username"
    [[ "$host_port" =~ ^([A-Za-z0-9._-]+):([0-9]{1,5})$ ]] ||
        die "SFTP URL must include HOST:PORT"
    cloud_host="${BASH_REMATCH[1]}"
    cloud_port="${BASH_REMATCH[2]}"
    (( 10#$cloud_port >= 1 && 10#$cloud_port <= 65535 )) || die "invalid SFTP port"
    [[ "$cloud_path" != *'//'* ]] || die "SFTP path cannot contain empty components"
    cloud_path="${cloud_path%/}"
    case "$cloud_path" in /|/home|/root|/data|/tmp) die "choose a dedicated absolute remote directory" ;; esac
    [[ "$cloud_path" != /.. && "$cloud_path" != ../* &&
       "$cloud_path" != */../* && "$cloud_path" != */.. ]] ||
        die "SFTP path cannot traverse parent directories"
    cloud_url="sftp://$cloud_user@$cloud_host:$cloud_port$cloud_path"
}

ensure_legacy_cloud_remote() {
    local temporary auth password_path= fixed_password
    [[ -s "$storage_config" ]] || return 0
    jq -e '.cloud != null' "$storage_config" >/dev/null || return 0
    jq -e '
        .cloud |
        type == "object" and
        (.url | type == "string" and startswith("sftp://")) and
        (.auth == "key" or .auth == "agent" or .auth == "password") and
        (.known_hosts | type == "string" and startswith("/")) and
        (if .auth == "key"
         then (.key_file | type == "string" and startswith("/"))
         else true end)
    ' "$storage_config" >/dev/null ||
        die "legacy cloud configuration cannot be migrated safely"
    auth="$(jq -r '.cloud.auth' "$storage_config")"
    if [[ "$auth" == password ]]; then
        fixed_password="$(named_remote_password_path neburst)"
        password_path="$(jq -r '
            .cloud.password_file //
            .remotes.neburst.password_file //
            empty
        ' "$storage_config")"
        if [[ -z "$password_path" ]]; then
            if validate_configured_password_file "$fixed_password"; then
                password_path="$fixed_password"
            elif validate_configured_password_file "$cloud_password_file"; then
                password_path="$cloud_password_file"
            fi
        fi
    fi
    if [[ "$auth" != password ||
          -n "$password_path" ]] &&
       { [[ "$auth" != password ]] ||
         validate_configured_password_file "$password_path"; } &&
       jq -e --arg password_file "$password_path" '
           (.cloud |
             {type:"sftp", url:.url, auth:.auth,
              known_hosts:.known_hosts, legacy_cloud:true} +
             (if .key_file then {key_file:.key_file} else {} end) +
             (if $password_file == "" then {} else
                 {password_file:$password_file}
              end)
           ) as $legacy |
           (.remotes.neburst | del(.retiring)) == $legacy and
           (if $password_file == "" then
                .cloud.password_file == null
            else
                .cloud.password_file == $password_file
            end)
       ' "$storage_config" >/dev/null; then
        return 0
    fi
    lock
    if [[ ! -s "$storage_config" ]] ||
       ! jq -e '.cloud != null' "$storage_config" >/dev/null; then
        unlock
        return 0
    fi
    jq -e '
        .cloud |
        type == "object" and
        (.url | type == "string" and startswith("sftp://")) and
        (.auth == "key" or .auth == "agent" or .auth == "password") and
        (.known_hosts | type == "string" and startswith("/")) and
        (if .auth == "key"
         then (.key_file | type == "string" and startswith("/"))
         else true end)
    ' "$storage_config" >/dev/null || {
        unlock
        die "legacy cloud configuration cannot be migrated safely"
    }
    auth="$(jq -r '.cloud.auth' "$storage_config")"
    if [[ "$auth" == password ]]; then
        fixed_password="$(named_remote_password_path neburst)"
        password_path="$(jq -r '
            .cloud.password_file //
            .remotes.neburst.password_file //
            empty
        ' "$storage_config")"
        if [[ -z "$password_path" ]]; then
            if validate_configured_password_file "$fixed_password"; then
                password_path="$fixed_password"
            elif validate_configured_password_file "$cloud_password_file"; then
                password_path="$cloud_password_file"
            else
                unlock
                die "legacy cloud password is unavailable for migration"
            fi
        fi
        validate_configured_password_file "$password_path" || {
            unlock
            die "legacy cloud password path is unsafe or unavailable"
        }
    fi
    temporary="$storage_config.tmp.$$"
    if ! jq --arg password_file "$password_path" '
        (.cloud |
          {type:"sftp", url:.url, auth:.auth,
           known_hosts:.known_hosts, legacy_cloud:true} +
          (if .key_file then {key_file:.key_file} else {} end) +
          (if $password_file == "" then {} else
              {password_file:$password_file}
           end)
        ) as $legacy |
        (.remotes.neburst.retiring // null) as $retiring |
        if .remotes.neburst != null and
           .remotes.neburst.legacy_cloud != true and
           ((.remotes.neburst | del(.legacy_cloud, .retiring)) !=
            ($legacy | del(.legacy_cloud)))
        then error("legacy cloud conflicts with remote neburst")
        else
          .version = 4 |
          if $password_file == "" then
              del(.cloud.password_file)
          else
              .cloud.password_file = $password_file
          end |
          .remotes = (.remotes // {}) |
          .remotes.neburst = $legacy |
          if $retiring == null then .
          else .remotes.neburst.retiring = $retiring
          end
        end
    ' "$storage_config" > "$temporary"; then
        rm -f -- "$temporary"
        unlock
        die "legacy cloud conflicts with the configured neburst remote"
    fi
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    unlock
}

validate_remote_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
        die "remote name must be 1-64 letters, numbers, dots, underscores, or hyphens"
}

validate_git_branch() {
    local branch="${1:-}"
    [[ "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ &&
       "$branch" != *'..'* && "$branch" != *'//'*
       && "$branch" != */ && "$branch" != *'@{'* ]] ||
        die "invalid Git branch: $branch"
}

validate_git_remote_url() {
    local url="$1" lower
    [[ -n "$url" && "$url" != -* && "$url" != *$'\n'* &&
       "$url" != *$'\r'* && "$url" != *$'\t'* ]] ||
        die "Git URL is required, cannot start with '-', and cannot contain control characters"
    lower="${url,,}"
    [[ "$lower" != ftp://* && "$lower" != sftp://* ]] ||
        die "Git remote URL must use a Git-supported transport, not FTP or SFTP"
    if [[ "$lower" =~ ^https?://[^/]*@ ]]; then
        die "HTTP(S) Git URLs must not contain userinfo; use a credential helper or SSH"
    fi
}

check_remote_name_available() {
    local name="$1" mode
    ensure_legacy_cloud_remote
    [[ ! -s "$storage_config" ]] && return 0
    jq -e 'type == "object"' "$storage_config" >/dev/null ||
        die "invalid storage configuration: $storage_config"
    jq -e --arg name "$name" '.remotes[$name] != null' "$storage_config" >/dev/null &&
        die "remote already exists: $name"
    mode="remote:$name"
    jq -e --arg mode "$mode" '
        (.retired_modes // {})[$mode] != null or
        (.merged_modes // {})[$mode] != null
    ' "$storage_config" >/dev/null &&
        die "remote name $name is reserved by storage consolidation and cannot be reused"
    return 0
}

save_git_remote_config() {
    local name="$1" url="$2" branch="$3" temporary
    lock
    temporary="$storage_config.tmp.$$"
    if [[ -s "$storage_config" ]]; then
        jq --arg name "$name" --arg url "$url" --arg branch "$branch" '
            if .remotes[$name] != null then error("remote already exists") else
                .version = 4 |
                .remotes = (.remotes // {}) |
                .remotes[$name] = {type:"git", url:$url, branch:$branch} |
                del(.retired_modes["remote:" + $name])
            end
        ' "$storage_config" > "$temporary" || die "remote already exists: $name"
    else
        jq -n --arg name "$name" --arg url "$url" --arg branch "$branch" '
            {version:4, remotes:{($name):{type:"git", url:$url, branch:$branch}}}
        ' > "$temporary"
    fi
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    unlock
}

save_sftp_remote_config() {
    local name="$1" url="$2" auth="$3" known_hosts="$4" key_file="$5"
    local staged_secret="${6:-}" temporary secret_destination=
    local secret_published=0
    lock
    temporary="$storage_config.tmp.$$"
    if [[ -s "$storage_config" ]]; then
        if ! jq --arg name "$name" --arg url "$url" --arg auth "$auth" \
            --arg known_hosts "$known_hosts" --arg key_file "$key_file" '
            if .remotes[$name] != null then error("remote already exists") else
                .version = 4 |
                .remotes = (.remotes // {}) |
                .remotes[$name] = {
                    type:"sftp", url:$url, auth:$auth, known_hosts:$known_hosts
                } |
                del(.retired_modes["remote:" + $name]) |
                if $key_file == "" then . else
                    .remotes[$name].key_file = $key_file
                end
            end
        ' "$storage_config" > "$temporary"; then
            rm -f -- "$temporary"
            unlock
            die "remote already exists: $name"
        fi
    else
        if ! jq -n --arg name "$name" --arg url "$url" --arg auth "$auth" \
            --arg known_hosts "$known_hosts" --arg key_file "$key_file" '
            {version:4, remotes:{($name):{
                type:"sftp", url:$url, auth:$auth, known_hosts:$known_hosts
            }}} |
            if $key_file == "" then . else .remotes[$name].key_file = $key_file end
        ' > "$temporary"; then
            rm -f -- "$temporary"
            unlock
            die "cannot create remote configuration"
        fi
    fi
    chmod 600 "$temporary"
    if [[ -n "$staged_secret" ]]; then
        [[ -f "$staged_secret" && ! -L "$staged_secret" ]] || {
            rm -f -- "$temporary"
            unlock
            die "staged SFTP password is unavailable"
        }
        prepare_remote_password_directory
        secret_destination="$(named_remote_password_path "$name")"
        if [[ -e "$secret_destination" || -L "$secret_destination" ]]; then
            rm -f -- "$temporary"
            unlock
            die "an unreferenced encrypted password already exists for remote $name"
        fi
        if ! mv -- "$staged_secret" "$secret_destination"; then
            rm -f -- "$temporary"
            unlock
            die "cannot publish the encrypted SFTP password"
        fi
        secret_published=1
    fi
    if ! mv -- "$temporary" "$storage_config"; then
        if (( secret_published == 1 )); then
            mv -- "$secret_destination" "$staged_secret" 2>/dev/null || true
        fi
        rm -f -- "$temporary"
        unlock
        die "cannot publish remote configuration"
    fi
    unlock
}

named_remote_password_path() {
    local name="$1"
    validate_remote_name "$name"
    printf '%s/%s.age\n' "$remote_password_dir" "$name"
}

validate_configured_password_file() {
    local path="${1:-}" basename
    [[ "$path" == /* && "$path" != *$'\n'* &&
       "$path" != *$'\r'* && "$path" != *$'\t'* ]] || return 1
    if [[ "$path" == "$cloud_password_file" ]]; then
        :
    elif [[ "$path" == "$remote_password_dir/"* ]]; then
        basename="${path#"$remote_password_dir/"}"
        [[ -n "$basename" && "$basename" != */* &&
           "$basename" == *.age ]] || return 1
    else
        return 1
    fi
    [[ -f "$path" && ! -L "$path" && -r "$path" ]] || return 1
    storage_path_has_safe_components "$(dirname "$path")"
}

prepare_remote_password_directory() {
    local directory
    storage_path_has_safe_components "$state" ||
        die "AGS state path is unsafe for password storage"
    for directory in "$state" "$remote_password_dir"; do
        if [[ -e "$directory" || -L "$directory" ]]; then
            [[ -d "$directory" && ! -L "$directory" ]] ||
                die "password storage path has an unsafe component: $directory"
        else
            install -d -m700 -- "$directory"
        fi
        chmod 700 -- "$directory"
    done
    storage_path_has_safe_components "$remote_password_dir" ||
        die "password storage path changed while it was being prepared"
}

password_file_is_referenced() {
    local path="$1"
    [[ -s "$storage_config" ]] &&
        jq -e --arg path "$path" '
            any(
                [
                    .cloud.password_file?,
                    ((.remotes // {})[]?.password_file?)
                ][] |
                select(type == "string");
                . == $path
            )
        ' "$storage_config" >/dev/null
}

retire_unreferenced_neburst_passwords() {
    local path component directory destination timestamp
    local -a candidates=()
    if [[ -d "$remote_password_dir" ]]; then
        while IFS= read -r -d '' path; do
            candidates+=("$path")
        done < <(find "$remote_password_dir" -maxdepth 1 \
            \( -type f -o -type l \) -name 'neburst*.age' -print0)
    fi
    if [[ -e "$cloud_password_file" || -L "$cloud_password_file" ]]; then
        candidates+=("$cloud_password_file")
    fi
    (( ${#candidates[@]} > 0 )) || return 0
    directory="$state/trash/passwords/neburst"
    storage_path_has_safe_components "$state" ||
        die "AGS state path is unsafe for password recovery"
    for component in \
        "$state" \
        "$state/trash" \
        "$state/trash/passwords" \
        "$directory"; do
        if [[ -e "$component" || -L "$component" ]]; then
            [[ -d "$component" && ! -L "$component" ]] ||
                die "password recovery path has an unsafe component: $component"
        else
            install -d -m700 -- "$component"
        fi
        chmod 700 -- "$component"
    done
    storage_path_has_safe_components "$directory" ||
        die "password recovery path contains a symbolic link"
    timestamp="$(new_retirement_timestamp)"
    for path in "${candidates[@]}"; do
        password_file_is_referenced "$path" && continue
        validate_configured_password_file "$path" ||
            die "unreferenced Neburst password is unsafe: $path"
        destination="$directory/$(basename "$path").retired.$timestamp"
        [[ ! -e "$destination" && ! -L "$destination" ]] ||
            die "password recovery destination already exists"
        mv -- "$path" "$destination"
    done
}

configured_remote_password_path() {
    local name="$1" fallback
    validate_remote_name "$name"
    fallback="$(named_remote_password_path "$name")"
    jq -r --arg name "$name" --arg fallback "$fallback" '
        .remotes[$name] |
        if .auth == "password" then
            (.password_file // $fallback)
        else empty end
    ' "$storage_config"
}

stage_named_remote_password() {
    local name="$1" directory="$2" partial
    validate_remote_name "$name"
    [[ -d "$directory" && ! -L "$directory" ]] ||
        die "password staging directory is unavailable"
    partial="$directory/$name.password.age"
    load_encryption_identity
    if ! printf '%s' "$sync_remote_password_value" |
        age -r "$encryption_recipient" -o "$partial"; then
        rm -f -- "$partial"
        die "cannot encrypt the SFTP password"
    fi
    chmod 600 "$partial"
    printf '%s\n' "$partial"
}

verify_sftp_host_key() {
    local host="$1" port="$2" known_hosts="$3" lookup
    [[ "$known_hosts" == /* && -r "$known_hosts" ]] ||
        die "known_hosts is not readable: $known_hosts"
    [[ "$known_hosts" != *','* && "$known_hosts" != *$'\n'* &&
       "$known_hosts" != *$'\r'* && "$known_hosts" != *$'\t'* ]] ||
        die "known_hosts path contains unsupported characters"
    if [[ "$port" == 22 ]]; then lookup="$host"; else lookup="[$host]:$port"; fi
    ssh-keygen -F "$lookup" -f "$known_hosts" >/dev/null ||
        die "no verified host key for $lookup in $known_hosts; connect once with OpenSSH first"
}

build_sync_sftp_fs() {
    local options
    options=":sftp,host=$sync_remote_host,user=$sync_remote_user,port=$sync_remote_port,known_hosts_file=$sync_remote_known_hosts"
    case "$sync_remote_auth" in
        key) options+=",key_file=$sync_remote_key_file" ;;
        agent) options+=",key_use_agent=true" ;;
        password) ;;
        *) die "invalid SFTP authentication mode for remote $sync_remote_name" ;;
    esac
    sync_remote_fs="$options:$sync_remote_path"
}

sync_sftp_run() {
    local password obscured status
    if [[ "$sync_remote_auth" == password ]]; then
        # Keep plaintext credentials out of unrelated subprocess environments.
        unset AGENT_SESSION_CLOUD_PASSWORD AGENT_SESSION_REMOTE_PASSWORD
        if [[ -n "${sync_remote_password_value+x}" ]]; then
            password="$sync_remote_password_value"
        else
            local password_file
            password_file="${sync_remote_password_file:-$(
                named_remote_password_path "$sync_remote_name"
            )}"
            [[ -r "$password_file" ]] ||
                die "encrypted SFTP password is missing for remote $sync_remote_name"
            password="$(age_decrypt "$password_file")" ||
                die "cannot decrypt the SFTP password for remote $sync_remote_name"
        fi
        obscured="$(printf '%s\n' "$password" |
            rclone --config /dev/null obscure -)" ||
            die "cannot prepare the SFTP password for remote $sync_remote_name"
        unset password
        if env -u AGENT_SESSION_CLOUD_PASSWORD \
            -u AGENT_SESSION_REMOTE_PASSWORD \
            RCLONE_SFTP_PASS="$obscured" \
            rclone --config /dev/null --ask-password=false \
                --log-level ERROR "$@"; then
            unset obscured
            return 0
        fi
        status=$?
        unset obscured
        return "$status"
    fi
    env -u AGENT_SESSION_CLOUD_PASSWORD \
        -u AGENT_SESSION_REMOTE_PASSWORD \
        -u RCLONE_SFTP_PASS \
        rclone --config /dev/null --ask-password=false \
            --log-level ERROR "$@"
}

sync_sftp_ssh_run() {
    local remote_command="$1" password password_fd status
    local -a ssh_args
    need ssh
    ssh_args=(
        -T
        -p "$sync_remote_port"
        -o "UserKnownHostsFile=$sync_remote_known_hosts"
        -o GlobalKnownHostsFile=/dev/null
        -o StrictHostKeyChecking=yes
        -o LogLevel=ERROR
        -o ConnectTimeout=30
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=2
    )
    case "$sync_remote_auth" in
        key)
            ssh_args+=(
                -o BatchMode=yes
                -o IdentitiesOnly=yes
                -i "$sync_remote_key_file"
            )
            ;;
        agent)
            ssh_args+=(-o BatchMode=yes)
            ;;
        password)
            need sshpass
            unset AGENT_SESSION_CLOUD_PASSWORD AGENT_SESSION_REMOTE_PASSWORD
            if [[ -n "${sync_remote_password_value+x}" ]]; then
                password="$sync_remote_password_value"
            else
                local password_file
                password_file="${sync_remote_password_file:-$(
                    named_remote_password_path "$sync_remote_name"
                )}"
                [[ -r "$password_file" ]] ||
                    die "encrypted SFTP password is missing for remote $sync_remote_name"
                password="$(age_decrypt "$password_file")" ||
                    die "cannot decrypt the SFTP password for remote $sync_remote_name"
            fi
            exec {password_fd}<<< "$password"
            unset password
            if env -u AGENT_SESSION_CLOUD_PASSWORD \
                -u AGENT_SESSION_REMOTE_PASSWORD \
                -u RCLONE_SFTP_PASS \
                sshpass -d "$password_fd" \
                ssh "${ssh_args[@]}" \
                    -o PubkeyAuthentication=no \
                    -o NumberOfPasswordPrompts=1 \
                    "$sync_remote_user@$sync_remote_host" "$remote_command"; then
                status=0
            else
                status=$?
            fi
            exec {password_fd}<&-
            return "$status"
            ;;
        *) die "invalid SFTP authentication mode for remote $sync_remote_name" ;;
    esac
    env -u AGENT_SESSION_CLOUD_PASSWORD \
        -u AGENT_SESSION_REMOTE_PASSWORD \
        -u RCLONE_SFTP_PASS \
        ssh "${ssh_args[@]}" \
            "$sync_remote_user@$sync_remote_host" "$remote_command"
}

sftp_server_capability_probe() {
    printf '%s\n' "$sync_remote_path" | sync_sftp_ssh_run '
        set -eu
        umask 077
        IFS= read -r root
        case "$root" in
            /*) ;;
            *) exit 64 ;;
        esac
        command -v flock >/dev/null
        command -v find >/dev/null
        command -v sha256sum >/dev/null
        command -v sort >/dev/null
        command -v cmp >/dev/null
        command -v mv >/dev/null
        command -v rm >/dev/null
        command -v mkdir >/dev/null
        command -v chmod >/dev/null
        command -v sed >/dev/null
        command -v cut >/dev/null
        command -v dirname >/dev/null
        command -v stat >/dev/null
        mkdir -p -- "$root"
        [ -d "$root" ] && [ ! -L "$root" ]
        [ -z "$(find "$root" -type l -print -quit)" ]
        lock_path="$root/.ags-transaction.lock"
        if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
            [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
        fi
        exec 9>>"$lock_path"
        chmod 600 "$lock_path"
        flock -w 30 9
        [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
        lock_size="$(stat -c %s -- "$lock_path")"
        case "$lock_size" in
            ""|*[!0-9]*) exit 69 ;;
        esac
    ' || die "SFTP remote requires an SSH shell with flock and standard file utilities"
}

validate_sftp_relative_path() {
    local path="$1"
    [[ -n "$path" && "$path" != /* && "$path" != */ &&
       "$path" != '.' && "$path" != '..' &&
       "$path" != ../* && "$path" != */../* && "$path" != */.. &&
       "$path" != *$'\n'* && "$path" != *$'\r'* &&
       "$path" != *$'\t'* ]] ||
        die "unsafe SFTP transaction path"
}

sftp_server_publish() {
    local source_relative="$1" destination_relative="$2" digest="$3"
    validate_sftp_relative_path "$source_relative"
    validate_sftp_relative_path "$destination_relative"
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] ||
        die "invalid SFTP publication digest"
    printf '%s\n%s\n%s\n%s\n' \
        "$sync_remote_path" "$source_relative" "$destination_relative" "$digest" |
        sync_sftp_ssh_run '
            set -eu
            umask 077
            IFS= read -r root
            IFS= read -r source_relative
            IFS= read -r destination_relative
            IFS= read -r digest
            case "$root" in
                /*) ;;
                *) exit 64 ;;
            esac
            for relative in "$source_relative" "$destination_relative"; do
                case "$relative" in
                    ""|/*|*/|.|..|../*|*/../*|*/..) exit 64 ;;
                esac
            done
            case "$digest" in
                *[!0-9a-f]*|"") exit 64 ;;
            esac
            [ "${#digest}" -eq 64 ]
            [ -d "$root" ] && [ ! -L "$root" ]
            lock_path="$root/.ags-transaction.lock"
            if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
                [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
            fi
            exec 9>>"$lock_path"
            chmod 600 "$lock_path"
            flock -w 300 9
            [ -d "$root" ] && [ ! -L "$root" ]
            [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
            [ -z "$(find "$root" -type l -print -quit)" ]
            [ ! -e "$root/.ags-retired/ags-v1.retiring" ]
            [ ! -L "$root/.ags-retired/ags-v1.retiring" ]
            [ ! -e "$root/.ags-retired/ags-v1.retired" ]
            [ ! -L "$root/.ags-retired/ags-v1.retired" ]
            source="$root/$source_relative"
            destination="$root/$destination_relative"
            [ -f "$source" ] && [ ! -L "$source" ]
            [ "$(sha256sum "$source" | cut -d" " -f1)" = "$digest" ]
            if [ -e "$destination" ] || [ -L "$destination" ]; then
                exit 17
            fi
            mkdir -p -- "$(dirname -- "$destination")"
            [ -z "$(find "$(dirname -- "$destination")" -type l -print -quit)" ]
            mv -- "$source" "$destination"
            [ -f "$destination" ] && [ ! -L "$destination" ]
            [ "$(sha256sum "$destination" | cut -d" " -f1)" = "$digest" ]
        '
}

sftp_server_tree_revision() {
    local relative="$1" output revision
    validate_sftp_relative_path "$relative"
    output="$(
        printf '%s\n%s\n' "$sync_remote_path" "$relative" |
            sync_sftp_ssh_run '
                set -eu
                umask 077
                IFS= read -r root
                IFS= read -r relative
                case "$root" in
                    /*) ;;
                    *) exit 64 ;;
                esac
                case "$relative" in
                    ""|/*|*/|.|..|../*|*/../*|*/..) exit 64 ;;
                esac
                [ -d "$root" ] && [ ! -L "$root" ]
                lock_path="$root/.ags-transaction.lock"
                if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
                    [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
                fi
                exec 9>>"$lock_path"
                chmod 600 "$lock_path"
                flock -s -w 300 9
                [ -d "$root" ] && [ ! -L "$root" ]
                [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
                [ -z "$(find "$root" -type l -print -quit)" ]
                tree="$root/$relative"
                manifest=
                if [ -e "$tree" ] || [ -L "$tree" ]; then
                    [ -d "$tree" ] && [ ! -L "$tree" ]
                    [ -z "$(find "$tree" ! -type f ! -type d -print -quit)" ]
                    manifest="$(
                        cd -- "$tree"
                        find . -type f -print |
                            LC_ALL=C sort |
                            while IFS= read -r entry; do
                                path="${entry#./}"
                                case "$path" in
                                    ""|*[!A-Za-z0-9._/@+-]*) exit 65 ;;
                                esac
                                size="$(stat -c %s -- "$entry")"
                                digest="$(sha256sum "$entry" | cut -d" " -f1)"
                                printf "%s\t%s\t%s\n" "$path" "$size" "$digest"
                            done
                    )"
                fi
                revision="$(
                    printf "%s\n" "$manifest" |
                        sha256sum |
                        cut -d" " -f1
                )"
                printf "sftp:%s\n" "$revision"
            '
    )" || die "cannot compute a content-bound SFTP revision"
    revision="$(tail -n 1 <<< "$output")"
    [[ "$revision" =~ ^sftp:[0-9a-f]{64}$ ]] ||
        die "SFTP server returned an invalid revision"
    printf '%s\n' "$revision"
}

sftp_server_legacy_revision() {
    local unified_relative="${1:-$remote_store_prefix}"
    local legacy_parent="${2:-.}" output revision
    validate_sftp_relative_path "$unified_relative"
    [[ "$legacy_parent" == . ]] ||
        validate_sftp_relative_path "$legacy_parent"
    output="$(
        printf '%s\n%s\n%s\n' \
            "$sync_remote_path" "$unified_relative" "$legacy_parent" |
            sync_sftp_ssh_run '
                set -eu
                umask 077
                IFS= read -r root
                IFS= read -r unified_relative
                IFS= read -r legacy_parent
                case "$root" in
                    /*) ;;
                    *) exit 64 ;;
                esac
                for relative in "$unified_relative" "$legacy_parent"; do
                    case "$relative" in
                        ""|/*|*/|..|../*|*/../*|*/..) exit 64 ;;
                    esac
                done
                [ -d "$root" ] && [ ! -L "$root" ]
                lock_path="$root/.ags-transaction.lock"
                if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
                    [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
                fi
                exec 9>>"$lock_path"
                chmod 600 "$lock_path"
                flock -s -w 300 9
                [ -d "$root" ] && [ ! -L "$root" ]
                [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
                [ -z "$(find "$root" -type l -print -quit)" ]

                list_tree() {
                    tree="$1"
                    prefix="$2"
                    if [ -e "$tree" ] || [ -L "$tree" ]; then
                        [ -d "$tree" ] && [ ! -L "$tree" ]
                        [ -z "$(
                            find "$tree" ! -type f ! -type d -print -quit
                        )" ]
                        (
                            cd -- "$tree"
                            find . -type f -print |
                                LC_ALL=C sort |
                                while IFS= read -r entry; do
                                    path="${entry#./}"
                                    [ -n "$path" ]
                                    size="$(stat -c %s -- "$entry")"
                                    digest="$(
                                        sha256sum "$entry" | cut -d" " -f1
                                    )"
                                    path_digest="$(
                                        printf "%s/%s" "$prefix" "$path" |
                                            sha256sum |
                                            cut -d" " -f1
                                    )"
                                    printf "%s\t%s\t%s\n" \
                                        "$path_digest" "$size" "$digest"
                                done
                        )
                    fi
                }

                if [ "$legacy_parent" = "." ]; then
                    legacy_root="$root"
                else
                    legacy_root="$root/$legacy_parent"
                fi
                manifest="$(
                    {
                        list_tree "$root/$unified_relative" ags-v1
                        list_tree "$legacy_root/codex" codex
                        list_tree "$legacy_root/claude" claude
                    } |
                        LC_ALL=C sort
                )"
                revision="$(
                    printf "%s\n" "$manifest" |
                        sha256sum |
                        cut -d" " -f1
                )"
                printf "sftp:%s\n" "$revision"
            '
    )" || die "cannot compute a content-bound legacy SFTP revision"
    revision="$(tail -n 1 <<< "$output")"
    [[ "$revision" =~ ^sftp:[0-9a-f]{64}$ ]] ||
        die "SFTP server returned an invalid legacy revision"
    printf '%s\n' "$revision"
}

selected_sftp_remote_revision() {
    if [[ "${sync_remote_legacy_cloud:-0}" == 1 ]]; then
        sftp_server_legacy_revision "$remote_store_prefix" .
    else
        sftp_server_tree_revision "$remote_store_prefix"
    fi
}

assert_sftp_remote_not_retired() {
    [[ "${ags_allow_remote_retirement_marker:-0}" != 1 ]] || return 0
    printf '%s\n' "$sync_remote_path" |
        sync_sftp_ssh_run '
            set -eu
            umask 077
            IFS= read -r root
            case "$root" in
                /*) ;;
                *) exit 64 ;;
            esac
            [ -d "$root" ] && [ ! -L "$root" ]
            lock_path="$root/.ags-transaction.lock"
            if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
                [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
            fi
            exec 9>>"$lock_path"
            chmod 600 "$lock_path"
            flock -s -w 300 9
            [ -d "$root" ] && [ ! -L "$root" ]
            [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
            for marker in \
                "$root/.ags-retired/ags-v1.retiring" \
                "$root/.ags-retired/ags-v1.retired"; do
                if [ -e "$marker" ] || [ -L "$marker" ]; then
                    [ -f "$marker" ] && [ ! -L "$marker" ]
                    exit 75
                fi
            done
        ' ||
        die "remote $sync_remote_name is retired, unsafe, or cannot be verified"
}

assert_git_target_not_retired() {
    local url="$1" branch="$2" workspace repo status root_entry marker_entry
    mkdir -p "$state"
    workspace="$(mktemp -d "$state/git-remote-probe.XXXXXX")"
    trap_cleanup_dirs "$workspace"
    repo="$workspace/repo"
    git init -q "$repo"
    git -C "$repo" remote add origin "$url"
    if git -C "$repo" ls-remote --exit-code --heads origin \
        "refs/heads/$branch" >/dev/null 2>&1; then
        git -C "$repo" fetch -q --no-tags origin "refs/heads/$branch"
    else
        status=$?
        (( status == 2 )) || die "cannot inspect Git remote retirement state"
        rm -rf -- "$workspace"
        trap - EXIT
        return 0
    fi
    root_entry="$(git -C "$repo" ls-tree FETCH_HEAD -- .ags-retired)"
    if [[ -n "$root_entry" ]]; then
        [[ "$root_entry" == 040000\ tree\ *$'\t'.ags-retired ]] ||
            die "Git remote has an unsafe .ags-retired path"
        for marker_entry in \
            "$remote_retirement_pending_marker" \
            "$remote_retirement_marker"; do
            if [[ -n "$(git -C "$repo" ls-tree FETCH_HEAD -- "$marker_entry")" ]]; then
                die "Git remote branch has already been retired"
            fi
        done
    fi
    rm -rf -- "$workspace"
    trap - EXIT
}

add_git_remote() {
    local name="${1:-}" url="${2:-}" branch= option listing head_branch
    shift 2 2>/dev/null || true
    validate_remote_name "$name"
    [[ "$name" != cloud && "$name" != neburst ]] ||
        die "remote name $name is reserved for SFTP cloud storage"
    validate_git_remote_url "$url"
    while (( $# )); do
        option="$1"
        shift
        case "$option" in
            --branch)
                (( $# )) || die "--branch requires a branch name"
                branch="$1"
                shift
                ;;
            *) die "usage: ags remote add NAME git URL [--branch BRANCH]" ;;
        esac
    done
    need git; need jq
    check_remote_name_available "$name"
    listing="$(git ls-remote --symref "$url" HEAD)" ||
        die "cannot connect to Git remote: $url"
    if [[ -z "$branch" ]]; then
        head_branch="$(sed -n 's/^ref: refs\/heads\/\([^[:space:]]*\)[[:space:]]HEAD$/\1/p' <<< "$listing" | head -n 1)"
        branch="${head_branch:-main}"
    fi
    validate_git_branch "$branch"
    assert_git_target_not_retired "$url" "$branch"
    save_git_remote_config "$name" "$url" "$branch"
    printf 'status=configured\nname=%s\ntype=git\nurl=%s\nbranch=%s\n' \
        "$name" "$url" "$branch"
}

add_sftp_remote() {
    local name="${1:-}" url="${2:-}" option known_hosts auth= key_file=
    local tmp probe_source probe_copy probe_path staged_secret=
    shift 2 2>/dev/null || true
    validate_remote_name "$name"
    [[ "$name" != github ]] ||
        die "remote name github is reserved for Git storage"
    parse_sftp_url "$url"
    sync_remote_name="$name"
    sync_remote_url="$cloud_url"
    sync_remote_user="$cloud_user"
    sync_remote_host="$cloud_host"
    sync_remote_port="$cloud_port"
    sync_remote_path="$cloud_path"
    known_hosts="${AGENT_SESSION_KNOWN_HOSTS:-$HOME/.ssh/known_hosts}"
    while (( $# )); do
        option="$1"
        shift
        case "$option" in
            --known-hosts)
                (( $# )) || die "--known-hosts requires an absolute path"
                known_hosts="$1"
                shift
                ;;
            --key)
                (( $# )) || die "--key requires an absolute path"
                [[ -z "$auth" ]] ||
                    die "choose exactly one of --key, --agent, or --password"
                auth=key
                key_file="$1"
                shift
                ;;
            --agent)
                [[ -z "$auth" ]] ||
                    die "choose exactly one of --key, --agent, or --password"
                auth=agent
                ;;
            --password)
                [[ -z "$auth" ]] ||
                    die "choose exactly one of --key, --agent, or --password"
                auth=password
                if [[ -n "${AGENT_SESSION_REMOTE_PASSWORD:-}" ]]; then
                    sync_remote_password_value="$AGENT_SESSION_REMOTE_PASSWORD"
                    unset AGENT_SESSION_REMOTE_PASSWORD
                else
                    [[ -t 0 ]] ||
                        die "--password requires a terminal or AGENT_SESSION_REMOTE_PASSWORD"
                    IFS= read -r -s -p 'SFTP password: ' sync_remote_password_value
                    printf '\n' >&2
                fi
                [[ -n "$sync_remote_password_value" ]] ||
                    die "SFTP password cannot be empty"
                [[ "$sync_remote_password_value" != *$'\n'* &&
                   "$sync_remote_password_value" != *$'\r'* ]] ||
                    die "SFTP password cannot contain line breaks"
                ;;
            *) die "usage: ags remote add NAME sftp URL [--known-hosts FILE] [--key FILE|--agent|--password]" ;;
        esac
    done

    need cmp; need jq; need rclone; need realpath; need ssh-keygen
    check_remote_name_available "$name"
    [[ -r "$known_hosts" ]] ||
        die "known_hosts is not readable: $known_hosts"
    known_hosts="$(realpath -e -- "$known_hosts")"
    verify_sftp_host_key "$sync_remote_host" "$sync_remote_port" "$known_hosts"
    if [[ -z "$auth" ]]; then
        if [[ -r "$ssh_key" ]]; then
            auth=key
            key_file="$ssh_key"
        elif [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
            auth=agent
        else
            die "SFTP requires authentication; pass --key FILE, --agent, or --password"
        fi
    fi
    if [[ "$auth" == key ]]; then
        [[ "$key_file" == /* && -r "$key_file" ]] ||
            die "SFTP private key is not readable: $key_file"
        [[ "$key_file" != *','* && "$key_file" != *$'\n'* &&
           "$key_file" != *$'\r'* && "$key_file" != *$'\t'* ]] ||
            die "SFTP key path contains unsupported characters"
        key_file="$(realpath -e -- "$key_file")"
    fi
    sync_remote_auth="$auth"
    sync_remote_key_file="$key_file"
    sync_remote_known_hosts="$known_hosts"
    build_sync_sftp_fs
    sftp_server_capability_probe
    assert_sftp_remote_not_retired

    mkdir -p "$state"
    tmp="$(mktemp -d "$state/remote-add.XXXXXX")"
    trap_cleanup_dirs "$tmp"
    probe_source="$tmp/source"
    probe_copy="$tmp/copy"
    probe_path=".ags-probes/remote-add.$(hostname -s).$$.$RANDOM"
    printf 'ags remote probe %s\n' "$(date -u +%FT%TZ)" > "$probe_source"
    sync_sftp_run copyto "$probe_source" "$sync_remote_fs/$probe_path" ||
        die "SFTP write probe failed"
    if ! sync_sftp_run copyto "$sync_remote_fs/$probe_path" "$probe_copy" ||
       ! cmp "$probe_source" "$probe_copy"; then
        sync_sftp_run deletefile "$sync_remote_fs/$probe_path" >/dev/null 2>&1 || true
        die "SFTP read-back verification failed"
    fi
    sync_sftp_run deletefile "$sync_remote_fs/$probe_path"
    if [[ "$auth" == password ]]; then
        staged_secret="$(stage_named_remote_password "$name" "$tmp")"
    fi
    save_sftp_remote_config \
        "$name" "$sync_remote_url" "$auth" "$known_hosts" "$key_file" \
        "$staged_secret"
    unset sync_remote_password_value
    rm -rf -- "$tmp"
    trap - EXIT
    printf 'status=configured\nname=%s\ntype=sftp\nurl=%s\nauth=%s\nknown_hosts=%s\n' \
        "$name" "$sync_remote_url" "$auth" "$known_hosts"
}

add_named_remote() {
    local name="${1:-}" type="${2:-}"
    validate_remote_name "$name"
    lock_storage_consolidation
    lock_remote_operation "$name"
    if [[ "$type" == sftp://* ]]; then
        (( $# >= 2 )) || die "usage: ags remote add NAME SFTP_URL [OPTIONS]"
        shift 2
        add_sftp_remote "$name" "$type" "$@"
        unlock_remote_operation
        unlock_storage_consolidation
        return
    fi
    [[ "$type" != ftp://* ]] || die "plaintext FTP is not supported; use SFTP"
    (( $# >= 3 )) || die "usage: ags remote add NAME git|sftp LOCATION [OPTIONS]"
    shift 2
    case "$type" in
        git) add_git_remote "$name" "$@" ;;
        sftp) add_sftp_remote "$name" "$@" ;;
        ftp) die "plaintext FTP is not supported; use SFTP" ;;
        *) die "remote type must be git or sftp" ;;
    esac
    unlock_remote_operation
    unlock_storage_consolidation
}

list_named_remotes() {
    (( $# == 0 )) || die "usage: ags remote list"
    need jq
    ensure_legacy_cloud_remote
    [[ -s "$storage_config" ]] || { log "no remotes configured"; return 0; }
    jq -e 'type == "object" and ((.remotes // {}) | type == "object")' \
        "$storage_config" >/dev/null || die "invalid storage configuration: $storage_config"
    {
        printf 'NAME\tTYPE\tDEFAULT\tLOCATION\n'
        jq -r '
            (.default_remote // "") as $default |
            (.remotes // {}) | to_entries | sort_by(.key)[] |
            [.key, .value.type, (if .key == $default then "*" else "" end),
             (.value.url // "")] | @tsv
        ' "$storage_config"
    } | render_columns -t -s $'\t'
}

show_named_remote() {
    local name="${1:-}"
    (( $# == 1 )) || die "usage: ags remote show NAME"
    validate_remote_name "$name"
    need jq
    ensure_legacy_cloud_remote
    [[ -s "$storage_config" ]] || die "remote not found: $name"
    jq -e --arg name "$name" '.remotes[$name] != null' "$storage_config" >/dev/null ||
        die "remote not found: $name"
    jq -r --arg name "$name" '
        . as $root | .remotes[$name] |
        "name=" + $name,
        "type=" + .type,
        "url=" + .url,
        (if .branch then "branch=" + .branch else empty end),
        (if .auth then "auth=" + .auth else empty end),
        (if .key_file then "key_file=" + .key_file else empty end),
        (if .known_hosts then "known_hosts=" + .known_hosts else empty end),
        "default=" + (($root.default_remote == $name) | tostring)
    ' "$storage_config"
}

use_named_remote() {
    local name="${1:-}"
    (( $# == 1 )) || die "usage: ags remote use NAME"
    validate_remote_name "$name"
    promote_storage_mode "remote:$name"
    printf 'status=selected\nremote=%s\n' "$name"
}

remote_has_pending_sync() {
    local name="$1" mode="remote:$1" pending
    if [[ -d "$state/pending" ]]; then
        while IFS= read -r -d '' pending; do
            if jq -e --arg mode "$mode" \
                '(.storage_mode // "local") == $mode' "$pending" >/dev/null 2>&1; then
                return 0
            fi
        done < <(find "$state/pending" -type f -name '*.json' -print0)
    fi
    if [[ -d "$state/pending-sync" ]]; then
        while IFS= read -r -d '' pending; do
            if jq -e --arg mode "$mode" \
                '.schema == 1 and .storage_mode == $mode' \
                "$pending" >/dev/null 2>&1; then
                return 0
            fi
        done < <(find "$state/pending-sync" -type f -name '*.json' -print0)
    fi
    return 1
}

valid_remote_recovery_path() {
    local name="$1" path="$2" parent timestamp
    parent="$state/trash/remotes/$name"
    [[ "$path" == "$parent/"* &&
       "$path" != *$'\n'* && "$path" != *$'\r'* &&
       "$path" != *$'\t'* ]] || return 1
    timestamp="${path#"$parent/"}"
    [[ -n "$timestamp" && "$timestamp" != */* &&
       "$path" == "$parent/$timestamp" ]] || return 1
    valid_retirement_timestamp "$timestamp" || return 1
    storage_path_has_safe_components "$path"
}

prepare_remote_recovery_directory() {
    local name="$1" path="$2" directory
    valid_remote_recovery_path "$name" "$path" ||
        die "remote retirement has an invalid recovery path"
    validate_storage_directory_path "$state"
    storage_path_has_safe_components "$state" ||
        die "AGS state path is unsafe for remote recovery"
    for directory in \
        "$state" \
        "$state/trash" \
        "$state/trash/remotes" \
        "$state/trash/remotes/$name" \
        "$path"; do
        if [[ -e "$directory" || -L "$directory" ]]; then
            [[ -d "$directory" && ! -L "$directory" ]] ||
                die "remote recovery path has an unsafe component: $directory"
        else
            install -d -m700 -- "$directory"
        fi
        chmod 700 -- "$directory"
    done
    valid_remote_recovery_path "$name" "$path" ||
        die "remote recovery path changed while it was being prepared"
}

valid_retirement_timestamp() {
    local timestamp="$1"
    [[ "$timestamp" =~ ^[0-9]{8}T[0-9]{6}Z\.[0-9]+\.[0-9]+$ ||
       "$timestamp" =~ ^[0-9]{8}T[0-9]{6}\.[0-9]{1,9}Z$ ]]
}

new_retirement_timestamp() {
    printf '%s.%s.%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "$RANDOM"
}

stage_remote_recovery() {
    local name="$1" trash_dir="$2" secret
    prepare_remote_recovery_directory "$name" "$trash_dir"
    [[ ! -e "$trash_dir/config.json" &&
       ! -L "$trash_dir/config.json" ]] ||
        die "remote recovery destination already contains configuration"
    secret="$(configured_remote_password_path "$name")"
    if [[ -n "$secret" ]]; then
        validate_configured_password_file "$secret" ||
            die "encrypted SFTP password is unsafe or unavailable: $secret"
    fi
    jq --arg name "$name" --arg password_file "$trash_dir/password.age" '
        .remotes[$name] |
        del(.retiring) |
        if .auth == "password" then
            .password_file = $password_file
        else del(.password_file) end
    ' \
        "$storage_config" > "$trash_dir/config.json"
    chmod 600 "$trash_dir/config.json"
    if [[ "$name" == neburst ]] &&
       jq -e '.remotes.neburst.legacy_cloud == true and .cloud != null' \
           "$storage_config" >/dev/null; then
        jq --arg password_file "$trash_dir/password.age" '
            .cloud |
            if .auth == "password" then
                .password_file = $password_file
            else del(.password_file) end
        ' "$storage_config" > "$trash_dir/legacy-cloud.json"
        chmod 600 "$trash_dir/legacy-cloud.json"
        if [[ -e "$cloud_password_file" || -L "$cloud_password_file" ]]; then
            [[ -f "$cloud_password_file" && ! -L "$cloud_password_file" ]] ||
                die "legacy cloud password is not a regular file"
            cp -p -- "$cloud_password_file" "$trash_dir/cloud-password.age"
            chmod 600 "$trash_dir/cloud-password.age"
        fi
    fi
    if [[ -n "$secret" ]]; then
        cp -p -- "$secret" "$trash_dir/password.age"
        chmod 600 "$trash_dir/password.age"
    fi
}

prepare_remote_retirement() {
    local name="$1" destination="$2" revision="${3:-}"
    local temporary timestamp trash_dir
    local existing_destination existing_timestamp existing_recovery existing_revision
    validate_remote_name "$name"
    need jq
    lock
    [[ -s "$storage_config" ]] || die "remote not found: $name"
    jq -e --arg name "$name" '.remotes[$name] != null' "$storage_config" >/dev/null ||
        die "remote not found: $name"
    remote_has_pending_sync "$name" &&
        die "remote $name has a pending automatic sync; run ags flush first"
    if jq -e --arg name "$name" '.remotes[$name].retiring != null' \
        "$storage_config" >/dev/null; then
        existing_destination="$(jq -er --arg name "$name" \
            '.remotes[$name].retiring.destination | select(type == "string")' \
            "$storage_config")" ||
            die "remote $name has an invalid retirement transaction"
        [[ "$existing_destination" == "$destination" ]] ||
            die "remote $name is already retiring into $existing_destination"
        existing_timestamp="$(jq -er --arg name "$name" \
            '.remotes[$name].retiring.timestamp |
             select(type == "string" and length > 0)' "$storage_config")" ||
            die "remote $name has an invalid retirement timestamp"
        valid_retirement_timestamp "$existing_timestamp" ||
            die "remote $name has an unsafe retirement timestamp"
        existing_recovery="$(jq -er --arg name "$name" \
            '.remotes[$name].retiring.recoverable_config |
             select(type == "string" and startswith("/"))' "$storage_config")" ||
            die "remote $name has an invalid retirement recovery path"
        [[ "$existing_recovery" == \
           "$state/trash/remotes/$name/$existing_timestamp" ]] &&
            valid_remote_recovery_path "$name" "$existing_recovery" &&
            [[ -f "$existing_recovery/config.json" &&
               ! -L "$existing_recovery/config.json" ]] ||
            die "remote $name retirement recovery data is unavailable"
        existing_revision="$(jq -er --arg name "$name" \
            '.remotes[$name].retiring.revision |
             select(type == "string" and
                    (startswith("git:") or startswith("sftp:")))' \
            "$storage_config")" ||
            die "remote $name has an invalid retirement revision"
        retirement_timestamp="$existing_timestamp"
        retirement_recovery="$existing_recovery"
        retirement_revision="$existing_revision"
        unlock
        return 0
    fi
    [[ "$revision" == git:* || "$revision" == sftp:* ]] ||
        die "remote $name retirement requires a verified revision"
    timestamp="$(new_retirement_timestamp)"
    valid_retirement_timestamp "$timestamp" ||
        die "cannot create a safe retirement timestamp"
    trash_dir="$state/trash/remotes/$name/$timestamp"
    stage_remote_recovery "$name" "$trash_dir"
    temporary="$storage_config.tmp.$$"
    jq --arg name "$name" --arg destination "$destination" \
        --arg revision "$revision" \
        --arg timestamp "$timestamp" --arg recovery "$trash_dir" '
        .remotes[$name].retiring = {
            destination:$destination,
            revision:$revision,
            timestamp:$timestamp,
            recoverable_config:$recovery
        } |
        .version = 4
    ' "$storage_config" > "$temporary"
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    retirement_timestamp="$timestamp"
    retirement_recovery="$trash_dir"
    retirement_revision="$revision"
    unlock
}

remove_named_remote() {
    local name="${1:-}" internal="${2:-}" temporary secret trash_dir timestamp
    local retirement_destination= remove_legacy_cloud=0
    if [[ "$internal" == --retirement ]]; then
        (( $# == 2 )) || die "invalid internal remote retirement"
    else
        (( $# == 1 )) || die "usage: ags remote remove NAME"
    fi
    validate_remote_name "$name"
    need jq
    lock_storage_consolidation
    lock_remote_operation "$name"
    ensure_legacy_cloud_remote
    lock
    [[ -s "$storage_config" ]] || die "remote not found: $name"
    jq -e --arg name "$name" '.remotes[$name] != null' "$storage_config" >/dev/null ||
        die "remote not found: $name"
    if [[ "$name" == neburst ]] &&
       jq -e '.remotes.neburst.legacy_cloud == true' \
           "$storage_config" >/dev/null; then
        remove_legacy_cloud=1
    fi
    remote_has_pending_sync "$name" &&
        die "remote $name has a pending automatic sync; run ags flush first"
    secret="$(configured_remote_password_path "$name")"
    if [[ "$internal" != --retirement ]] &&
       jq -e --arg mode "remote:$name" '
           (.merged_modes // {})[$mode] != null or
           any((.merged_modes // {}) | to_entries[]; .value == $mode) or
           any((.retired_modes // {}) | to_entries[]; .value == $mode)
       ' "$storage_config" >/dev/null; then
        die "remote $name participates in storage consolidation; retire it through ags storage retire"
    fi
    if [[ "$internal" == --retirement ]]; then
        retirement_destination="$(jq -er --arg name "$name" \
            '.remotes[$name].retiring.destination | select(type == "string")' \
            "$storage_config")" ||
            die "remote $name has no prepared retirement"
        trash_dir="$(jq -er --arg name "$name" \
            '.remotes[$name].retiring.recoverable_config |
             select(type == "string" and startswith("/"))' "$storage_config")" ||
            die "remote $name retirement recovery path is invalid"
        valid_remote_recovery_path "$name" "$trash_dir" &&
            [[ -f "$trash_dir/config.json" && ! -L "$trash_dir/config.json" ]] ||
            die "remote $name retirement recovery data is unavailable"
    else
        jq -e --arg name "$name" '.remotes[$name].retiring == null' \
            "$storage_config" >/dev/null ||
            die "remote $name has a pending retirement; rerun ags storage retire"
        timestamp="$(new_retirement_timestamp)"
        valid_retirement_timestamp "$timestamp" ||
            die "cannot create a safe retirement timestamp"
        trash_dir="$state/trash/remotes/$name/$timestamp"
        stage_remote_recovery "$name" "$trash_dir"
    fi
    temporary="$storage_config.tmp.$$"
    jq --arg name "$name" --arg source "remote:$name" \
        --arg destination "$retirement_destination" \
        --argjson remove_legacy_cloud "$remove_legacy_cloud" '
        .merged_modes = (
            (.merged_modes // {}) |
            with_entries(
                if $destination != "" and .value == $source
                then .value = $destination else . end
            )
        ) |
        .retired_modes = (
            (.retired_modes // {}) |
            with_entries(
                if $destination != "" and .value == $source
                then .value = $destination else . end
            )
        ) |
        del(.remotes[$name]) |
        del(.merged_modes[$source]) |
        if $remove_legacy_cloud then del(.cloud) else . end |
        if .default_remote == $name then del(.default_remote) else . end |
        .mode_mru = [(.mode_mru // [])[] | select(. != ("remote:" + $name))] |
        if $destination == "" then . else
            .retired_modes = (.retired_modes // {}) |
            .retired_modes["remote:" + $name] = $destination
        end |
        .version = 4
    ' "$storage_config" > "$temporary"
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    if [[ -n "$secret" && ( -e "$secret" || -L "$secret" ) ]]; then
        validate_configured_password_file "$secret" ||
            die "encrypted SFTP password is unsafe or unavailable: $secret"
        mv -f -- "$secret" "$trash_dir/password.age"
    fi
    if (( remove_legacy_cloud == 1 )) &&
       [[ "$secret" != "$cloud_password_file" ]] &&
       [[ -e "$cloud_password_file" || -L "$cloud_password_file" ]]; then
        [[ -f "$cloud_password_file" && ! -L "$cloud_password_file" ]] ||
            die "legacy cloud password is not a regular file"
        mv -f -- "$cloud_password_file" "$trash_dir/cloud-password.age"
    fi
    [[ "$name" != neburst ]] || retire_unreferenced_neburst_passwords
    unlock
    unlock_remote_operation
    unlock_storage_consolidation
    printf 'status=removed\nremote=%s\nrecoverable_config=%s\n' \
        "$name" "$trash_dir"
}

select_named_remote() {
    local requested="${1:-}" count
    need jq
    ensure_legacy_cloud_remote
    sync_remote_legacy_cloud=0
    sync_remote_password_file=
    [[ -s "$storage_config" ]] || die "no remotes configured; run ags remote add"
    jq -e 'type == "object" and ((.remotes // {}) | type == "object")' \
        "$storage_config" >/dev/null || die "invalid storage configuration: $storage_config"
    if [[ -n "$requested" ]]; then
        validate_remote_name "$requested"
        sync_remote_name="$requested"
    else
        sync_remote_name="$(jq -r '.default_remote // empty' "$storage_config")"
        if [[ -z "$sync_remote_name" ]]; then
            count="$(jq '(.remotes // {}) | length' "$storage_config")"
            if [[ "$count" == 1 ]]; then
                sync_remote_name="$(jq -r '(.remotes // {}) | keys[0]' "$storage_config")"
            else
                die "choose a remote or run ags remote use NAME"
            fi
        fi
    fi
    validate_remote_name "$sync_remote_name"
    jq -e --arg name "$sync_remote_name" '.remotes[$name] != null' \
        "$storage_config" >/dev/null || die "remote not found: $sync_remote_name"
    if [[ "${ags_allow_retiring_remote:-0}" != 1 ]]; then
        jq -e --arg name "$sync_remote_name" \
            '.remotes[$name].retiring == null' "$storage_config" >/dev/null ||
            die "remote $sync_remote_name has a pending retirement; rerun ags storage retire"
    fi
    sync_remote_type="$(jq -er --arg name "$sync_remote_name" \
        '.remotes[$name].type | select(. == "git" or . == "sftp")' "$storage_config")" ||
        die "invalid remote type: $sync_remote_name"
    sync_remote_url="$(jq -er --arg name "$sync_remote_name" \
        '.remotes[$name].url | select(type == "string" and length > 0)' "$storage_config")" ||
        die "remote URL is missing: $sync_remote_name"
    case "$sync_remote_type" in
        git)
            validate_git_remote_url "$sync_remote_url"
            sync_remote_branch="$(jq -er --arg name "$sync_remote_name" \
                '.remotes[$name].branch | select(type == "string" and length > 0)' "$storage_config")" ||
                die "Git branch is missing: $sync_remote_name"
            validate_git_branch "$sync_remote_branch"
            ;;
        sftp)
            need rclone; need ssh-keygen
            if jq -e --arg name "$sync_remote_name" \
                '.remotes[$name].legacy_cloud == true' \
                "$storage_config" >/dev/null; then
                sync_remote_legacy_cloud=1
            fi
            sync_remote_auth="$(jq -er --arg name "$sync_remote_name" \
                '.remotes[$name].auth |
                 select(. == "key" or . == "agent" or . == "password")' \
                "$storage_config")" ||
                die "SFTP authentication is missing: $sync_remote_name"
            sync_remote_known_hosts="$(jq -er --arg name "$sync_remote_name" \
                '.remotes[$name].known_hosts | select(type == "string" and length > 0)' "$storage_config")" ||
                die "known_hosts is missing: $sync_remote_name"
            sync_remote_key_file="$(jq -r --arg name "$sync_remote_name" \
                '.remotes[$name].key_file // empty' "$storage_config")"
            parse_sftp_url "$sync_remote_url"
            sync_remote_user="$cloud_user"
            sync_remote_host="$cloud_host"
            sync_remote_port="$cloud_port"
            sync_remote_path="$cloud_path"
            verify_sftp_host_key "$sync_remote_host" "$sync_remote_port" "$sync_remote_known_hosts"
            if [[ "$sync_remote_auth" == key ]]; then
                [[ "$sync_remote_key_file" == /* && -r "$sync_remote_key_file" ]] ||
                    die "SFTP private key is not readable: $sync_remote_key_file"
                [[ "$sync_remote_key_file" != *','* &&
                   "$sync_remote_key_file" != *$'\n'* &&
                   "$sync_remote_key_file" != *$'\r'* &&
                   "$sync_remote_key_file" != *$'\t'* ]] ||
                    die "SFTP key path contains unsupported characters"
            elif [[ "$sync_remote_auth" == password ]]; then
                need age
                sync_remote_password_file="$(jq -r \
                    --arg name "$sync_remote_name" \
                    --arg fallback "$(
                        named_remote_password_path "$sync_remote_name"
                    )" '
                    .remotes[$name].password_file // $fallback
                ' "$storage_config")"
                validate_configured_password_file "$sync_remote_password_file" ||
                    die "encrypted SFTP password is missing for remote $sync_remote_name"
            fi
            build_sync_sftp_fs
            ;;
    esac
}

storage_mode_is_configured() {
    local mode="$1" name
    need jq
    ensure_legacy_cloud_remote
    case "$mode" in
        local)
            [[ -n "${AGENT_SESSION_LOCAL_DIR:-}" ]] && return 0
            [[ -s "$storage_config" ]] &&
                jq -e '
                    (.local_path // .paths.local) |
                    type == "string" and startswith("/")
                ' "$storage_config" >/dev/null
            ;;
        remote:*)
            name="${mode#remote:}"
            validate_remote_name "$name"
            [[ -s "$storage_config" ]] &&
                jq -e --arg name "$name" '
                    .remotes[$name] |
                    type == "object" and
                    (.type == "git" or .type == "sftp")
                ' "$storage_config" >/dev/null
            ;;
        *) return 1 ;;
    esac
}

named_remote_has_type() {
    local name="$1" type="$2"
    [[ -s "$storage_config" ]] &&
        jq -e --arg name "$name" --arg type "$type" '
            .remotes[$name] |
            type == "object" and .type == $type
        ' "$storage_config" >/dev/null
}

follow_storage_mode_redirects() {
    local mode="$1" next depth
    local -A seen=()
    [[ -s "$storage_config" ]] || {
        resolved_storage_mode="$mode"
        return
    }
    for depth in {1..16}; do
        [[ ! ${seen[$mode]+present} ]] ||
            die "storage retirement redirects contain a cycle"
        seen["$mode"]=1
        next="$(jq -r --arg mode "$mode" '
            (.retired_modes // {})[$mode] //
            (.merged_modes // {})[$mode] //
            empty
        ' "$storage_config")"
        [[ -n "$next" ]] || {
            resolved_storage_mode="$mode"
            return
        }
        [[ "$next" == local || "$next" == remote:* ]] ||
            die "storage retirement redirect is invalid: $mode"
        mode="$next"
    done
    die "storage retirement redirect chain is too deep"
}

configured_storage_modes() {
    local env_local=0
    need jq
    ensure_legacy_cloud_remote
    [[ -z "${AGENT_SESSION_LOCAL_DIR:-}" ]] || env_local=1
    if [[ -s "$storage_config" ]]; then
        jq -r --argjson env_local "$env_local" '
            . as $root |
            ([
                if $env_local == 1 or
                   ((.local_path // .paths.local // null) | type == "string")
                then
                    if (($root.merged_modes // {}).local == null)
                    then "local" else empty end
                else empty end
            ] + [
                (.remotes // {} | to_entries[] |
                    select(
                        (.value.type == "git" or .value.type == "sftp") and
                        (.value.retiring == null) and
                        (($root.merged_modes // {})["remote:" + .key] == null)
                    ) |
                    "remote:" + .key)
            ]) as $configured |
            (if (.mode_mru // []) | type == "array"
             then (.mode_mru // []) else [] end) as $mru |
            [$mru[] |
                select(type == "string" and
                       ($configured | index(.) != null))] as $recent |
            reduce (($recent + ($configured | sort))[]) as $mode
                ([]; if index($mode) == null
                     then . + [$mode] else . end) |
            .[]
        ' "$storage_config"
    elif (( env_local == 1 )); then
        printf 'local\n'
    fi
}

resolve_storage_mode() {
    local requested="${1:-}" name
    local -a matches=()
    need jq
    [[ -n "$requested" && "$requested" != *$'\n'* &&
       "$requested" != *$'\r'* && "$requested" != *$'\t'* ]] ||
        die "storage mode is required"
    case "$requested" in
        local)
            resolved_storage_mode=local
            ;;
        remote:*)
            name="${requested#remote:}"
            validate_remote_name "$name"
            resolved_storage_mode="remote:$name"
            ;;
        *)
            validate_remote_name "$requested"
            if [[ "$requested" == cloud || "$requested" == neburst ]]; then
                if named_remote_has_type "$requested" sftp; then
                    resolved_storage_mode="remote:$requested"
                elif named_remote_has_type neburst sftp; then
                    resolved_storage_mode=remote:neburst
                elif [[ -s "$storage_config" ]]; then
                    mapfile -t matches < <(jq -r '
                        (.remotes // {}) | to_entries[] |
                        select(.value.type == "sftp") | .key
                    ' "$storage_config")
                    (( ${#matches[@]} == 1 )) ||
                        die "cloud is ambiguous; choose a configured SFTP remote name"
                    resolved_storage_mode="remote:${matches[0]}"
                else
                    die "cloud storage is not configured"
                fi
            elif [[ "$requested" == github ]]; then
                if named_remote_has_type github git; then
                    resolved_storage_mode=remote:github
                elif [[ -s "$storage_config" ]]; then
                    mapfile -t matches < <(jq -r '
                        (.remotes // {}) | to_entries[] |
                        select(.value.type == "git") | .key
                    ' "$storage_config")
                    (( ${#matches[@]} == 1 )) ||
                        die "GitHub is ambiguous; choose a configured Git remote name"
                    resolved_storage_mode="remote:${matches[0]}"
                else
                    die "GitHub storage is not configured"
                fi
            elif storage_mode_is_configured "remote:$requested"; then
                resolved_storage_mode="remote:$requested"
            else
                die "storage mode is not configured: $requested"
            fi
            ;;
    esac
    if [[ "${ags_ignore_storage_redirect:-0}" != 1 ]]; then
        follow_storage_mode_redirects "$resolved_storage_mode"
    fi
    storage_mode_is_configured "$resolved_storage_mode" ||
        die "storage mode is not configured: $requested"
    if [[ "$resolved_storage_mode" == remote:* &&
          "${ags_allow_retiring_remote:-0}" != 1 ]]; then
        jq -e --arg name "${resolved_storage_mode#remote:}" \
            '.remotes[$name].retiring == null' "$storage_config" >/dev/null ||
            die "remote ${resolved_storage_mode#remote:} has a pending retirement; rerun ags storage retire"
    fi
}

redirect_merged_storage_sources() {
    local destination="$1" source sources_json temporary
    shift
    local -a redirected_sources=()
    for source in "$@"; do
        [[ "$source" == "$destination" ]] ||
            redirected_sources+=("$source")
    done
    (( ${#redirected_sources[@]} > 0 )) || return 0
    sources_json="$(
        printf '%s\n' "${redirected_sources[@]}" |
            jq -Rsc 'split("\n") | map(select(length > 0))'
    )"
    lock
    temporary="$storage_config.tmp.$$"
    if ! jq --arg destination "$destination" --argjson sources "$sources_json" '
        def configured($root; $mode):
            if $mode == "local" then
                (($root.local_path // $root.paths.local // null) |
                 type == "string" and startswith("/"))
            elif ($mode | startswith("remote:")) then
                ($mode | ltrimstr("remote:")) as $name |
                ($root.remotes[$name] |
                 type == "object" and
                 (.type == "git" or .type == "sftp") and
                 .retiring == null)
            else false end;
        . as $root |
        if configured($root; $destination) and
           ([$sources[] | configured($root; .)] | all)
        then . else
            error("storage configuration changed during consolidation")
        end |
        .version = 4 |
        .merged_modes = (.merged_modes // {}) |
        del(.merged_modes[$destination]) |
        .merged_modes = (
            .merged_modes |
            with_entries(
                .value as $value |
                if ($sources | index($value)) != null
                then .value = $destination else . end
            )
        ) |
        .retired_modes = (
            (.retired_modes // {}) |
            with_entries(
                .value as $value |
                if ($sources | index($value)) != null
                then .value = $destination else . end
            )
        ) |
        reduce $sources[] as $source (.;
            if $source == $destination then . else
                .merged_modes[$source] = $destination
            end
        ) |
        .merged_modes = (
            .merged_modes |
            with_entries(select(.key != .value))
        )
    ' "$storage_config" > "$temporary"; then
        rm -f -- "$temporary"
        unlock
        die "storage configuration changed during consolidation"
    fi
    if ! jq -e '
        ((.merged_modes // {}) + (.retired_modes // {})) as $links |
        def acyclic($node; $seen):
            if $node == null then true
            elif ($seen | index($node)) != null then false
            else acyclic($links[$node]; $seen + [$node])
            end;
        [($links | keys[]) | acyclic(.; [])] | all
    ' "$temporary" >/dev/null; then
        rm -f -- "$temporary"
        unlock
        die "storage consolidation would create a redirect cycle"
    fi
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    unlock
}

storage_mode_label() {
    local mode="$1" name type
    if [[ "$mode" == local ]]; then
        printf 'Local\n'
        return
    fi
    name="${mode#remote:}"
    type="$(jq -r --arg name "$name" '.remotes[$name].type' "$storage_config")"
    case "$name:$type" in
        neburst:sftp) printf 'Neburst cloud\n' ;;
        github:git) printf 'GitHub\n' ;;
        *:sftp) printf '%s cloud\n' "$name" ;;
        *:git) printf '%s Git\n' "$name" ;;
    esac
}

storage_mode_type() {
    local mode="$1" name
    if [[ "$mode" == local ]]; then
        printf 'local\n'
    else
        name="${mode#remote:}"
        jq -r --arg name "$name" '.remotes[$name].type' "$storage_config"
    fi
}

promote_storage_mode() {
    local mode="$1" name= temporary
    storage_mode_is_configured "$mode" ||
        die "storage mode is not configured: $mode"
    if [[ "$mode" == remote:* ]]; then
        jq -e --arg name "${mode#remote:}" \
            '.remotes[$name].retiring == null' "$storage_config" >/dev/null ||
            die "remote ${mode#remote:} has a pending retirement"
    fi
    [[ -s "$storage_config" ]] || return 0
    [[ "$mode" != remote:* ]] || name="${mode#remote:}"
    lock
    temporary="$storage_config.tmp.$$"
    jq --arg mode "$mode" --arg name "$name" '
        .version = 4 |
        .mode_mru = (
            [$mode] +
            [(.mode_mru // [])[] |
                select(type == "string" and . != $mode)]
        ) |
        if $name == "" then . else .default_remote = $name end
    ' "$storage_config" > "$temporary"
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    unlock
}

list_storage_modes() {
    local mode type label marker index=0
    local -a modes=()
    (( $# == 0 )) || die "usage: ags storage list"
    mapfile -t modes < <(configured_storage_modes)
    (( ${#modes[@]} > 0 )) ||
        die "no storage configured; run ags init"
    {
        printf 'RECENT\tMODE\tTYPE\tLABEL\n'
        for mode in "${modes[@]}"; do
            marker=
            (( index > 0 )) || marker='*'
            type="$(storage_mode_type "$mode")"
            label="$(storage_mode_label "$mode")"
            printf '%s\t%s\t%s\t%s\n' "$marker" "$mode" "$type" "$label"
            index=$((index + 1))
        done
    } | render_columns -t -s $'\t'
}

use_storage_mode() {
    local requested="${1:-}"
    (( $# == 1 )) || die "usage: ags storage use local|NAME"
    resolve_storage_mode "$requested"
    promote_storage_mode "$resolved_storage_mode"
    printf 'status=selected\nmode=%s\n' "$resolved_storage_mode"
}

prepare_storage_for_launch() {
    local requested="${AGENT_SESSION_STORAGE_MODE:-}" choice mode index
    local sync_error sync_status
    local -a modes=()
    [[ "${ags_storage_prepared:-0}" == 0 ]] || return 0
    if [[ -n "$requested" ]]; then
        resolve_storage_mode "$requested"
        mode="$resolved_storage_mode"
    else
        mapfile -t modes < <(configured_storage_modes)
        (( ${#modes[@]} > 0 )) ||
            die "no storage configured; run ags init"
        if (( ${#modes[@]} == 1 )) || [[ ! -t 0 || ! -t 1 ]]; then
            mode="${modes[0]}"
        else
            printf 'Storage:\n'
            for index in "${!modes[@]}"; do
                printf '  %d) %s\n' "$((index + 1))" \
                    "$(storage_mode_label "${modes[$index]}")"
            done
            printf 'Choose [1]: '
            IFS= read -r choice
            choice="${choice:-1}"
            [[ "$choice" =~ ^[1-9][0-9]*$ ]] &&
                (( 10#$choice <= ${#modes[@]} )) ||
                die "invalid storage selection"
            mode="${modes[10#$choice - 1]}"
        fi
    fi
    if [[ "$mode" == remote:* ]]; then
        if sync_error="$(sync_records sync "${mode#remote:}" 2>&1 >/dev/null)"; then
            :
        else
            sync_status=$?
            [[ -z "$sync_error" ]] || printf '%s\n' "$sync_error" >&2
            return "$sync_status"
        fi
    else
        load_local_storage
    fi
    promote_storage_mode "$mode"
    export AGENT_SESSION_STORAGE_MODE="$mode"
    ags_storage_prepared=1
}

copy_jsonl_tree() {
    local source="$1" destination="$2"
    [[ -d "$source" ]] || return 0
    mkdir -p "$destination"
    rsync -a --no-links --prune-empty-dirs \
        --include='*/' --include='*.jsonl' --exclude='*' \
        "$source/" "$destination/"
}

validate_jsonl() {
    local root="$1" file count=0
    while IFS= read -r -d '' file; do
        tail -n 1 "$file" | jq -e . >/dev/null ||
            die "incomplete session (agent may still be writing): $file"
        count=$((count + 1))
    done < <(find "$root" -type f -name '*.jsonl' -print0)
    (( count > 0 )) || die "no sessions found"
    printf '%s\n' "$count"
}

validate_session_id() {
    [[ "$1" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] ||
        die "expected a native session UUID"
}

validate_new_checkpoint_id() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
        die "ID must be 1-64 letters, numbers, dots, underscores, or hyphens"
}

valid_binary_provenance_path() {
    local path="${1:-}"
    [[ "$path" == /* && "$path" != *$'\n'* &&
       "$path" != *$'\r'* && "$path" != *$'\t'* ]]
}

valid_local_binary_path() {
    local path="${1:-}"
    valid_binary_provenance_path "$path" && [[ -f "$path" && -x "$path" ]]
}

valid_agent_binary_path() {
    local agent="$1" path="$2"
    [[ "$agent" == codex || "$agent" == claude ]] &&
        valid_binary_provenance_path "$path" &&
        { [[ "${path##*/}" == "$agent" ]] ||
          # codext is Codex with the credential pool wired in. It is the same
          # CLI, the same session format, the same everything AGS reads — the
          # fork adds one auth provider. Refusing it here would mean AGS could
          # never launch the build this machine is configured to use.
          [[ "$agent" == codex && "${path##*/}" == codext ]]; }
}

find_agent_ancestor_binary() {
    local agent="$1" process_id="$PPID" process_name process_exe process_argv0
    local process_parent version lower iteration
    [[ "$platform" == Linux ]] || return 1
    for iteration in {1..32}; do
        [[ "$process_id" =~ ^[0-9]+$ && -r "/proc/$process_id/status" ]] || break
        process_argv0=
        if [[ -r "/proc/$process_id/cmdline" ]]; then
            IFS= read -r -d '' process_argv0 < "/proc/$process_id/cmdline" || true
        fi
        if [[ "${process_argv0##*/}" == "$agent" ]] &&
           valid_local_binary_path "$process_argv0"; then
            printf '%s\n' "$process_argv0"
            return 0
        fi
        process_exe="$(readlink -f -- "/proc/$process_id/exe" 2>/dev/null || true)"
        if [[ "${process_exe##*/}" == "$agent" ]] &&
           valid_local_binary_path "$process_exe"; then
            printf '%s\n' "$process_exe"
            return 0
        fi
        process_name="$(sed -n 's/^Name:[[:space:]]*//p' "/proc/$process_id/status")"
        if [[ "$process_name" == "$agent" ]] && valid_local_binary_path "$process_exe"; then
            version="$("$process_exe" --version 2>/dev/null || true)"
            lower="${version,,}"
            if [[ "$lower" == *"$agent"* ||
                  ( "$agent" == claude && "$lower" == *"claude code"* ) ]]; then
                printf '%s\n' "$process_exe"
                return 0
            fi
        fi
        process_parent="$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$process_id/status")"
        [[ "$process_parent" != "$process_id" ]] || break
        process_id="$process_parent"
    done
    return 1
}

resolve_agent_binary() {
    local agent="$1" mode="${2:-resume}" binary registry
    [[ "$agent" == codex || "$agent" == claude ]] || die "agent must be codex or claude"
    case "$agent" in
        codex) binary="${AGENT_SESSION_CODEX_BINARY:-}" ;;
        claude) binary="${AGENT_SESSION_CLAUDE_BINARY:-}" ;;
    esac
    if [[ -n "$binary" ]]; then
        valid_local_binary_path "$binary" ||
            die "configured $agent binary is not executable: $binary"
        printf '%s\n' "$binary"
        return
    fi
    # Ahead of the registry below, which is only a cache of whichever binary
    # AGS launched last, not a declared preference — it gets rewritten on the
    # next launch anyway.
    #
    # Prefer codext when it is installed. It is a superset: with a pool
    # configured it leases an account, and without one it falls back to the
    # same local auth.json plain codex uses. Preferring it here is what makes
    # `ags codex`, the launcher menu and every resume path go through the pool
    # without any of them having to know the pool exists.
    if [[ "$agent" == codex ]]; then
        binary="$(command -v codext 2>/dev/null || true)"
        if valid_agent_binary_path codex "$binary" && [[ -f "$binary" && -x "$binary" ]]; then
            printf '%s\n' "$binary"
            return
        fi
    fi
    registry="$trusted_binary_dir/$agent"
    if [[ "$mode" != save && -f "$registry" ]]; then
        IFS= read -r binary < "$registry" || true
        if valid_local_binary_path "$binary"; then
            printf '%s\n' "$binary"
            return
        fi
        log "warning: trusted local $agent binary is unavailable: ${binary:-invalid registry entry}"
    fi
    binary="$(command -v "$agent" 2>/dev/null || true)"
    valid_agent_binary_path "$agent" "$binary" &&
        [[ -f "$binary" && -x "$binary" ]] ||
        die "cannot find an executable $agent binary"
    printf '%s\n' "$binary"
}

# --- codext credential pool -------------------------------------------------
#
# The pool lives in PersonalWeb; codext leases an account from it before every
# request. AGS's part is small on purpose: ask for the address and this
# terminal's key once, prove they work, and write them where codext looks.
# Everything after that — which account, when to swap, reporting usage — is
# decided server-side, so there is no state here to drift out of date.

codex_pool_prefix='/x8Rk3Nq6Vd2'
codex_pool_default_url='https://www.itachi.fans'

codex_home_dir() {
    printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
}

codex_pool_config_path() {
    printf '%s/pool.json\n' "$(codex_home_dir)"
}

# Prove the address resolves, the TLS chain is good, the port is served and the
# key is live — every way this goes wrong in practice, in one call.
#
# Deliberately `/ping` and not `/lease`: leasing would occupy a scheduling slot
# for a full lease period, so a connectivity check would leave a phantom holder
# behind that skews which account the next real session gets.
# 池子的调用一律跟随重定向。
#
# 不跟随的话，服务端换个端口（`https://…:844` → `https://…`，nginx 回 308）就会让
# 这几个调用**静默失效**：`/sessions` 的查重跳过、`/session` 的上报跳过、`/resolve`
# 的启动前核对跳过——会话再也不出现在后台，而没有任何提示。2026-08-21 换端口之后
# 在 MacBook 上量到过：`curl` 不带 `-L` 拿到 308，带上就是 200；而 codext 自己会
# 跟随，所以"号照样租得到"，坏掉的部分刚好全是安静的那些。
#
# 跟随但设界：`--proto-redir '=https'` 让重定向永远不能降级到明文——这些请求带着
# 池子的密钥，跳到 http 上等于把它明文发出去。跳数也封死，免得绕圈。
codex_pool_curl_redirect="-L --proto-redir =https --max-redirs 3"

codex_pool_probe() {
    local url="$1" key="$2" status
    status="$(curl -sS $codex_pool_curl_redirect --connect-timeout 8 --max-time 20 \
        -o /dev/null -w '%{http_code}' \
        -H "X-Codex-Pool-Token: $key" \
        "$url$codex_pool_prefix/ping" 2>/dev/null)" || return 2
    case "$status" in
        200) return 0 ;;
        403) return 3 ;;
        404) return 4 ;;
        '') return 2 ;;
        *) return 5 ;;
    esac
}

codex_pool_usable_accounts() {
    local url="$1" key="$2"
    curl -sS $codex_pool_curl_redirect --connect-timeout 8 --max-time 20 \
        -H "X-Codex-Pool-Token: $key" "$url$codex_pool_prefix/ping" 2>/dev/null |
        jq -er '.data.accounts' 2>/dev/null || printf '?\n'
}

configure_codex_pool() {
    local url key attempt reply
    need curl; need jq
    while :; do
        printf 'PersonalWeb 地址 [%s]: ' "$codex_pool_default_url"
        IFS= read -r url || return 1
        url="${url:-$codex_pool_default_url}"
        url="${url%/}"
        [[ "$url" == https://* || "$url" == http://* ]] || {
            log "地址要以 http:// 或 https:// 开头"
            continue
        }
        # 443 是 PersonalWeb 的正式端口；844 只是留给老调用方的兼容重定向。
        #
        # **提醒要发给带了端口的人，不是没带的人。** 不带端口就是对的，冲着对的
        # 做法发"提醒"只会让人以为自己写错了，然后去补一个端口——那正是我们要
        # 避免的方向。而 844 这类非标端口在公司、校园和部分 ISP 的出口上会被直接
        # 挡掉，连不上就没有重定向可言，`codex_pool_probe` 只能报 return 2
        # （"连不上"），看起来像域名坏了。
        if [[ "$url" =~ ^https?://[^/]+:([0-9]+)$ && "${BASH_REMATCH[1]}" != 443 ]]; then
            log "提醒：地址带了非标端口 ${BASH_REMATCH[1]}，很多网络会挡掉它；PersonalWeb 在标准 HTTPS 443 上（${codex_pool_default_url}）"
        fi
        IFS= read -r -s -p '终端密钥（在后台「密钥管理」签发）: ' key || return 1
        printf '\n'
        [[ -n "$key" ]] || { log "密钥不能为空"; continue; }

        # `if`, not a bare call: this script runs under `set -e`, and the probe
        # reports which way it failed through its exit status. Called bare, a
        # failed probe would kill the script before the message explaining it.
        if codex_pool_probe "$url" "$key"; then
            attempt=0
        else
            attempt=$?
        fi
        case "$attempt" in
            0) break ;;
            2) log "连不上 $url —— 地址、端口或网络的问题" ;;
            3) log "服务器拒绝了这把密钥（已停用、已过期，或抄错了）" ;;
            4) log "$url 上没有这个接口 —— 地址对吗？" ;;
            *) log "服务器返回了意外的状态，稍后再试" ;;
        esac
        printf '再试一次？[Y/n]: '
        IFS= read -r reply || return 1
        case "${reply:-y}" in
            [Nn]*) return 1 ;;
        esac
    done

    codex_pool_write "$url" "$key"
    log "codext 已连上 $url"
}

codex_pool_write() {
    local url="$1" key="$2" home target temporary
    home="$(codex_home_dir)"
    target="$(codex_pool_config_path)"
    install -d -m700 "$home"
    temporary="$target.tmp.$$"
    rm -f -- "$temporary"
    ( umask 077
      jq -n --arg u "$url" --arg k "$key" '{base_url:$u, key:$k}' > "$temporary" ) ||
        die "cannot write $target"
    chmod 600 "$temporary"
    mv -- "$temporary" "$target"
}

codex_name_decision_file() { printf '%s/codex-name\n' "$state"; }
codex_pool_disabled_file() { printf '%s/codex-pool-disabled\n' "$state"; }

# Give codext the name `codex`, in the directory codext already lives in.
#
# Same directory on purpose: that directory is by definition on PATH — it is
# where `command -v codext` just found it — so the new name takes effect with
# no PATH change and no second place to keep in sync.
link_codext_as_codex() {
    local codext_path="$1" directory
    directory="$(dirname -- "$codext_path")"
    [[ -w "$directory" ]] || {
        log "警告：$directory 不可写，codext 无法取得 codex 这个名字；ags codex 将不可用"
        return 1
    }
    ln -sfn -- "$codext_path" "$directory/codex" || return 1
    log "codext 已取得 codex 这个名字：$directory/codex -> $codext_path"
}

# Decide, once, which binary owns the name `codex` on this machine.
#
# Two places disagree about what "Codex" means, and that disagreement is what
# made a codext-only host unusable. Anything that detects Codex strictly by the
# name `codex` sees nothing on a codext-only host, while `resolve_agent_binary`
# prefers `codext` and finds it regardless — so init configures nothing, launch
# works anyway, and any refusal in between reads "run ags init": advice that
# could never work there, because the next init makes the same non-decision.
#
# Deciding here, before anything reads either name, is what makes
# `codex --yolo` start in all three cases.
#
# `mode` 决定这一趟能走多远：
#
#   maintain（默认）  只在**没有任何** codex 时补上那个名字。不问，不动别人的
#                     文件。`ags init` 走这一支——那个命令是可以反复跑的，而
#                     「把某人的二进制挪走」不是能在一个随手重跑的命令里发生
#                     的事，哪怕只发生一次。
#   install           完整决定：发现外来 codex 就问，允许时把它挪开。只有安装
#                     器调这一支。
reconcile_codex_binary_name() {
    local mode="${1:-maintain}"
    local codext_path codex_path resolved_codex resolved_codext
    local decision reply directory backup decision_file
    codext_path="$(command -v codext 2>/dev/null || true)"
    [[ -n "$codext_path" ]] || return 0
    codex_path="$(command -v codex 2>/dev/null || true)"

    if [[ -z "$codex_path" ]]; then
        # 没有人占着这个名字，给它一个主人不会动到任何既有文件，所以两种模式
        # 都做——这正是那个死循环的解。
        link_codext_as_codex "$codext_path" || true
        return 0
    fi

    resolved_codex="$(realpath -e -- "$codex_path" 2>/dev/null || printf '%s' "$codex_path")"
    resolved_codext="$(realpath -e -- "$codext_path" 2>/dev/null || printf '%s' "$codext_path")"
    # 已经是同一个文件，没什么可决定的。
    [[ "$resolved_codex" != "$resolved_codext" ]] || return 0

    # 到这里说明有一个外来的 codex。取代它是安装期的决定。
    [[ "$mode" == install ]] || return 0

    decision_file="$(codex_name_decision_file)"
    decision=
    [[ ! -s "$decision_file" ]] || IFS= read -r decision < "$decision_file" || decision=
    [[ "$decision" == replace || "$decision" == keep ]] || decision=

    if [[ -z "$decision" ]]; then
        if [[ ! -t 0 || ! -t 1 ]]; then
            # 非交互式选不破坏的那一边。移动别人的二进制不是能替人默认的事。
            decision=keep
            log "检测到另一个 codex（${resolved_codex}）；非交互式运行按保留处理"
        else
            printf '\n检测到已安装的 codex：%s\n' "$resolved_codex"
            printf 'codext 是它的超集：配了凭据池就在线租号，没配就退回同一份本地 auth.json。\n'
            printf '用 codext 接管 codex 这个名字？\n'
            printf '  y = 把现有的挪到一边（保留备份，可还原），codex 指向 codext\n'
            printf '  N = 保留现有的；本机不配置凭据池，原生 codex 读不到它\n[y/N]: '
            IFS= read -r reply || reply=n
            case "${reply:-n}" in
                [Yy]*) decision=replace ;;
                *) decision=keep ;;
            esac
        fi
    fi

    if [[ "$decision" == replace ]]; then
        directory="$(dirname -- "$codex_path")"
        if [[ ! -w "$directory" ]]; then
            log "警告：$directory 不可写，改为保留现有 codex"
            decision=keep
        else
            backup="$codex_path.stock.$(date -u +%Y%m%dT%H%M%SZ)"
            mv -- "$codex_path" "$backup" || return 1
            # 挪开而不是删除：这是可还原的，而删除不是。包管理器装的那种
            # （npm、brew）仍然认为自己装着，下次升级可能把它放回来——真要
            # 永久移除，得用装它的那个包管理器卸载。
            log "原 codex 已挪到 ${backup}（若由包管理器安装，升级时可能被放回）"
            link_codext_as_codex "$codext_path" || return 1
            rm -f -- "$(codex_pool_disabled_file)"
        fi
    fi

    if [[ "$decision" == keep ]]; then
        # 原生 codex 读不到池配置，问了也用不上，所以这里直接记为禁用而不是
        # 每次 init 再问一遍。
        : > "$(codex_pool_disabled_file)"
        log "保留现有 codex；本机不配置凭据池（原生 codex 用不到）"
    fi
    printf '%s\n' "$decision" > "$decision_file"
    log "要改这个决定：删掉 $decision_file 再跑 ags init"
}

# Ask at init time whether this machine should use the pool at all.
#
# Asked rather than assumed: a machine that already has its own `codex login`
# should be able to say no and keep using it. Declining leaves no config
# behind, and codext then behaves exactly like stock codex.
offer_codex_pool() {
    local reply existing
    existing="$(codex_pool_config_path)"
    # 选了保留原生 codex 的机器不必再被问一遍——那份配置它读不到。
    [[ ! -e "$(codex_pool_disabled_file)" ]] || return 0
    if [[ ! -t 0 || ! -t 1 ]]; then
        [[ -s "$existing" ]] ||
            log "codext 凭据池未配置（非交互式运行）；需要时跑 ags codex-init"
        return 0
    fi
    if [[ -s "$existing" ]]; then
        printf '\ncodext 凭据池已配置（%s）。重新配置？[y/N]: ' "$existing"
        IFS= read -r reply || return 0
        case "${reply:-n}" in
            [Yy]*) ;;
            *) return 0 ;;
        esac
    else
        printf '\n配置 codext 凭据池？（从 PersonalWeb 在线租借 Codex 账号）[y/N]: '
        IFS= read -r reply || return 0
        case "${reply:-n}" in
            [Yy]*) ;;
            *)
                log "跳过。以后要配就跑 ags codex-init"
                return 0
                ;;
        esac
    fi
    configure_codex_pool || log "没有配置 codext 凭据池"
}

codex_pool_status() {
    local config url key
    config="$(codex_pool_config_path)"
    [[ -s "$config" ]] || {
        printf 'codext 凭据池：未配置\n跑 ags codex-init 配置它\n'
        return 0
    }
    need jq
    url="$(jq -er '.base_url' "$config" 2>/dev/null)" ||
        die "配置文件读不出来：$config"
    key="$(jq -er '.key' "$config" 2>/dev/null)" ||
        die "配置文件里没有密钥：$config"
    printf 'pool       %s\nCODEX_HOME %s\n' "$url" "$(codex_home_dir)"
    if codex_pool_probe "$url" "$key"; then
        # 账号是按**项目目录**派的，不是按机器：同一台电脑上不同项目各拿各的号。
        # 所以这里报的是池子里现在有几个号可派，而不是"我占着哪个"。
        printf 'status     可用（池子里 %s 个号可派）\n' \
            "$(codex_pool_usable_accounts "$url" "$key")"
    else
        printf 'status     连不上或密钥无效\n'
        return 1
    fi
}

resolve_ags_converter_binary() {
    local binary="${AGS_CONVERTER_BINARY:-}" version
    if [[ -z "$binary" ]]; then
        binary="$(command -v ags 2>/dev/null || true)"
    fi
    valid_local_binary_path "$binary" ||
        die "cannot find the ags program; reinstall ags"
    if [[ "$ags_converter_version" == unknown ]]; then
        version="$("$binary" --version 8>&- 9>&- </dev/null 2>/dev/null || true)"
        if [[ "$version" =~ ^ags[[:space:]]+([^[:space:]]+) ]]; then
            ags_converter_version="${BASH_REMATCH[1]}"
        fi
    fi
    printf '%s\n' "$binary"
}

scrub_transport_password_environment() {
    # These variables are accepted only while configuring or invoking an SFTP
    # transport. They are never Agent credentials and must not cross the
    # Claude or Codex process boundary.
    unset AGENT_SESSION_CLOUD_PASSWORD
    unset AGENT_SESSION_REMOTE_PASSWORD
    unset RCLONE_SFTP_PASS
}

text_has_no_control_characters() {
    local value="${1-}"
    printf '%s' "$value" | jq -eRsr '
        test("[\u0000-\u001f\u007f-\u009f]") | not
    ' >/dev/null 2>&1
}

live_session_description_valid() {
    local description="${1-}"
    printf '%s' "$description" | jq -eRsr '
        length > 0 and length <= 80 and
        (test("[\u0000-\u001f\u007f-\u009f]") | not)
    ' >/dev/null 2>&1
}

validate_live_session_description() {
    need jq
    live_session_description_valid "${1-}" ||
        die "description must be 1-80 characters without control characters"
}

agent_display_name() {
    case "$1" in
        codex) printf 'Codex\n' ;;
        claude) printf 'Claude\n' ;;
        *) printf 'Session\n' ;;
    esac
}

# The native session selection inside a command line, removed. Result in
# `stripped_launch_args`.
#
# `ags codex resume` and `ags claude --resume ID` are ordinary ways to start a
# session, so the argv AGS captures at launch legitimately contains the very
# arguments that pick one. Keeping them in the record is what makes the next
# `ags resume` wrong: it has already rebuilt `codex resume <restored>` /
# `claude --resume <restored>` from the checkpoint, the replayed selection
# lands after that, and both clients let the later selection win — so the
# record restores one session and then opens a different one. No validator
# catches it either; the ones that exist guard the workspace, the
# configuration, and the provider.
#
# Only the selection goes. Every other flag survives, because Codex's `resume`
# subcommand accepts the same configuration options the bare command does, so
# `--model`, `--profile` and the rest stay valid where AGS puts them.
strip_session_selection_args() {
    local agent="$1" argument
    shift
    stripped_launch_args=()
    stripped_session_selected=0
    stripped_session_id=
    while (( $# > 0 )); do
        argument="$1"
        shift
        # The same boundary the argument validators stop at: a bare `--` ends
        # the part AGS reads, and the rest passes through untouched.
        if [[ "$argument" == -- ]]; then
            stripped_launch_args+=("$argument" "$@")
            return 0
        fi
        if [[ "$agent" == codex ]]; then
            case "$argument" in
                resume)
                    # Codex's subcommand. Its SESSION_ID is positional and
                    # optional, so the next word is that id only when the next
                    # word is not itself a flag.
                    stripped_session_selected=1
                    if [[ $# -gt 0 && "$1" != -* ]]; then
                        stripped_session_id="$1"
                        shift
                    fi
                    continue
                    ;;
                --last|--all|--include-non-interactive)
                    # Picker controls. Inert once AGS names the session at
                    # best, and `--last` outranks that name at worst.
                    continue
                    ;;
            esac
        else
            case "$argument" in
                -r|--resume|--from-pr)
                    # Claude's value is optional here too, so the same rule
                    # decides whether the next word belongs to the flag.
                    stripped_session_selected=1
                    if [[ $# -gt 0 && "$1" != -* ]]; then
                        stripped_session_id="$1"
                        shift
                    fi
                    continue
                    ;;
                --resume=*|--from-pr=*|--session-id=*)
                    stripped_session_selected=1
                    stripped_session_id="${argument#*=}"
                    continue
                    ;;
                -c|--continue|--fork-session)
                    # `--fork-session` selects a session as much as the rest:
                    # it resumes into a *new* id, so the restored one would be
                    # loaded and then abandoned.
                    stripped_session_selected=1
                    continue
                    ;;
                --session-id)
                    stripped_session_selected=1
                    if (( $# > 0 )); then
                        stripped_session_id="$1"
                        shift
                    fi
                    continue
                    ;;
            esac
        fi
        stripped_launch_args+=("$argument")
    done
}

# Set a useful terminal tab title where the terminal implements the standard
# OSC title sequence. Unsupported terminals simply ignore it; non-interactive
# launches do not prompt and do not write terminal control bytes to captured
# output.
# 把 `--account` 变成 codext 认得的两个环境变量。
#
# **两个，不是一个。** `CODEXT_POOL_ACCOUNT` 说这次要哪个号；
# `CODEXT_POOL_DEVICE_ID` 决定服务端按哪条租约认人——codext 的 device_id 默认按
# **工作目录**取（同一个项目反复调用复用同一条租约），而服务端的租约表在
# device_id 上有唯一约束。只给账号不给 device_id 的话，同一个目录里两个点不同号
# 的会话会撞在同一条租约行上互相顶掉，也就是"指定账号影响了别的会话"。
#
# 已经显式设了 `CODEXT_POOL_DEVICE_ID` 就不动它：那是调用方明确表达过的意图。
# 摘要里放的是账号的哈希而不是账号本身，因为这个值会发到服务端、显示在后台界面上。
# 这次会话在凭据池那边的租约身份。
#
# 三段：`<主机>-<目录哈希>-<会话哈希>`。最后一段以前是**点名账号串**的摘要，现在
# 是 **AGS ID** 的，因为身份该由会话决定，不该由它点了哪些号决定：
#
#   - 同一条工作线换一组点名账号，以前 device_id 会变，于是留下一条孤儿租约，原来
#     那个号被白占到 600 秒过期。现在不变。
#   - 同一个目录里的两个会话，以前只有点名不同的号才互不干扰；现在 ID 必然不同，
#     所以必然互不干扰。
#   - 服务端能把租约和会话上报对上，靠的正是这个值两边一致。
#
# 调用方显式给过 `CODEXT_POOL_DEVICE_ID` 就不覆盖。
export_pool_device_id() {
    local agent="$1" host workspace session
    [[ "$agent" == codex ]] || return 0
    [[ -n "${ags_session_id:-}" ]] || return 0
    [[ -z "${CODEXT_POOL_DEVICE_ID:-}" ]] || return 0
    host="${HOSTNAME:-${COMPUTERNAME:-codext}}"
    workspace="$(sha256_text "$PWD" 2>/dev/null)" || workspace=""
    session="$(sha256_text "$ags_session_id" 2>/dev/null)" || session=""
    export CODEXT_POOL_DEVICE_ID="$host-${workspace:0:16}-${session:0:16}"
}

apply_pool_account() {
    local agent="$1" account="$2"
    [[ -n "$account" ]] || return 0
    # 凭据池是 codext 独有的（`CODEXT_POOL_*` 只有它读）。给别的 agent 注入等于
    # 让人以为号钉住了、其实什么都没发生——**静默无视比报错糟得多**，所以这里
    # 直接拒绝而不是打个警告了事。
    [[ "$agent" == codex ]] || die "--account / --pick-account 只对 Codex 有意义：$agent 不从凭据池取号"

    export CODEXT_POOL_ACCOUNT="$account"
}

# 让用户从池子里挑一个号（`--pick-account`）。
#
# 走 curl 而不是引一个 HTTP 客户端：这是脚本里为数不多的网络调用，而 curl 和 jq
# 本来就是依赖。服务端那边问 `/usage` 同样是 shell 出去调 curl，理由一致。
# 现在这把密钥能点名要哪些号（原样返回服务端那段 JSON）。
#
# **每次都重新问**，不缓存：能不能点名一个号取决于此刻谁占着它，是会变的。服务端
# 已经把"此刻被别的密钥独占着"的号排除在外，所以这份列表就是这一刻真能点的全集
# ——但也仅限这一刻。
fetch_pool_accounts() {
    local config url key payload
    config="$(codex_pool_config_path)"
    [[ -s "$config" ]] || die "还没配置 codext 凭据池，先跑 ags codex-init"
    url="$(jq -er '.base_url' "$config" 2>/dev/null)" ||
        die "配置文件读不出来：$config"
    key="$(jq -er '.key' "$config" 2>/dev/null)" ||
        die "配置文件里没有密钥：$config"
    payload="$(curl -sS $codex_pool_curl_redirect --connect-timeout 8 --max-time 20 -X POST \
        -H "X-Codex-Pool-Token: $key" \
        "$url$codex_pool_prefix/accounts" 2>/dev/null)" ||
        die "问不到凭据池：$url"
    jq -e '.data.accounts | type == "array"' <<< "$payload" >/dev/null 2>&1 ||
        die "凭据池回的不是预期的 JSON"
    printf '%s\n' "$payload"
}

# 一个号在挑号界面上的名字：发邮箱而不是 account_key，服务端两个都认，而邮箱是人
# 看得懂的那个——它会出现在日志和后台界面上。
pool_account_identity() {
    jq -r --argjson i "$2" \
        '.data.accounts[$i] | (.email // "" | select(. != "")) // .account_key' \
        <<< "$1"
}

# 让用户从池子里挑号。可以挑**多个**，组成一个队列。
#
# 队列的含义：你圈定范围，具体用哪个交给调度器——档位、余量、风险那套原样作用在
# 这个子集上；手上这个跑满了在队列内换，整组都不可用了才回落公共池。
#
# 挑完会**再问一次池子**才返回。列表和启动之间隔着人打字的时间，一个 Plus 号完全
# 可能在这几秒里被别的密钥占走；不复核的话，那次启动会静默回落到公共池，而人以为
# 自己钉住了号——这正是点名功能最怕的失败方式。
pick_pool_account() {
    local payload count choice token index identity fresh
    local -a picked names gone
    need jq
    while :; do
        payload="$(fetch_pool_accounts)" || return 1
        count="$(jq -r '.data.accounts | length' <<< "$payload")"
        (( count > 0 )) || die "这把密钥现在没有可点名的号"
        # 余量和状态一起印出来：挑号时看不见这两样等于盲选，很容易挑中一个已经
        # 跑满的号，然后以为是指定账号没生效。
        jq -r '.data.accounts | to_entries[] |
            "  \(.key + 1)) \(.value.email)  \(.value.plan)  余量 \((.value.headroom * 100) | floor)%" +
            (if .value.assigned then "  [专属]"
             elif (.value.schedulable | not) then "  [冷却中]"
             else "" end)' <<< "$payload" > /dev/tty
        printf '选号 [1-%s]，多选用逗号组成队列（如 1,3）；r 重新拉取: ' "$count" > /dev/tty
        # 读到 EOF 就必须退出。少了这一条，非交互地跑到这里会在循环里空转。
        IFS= read -r choice < /dev/tty || die "没挑号"
        [[ "$choice" == [rR] ]] && continue

        picked=(); names=()
        for token in ${choice//,/ }; do
            if [[ ! "$token" =~ ^[0-9]+$ ]] || (( token < 1 || token > count )); then
                printf '没有这个选项：%s，重挑。\n' "$token" > /dev/tty
                continue 2
            fi
            index=$(( token - 1 ))
            # 去重，保留写的顺序。顺序不影响调度（队列内部由调度算法定先后，见
            # 服务端的 rank()），保留它只是让回显和人写的一致。
            [[ " ${picked[*]-} " == *" $index "* ]] && continue
            picked+=("$index")
            names+=("$(pool_account_identity "$payload" "$index")")
        done
        (( ${#picked[@]} > 0 )) || { printf '没挑号，重挑。\n' > /dev/tty; continue; }

        fresh="$(fetch_pool_accounts)" || return 1
        gone=()
        for identity in "${names[@]}"; do
            jq -e --arg a "$identity" '.data.accounts | any(
                ((.email // "") | ascii_downcase) == ($a | ascii_downcase)
                or .account_key == $a)' <<< "$fresh" >/dev/null 2>&1 ||
                gone+=("$identity")
        done
        if (( ${#gone[@]} > 0 )); then
            printf '这几个号刚被占走了，重挑：%s\n' "${gone[*]}" > /dev/tty
            continue
        fi

        (IFS=,; printf '%s\n' "${names[*]}")
        return 0
    done
}

# 消费一个 ags 参数，把消费掉的个数放进 `ags_consumed`（0 = 这不是 ags 的参数）。
#
# 两个参数区共用这一份：命令名**之前**那个区遇到 0 就停下（后面是命令名），
# `--` **之后**那个区遇到 0 就报错（那一段只能是 ags 的）。一份实现，两种收尾，
# 免得两个区将来各自漂移出不同的参数集。
#
# 值本身不在这里校验：`--to` / `--cwd` / `--profile` 的校验留在 `resume_checkpoint`
# 里，那样报错措辞和以前一模一样。
ags_consume_option() {
    ags_consumed=0
    case "${1:-}" in
        --account)
            (( $# >= 2 )) || die "--account 需要一个邮箱或账号标识"
            ags_account="$2"
            ags_consumed=2
            ;;
        --account=*)
            ags_account="${1#--account=}"
            [[ -n "$ags_account" ]] || die "--account 需要一个邮箱或账号标识"
            ags_consumed=1
            ;;
        --id)
            (( $# >= 2 )) || die "--id 需要一个会话 ID"
            # 空串也是"给过了"。分成两个开关而不是只看值空不空：`--id ''` 是一个
            # 明确的、写错了的意图，把它和"根本没提 --id"混为一谈的结果是悄悄自动
            # 起一个名字——人以为自己命了名，实际没有。
            #
            # 这以前被另一个 bug 盖住了：顶层重切参数数组时没加引号，空串在词分割
            # 里直接消失，于是 `--id ''` 表现成 `--id` 缺值而被拒。引号补上之后空串
            # 留了下来，这里就得自己认。
            [[ -n "$2" ]] || die "--id 需要一个会话 ID"
            ags_id_option="$2"
            ags_consumed=2
            ;;
        --id=*)
            ags_id_option="${1#--id=}"
            [[ -n "$ags_id_option" ]] || die "--id 需要一个会话 ID"
            ags_consumed=1
            ;;
        --pick-account) ags_pick_account=1; ags_consumed=1 ;;
        --no-agent-args) ags_no_agent_args=1; ags_consumed=1 ;;
        --to)
            (( $# >= 2 )) || die "--to requires codex or claude"
            ags_to="$2"
            ags_consumed=2
            ;;
        --to=*) ags_to="${1#--to=}"; ags_consumed=1 ;;
        --cwd)
            (( $# >= 2 )) || die "--cwd requires a path"
            ags_cwd_option="$2"
            ags_consumed=2
            ;;
        --cwd=*) ags_cwd_option="${1#--cwd=}"; ags_consumed=1 ;;
        --profile)
            (( $# >= 2 )) || die "--profile requires a profile name"
            ags_profile_option="$2"
            ags_consumed=2
            ;;
        --profile=*) ags_profile_option="${1#--profile=}"; ags_consumed=1 ;;
    esac
}

terminal_can_set_title() {
    [[ "${TERM:-dumb}" != dumb && -t 0 && -t 1 &&
       -r /dev/tty && -w /dev/tty ]]
}

set_terminal_tab_title() {
    local title="${1:-}"
    terminal_can_set_title || return 0
    [[ -n "$title" ]] || return 0
    text_has_no_control_characters "$title" || return 0
    printf '\033]0;%s\007' "$title" > /dev/tty 2>/dev/null || true
}

# 一个目录名里能进 AGS ID 的部分。ID 的字符集是
# `^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`（见 `validate_new_checkpoint_id`），而目录名
# 里什么都可能有。
sanitize_ags_id_fragment() {
    local text="${1:-}"
    text="${text//[^A-Za-z0-9._-]/-}"      # 非法字符一律换成连字符
    # 削掉开头的非字母数字。刻意不用 `${text##+([-._])}`：那要 `extglob`，而这个
    # 脚本没开——不开的话那个模式**一个字符都不删**，还不报错，正是最难发现的那
    # 种失效。
    while [[ -n "$text" && "$text" != [A-Za-z0-9]* ]]; do
        text="${text:1}"
    done
    text="${text:0:32}"
    [[ -n "$text" ]] || text=session
    printf '%s\n' "$text"
}

# 没起名字时用的默认 ID：`<目录名>-<年.月.日>-<时.分.秒>`，例如
# `05_MyWork-2026.08.21-03.17.45`。
#
# 刻意**不用随机串**。这个 ID 会出现在标签页上、检查点里、后台的会话列表里，几个
# 月后还要靠它认出"这是哪一条工作线"——`a7f3c1` 认不出来，上面那个认得出。
#
# **带年份**：检查点是长期存着的，只有月日的话，隔一年再看 `0821` 分不出是哪年。
#
# 分隔符用 `.` 而不是 `/`：ID 的字符集是 `[A-Za-z0-9._-]`（见
# `validate_new_checkpoint_id`），而且它会进文件名——`/` 在那里是路径分隔符。`.`
# 是允许的字符里唯一读起来像分隔符的，日期和时间各用它分段之后，`-` 就只用来分
# 隔"目录 / 日期 / 时间"三块，一眼能扫开。
#
# **精确到秒**而不是分钟：ID 现在决定租约身份，两个撞了 ID 的会话会争同一条租约
# 行。分钟粒度看着更干净，但同一目录里一分钟内起两个无名会话就会撞上——实测撞到
# 过。下面那个序号循环挡不住它，因为刚启动、还没保存也还没上报的会话，本地和池子
# 都还看不见。
default_ags_id() {
    local launch_cwd="$1" base stamp candidate index=2
    base="$(sanitize_ags_id_fragment "${launch_cwd##*/}")"
    stamp="$(date +%Y.%m.%d-%H.%M.%S)"
    candidate="$base-$stamp"
    while ags_id_is_taken "$candidate"; do
        candidate="$base-$stamp-$index"
        index=$(( index + 1 ))
        (( index < 100 )) || break
    done
    printf '%s\n' "${candidate:0:64}"
}

# 这把密钥此刻占用了哪些 ID。问不到就当没有——查重名失败不该拦住启动。
pool_live_ags_ids() {
    local config url key payload
    command -v jq >/dev/null 2>&1 || return 0
    config="$(codex_pool_config_path)"
    [[ -s "$config" ]] || return 0
    url="$(jq -er '.base_url' "$config" 2>/dev/null)" || return 0
    key="$(jq -er '.key' "$config" 2>/dev/null)" || return 0
    payload="$(curl -sS $codex_pool_curl_redirect --connect-timeout 4 --max-time 8 -X POST \
        -H "X-Codex-Pool-Token: $key" \
        "$url$codex_pool_prefix/sessions" 2>/dev/null)" || return 0
    jq -r '.data.sessions[]?.ags_id // empty' <<< "$payload" 2>/dev/null || true
}

# 这个 ID 现在能不能用。
#
# 两个命名空间，规则不同：本地检查点库里的 ID 是**永久**的（一条工作线的名字），
# 池子里的只在**活着的会话**之间唯一（会话结束就把名字放出来）。两边任意一边占着
# 就算被占。
ags_id_is_taken() {
    local candidate="$1" taken
    [[ -n "$candidate" ]] || return 0
    if checkpoint_id_exists local "$candidate" 2>/dev/null; then
        return 0
    fi
    for taken in ${ags_pool_live_ids[@]+"${ags_pool_live_ids[@]}"}; do
        [[ "$taken" == "$candidate" ]] && return 0
    done
    return 1
}

# 这次会话叫什么。
#
# 以前这里问的是"标签页叫什么"，答案用完即弃。现在同一个答案就是 **AGS ID**：标签
# 页名、`ags save` 用的 ID、上报给池子的名字，三者是同一个东西。
#
# 为什么合并：`ags resume` 早就是这样了（标签页名就是检查点 ID），只有全新启动那条
# 路让人在启动时起一个名字、保存时再起一个，于是同一条工作线有两个名字，而后台看
# 到的那个（哈希）两个都不是。
#
# 本地已经有同名检查点就**拒绝**，不是警告：放行的话，人会干一小时活，然后在
# `ags save` 那一步撞上"checkpoint ID already exists"，那时已经没有别的保存路径了。
prepare_session_identity() {
    local launch_cwd="$1" agent="$2" suggestion answer
    if [[ "${launch_terminal_title_mode:-new}" == resume ]]; then
        # 恢复一条已有的工作线：名字就是它的检查点 ID，不该再问一次。
        ags_session_id="${launch_terminal_title:-}"
        [[ -z "$ags_session_id" ]] || export AGS_ID="$ags_session_id"
        set_terminal_tab_title "$ags_session_id"
        return 0
    fi

    ags_pool_live_ids=()
    if [[ "$agent" == codex ]]; then
        while IFS= read -r answer; do
            [[ -n "$answer" ]] && ags_pool_live_ids+=("$answer")
        done < <(pool_live_ags_ids)
    fi

    # 给了 `--id` 就用它，没给就用自动生成的。**不问。**
    #
    # 起一个会话是这个工具里最频繁的动作。为它加一个提问，等于每次开工都要先按一次
    # 回车；而绝大多数会话根本不需要人起名字——`<目录>-<年.月.日>-<时.分.秒>` 已经
    # 够认出是哪一条。要起名字的那几次写 `--id` 就行。
    if [[ -n "${ags_id_option:-}" ]]; then
        answer="$ags_id_option"
        [[ "$answer" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
            die "--id 只能是 1-64 个字母、数字、点、下划线或连字符，且以字母或数字开头：$answer"
        # 人显式给的名字撞上了就**报错**，不悄悄换一个：换了的话这个会话会挂在一个
        # 他没起过的名字下，而后台要靠这个名字找到它。
        if checkpoint_id_exists local "$answer" 2>/dev/null; then
            die "本地已经有叫「${answer}」的检查点；接着那条线用 ags resume ${answer}，要开新的换个名字"
        fi
        if ags_id_is_taken "$answer"; then
            die "「${answer}」正被这把密钥的另一个会话占着；在跑的有：$(IFS=, ; printf '%s' "${ags_pool_live_ids[*]-}")"
        fi
    else
        answer="$(default_ags_id "$launch_cwd")"
    fi

    ags_session_id="$answer"
    export AGS_ID="$ags_session_id"
    set_terminal_tab_title "$ags_session_id"
    # 提问没了，这一行就是人知道"这次叫什么"的唯一途径——而 `ags resume`、
    # `ags save --id`、后台的会话管理都要用这个名字。标签页上也有，但没有标签页的
    # 终端就只剩这里了。
    log "会话 $ags_session_id"
}

# 启动前核一遍点名的名字，**只**挑出匹配不到任何账号的那些。
#
# 这一类是打错字、全角逗号、号被删了——会话会静默跑在公共池上，而人以为自己钉住
# 了号，事后只能靠翻后台发现。2026-08-21 那次三个号只生效一个就是这么藏住的。
#
# 冷却中、被别的密钥占着、指给了别人——一律**不**拦。点名是强首选而不是唯一选项，
# 回落公共池继续干活是设计如此，在启动前拒掉才是错的。
#
# 刻意**不拿** `/accounts` 来核：那个接口故意隐藏此刻被别的密钥独占的号，拿它当
# 白名单会把一个完全合法的号误判成打错字，拒掉一次本该成功的启动。判定走服务端的
# `/resolve`，它分得清"没有这个号"和"有但此刻拿不到"。
#
# 问不到池子就放行：核对失败不该拦住启动，那比漏一次提示糟。
unresolvable_pool_accounts() {
    local account="$1" config url key payload
    [[ -n "$account" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    config="$(codex_pool_config_path)"
    [[ -s "$config" ]] || return 0
    url="$(jq -er '.base_url' "$config" 2>/dev/null)" || return 0
    key="$(jq -er '.key' "$config" 2>/dev/null)" || return 0
    payload="$(curl -sS $codex_pool_curl_redirect --connect-timeout 4 --max-time 8 -X POST \
        -H "X-Codex-Pool-Token: $key" -H 'Content-Type: application/json' \
        -d "$(jq -nc --arg a "$account" '{want_account:$a}')" \
        "$url$codex_pool_prefix/resolve" 2>/dev/null)" || return 0
    jq -e '.data.wanted | type == "array"' <<< "$payload" >/dev/null 2>&1 || return 0
    jq -r '.data.wanted[] | select(.state == "unknown") | .name' \
        <<< "$payload" 2>/dev/null || true
}

check_pool_account_names() {
    local agent="$1" account="$2" missing name
    [[ "$agent" == codex ]] || return 0
    [[ -n "$account" ]] || return 0
    missing=()
    while IFS= read -r name; do
        [[ -n "$name" ]] && missing+=("$name")
    done < <(unresolvable_pool_accounts "$account")
    (( ${#missing[@]} > 0 )) || return 0
    die "这些名字在凭据池里找不到对应账号：$(IFS=, ; printf '%s' "${missing[*]}")（检查拼写；中文输入法的全角逗号「，」也算，虽然服务端认它）"
}

# 把这次会话的身份告诉凭据池：ID、目录、主机、启动时刻。
#
# **绝不阻塞启动**：问不到池子、没配置、服务端还是老版本——一律静默跳过。上报的
# 用处是让后台能认出这个会话，认不出只是不方便，而拦住启动是真的损失。
#
# 由 ags 发而不是 codext 发：ags 自己就在算 device_id，而 codext 那边加一个字段
# 意味着再发一版 codext。
report_pool_session() {
    local agent="$1" launch_cwd="$2" config url key
    [[ "$agent" == codex ]] || return 0
    [[ -n "${ags_session_id:-}" ]] || return 0
    [[ -n "${CODEXT_POOL_DEVICE_ID:-}" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    config="$(codex_pool_config_path)"
    [[ -s "$config" ]] || return 0
    url="$(jq -er '.base_url' "$config" 2>/dev/null)" || return 0
    key="$(jq -er '.key' "$config" 2>/dev/null)" || return 0
    # `accounts` 一并发过去：**启动是一个显式动作**，人刚刚亲口说了这次要哪几个
    # 号，服务端据此重置这条队列。
    #
    # 和 `/lease` 上那串的区别是所有权：那一串每个请求都会再发一次，服务端只在
    # 队列为空时拿它播种，否则后台刚给这个会话追加的号下一秒就被抹掉。这里发的
    # 是"这一次启动我要这些"，一次性的，所以可以覆盖。
    #
    # 没写 `--account` 时发空数组，意思是"这次不点名"，和"没提这件事"不同——后者
    # 会让上一轮的队列莫名其妙地留着。
    curl -sS $codex_pool_curl_redirect --connect-timeout 4 --max-time 8 -X POST \
        -H "X-Codex-Pool-Token: $key" -H 'Content-Type: application/json' \
        -d "$(jq -nc \
              --arg d "$CODEXT_POOL_DEVICE_ID" --arg i "$ags_session_id" \
              --arg c "$launch_cwd" --arg h "${HOSTNAME:-${COMPUTERNAME:-}}" \
              --arg s "$(date +%Y-%m-%dT%H:%M:%S%z)" \
              --arg a "${ags_account:-}" \
              '{device_id:$d, ags_id:$i, cwd:$c, host:$h, started_at:$s,
                accounts:($a | if . == "" then [] else split(",") end)}')" \
        "$url$codex_pool_prefix/session" >/dev/null 2>&1 || true
}


# The Agent arguments a session was started with, as a JSON array.
#
# JSON rather than a quoted command line because these records synchronize
# between machines, so decoding must never be `eval` — that would make a
# synchronized checkpoint a remote code execution primitive. A JSON array also
# survives the line-oriented manifest intact, which a raw argv would not.
#
# What AGS injects itself — `resume`, `--resume`, `--profile`, `--settings` —
# never reaches here, and `strip_session_selection_args` above removes the
# session selection a user typed, because both are rebuilt from the checkpoint
# on every resume. Replaying a stale session id or a temporary settings path
# would be wrong on the next machine.
encode_launch_args() {
    local argument
    (( $# > 0 )) && command -v jq >/dev/null || { printf '[]\n'; return 0; }
    for argument in "$@"; do
        # A line break cannot round-trip through the manifest. Recording nothing
        # is the safe end of that: the session still resumes, only without a
        # remembered command line.
        [[ "$argument" != *$'\n'* && "$argument" != *$'\r'* ]] ||
            { printf '[]\n'; return 0; }
    done
    printf '%s\n' "$@" | jq -Rsc 'split("\n")[:-1]'
}

# Decode into `launch_args_decoded`. Fails for anything that is not a flat array
# of single-line strings, so a corrupted or hostile record cannot smuggle an
# extra argument past the caller through an embedded line break.
decode_launch_args() {
    local json="${1:-}"
    launch_args_decoded=()
    [[ -n "$json" && "$json" != '[]' ]] || return 0
    command -v jq >/dev/null || return 1
    jq -e '
        type == "array" and
        (map(type == "string" and (test("[\n\r]") | not)) | all)
    ' <<< "$json" >/dev/null 2>&1 || return 1
    mapfile -t launch_args_decoded < <(jq -r '.[]' <<< "$json")
}

# One line describing an encoded argv.
#
# The output is deliberately also the *input* format: what the menu shows is
# exactly what can be typed back into it, because both sides go through the same
# `xargs` word splitting. Anything outside the unambiguous character set is
# single-quoted, which is what makes that round trip hold for an argument like
# `Bash(git:*)` — and keeps the line safe to paste into a shell as well.
format_launch_args() {
    local json="${1:-}" argument line=
    decode_launch_args "$json" || { printf 'unreadable\n'; return 0; }
    for argument in "${launch_args_decoded[@]}"; do
        argument="${argument//$'\t'/ }"
        if [[ -z "$argument" || "$argument" == *[^[:alnum:]_@%+=:,./-]* ]]; then
            argument="'${argument//\'/\'\\\'\'}'"
        fi
        line+="${line:+ }$argument"
    done
    printf '%s\n' "$line"
}

# Split a typed command line into `launch_args_decoded` without eval. `xargs`
# applies the quoting rules format_launch_args prints with, and rejects an
# unmatched quote instead of guessing at it.
parse_launch_args() {
    local line="$1"
    launch_args_decoded=()
    [[ -n "${line//[[:space:]]/}" ]] || return 0
    command -v xargs >/dev/null || return 1
    mapfile -t launch_args_decoded < <(
        printf '%s\n' "$line" | xargs printf '%s\n' 2>/dev/null
    ) || return 1
    (( ${#launch_args_decoded[@]} > 0 )) || return 1
}

# Hand the captured argv to the session being started. `ags save` runs as a child
# of the Agent, so the environment is the only channel that reaches it — the
# arguments themselves are consumed by `exec` and gone.
export_launch_args() {
    AGS_LAUNCH_ARGS="$(encode_launch_args "$@")"
    export AGS_LAUNCH_ARGS
}

# Leave the alternate drawing state the menu sets up. Every exit path goes
# through this, including the ones that hand the terminal straight to an Agent:
# `launch_managed_agent` ends in `exec`, so a cursor left hidden here would stay
# hidden for the whole session that follows.
terminal_menu_leave() {
    printf '\033[?25h\033[H\033[2J'
}

terminal_menu_edit_args() {
    local index="$1" edited= prefill= agent=
    # Only offer a prefill that decoded. A record whose arguments are unreadable
    # displays as the word "unreadable", and prefilling that would let one Enter
    # turn it into a literal argument handed to the Agent.
    decode_launch_args "${terminal_menu_args[$index]}" &&
        prefill="${terminal_menu_details[$index]}"
    printf '\033[?25h'
    printf '\n  %sAgent arguments for this session%s — empty clears them\n' \
        "$style_dim" "$style_reset"
    IFS= read -r -e -p '  ' -i "$prefill" edited || {
        printf '\033[?25l'
        return 0
    }
    if parse_launch_args "$edited"; then
        # 和恢复时同一条规矩，在**写下来**的时候就执行一次。
        #
        # 恢复那一侧本来就会剥掉选会话的参数（两处，见 `resume_checkpoint` 和
        # `resume_live_session`），所以这里漏掉不会开错会话。它解决的是另一件事：
        # 不这么做，记录里就存着一段永远会被丢掉的参数，而列表把它照原样显示成
        # 「这个会话带着这些参数」——写下来的和真正会跑的不是一回事。
        agent="${terminal_menu_agents[$index]:-}"
        if [[ -n "$agent" ]]; then
            strip_session_selection_args "$agent" \
                ${launch_args_decoded[@]+"${launch_args_decoded[@]}"}
            if (( ${#launch_args_decoded[@]} != ${#stripped_launch_args[@]} )); then
                launch_args_decoded=(${stripped_launch_args[@]+"${stripped_launch_args[@]}"})
                terminal_menu_notice='Dropped the session selection: AGS names the session itself.'
            else
                terminal_menu_notice=
            fi
        else
            terminal_menu_notice=
        fi
        terminal_menu_args[index]="$(encode_launch_args ${launch_args_decoded[@]+"${launch_args_decoded[@]}"})"
        terminal_menu_details[index]="$(format_launch_args "${terminal_menu_args[index]}")"
    else
        terminal_menu_notice='Could not read those arguments; check the quoting.'
    fi
    printf '\033[?25l'
}

# 整页翻。`$1` 是方向（1 往后、-1 往前）。
#
# 光标落到**新一页的第一行**，窗口跟着整页移动。只把光标 `index` 加减一页而让窗口
# 自己贴上去的话，第一次翻会看起来只滚了一行：光标从第 0 行跳到第 10 行，而窗口
# 只需要挪 1 行就能把它露出来。人按的是"翻页"，看到的却是"滚了一行"。
menu_turn_page() {
    local direction="$1" page
    # 落到相邻那一页的**第一行**，而不是"当前光标加减一页"。后者在半页位置上翻
    # 会落到下一页的中间，人按翻页却看不出边界在哪。
    page=$(( index / visible + direction ))
    (( page >= 0 )) || page=0
    index=$(( page * visible ))
    (( index < total )) || index=$(( (total - 1) / visible * visible ))
    (( index >= 0 )) || index=0
}

# 每个 Agent 的权限档位，从**最大到最小**排。
#
# 为什么要有这个：忘记开权限是这套工具里最常见的一次返工——会话起来了，干到一半
# 发现是只读的，退出、翻文档想那个 flag 叫什么、重开。而"忘记"这件事做成一个按键
# 是治不好的，因为你不会去按一个你已经忘了的东西。所以它挂在回车这条路上。
#
# 每一行是 `标签<TAB>说明<TAB>参数`，参数之间用 `\x1f` 分隔（一档往往是两个 flag）。
# 外层用 TAB 是安全的：唯一可能为空的是最后那个字段，而 `read` 把行尾的 IFS 空白
# 吃掉之后正好留一个空串——中间字段为空才会踩到 tab 合并那个坑（见 gc 那边）。
#
# 说明是从两个 Agent 自己的文档里抄的，不是猜的：
#   - Codex：`codex --help` 的 `--sandbox` / `--ask-for-approval` 两段。
#   - Claude：二进制里那段 permission mode 的说明（default/acceptEdits/
#     bypassPermissions/plan/dontAsk/auto 逐条）。`manual` 是 CLI 收的名字，内部
#     映射成 `default`。
#
# 顶格那一档故意用各自"最直白"的写法：Codex 是
# `--dangerously-bypass-approvals-and-sandbox`，Claude 是
# `--dangerously-skip-permissions` 而不是 `--permission-mode bypassPermissions`
# ——后者还要 `allowDangerouslySkipPermissions` 才生效，选了却不生效比没得选更糟。
permission_ladder() {
    case "$1" in
        codex)
            printf '%s\n' \
                $'yolo\t不沙箱、不询问，什么都直接跑（最大）\t--dangerously-bypass-approvals-and-sandbox' \
                $'auto\t工作区内随便写，从不问你\t--sandbox\x1fworkspace-write\x1f--ask-for-approval\x1fnever' \
                $'default\t工作区内可写，越界时问你\t--sandbox\x1fworkspace-write\x1f--ask-for-approval\x1fon-request' \
                $'read-only\t什么都改不了，要改就问你\t--sandbox\x1fread-only\x1f--ask-for-approval\x1fon-request' \
                $'locked\t什么都改不了，也不问（最小）\t--sandbox\x1fread-only\x1f--ask-for-approval\x1fnever' \
                $'keep\t不改，沿用这个会话现在的参数\t'
            ;;
        claude)
            printf '%s\n' \
                $'bypass\t跳过所有权限检查（最大）\t--dangerously-skip-permissions' \
                $'auto\t模型判官自动批准或拒绝每一次请求\t--permission-mode\x1fauto' \
                $'acceptEdits\t文件编辑自动通过，其余照问\t--permission-mode\x1facceptEdits' \
                $'manual\t危险操作问你（Claude 的默认）\t--permission-mode\x1fmanual' \
                $'dontAsk\t不问；没预先批准过的一律拒绝\t--permission-mode\x1fdontAsk' \
                $'plan\t计划模式，不执行任何工具（最小）\t--permission-mode\x1fplan' \
                $'keep\t不改，沿用这个会话现在的参数\t'
            ;;
    esac
}

# 把参数拆成"权限那部分"和"其余"。
#
# 选完档位要把新的一档写回去，而**旧的一档必须先拿掉**：`--sandbox read-only` 后面
# 再跟一个 `--sandbox workspace-write`，两个 Agent 谁赢都不该由我们来赌。
#
# 和 `strip_session_selection_args` 一样在裸 `--` 处收手：那之后是给模型的 prompt，
# 里面出现 `--sandbox` 这个词也只是个词。
strip_permission_args() {
    local agent="$1" argument
    shift
    stripped_permission_args=()
    permission_args_found=()
    while (( $# > 0 )); do
        argument="$1"
        shift
        if [[ "$argument" == -- ]]; then
            stripped_permission_args+=("$argument" "$@")
            return 0
        fi
        if [[ "$agent" == codex ]]; then
            case "$argument" in
                --dangerously-bypass-approvals-and-sandbox|--yolo|--full-auto|--approve-for-me)
                    permission_args_found+=("$argument"); continue ;;
                -s|--sandbox|-a|--ask-for-approval)
                    permission_args_found+=("$argument")
                    if (( $# > 0 )) && [[ "$1" != -* ]]; then
                        permission_args_found+=("$1"); shift
                    fi
                    continue ;;
                --sandbox=*|--ask-for-approval=*)
                    permission_args_found+=("${argument%%=*}" "${argument#*=}"); continue ;;
            esac
        else
            case "$argument" in
                --dangerously-skip-permissions)
                    permission_args_found+=("$argument"); continue ;;
                --permission-mode)
                    permission_args_found+=("$argument")
                    if (( $# > 0 )) && [[ "$1" != -* ]]; then
                        permission_args_found+=("$1"); shift
                    fi
                    continue ;;
                --permission-mode=*)
                    permission_args_found+=("${argument%%=*}" "${argument#*=}"); continue ;;
            esac
        fi
        stripped_permission_args+=("$argument")
    done
}

# 一组参数的比较用指纹：排过序再拼起来，所以 `-a never -s read-only` 和
# `-s read-only -a never` 是同一档。用来把"这个会话上次用的"对回到某一行去预选。
permission_args_key() {
    (( $# > 0 )) || { printf '\n'; return 0; }
    printf '%s\n' "$@" | LC_ALL=C sort | tr '\n' ' '
}

# 选权限档位。回车之后、真正把进程交出去之前的最后一屏。
#
# 预选的是这个会话**上次用的那一档**，所以老路径仍然是两次回车；认不出来（第一次
# 开，或者参数是手写的）就停在 `keep`——那一档一个参数都不加，等于这个功能加进来
# 之前的行为。Esc 退回列表，什么都不改。
#
# `AGS_PERMISSION_PROMPT=0` 整个关掉。
pick_permission_mode() {
    local agent="$1" current_json="$2"
    local -a mode_label=() mode_desc=() mode_args=() base=() chosen=()
    local label desc args index total row key second third want
    permission_pick_args_json="$current_json"
    [[ "${AGS_PERMISSION_PROMPT:-1}" != 0 ]] || return 0
    [[ "$agent" == codex || "$agent" == claude ]] || return 0
    while IFS=$'\t' read -r label desc args; do
        [[ -n "$label" ]] || continue
        mode_label+=("$label"); mode_desc+=("$desc"); mode_args+=("$args")
    done < <(permission_ladder "$agent")
    total=${#mode_label[@]}
    (( total > 0 )) || return 0
    decode_launch_args "$current_json" || launch_args_decoded=()
    strip_permission_args "$agent" ${launch_args_decoded[@]+"${launch_args_decoded[@]}"}
    base=(${stripped_permission_args[@]+"${stripped_permission_args[@]}"})
    index=$(( total - 1 ))
    want="$(permission_args_key ${permission_args_found[@]+"${permission_args_found[@]}"})"
    for ((row = 0; row < total; row++)); do
        chosen=()
        [[ -z "${mode_args[$row]}" ]] ||
            mapfile -t chosen < <(printf '%s' "${mode_args[$row]}" | tr '\037' '\n')
        if [[ "$(permission_args_key ${chosen[@]+"${chosen[@]}"})" == "$want" ]]; then
            index=$row
            break
        fi
    done
    init_terminal_style
    printf '\033[?25l'
    while true; do
        printf '\033[H\033[2J'
        printf '  %s%s 的权限%s  %s从最大到最小；回车确认，Esc/q 回列表%s\n\n' \
            "$style_bold" "$agent" "$style_reset" "$style_dim" "$style_reset"
        for ((row = 0; row < total; row++)); do
            if (( row == index )); then
                printf '%s%s%-12s %s%s\n' "$style_pointer" "$style_select" \
                    "${mode_label[$row]}" "${mode_desc[$row]}" "$style_reset"
            else
                printf '  %-12s %s%s%s\n' "${mode_label[$row]}" \
                    "$style_dim" "${mode_desc[$row]}" "$style_reset"
            fi
        done
        # 这一行是"要生效"的证据：选中的档位到底会往命令行上加什么，当场看得见。
        if [[ -n "${mode_args[$index]}" ]]; then
            printf '\n  %sflags%s  %s\n' "$style_dim" "$style_reset" \
                "$(printf '%s' "${mode_args[$index]}" | tr '\037' ' ')"
        elif (( ${#permission_args_found[@]} > 0 )); then
            printf '\n  %sflags%s  %s\n' "$style_dim" "$style_reset" \
                "${permission_args_found[*]}"
        else
            printf '\n  %sflags%s  %s没有权限参数%s\n' \
                "$style_dim" "$style_reset" "$style_dim" "$style_reset"
        fi
        if ! IFS= read -rsn1 key; then
            terminal_menu_leave
            return 1
        fi
        if [[ -z "$key" ]]; then
            break
        fi
        case "$key" in
            k) (( index > 0 )) && index=$((index - 1)); continue ;;
            j) (( index + 1 < total )) && index=$((index + 1)); continue ;;
            q|Q) terminal_menu_leave; return 1 ;;
        esac
        [[ "$key" == $'\033' ]] || continue
        if ! IFS= read -rsn1 -t 0.05 second; then
            terminal_menu_leave
            return 1
        fi
        [[ "$second" == '[' || "$second" == O ]] || continue
        IFS= read -rsn1 -t 0.05 third || continue
        case "$third" in
            A) (( index > 0 )) && index=$((index - 1)) ;;
            B) (( index + 1 < total )) && index=$((index + 1)) ;;
            H) index=0 ;;
            F) index=$((total - 1)) ;;
        esac
    done
    terminal_menu_leave
    # `keep` 是**一个字都不改**，不是"不加权限参数"。
    #
    # 这两件事在一个已经写着 `--yolo` 的会话上是相反的：后者会把 `--yolo` 剥掉，
    # 于是"我什么都没选"变成了一次降权。选项写着"沿用现在的参数"，那它就得真的
    # 原样返回。
    if [[ -z "${mode_args[$index]}" ]]; then
        permission_pick_args_json="$current_json"
        return 0
    fi
    mapfile -t chosen < <(printf '%s' "${mode_args[$index]}" | tr '\037' '\n')
    # 权限参数放在**前面**：`base` 的尾巴上可能挂着一个裸 `--` 和给模型的 prompt，
    # 追加到那后面就成了 prompt 的一部分，一个字都不会生效。
    permission_pick_args_json="$(encode_launch_args \
        ${chosen[@]+"${chosen[@]}"} ${base[@]+"${base[@]}"})"
    return 0
}

terminal_menu() {
    local title="$1" allow_delete="$2" allow_actions="${3:-0}" key second third fourth
    local menu_page_rows confirm
    local index=0 row width height body count hint pad
    local total chrome visible first=0
    (( ${#terminal_menu_ids[@]} > 0 )) || return 1
    init_terminal_style
    menu_page_rows="${AGS_PAGE_ROWS:-10}"
    [[ "$menu_page_rows" =~ ^[1-9][0-9]{0,2}$ ]] || menu_page_rows=10
    width="$(terminal_width)"
    (( width > 0 )) || width=80
    height="$(terminal_height)"
    body=$((width - 2))
    total=${#terminal_menu_labels[@]}
    printf -v count '%d saved' "${#terminal_menu_ids[@]}"
    printf '\033[?25l'
    while true; do
        # Everything the frame draws besides the rows themselves, so a store
        # with more sessions than the terminal has lines scrolls inside the
        # frame instead of pushing its own header off the top.
        chrome=9
        [[ -z "$terminal_menu_notice" ]] || chrome=$((chrome + 2))
        visible=$((height - chrome))
        (( visible >= 3 )) || visible=3
        if (( total > visible )); then
            visible=$((visible - 2))
            (( visible >= 3 )) || visible=3
        fi
        # 一页固定这么多行。窗口比它还小的时候以窗口为准——画不下的行不是"一页"，
        # 是被截掉。翻页的步长用的就是这个数（见方向键那一段），所以窗口多大、
        # 一次翻多远，永远是同一个数。
        (( visible <= menu_page_rows )) || visible=$menu_page_rows
        (( total > visible )) || visible=$total
        # 窗口按**整页**对齐，不跟着光标一行一行地滑。
        #
        # 滑动式的窗口在一百多条会话里读起来很累：↓ 到底之后每按一次就整屏重画、
        # 内容只挪一行，眼睛得重新找位置。按页对齐之后，↓ 到最后一行再按一次就是
        # 干净的翻页，光标落到下一页第一行；↑ 同理往回翻。
        #
        # 最后一页可能不满（102 条、一页 10 行，最后一页只有 2 条），所以下面画行
        # 的循环必须同时以 `total` 收口，否则会去读数组越界的下标。
        first=$(( (index / visible) * visible ))
        (( first >= 0 )) || first=0
        pad=$((body - ${#title} - ${#count}))
        (( pad >= 1 )) || pad=1
        printf '\033[H\033[2J'
        printf '  %s%s%s%*s%s%s%s\n\n' \
            "$style_bold" "$title" "$style_reset" "$pad" '' \
            "$style_dim" "$count" "$style_reset"
        [[ -z "$terminal_menu_header" ]] ||
            printf '  %s%s%s\n' "$style_dim" "$terminal_menu_header" "$style_reset"
        printf '  %s%s%s\n' \
            "$style_dim" "$(style_rule_line "$body")" "$style_reset"
        (( first == 0 )) ||
            printf '  %s%s %d more above%s\n' \
                "$style_dim" "$style_more" "$first" "$style_reset"
        for ((row = first; row < first + visible && row < total; row++)); do
            if (( row == index )); then
                printf '%s%s%s%s\n' "$style_pointer" "$style_select" \
                    "${terminal_menu_labels[$row]}" "$style_reset"
            else
                printf '  %s\n' "${terminal_menu_labels[$row]}"
            fi
        done
        (( first + visible >= total )) ||
            printf '  %s%s %d more below%s\n' \
                "$style_dim" "$style_more" "$((total - first - visible))" "$style_reset"
        if (( ${#terminal_menu_details[@]} > 0 )); then
            if [[ -n "${terminal_menu_details[$index]}" ]]; then
                printf '\n  %sargs%s  %s\n' \
                    "$style_dim" "$style_reset" "${terminal_menu_details[$index]}"
            else
                printf '\n  %sargs%s  %snone — press a to add%s\n' \
                    "$style_dim" "$style_reset" "$style_dim" "$style_reset"
            fi
        fi
        hint="$style_hint_move$style_separator$style_hint_page$style_separator$style_hint_open"
        (( ${#terminal_menu_details[@]} == 0 )) || hint+="${style_separator}a args"
        [[ "$allow_actions" != 1 ]] || hint+="${style_separator}p pin${style_separator}s save"
        [[ "$allow_delete" != 1 ]] || hint+="${style_separator}del delete"
        hint+="${style_separator}esc quit"
        printf '\n  %s%s%s\n' "$style_dim" "$hint" "$style_reset"
        [[ -z "$terminal_menu_notice" ]] ||
            printf '\n  %s%s%s\n' "$style_accent" "$terminal_menu_notice" "$style_reset"
        if ! IFS= read -rsn1 key; then
            terminal_menu_leave
            return 1
        fi
        if [[ -z "$key" ]]; then
            terminal_menu_selected="${terminal_menu_ids[$index]}"
            terminal_menu_selected_args="${terminal_menu_args[$index]:-[]}"
            terminal_menu_selected_agent="${terminal_menu_agents[$index]:-}"
            terminal_menu_leave
            return 0
        fi
        case "$key" in
            # j/k alongside the arrow keys: the muscle memory every other
            # terminal picker in this workflow already trains.
            k) (( index > 0 )) && index=$((index - 1)); continue ;;
            j) (( index + 1 < ${#terminal_menu_ids[@]} )) && index=$((index + 1)); continue ;;
            a|A)
                (( ${#terminal_menu_details[@]} > 0 )) || continue
                terminal_menu_edit_args "$index"
                continue
                ;;
            p|P)
                [[ "$allow_actions" == 1 ]] || continue
                terminal_menu_selected="${terminal_menu_ids[$index]}"
                terminal_menu_selected_args="${terminal_menu_args[$index]:-[]}"
                terminal_menu_selected_agent="${terminal_menu_agents[$index]:-}"
                terminal_menu_leave
                return 3
                ;;
            s|S)
                [[ "$allow_actions" == 1 ]] || continue
                terminal_menu_selected="${terminal_menu_ids[$index]}"
                terminal_menu_selected_args="${terminal_menu_args[$index]:-[]}"
                terminal_menu_selected_agent="${terminal_menu_agents[$index]:-}"
                terminal_menu_leave
                return 4
                ;;
            q|Q)
                terminal_menu_leave
                return 1
                ;;
        esac
        [[ "$key" == $'\177' ]] && continue
        [[ "$key" == $'\033' ]] || continue
        if ! IFS= read -rsn1 -t 0.05 second; then
            terminal_menu_leave
            return 1
        fi
        [[ "$second" == '[' || "$second" == O ]] || continue
        IFS= read -rsn1 -t 0.05 third || continue
        case "$third" in
            A) (( index > 0 )) && index=$((index - 1)) ;;
            B) (( index + 1 < ${#terminal_menu_ids[@]} )) && index=$((index + 1)) ;;
            # 整页地翻。一次一行在一百多个会话里没法用，而这三组键是终端里
            # 「翻页」的三种肌肉记忆，都接上：左右方向键、PageUp/PageDown、
            # 以及 Home/End 直接到头和到尾。
            #
            # 步长用的是这一屏**实际画了几行**（`visible`），不是一个写死的数字：
            # 窗口多高就翻多少，翻完光标停的位置和眼睛看的位置才对得上。
            C) menu_turn_page 1 ;;
            D) menu_turn_page -1 ;;
            H) index=0 ;;
            F) index=$((total - 1)) ;;
            5)
                [[ "$second" == '[' ]] || continue
                IFS= read -rsn1 -t 0.05 fourth || continue
                [[ "$fourth" == '~' ]] || continue
                menu_turn_page -1
                ;;
            6)
                [[ "$second" == '[' ]] || continue
                IFS= read -rsn1 -t 0.05 fourth || continue
                [[ "$fourth" == '~' ]] || continue
                menu_turn_page 1
                ;;
            1|7)
                [[ "$second" == '[' ]] || continue
                IFS= read -rsn1 -t 0.05 fourth || continue
                [[ "$fourth" == '~' ]] || continue
                index=0
                ;;
            4|8)
                [[ "$second" == '[' ]] || continue
                IFS= read -rsn1 -t 0.05 fourth || continue
                [[ "$fourth" == '~' ]] || continue
                index=$((total - 1))
                ;;
            3)
                [[ "$second" == '[' ]] || continue
                IFS= read -rsn1 -t 0.05 fourth || continue
                [[ "$fourth" == '~' && "$allow_delete" == 1 ]] || continue
                # 两种东西，两种问法。删存档是删我们自己目录里的一份副本；删活
                # 会话是删 **Agent 自己 home 里的**东西，那是不一样的一件事，问的
                # 时候就得说清楚，而不是共用一句「Delete this saved session?」——
                # 对着一个从没存过的会话，那句话本身就是假的。
                if [[ "${terminal_menu_ids[$index]}" == live:* ]]; then
                    printf '\n  %sDelete this session from the Agent? Any archive of it stays.%s [y/N] ' \
                        "$style_bold" "$style_reset"
                else
                    printf '\n  %sDelete this saved session?%s [y/N] ' \
                        "$style_bold" "$style_reset"
                fi
                IFS= read -rsn1 confirm || confirm=
                printf '\n'
                if [[ "$confirm" == y || "$confirm" == Y ]]; then
                    terminal_menu_selected="${terminal_menu_ids[$index]}"
                    terminal_menu_selected_args="${terminal_menu_args[$index]:-[]}"
                    terminal_menu_selected_agent="${terminal_menu_agents[$index]:-}"
                    terminal_menu_leave
                    return 2
                fi
                ;;
        esac
    done
}

launch_managed_agent() {
    local launch_binary="$1" agent="$2" launch_cwd
    shift 2
    # ags 自己的参数在命令名之前就解析完了（见文件末尾的分发）。落地放在这里而不是
    # `start_managed_agent`：`ags resume` 那条路不经过它，只经过这里，而恢复一个
    # 会话同样需要能点名要号。
    if (( ${ags_pick_account:-0} == 1 )); then
        [[ "$agent" == codex ]] ||
            die "--pick-account 只对 Codex 有意义：$agent 不从凭据池取号"
        ags_account="$(pick_pool_account)"
    fi
    apply_pool_account "$agent" "${ags_account:-}"
    check_pool_account_names "$agent" "${ags_account:-}"
    scrub_transport_password_environment
    launch_cwd="$(pwd -P)"
    if [[ "$agent" == claude ]]; then
        # The effective probe is intentionally slow, so both Claude checks run
        # as late as possible — immediately before the process is handed over —
        # and a settings file edited during the probe still gets caught.
        validate_claude_context_args "$@"
        validate_claude_settings_sources "$launch_cwd"
    fi
    # 会话身份要在租约身份之前定下来——后者是从前者派生的。
    prepare_session_identity "$launch_cwd" "$agent"
    export_pool_device_id "$agent"
    report_pool_session "$agent" "$launch_cwd"
    # After every check that can refuse this launch, so a pending update is
    # never the last thing printed before a refusal — and never mistaken for
    # part of one. `|| true` states the contract where it matters: an update
    # notice is the least important thing this function does, and nothing about
    # it may stand between a validated launch and the Agent.
    announce_pending_updates || true
    # 同样的道理，同样的 `|| true`：先报上一轮自动 gc 删了什么，再让这一轮有机会
    # 起来。两件事都在**所有能拒绝这次启动的检查之后**——一条"删了 12 个会话"的
    # 提示绝不该是一次拒绝之前的最后一句话，那读起来像是拒绝的一部分。
    announce_auto_gc || true
    maybe_start_background_gc || true
    exec "$launch_binary" "$@"
}

resolve_checkpoint_record_for_live() {
    local target="$1" checkpoint_id="$2"
    [[ "$target" == local ]] || die "target must be local"
    load_local_storage
    find_local_checkpoint_archive "$checkpoint_id"
}

read_checkpoint_runtime_manifest() {
    local target="$1"
    [[ "$target" == local ]] || die "target must be local"
    age_decrypt "$checkpoint_match" | tar -xzOf - manifest
}

start_managed_agent() {
    local agent="$1" launch_binary
    shift
    scrub_transport_password_environment
    # Here "$@" is exactly what the user typed, before AGS adds anything of its
    # own — which is the only point in the program where that is true. The
    # launch below still receives it whole, so `ags codex resume` picks a
    # session exactly as it always did; only the record drops that part,
    # because a resume of this checkpoint rebuilds the selection itself.
    strip_session_selection_args "$agent" "$@"
    if (( stripped_session_selected == 1 )); then
        launch_terminal_title_mode=resume
        launch_terminal_title="$stripped_session_id"
    else
        launch_terminal_title_mode=new
        launch_terminal_title=
    fi
    export_launch_args "${stripped_launch_args[@]}"
    prepare_storage_for_launch
    launch_binary="$(resolve_agent_binary "$agent")"
    if [[ "$agent" == codex ]]; then
        validate_codex_context_args "$@"
    else
        validate_claude_context_args "$@"
    fi
    launch_managed_agent "$launch_binary" "$agent" "$@"
}

# 这个 Agent 在这台机器上起得来吗。
#
# 必须和 resolve_agent_binary 用同一套判断：它认 codext 当 codex，而菜单从前
# 只认 `codex` 这个名字。两边口径不一致的后果具体而恼人——一台只装了 codext
# 的机器，`ags codex` 跑得好好的，菜单却说找不到 Codex。给 codext 加一个叫
# codex 的软链接（`ags codex-name`）能让名字对上，但那是安装期的取舍，判断本身
# 不该指望它：没做那一步的机器，菜单照样要看得见。
agent_available() {
    resolve_agent_binary "$1" >/dev/null 2>&1
}

enter_ags() {
    local choice
    scrub_transport_password_environment
    prepare_storage_for_launch
    if agent_available claude && agent_available codex; then
        [[ -t 0 && -t 1 ]] ||
            die "choosing an Agent needs a terminal; run ags claude or ags codex"
        printf 'Start:\n  1) Claude\n  2) Codex\nChoose [1]: '
        IFS= read -r choice
        case "${choice:-1}" in
            1) start_managed_agent claude ;;
            2) start_managed_agent codex ;;
            *) die "invalid Agent selection" ;;
        esac
    elif agent_available claude; then
        start_managed_agent claude
    elif agent_available codex; then
        start_managed_agent codex
    else
        die "cannot find an executable Claude or Codex binary"
    fi
}

run_ags_isolated() {
    local binary="$1" sandbox="$2"
    shift 2
    env -i \
        HOME="$sandbox/home" \
        PATH=/usr/local/bin:/usr/bin:/bin \
        TMPDIR="$sandbox/tmp" \
        XDG_DATA_HOME="$sandbox/xdg-data" \
        XDG_STATE_HOME="$sandbox/xdg-state" \
        CODEX_HOME="$sandbox/codex-home" \
        CLAUDE_CONFIG_DIR="$sandbox/claude-home" \
        CLAUDE_HOME="$sandbox/claude-home" \
        "$binary" "$@" 8>&- 9>&- </dev/null
}

validate_converted_transcript_identity() {
    local agent="$1" session_id="$2" transcript="$3" codex_provider="${4:-}"
    case "$agent" in
        claude)
            jq -se --arg id "$session_id" '
                . as $rows |
                (($rows | length) > 0) and
                all($rows[];
                    .sessionId == $id and
                    .isSidechain == false and
                    ((.uuid? | type) == "string") and
                    (.uuid | test(
                        "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
                    ))
                ) and
                (($rows | map(.uuid) | length) ==
                    ($rows | map(.uuid) | unique | length)) and
                ($rows[0].parentUuid == null) and
                ([
                    range(1; ($rows | length)) as $index |
                    (
                        (($rows[$index].parentUuid | type) == "string") and
                        (
                            [$rows[0:$index][].uuid] |
                            index($rows[$index].parentUuid)
                        ) != null
                    )
                ] | all)
            ' "$transcript" >/dev/null ||
                die "converted Claude transcript has an invalid session tree"
            ;;
        codex)
            jq -se --arg id "$session_id" --arg provider "$codex_provider" '
                length > 0 and
                .[0].type == "session_meta" and
                .[0].payload.id == $id and
                .[0].payload.model_provider == $provider and
                ([.[] | select(.type == "session_meta")] | length) == 1
            ' "$transcript" >/dev/null ||
                die "converted Codex transcript has invalid session metadata"
            ;;
        *) die "unsupported converted transcript format: $agent" ;;
    esac
}

read_codex_model_provider() {
    local file="$1" line provider=
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*\[ ]] && break
        line="${line%%#*}"
        if [[ "$line" =~ ^[[:space:]]*model_provider[[:space:]]*=[[:space:]]*\"([A-Za-z0-9._-]+)\"[[:space:]]*$ ]]; then
            [[ -z "$provider" ]] ||
                die "Codex config defines model_provider more than once: $file"
            provider="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^[[:space:]]*model_provider[[:space:]]*=[[:space:]]*\'([A-Za-z0-9._-]+)\'[[:space:]]*$ ]]; then
            [[ -z "$provider" ]] ||
                die "Codex config defines model_provider more than once: $file"
            provider="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^[[:space:]]*model_provider[[:space:]]*= ]]; then
            die "Codex config has an unsupported model_provider value: $file"
        fi
    done < "$file"
    printf '%s\n' "$provider"
}

validate_profile_name() {
    local profile="$1" LC_ALL=C
    [[ "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
        die "invalid profile name: $profile"
}

resolve_codex_model_provider() {
    local native_home="$1" profile="${2:-}" provider= profile_file
    if [[ -n "$profile" ]]; then
        validate_profile_name "$profile"
        profile_file="$native_home/$profile.config.toml"
        [[ -f "$profile_file" ]] ||
            die "Codex profile does not exist: $profile_file"
        provider="$(read_codex_model_provider "$profile_file")"
    fi
    if [[ -z "$provider" ]]; then
        provider="$(read_codex_model_provider "$native_home/config.toml")"
    fi
    [[ -n "$provider" ]] || provider=openai
    printf '%s\n' "$provider"
}

validate_claude_auth_settings() {
    local settings="$1" label="$2" filter
    filter='
      length == 1 and
      (.[0] |
        type == "object" and
        ((keys - ["apiKeyHelper", "effortLevel", "env", "model"]) | length) == 0 and
        (
          (has("env") | not) or
          (
            .env |
            type == "object" and
            all(to_entries[];
              (.key | type) == "string" and
              (
                .key == "ANTHROPIC_BASE_URL" or
                .key == "ANTHROPIC_API_KEY" or
                .key == "ANTHROPIC_AUTH_TOKEN"
              ) and
              (.value | type) == "string"
            )
          )
        ) and
        (
          (has("apiKeyHelper") | not) or
          (
            .apiKeyHelper |
            type == "string" and
            test("\\A/usr/bin/printenv [A-Za-z_][A-Za-z0-9_]*\\z")
          )
        ) and
        ((has("model") | not) or (.model | type == "string")) and
        ((has("effortLevel") | not) or (.effortLevel | type == "string"))
      )
    '
    [[ ! -L "$settings" ]] ||
        die "$label cannot be a symbolic link"
    if [[ -f "$settings" ]]; then
        [[ -r "$settings" ]] || die "$label is not readable"
        jq -e -s "$filter" -- "$settings" >/dev/null 2>&1 ||
            die "$label may contain only ANTHROPIC_BASE_URL, ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, apiKeyHelper, model, and effortLevel"
        return
    fi
    printf '%s' "$settings" | jq -e -s "$filter" >/dev/null 2>&1 ||
        die "$label must be a readable JSON file or inline JSON containing only ANTHROPIC_BASE_URL, ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, apiKeyHelper, model, and effortLevel"
}

resolve_claude_profile_settings() {
    local native_home="$1" profile="$2" settings_file
    validate_profile_name "$profile"
    settings_file="$native_home/$profile.settings.json"
    [[ -f "$settings_file" && -r "$settings_file" ]] ||
        die "Claude profile does not exist or is not readable: $settings_file"
    validate_claude_auth_settings "$settings_file" "Claude profile"
    printf '%s\n' "$settings_file"
}

validate_claude_settings_source() {
    local settings="$1" label="$2" filter
    [[ -e "$settings" || -L "$settings" ]] || return 0
    [[ ! -L "$settings" ]] || die "$label cannot be a symbolic link"
    [[ -f "$settings" && -r "$settings" ]] ||
        die "$label is not a readable regular file"
    filter='
      length == 1 and
      (.[0] |
        type == "object" and
        (
          (has("apiKeyHelper") | not) or
          (
            .apiKeyHelper |
            type == "string" and
            test("\\A/usr/bin/printenv [A-Za-z_][A-Za-z0-9_]*\\z")
          )
        )
      )
    '
    jq -e -s "$filter" -- "$settings" >/dev/null 2>&1 ||
        die "$label must be one JSON object and apiKeyHelper, if present, must be /usr/bin/printenv ENV_NAME"
}

validate_claude_settings_sources() {
    local audit_cwd="$1" project_root git_common_dir main_root settings i
    local -a settings_files settings_labels
    local -A seen=()
    [[ "$audit_cwd" == /* && -d "$audit_cwd" ]] ||
        die "Claude workspace is not an absolute directory"
    audit_cwd="$(cd -- "$audit_cwd" && pwd -P)" ||
        die "cannot resolve Claude workspace"

    settings_files=(
        "$claude_home/settings.json"
        "/etc/claude-code/managed-settings.json"
    )
    settings_labels=(
        "Claude user settings"
        "Claude managed settings"
    )

    project_root="$audit_cwd"
    if git -C "$audit_cwd" rev-parse --show-toplevel >/dev/null 2>&1; then
        project_root="$(git -C "$audit_cwd" rev-parse --show-toplevel)" ||
            die "cannot resolve Claude project settings root"
        project_root="$(cd -- "$project_root" && pwd -P)" ||
            die "cannot resolve Claude project settings root"
    fi
    settings_files+=(
        "$project_root/.claude/settings.json"
        "$project_root/.claude/settings.local.json"
    )
    settings_labels+=(
        "Claude project settings"
        "Claude local settings"
    )

    if [[ "$audit_cwd" != "$project_root" ]]; then
        settings_files+=("$audit_cwd/.claude/settings.local.json")
        settings_labels+=("Claude legacy local settings")
    fi

    git_common_dir="$(
        git -C "$audit_cwd" rev-parse --path-format=absolute --git-common-dir \
            2>/dev/null || true
    )"
    if [[ "$git_common_dir" == */.git ]]; then
        main_root="${git_common_dir%/.git}"
        if [[ "$main_root" != "$project_root" ]]; then
            settings_files+=("$main_root/.claude/settings.local.json")
            settings_labels+=("Claude main-worktree local settings")
        fi
    fi

    for ((i = 0; i < ${#settings_files[@]}; i++)); do
        settings="${settings_files[$i]}"
        [[ -z "${seen[$settings]:-}" ]] || continue
        seen["$settings"]=1
        validate_claude_settings_source "$settings" "${settings_labels[$i]}"
    done
}

validate_claude_context_environment() {
    local value
    for value in "${CLAUDE_CODE_SAFE_MODE:-}" "${CLAUDE_CODE_SIMPLE:-}"; do
        case "${value,,}" in
            ''|0|false|no|off) ;;
            *)
                die "Claude safe/bare mode is forbidden because it disables the AGS plugin"
                ;;
        esac
    done
}

validate_claude_context_args() {
    local argument settings i audit_cwd
    local -a arguments=()
    arguments=("$@")
    validate_claude_context_environment
    for ((i = 0; i < ${#arguments[@]}; i++)); do
        argument="${arguments[$i]}"
        [[ "$argument" == -- ]] && break
        case "$argument" in
            --safe-mode|--safe-mode=*|--bare|--bare=*|--strict-mcp-config|--strict-mcp-config=*)
                die "Claude $argument is forbidden because it disables the AGS plugin"
                ;;
            --settings)
                (( i + 1 < ${#arguments[@]} )) ||
                    die "Claude --settings requires a file or inline JSON"
                settings="${arguments[$((i + 1))]}"
                validate_claude_auth_settings "$settings" "Claude --settings"
                i=$((i + 1))
                ;;
            --settings=*)
                settings="${argument#--settings=}"
                validate_claude_auth_settings "$settings" "Claude --settings"
                ;;
            --agent|--agent=*|--agents|--agents=*)
                die "Claude ${argument%%=*} cannot be forwarded because Agent selection or definitions may replace the AGS tools"
                ;;
            --setting-sources|--setting-sources=*|--mcp-config|--mcp-config=*|--plugin-dir|--plugin-dir=*|--plugin-url|--plugin-url=*|--disallowedTools|--disallowedTools=*|--disallowed-tools|--disallowed-tools=*)
                die "Claude ${argument%%=*} cannot be forwarded because it changes settings, MCP, plugins, or tool availability after AGS validated them"
                ;;
            --no-session-persistence|--no-session-persistence=*)
                die "Claude --no-session-persistence cannot be forwarded because it disables AGS session recovery"
                ;;
        esac
    done
    audit_cwd="$(pwd -P)" || die "cannot resolve Claude workspace"
    validate_claude_settings_sources "$audit_cwd"
}

validate_codex_context_args() {
    local argument profile= i
    local -a arguments=()
    arguments=("$@")
    codex_audit_profile=
    for ((i = 0; i < ${#arguments[@]}; i++)); do
        argument="${arguments[$i]}"
        [[ "$argument" == -- ]] && break
        case "$argument" in
            -p|--profile)
                (( i + 1 < ${#arguments[@]} )) ||
                    die "$argument requires a Codex profile"
                [[ -z "$profile" ]] ||
                    die "Codex profile may be specified only once"
                profile="${arguments[$((i + 1))]}"
                validate_profile_name "$profile"
                i=$((i + 1))
                ;;
            --profile=*)
                [[ -z "$profile" ]] ||
                    die "Codex profile may be specified only once"
                profile="${argument#--profile=}"
                validate_profile_name "$profile"
                ;;
            -p?*)
                [[ -z "$profile" ]] ||
                    die "Codex profile may be specified only once"
                profile="${argument#-p}"
                profile="${profile#=}"
                validate_profile_name "$profile"
                ;;
            -C|--cd|-c|--config|--enable|--disable|--remote|--remote-auth-token-env|--add-dir)
                die "Codex $argument cannot be forwarded because it changes the workspace or configuration after AGS validated it"
                ;;
            -C?*|-c?*|--cd=*|--config=*|--enable=*|--disable=*|--remote=*|--remote-auth-token-env=*|--add-dir=*)
                die "Codex ${argument%%=*} cannot be forwarded because it changes the workspace or configuration after AGS validated it"
                ;;
            --dangerously-bypass-hook-trust)
                die "Codex hook trust bypass is forbidden because AGS relies on its own hooks"
                ;;
        esac
    done
    codex_audit_profile="$profile"
}

validate_cross_codex_client_args() {
    local argument
    local -a arguments=("$@")
    for argument in "${arguments[@]}"; do
        [[ "$argument" == -- ]] && return
        case "$argument" in
            --oss|--oss=*|--local-provider|--local-provider=*)
                die "do not override the Codex provider during cross-Agent resume"
                ;;
        esac
    done
}

prepare_cross_agent_restore() {
    local source_agent="$1" source_session_id="$2" source_main="$3"
    local target_agent="$4" target_cwd="$5" work="$6" codex_provider="${7:-}"
    local sandbox="$work/ags" source_input="$source_main" target_root
    local binary result_file stderr error_message target_main relative normalized target_project
    local source_slug target_slug target_alias conversion_fidelity readback produced message

    umask 077
    mkdir -p "$sandbox/home" "$sandbox/tmp" "$sandbox/xdg-data" \
        "$sandbox/xdg-state" "$sandbox/codex-home" "$sandbox/claude-home"
    binary="$(resolve_ags_converter_binary)"
    conversion_result_binary="$binary"

    if [[ "$source_main" == *.jsonl.zst ]]; then
        need zstd
        source_input="$sandbox/source.jsonl"
        zstd -q -dc -- "$source_main" > "$source_input" ||
            die "cannot decompress the Codex transcript for conversion"
        [[ -s "$source_input" ]] ||
            die "decompressed Codex transcript is empty"
    fi

    case "$source_agent" in
        codex) source_slug=codex ;;
        claude) source_slug=claude-code ;;
        *) die "unsupported conversion source Agent: $source_agent" ;;
    esac
    case "$target_agent" in
        codex)
            target_root="$sandbox/codex-home"
            target_slug=codex
            target_alias=cod
            ;;
        claude)
            target_root="$sandbox/claude-home"
            target_slug=claude-code
            target_alias=cc
            ;;
        *) die "unsupported conversion target Agent: $target_agent" ;;
    esac
    result_file="$sandbox/convert.json"
    stderr="$sandbox/convert.err"
    # `convert` 前缀：转换那套收在它底下了（见 `converter_cli`）。这里不能直接用
    # `converter_cli`——这一次要在隔离沙箱里跑。
    if ! run_ags_isolated "$binary" "$sandbox" \
        convert --json resume "$target_alias" "$source_session_id" \
        --source "$source_input" --force --exact-source \
        > "$result_file" 2> "$stderr"; then
        error_message="$(jq -r '.message // empty' "$stderr" 2>/dev/null || true)"
        [[ -n "$error_message" ]] ||
            error_message="$(sed -n '/[^[:space:]]/h; ${x;p;}' "$stderr")"
        die "ags conversion failed: ${error_message:-unknown error}"
    fi
    jq -e --arg source "$source_slug" --arg target "$target_slug" \
        --arg source_id "$source_session_id" '
        .ok == true and
        .source_provider == $source and
        .target_provider == $target and
        .source_session_id == $source_id and
        .dry_run == false and
        (.fidelity | type == "string") and
        (
          .verified_fidelity == null or
          (.verified_fidelity | type == "string")
        ) and
        (.warnings | type == "array") and
        (.losses | type == "array") and
        (.target_session_id | type == "string") and
        (.written_paths | type == "array" and length == 1) and
        (.written_paths[0] | type == "string")
    ' "$result_file" >/dev/null ||
        die "ags returned an invalid conversion result"
    conversion_result_session_id="$(jq -r '.target_session_id' "$result_file")"
    validate_session_id "$conversion_result_session_id"
    [[ "$conversion_result_session_id" != "$source_session_id" ]] ||
        die "ags reused the source session UUID"
    target_main="$(jq -r '.written_paths[0]' "$result_file")"
    [[ "$target_main" == "$target_root/"* && -f "$target_main" && ! -L "$target_main" ]] ||
        die "ags target transcript escaped its output root"

    [[ -z "$(find "$target_root" -type l -print -quit)" ]] ||
        die "ags output contains a symbolic link"
    [[ -z "$(find "$target_root" -mindepth 1 ! -type d ! -type f -print -quit)" ]] ||
        die "ags output contains a special file"
    relative="${target_main#"$target_root/"}"
    [[ "$relative" != "$target_main" ]] ||
        die "ags target transcript escaped its output root"
    validate_native_main_path "$target_agent" "$conversion_result_session_id" "$relative" ||
        die "ags produced an unsupported target transcript path"

    while IFS= read -r -d '' produced; do
        [[ "$produced" == "$target_main" ]] ||
            die "ags produced an unexpected target artifact: ${produced#"$target_root/"}"
    done < <(find "$target_root" -type f -print0)

    conversion_result_main="$target_main"
    if [[ "$target_agent" == claude ]]; then
        normalized="$sandbox/claude-normalized.jsonl"
        jq -c --arg cwd "$target_cwd" '.cwd = $cwd' "$target_main" > "$normalized" ||
            die "cannot normalize converted Claude working directory"
        [[ "$(wc -l < "$normalized")" == "$(wc -l < "$target_main")" ]] ||
            die "converted Claude transcript changed length during normalization"
        tail -n 1 "$normalized" | jq -e . >/dev/null ||
            die "converted Claude JSONL is incomplete"
        chmod 600 "$normalized"
        conversion_result_main="$normalized"
        target_project="$(claude_project_key_for_cwd "$target_cwd")"
        [[ -n "$target_project" && "$target_project" != */* ]] ||
            die "cannot map the target cwd to Claude project storage"
        conversion_result_relative="projects/$target_project/$conversion_result_session_id.jsonl"
    else
        normalized="$sandbox/codex-normalized.jsonl"
        jq -c --arg provider "$codex_provider" --arg cwd "$target_cwd" '
            if .type == "session_meta" then
                .payload.model_provider = $provider |
                .payload.cwd = $cwd
            elif .type == "turn_context" and
                 ((.payload.workspace_roots? | type) == "array") then
                .payload.workspace_roots = [$cwd]
            else .
            end
        ' "$target_main" > "$normalized" ||
            die "cannot normalize converted Codex model provider"
        [[ "$(wc -l < "$normalized")" == "$(wc -l < "$target_main")" ]] ||
            die "converted Codex transcript changed length during normalization"
        tail -n 1 "$normalized" | jq -e . >/dev/null ||
            die "converted Codex JSONL is incomplete"
        chmod 600 "$normalized"
        conversion_result_main="$normalized"
        conversion_result_relative="$relative"
    fi

    validate_converted_transcript_identity "$target_agent" \
        "$conversion_result_session_id" "$conversion_result_main" "$codex_provider"
    readback="$sandbox/readback.json"
    if ! run_ags_isolated "$binary" "$sandbox" \
        --json info "$conversion_result_main" --from "$target_alias" \
        > "$readback" 2> "$stderr"; then
        die "ags cannot read back the normalized $target_agent transcript"
    fi
    jq -e --arg id "$conversion_result_session_id" --arg format "$target_slug" '
        .session_id == $id and .detected_format == $format
    ' "$readback" >/dev/null ||
        die "ags read-back identity does not match the normalized transcript"
    conversion_fidelity="$(
        jq -r '.verified_fidelity // .fidelity' "$result_file"
    )"
    log "warning: cross-Agent resume fidelity reported by ags: $conversion_fidelity"
    while IFS= read -r message; do
        [[ -z "$message" ]] || log "warning: ags: $message"
    done < <(jq -r '.warnings[]?' "$result_file")
    while IFS= read -r message; do
        [[ -z "$message" ]] || log "warning: ags loss: $message"
    done < <(jq -r '.losses[]? | "\(.kind): \(.note)"' "$result_file")
}

register_trusted_agent_binary() {
    local agent="$1" binary="$2" temporary
    valid_local_binary_path "$binary" ||
        die "cannot trust an invalid $agent binary: $binary"
    mkdir -p -m700 "$trusted_binary_dir"
    temporary="$trusted_binary_dir/.$agent.$$.$RANDOM"
    printf '%s\n' "$binary" > "$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$trusted_binary_dir/$agent"
}

capture_binary_provenance() {
    local agent="$1" binary real version override ancestor path_binary path_real
    local native_context=0
    case "$agent" in
        codex)
            override="${AGENT_SESSION_CODEX_BINARY:-}"
            [[ -z "${CODEX_THREAD_ID:-}" ]] || native_context=1
            ;;
        claude)
            override="${AGENT_SESSION_CLAUDE_BINARY:-}"
            [[ -z "${CLAUDE_CODE_SESSION_ID:-}" ]] || native_context=1
            ;;
        *) die "agent must be codex or claude" ;;
    esac
    if [[ -n "$override" ]]; then
        binary="$(resolve_agent_binary "$agent" save)"
        checkpoint_binary_resolution=explicit
    elif (( native_context == 1 )) &&
         ancestor="$(find_agent_ancestor_binary "$agent" 2>/dev/null)"; then
        binary="$ancestor"
        checkpoint_binary_resolution=ancestor
        path_binary="$(command -v "$agent" 2>/dev/null || true)"
        if valid_agent_binary_path "$agent" "$path_binary" &&
           valid_local_binary_path "$path_binary"; then
            path_real="$(readlink -f -- "$path_binary" 2>/dev/null || true)"
            [[ "$path_real" != "$(readlink -f -- "$ancestor" 2>/dev/null || true)" ]] ||
                binary="$path_binary"
        fi
    else
        binary="$(resolve_agent_binary "$agent" save)"
        checkpoint_binary_resolution=path
    fi
    real="$(readlink -f -- "$binary" 2>/dev/null || true)"
    valid_local_binary_path "$real" ||
        die "cannot resolve the $agent binary: $binary"
    version="$("$binary" --version 2>/dev/null || printf unknown)"
    version="${version//$'\t'/ }"
    version="${version//$'\n'/ }"
    version="${version//$'\r'/ }"
    checkpoint_binary="$binary"
    checkpoint_binary_invoked="$binary"
    checkpoint_binary_real="$real"
    checkpoint_binary_version="${version:0:240}"
    checkpoint_binary_sha256="$(sha256sum "$real" | cut -d' ' -f1)"
    checkpoint_binary_os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    checkpoint_binary_arch="$(uname -m)"
    register_trusted_agent_binary "$agent" "$binary"
}

complete_binary_provenance() {
    local real version
    checkpoint_binary_invoked="${checkpoint_binary_invoked:-${checkpoint_binary:-}}"
    if [[ -z "$checkpoint_binary_invoked" ]]; then
        capture_binary_provenance "$checkpoint_agent"
        return
    fi
    checkpoint_binary="$checkpoint_binary_invoked"
    if valid_local_binary_path "$checkpoint_binary_invoked"; then
        real="$(readlink -f -- "$checkpoint_binary_invoked" 2>/dev/null || true)"
        if [[ "$real" == /* && -f "$real" ]]; then
            checkpoint_binary_real="${checkpoint_binary_real:-$real}"
            checkpoint_binary_sha256="${checkpoint_binary_sha256:-$(sha256sum "$real" | cut -d' ' -f1)}"
        fi
        if [[ -z "${checkpoint_binary_version:-}" ]]; then
            version="$("$checkpoint_binary_invoked" --version 2>/dev/null || printf unknown)"
            version="${version//$'\t'/ }"
            version="${version//$'\n'/ }"
            version="${version//$'\r'/ }"
            checkpoint_binary_version="${version:0:240}"
        fi
    fi
    checkpoint_binary_real="${checkpoint_binary_real:-unknown}"
    checkpoint_binary_version="${checkpoint_binary_version:-unknown}"
    checkpoint_binary_sha256="${checkpoint_binary_sha256:-unknown}"
    checkpoint_binary_os="${checkpoint_binary_os:-$(uname -s | tr '[:upper:]' '[:lower:]')}"
    checkpoint_binary_arch="${checkpoint_binary_arch:-$(uname -m)}"
    checkpoint_binary_resolution="${checkpoint_binary_resolution:-unknown}"
}

validate_binary_provenance() {
    local agent="$1" strict="${2:-0}"
    if [[ "$strict" == 1 ]]; then
        valid_binary_provenance_path "${checkpoint_binary_invoked:-}" ||
            die "invalid pending agent binary"
        [[ "${checkpoint_binary_real:-}" == /* &&
           "${checkpoint_binary_real:-}" != *$'\n'* &&
           "${checkpoint_binary_real:-}" != *$'\r'* &&
           "${checkpoint_binary_real:-}" != *$'\t'* ]] ||
            die "invalid pending real agent binary"
        [[ "${checkpoint_binary_sha256:-}" =~ ^[0-9a-f]{64}$ ]] ||
            die "invalid pending agent binary checksum"
    else
        [[ "${checkpoint_binary_invoked:-}" == unknown ]] ||
            valid_binary_provenance_path "${checkpoint_binary_invoked:-}" ||
            die "invalid pending agent binary"
        [[ "${checkpoint_binary_real:-}" == unknown ||
           ( "${checkpoint_binary_real:-}" == /* &&
             "${checkpoint_binary_real:-}" != *$'\n'* &&
             "${checkpoint_binary_real:-}" != *$'\r'* &&
             "${checkpoint_binary_real:-}" != *$'\t'* ) ]] ||
            die "invalid pending real agent binary"
        [[ "${checkpoint_binary_sha256:-}" == unknown ||
           "${checkpoint_binary_sha256:-}" =~ ^[0-9a-f]{64}$ ]] ||
            die "invalid pending agent binary checksum"
    fi
    [[ -n "${checkpoint_binary_version:-}" &&
       "${checkpoint_binary_version:-}" != *$'\n'* &&
       "${checkpoint_binary_version:-}" != *$'\r'* &&
       "${checkpoint_binary_version:-}" != *$'\t'* ]] ||
        die "invalid pending agent binary version"
    [[ "${checkpoint_binary_os:-}" =~ ^[A-Za-z0-9._-]+$ &&
       "${checkpoint_binary_arch:-}" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "invalid pending agent binary"
    [[ "${checkpoint_binary_resolution:-unknown}" == explicit ||
       "${checkpoint_binary_resolution:-unknown}" == ancestor ||
       "${checkpoint_binary_resolution:-unknown}" == path ||
       "${checkpoint_binary_resolution:-unknown}" == unknown ]] ||
        die "invalid pending agent binary resolution"
}

compare_binary_provenance() {
    local agent="$1" selected="$2" saved_invoked="${3:-}" saved_real="${4:-}"
    local saved_version="${5:-}" saved_sha256="${6:-}" saved_os="${7:-}" saved_arch="${8:-}"
    local selected_real selected_version selected_sha256 current_os current_arch

    current_os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    current_arch="$(uname -m)"
    [[ -z "$saved_os" || "$saved_os" == unknown || "$saved_os" == "$current_os" ]] ||
        die "saved $agent session platform is $saved_os, current platform is $current_os"
    [[ -z "$saved_arch" || "$saved_arch" == unknown || "$saved_arch" == "$current_arch" ]] ||
        die "saved $agent session architecture is $saved_arch, current architecture is $current_arch"

    selected_real="$(readlink -f -- "$selected" 2>/dev/null || true)"
    [[ "$selected_real" == /* && -f "$selected_real" && -x "$selected_real" ]] ||
        die "cannot resolve the trusted $agent binary: $selected"
    selected_version="$("$selected" --version 2>/dev/null || printf unknown)"
    selected_version="${selected_version//$'\t'/ }"
    selected_version="${selected_version//$'\n'/ }"
    selected_version="${selected_version//$'\r'/ }"
    selected_sha256="$(sha256sum "$selected_real" | cut -d' ' -f1)"

    if [[ -n "$saved_invoked" && "$saved_invoked" != unknown &&
          "$saved_invoked" != "$selected" && ! -x "$saved_invoked" ]]; then
        log "warning: saved $agent binary is unavailable: $saved_invoked"
    elif [[ -n "$saved_real" && "$saved_real" != unknown &&
            "$saved_real" != "$selected_real" ]]; then
        log "warning: using trusted local $agent binary instead of saved provenance: $selected"
    fi
    [[ -z "$saved_version" || "$saved_version" == unknown ||
       "$saved_version" == "$selected_version" ]] ||
        log "warning: saved $agent version differs: $saved_version; local: $selected_version"
    [[ -z "$saved_sha256" || "$saved_sha256" == unknown ||
       "$saved_sha256" == "$selected_sha256" ]] ||
        log "warning: saved $agent binary checksum differs from trusted local binary"
}

record_matches_checkpoint_id() {
    local record_id="$1" checkpoint_id="$2" nonce="${1%%@*}"
    [[ "$record_id" == "$checkpoint_id" ]] ||
        [[ "$record_id" == *"@$checkpoint_id" && "$nonce" =~ ^[0-9a-f]{24}$ ]]
}

local_checkpoint_id_exists() {
    local root="$1" checkpoint_id="$2" file base record_id
    [[ -d "$root" ]] || return 1
    while IFS= read -r -d '' file; do
        base="$(basename "$file")"
        record_id="${base%.checkpoint.tar.gz.age}"
        record_matches_checkpoint_id "$record_id" "$checkpoint_id" && return 0
    done < <(find "$root" -mindepth 2 -maxdepth 2 -type f -name '*.checkpoint.tar.gz.age' -print0)
    return 1
}

local_checkpoint_selector_exists() {
    local root="$1" selector="$2"
    parse_checkpoint_selector "$selector"
    if [[ -n "$checkpoint_selector_agent" ]]; then
        [[ -f "$root/$checkpoint_selector_agent/$checkpoint_selector_record_id.checkpoint.tar.gz.age" ]]
    else
        local_checkpoint_id_exists "$root" "$selector"
    fi
}

checkpoint_id_exists() {
    local target="$1" checkpoint_id="$2" pending
    if [[ -d "$state/pending" ]]; then
        while IFS= read -r -d '' pending; do
            if jq -e --arg target "$target" --arg id "$checkpoint_id" \
                '.target == $target and .checkpoint_id == $id' "$pending" >/dev/null 2>&1; then
                return 0
            fi
        done < <(find "$state/pending" -type f -name '*.json' -print0)
    fi
    local_checkpoint_id_exists "$local_checkpoints" "$checkpoint_id" && return 0
    return 1
}

find_session_file() {
    local agent="$1" id="$2" cwd project_key candidate hinted
    local -a matches=()
    validate_session_id "$id"

    case "$agent" in
        codex)
            for candidate in "$codex_home/sessions" "$codex_home/archived_sessions"; do
                [[ -d "$candidate" ]] || continue
                while IFS= read -r -d '' candidate; do matches+=("$candidate"); done \
                    < <(find "$candidate" -type f \
                        \( -name "*-$id.jsonl" -o -name "*-$id.jsonl.zst" \) -print0)
            done
            ;;
        claude)
            hinted="${AGENT_SESSION_TRANSCRIPT_PATH:-}"
            if [[ -n "$hinted" ]]; then
                validate_claude_transcript_source "$hinted" "$claude_home" "$id"
                printf '%s\n' "$hinted"
                return
            fi
            cwd="${AGENT_SESSION_CWD:-$(pwd -P)}"
            [[ "$cwd" == /* && "$cwd" != *$'\n'* && "$cwd" != *$'\r'* ]] ||
                die "invalid Claude cwd hint"
            project_key="$(claude_project_key_for_cwd "$cwd")"
            candidate="$claude_home/projects/$project_key/$id.jsonl"
            if [[ -f "$candidate" ]]; then
                validate_claude_transcript_source "$candidate" "$claude_home" "$id"
                printf '%s\n' "$candidate"
                return
            fi
            [[ -d "$claude_home/projects" ]] &&
                mapfile -d '' matches < <(find "$claude_home/projects" -type f -name "$id.jsonl" -print0)
            ;;
        *) die "agent must be codex or claude" ;;
    esac

    (( ${#matches[@]} == 1 )) ||
        die "expected one transcript for $agent/$id; found ${#matches[@]}"
    if [[ "$agent" == claude ]]; then
        validate_claude_transcript_source "${matches[0]}" "$claude_home" "$id"
    fi
    printf '%s\n' "${matches[0]}"
}

validate_claude_transcript_source() {
    local source="$1" source_home="$2" session_id="$3" source_real home_real relative
    [[ "$source" == "$source_home/projects/"* &&
       "${source##*/}" == "$session_id.jsonl" && -f "$source" && ! -L "$source" ]] ||
        die "Claude transcript is outside CLAUDE_CONFIG_DIR or does not match the session"
    relative="${source#"$source_home"/}"
    safe_artifact_path "$relative" ||
        die "Claude transcript has an unsafe native path"
    source_real="$(readlink -f -- "$source" 2>/dev/null || true)"
    home_real="$(readlink -f -- "$source_home" 2>/dev/null || true)"
    [[ "$home_real" == /* && "$source_real" == "$home_real/projects/"* ]] ||
        die "Claude transcript escapes CLAUDE_CONFIG_DIR"
}

normalize_safe_artifact_mode() {
    local mode="$1"
    [[ "$mode" =~ ^[0-7]{1,3}$ ]] || return 1
    printf '%03o\n' "$((8#$mode))"
}

validate_artifact_metadata() {
    local mode="$1" mtime="$2"
    [[ "$mode" =~ ^[0-7]{3}$ &&
       "$mtime" =~ ^(0|[1-9][0-9]{0,11})$ ]] || return 1
    (( 10#$mtime <= 253402300799 ))
}

snapshot_jsonl() {
    local source="$1" destination="$2" attempt before after raw_mode
    for attempt in {1..10}; do
        before="$(stat -c '%s:%Y:%a' "$source")"
        cp -- "$source" "$destination"
        after="$(stat -c '%s:%Y:%a' "$source")"
        if [[ "$before" == "$after" ]] && cmp -s "$source" "$destination" &&
           tail -n 1 "$destination" | jq -e . >/dev/null; then
            IFS=: read -r _ snapshot_mtime raw_mode <<< "$after"
            snapshot_mode="$(normalize_safe_artifact_mode "$raw_mode")" ||
                die "native artifact has unsafe mode bits: $source"
            validate_artifact_metadata "$snapshot_mode" "$snapshot_mtime" ||
                die "native artifact has an unsupported mtime: $source"
            return
        fi
        sleep 0.1
    done
    die "could not capture a complete JSONL prefix: $source"
}

snapshot_file() {
    local source="$1" destination="$2" attempt before after raw_mode
    for attempt in {1..10}; do
        before="$(stat -c '%s:%Y:%a' "$source")"
        cp -- "$source" "$destination"
        after="$(stat -c '%s:%Y:%a' "$source")"
        if [[ "$before" == "$after" ]] && cmp -s "$source" "$destination"; then
            IFS=: read -r _ snapshot_mtime raw_mode <<< "$after"
            snapshot_mode="$(normalize_safe_artifact_mode "$raw_mode")" ||
                die "native artifact has unsafe mode bits: $source"
            validate_artifact_metadata "$snapshot_mode" "$snapshot_mtime" ||
                die "native artifact has an unsupported mtime: $source"
            return
        fi
        sleep 0.1
    done
    die "could not capture a stable file: $source"
}

safe_artifact_path() {
    local relative="$1"
    [[ -n "$relative" && "$relative" != /* &&
       "$relative" != '..' && "$relative" != ../* &&
       "$relative" != */../* && "$relative" != */.. &&
       "$relative" != *$'\t'* && "$relative" != *$'\n'* &&
       "$relative" != *$'\r'* ]]
}

capture_artifact() {
    local payload="$1" source="$2" relative="$3" main="${4:-0}"
    local destination checksum size
    safe_artifact_path "$relative" || die "unsafe native artifact path: $relative"
    [[ -f "$source" && ! -L "$source" ]] || die "native artifact is not a regular file: $source"
    destination="$payload/artifacts/$relative"
    mkdir -p -- "$(dirname "$destination")"
    if [[ "$main" == 1 && "$relative" == *.jsonl ]]; then
        snapshot_jsonl "$source" "$destination"
    else
        snapshot_file "$source" "$destination"
    fi
    checksum="$(sha256sum "$destination" | cut -d' ' -f1)"
    size="$(stat -c %s "$destination")"
    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$checksum" "$size" "$relative" "$snapshot_mode" "$snapshot_mtime" \
        >> "$payload/artifacts.tsv"
    checkpoint_artifact_count=$((checkpoint_artifact_count + 1))
    checkpoint_artifact_size=$((checkpoint_artifact_size + size))
}

capture_artifact_tree() {
    local payload="$1" source_home="$2" tree="$3" source relative
    [[ -d "$tree" ]] || return 0
    [[ -z "$(find "$tree" ! -type d ! -type f -print -quit)" ]] ||
        die "native artifact tree contains a non-regular file: $tree"
    while IFS= read -r -d '' source; do
        relative="${source#"$source_home"/}"
        [[ "$relative" != "$source" ]] || die "native artifact is outside its home: $source"
        capture_artifact "$payload" "$source" "$relative"
    done < <(find "$tree" -type f -print0 | sort -z)
}

capture_checkpoint_artifacts() {
    local payload="$1" session_tree
    : > "$payload/artifacts.tsv"
    mkdir -p "$payload/artifacts"
    checkpoint_artifact_count=0
    checkpoint_artifact_size=0
    capture_artifact "$payload" "$checkpoint_source" "$checkpoint_relative" 1
    if [[ "$checkpoint_agent" == claude ]]; then
        session_tree="${checkpoint_source%.jsonl}"
        capture_artifact_tree "$payload" "$checkpoint_source_home" "$session_tree"
        capture_artifact_tree "$payload" "$checkpoint_source_home" \
            "$checkpoint_source_home/file-history/$checkpoint_session_id"
        capture_artifact_tree "$payload" "$checkpoint_source_home" \
            "$checkpoint_source_home/tasks/$checkpoint_session_id"
        capture_artifact_tree "$payload" "$checkpoint_source_home" \
            "$checkpoint_source_home/session-env/$checkpoint_session_id"
    fi
}

capture_ip_location() {
    local response
    checkpoint_public_ip=unknown
    checkpoint_ip_location=unknown
    checkpoint_geo_provider=ipwho.is
    [[ "${AGENT_SESSION_DISABLE_GEO:-0}" != 1 ]] || return 0
    command -v curl >/dev/null && command -v jq >/dev/null || return 0
    response="$(curl -fsS --connect-timeout 1 --max-time 3 --max-filesize 65536 \
        'https://ipwho.is/?fields=success,ip,country,region,city,latitude,longitude' 2>/dev/null)" || return 0
    checkpoint_public_ip="$(jq -er '
        select(.success == true) | .ip |
        select(type == "string" and test("^[0-9A-Fa-f:.]+$"))
    ' <<< "$response" 2>/dev/null)" || checkpoint_public_ip=unknown
    checkpoint_ip_location="$(jq -er '
        select(.success == true) |
        ([.city, .region, .country] |
            map(select(type == "string" and length > 0)) | join(", ")) as $place |
        if ((.latitude | type) == "number" and (.longitude | type) == "number")
        then "\($place) [\(.latitude), \(.longitude)]" else $place end |
        gsub("[\\t\\r\\n]"; " ") | select(length > 0 and length <= 240)
    ' <<< "$response" 2>/dev/null)" || checkpoint_ip_location=unknown
}

prepare_checkpoint() {
    local target="${1:-}" agent="${2:-}" id="${3:-}" requested_id="${4:-}"
    local description source_home destination_root record_nonce
    (( $# >= 4 )) || die "a checkpoint ID is required"
    shift 4
    description="$*"

    [[ "$target" == local ]] || die "target must be local"
    load_local_storage
    [[ "$agent" == codex || "$agent" == claude ]] || die "agent must be codex or claude"
    validate_session_id "$id"
    validate_new_checkpoint_id "$requested_id"
    need sha256sum
    validate_live_session_description "$description"

    checkpoint_source="$(find_session_file "$agent" "$id")"
    if [[ "$agent" == codex ]]; then source_home="$codex_home"; else source_home="$claude_home"; fi
    checkpoint_source_home="$source_home"
    checkpoint_relative="${checkpoint_source#"$source_home"/}"
    [[ "$checkpoint_relative" != "$checkpoint_source" ]] || die "transcript is outside its native home"

    checkpoint_target="$target"
    checkpoint_agent="$agent"
    capture_binary_provenance "$agent"
    # `ags save` runs as a child of the Agent, so this is the launch AGS itself
    # performed, inherited across `exec`. A session started outside AGS simply
    # has none, and records no arguments.
    checkpoint_launch_args="${AGS_LAUNCH_ARGS:-[]}"
    decode_launch_args "$checkpoint_launch_args" || checkpoint_launch_args='[]'
    checkpoint_session_id="$id"
    checkpoint_description="$description"
    checkpoint_id="$requested_id"
    checkpoint_created_utc="$(date -u +%FT%T.%3NZ)"
    record_nonce="$(
        printf '%s\n' "$checkpoint_created_utc" "$checkpoint_session_id" \
            "$(machine_id_fragment)" "$$" "$RANDOM" |
            sha256sum | cut -c1-24
    )"
    checkpoint_record_id="$record_nonce@$checkpoint_id"
    checkpoint_cwd="${AGENT_SESSION_CWD:-$(pwd -P)}"
    if [[ -d "$checkpoint_cwd" ]]; then
        checkpoint_cwd="$(cd -- "$checkpoint_cwd" && pwd -P)"
    fi
    [[ "$checkpoint_cwd" == /* ]] || die "PWD must be an absolute path"
    [[ "$checkpoint_cwd" != *$'\n'* && "$checkpoint_cwd" != *$'\r'* ]] ||
        die "PWD cannot contain line breaks"
    capture_ip_location
    if [[ "$target" == local ]]; then destination_root="$local_checkpoints"; else destination_root="$cloud_url"; fi
    checkpoint_destination_root="$destination_root"
    checkpoint_destination="$destination_root/$agent/$checkpoint_record_id.checkpoint.tar.gz.age"
}

write_checkpoint_archive() {
    local tmp payload recipient archive manifest_archive partial count destination_root
    local main_artifact source_size source_sha256 artifact_index_sha256

    need age; need cmp; need flock; need head; need jq; need readlink; need sha256sum; need ssh-keygen; need tar
    load_encryption_identity
    [[ "$checkpoint_target" == local || "$checkpoint_target" == cloud ]] || die "invalid pending target"
    [[ "$checkpoint_agent" == codex || "$checkpoint_agent" == claude ]] || die "invalid pending agent"
    complete_binary_provenance
    validate_binary_provenance "$checkpoint_agent" 1
    validate_session_id "$checkpoint_session_id"
    validate_checkpoint_id "$checkpoint_id"
    validate_checkpoint_id "$checkpoint_record_id"
    record_matches_checkpoint_id "$checkpoint_record_id" "$checkpoint_id" ||
        die "checkpoint record does not match its ID"
    live_session_description_valid "$checkpoint_description" ||
        die "invalid pending description"
    [[ -n "${checkpoint_created_utc:-}" && "$checkpoint_created_utc" != *$'\n'* &&
       "$checkpoint_created_utc" != *$'\r'* && "$checkpoint_created_utc" != *$'\t'* ]] ||
        die "invalid checkpoint creation time"
    [[ -f "$checkpoint_source" ]] || die "transcript not found: $checkpoint_source"
    [[ "$checkpoint_source_home" == /* && "$checkpoint_source_home" != / ]] ||
        die "invalid pending native home"
    [[ "$checkpoint_source" == "$checkpoint_source_home/"* && "$checkpoint_relative" == "${checkpoint_source#"$checkpoint_source_home"/}" ]] ||
        die "pending transcript path mismatch"
    destination_root="${checkpoint_destination_root:-}"
    if [[ "$checkpoint_target" == local ]]; then
        if [[ -z "$destination_root" ]]; then load_local_storage; destination_root="$local_checkpoints"; fi
        [[ "$destination_root" == /* ]] || die "invalid local checkpoint destination root"
        checkpoint_destination="$destination_root/$checkpoint_agent/$checkpoint_record_id.checkpoint.tar.gz.age"
    else
        load_cloud_storage
        [[ -z "$destination_root" || "$destination_root" == "$cloud_url" ]] ||
            die "cloud configuration changed while checkpoint was pending"
        destination_root="$cloud_url"
        checkpoint_destination="$cloud_url/$checkpoint_agent/$checkpoint_record_id.checkpoint.tar.gz.age"
    fi

    lock
    if [[ "$checkpoint_target" == local ]]; then
        lock_checkpoint_root "$destination_root"
        if local_checkpoint_id_exists "$destination_root" "$checkpoint_id"; then
            die "checkpoint ID already exists for local storage: $checkpoint_id"
        fi
    fi
    tmp="$(mktemp -d "$state/save.XXXXXX")"
    trap_cleanup_dirs "$tmp"
    payload="$tmp/payload"
    mkdir -p "$payload"
    capture_checkpoint_artifacts "$payload"
    main_artifact="$payload/artifacts/$checkpoint_relative"
    source_size="$(stat -c %s "$main_artifact")"
    source_sha256="$(sha256sum "$main_artifact" | cut -d' ' -f1)"
    artifact_index_sha256="$(sha256sum "$payload/artifacts.tsv" | cut -d' ' -f1)"
    if [[ "$checkpoint_relative" == *.jsonl ]]; then
        count="$(wc -l < "$main_artifact")"
    else
        count=
    fi
    {
        printf 'format=4\nkind=checkpoint\ncheckpoint_id=%s\nrecord_id=%s\n' \
            "$checkpoint_id" "$checkpoint_record_id"
        printf 'description=%s\ncreated_utc=%s\ntarget=%s\n' \
            "$checkpoint_description" "$checkpoint_created_utc" "$checkpoint_target"
        printf 'agent=%s\nagent_binary=%s\nsession_id=%s\nrelative_path=%s\n' \
            "$checkpoint_agent" "$checkpoint_binary_invoked" "$checkpoint_session_id" "$checkpoint_relative"
        printf 'binary_invoked_path=%s\nbinary_real_path=%s\nbinary_version=%s\nbinary_resolution=%s\n' \
            "$checkpoint_binary_invoked" "$checkpoint_binary_real" \
            "$checkpoint_binary_version" "$checkpoint_binary_resolution"
        printf 'binary_sha256=%s\nbinary_os=%s\nbinary_arch=%s\n' \
            "$checkpoint_binary_sha256" "$checkpoint_binary_os" "$checkpoint_binary_arch"
        printf 'cwd=%s\nsource_size=%s\nsource_sha256=%s\n' \
            "$checkpoint_cwd" "$source_size" "$source_sha256"
        printf 'capture_fidelity=full\nartifact_metadata=mode-mtime-v1\n'
        printf 'artifact_count=%s\nartifact_size=%s\nartifact_index_sha256=%s\n' \
            "$checkpoint_artifact_count" "$checkpoint_artifact_size" "$artifact_index_sha256"
        printf 'public_ip=%s\nip_location=%s\ngeo_provider=%s\n' \
            "$checkpoint_public_ip" "$checkpoint_ip_location" "$checkpoint_geo_provider"
        # Deliberately not a `format` bump. Every reader here pulls fields with
        # `sed -n 's/^key=//p'`, so an older AGS ignores this line and resumes
        # exactly as it does today, while a newer AGS reading an older record
        # finds no line and also resumes as it does today. Raising `format` to 5
        # would instead make every machine that has not updated yet reject these
        # checkpoints outright at the format gate, and these records synchronize.
        printf 'launch_args=%s\n' "${checkpoint_launch_args:-[]}"
        printf 'device_id=%s\ncli_version=%s\n' \
            "$(hostname -s)-$(machine_id_fragment)" \
            "$checkpoint_binary_version"
    } > "$payload/manifest"

    recipient="$tmp/recipient.pub"
    write_age_recipient_file "$recipient"
    archive="$tmp/checkpoint.age"
    tar -C "$payload" -czf - manifest artifacts.tsv artifacts | age -R "$recipient" -o "$archive"
    mkdir -p "$(dirname "$checkpoint_destination")"
    partial="$checkpoint_destination.partial.$(machine_id_fragment).$$.$RANDOM"
    cp -- "$archive" "$partial"
    if ! ln -- "$partial" "$checkpoint_destination"; then
        rm -f -- "$partial"
        die "checkpoint ID already exists for local storage: $checkpoint_id"
    fi
    rm -f -- "$partial"
    unlock_checkpoint_root
    unlock
    rm -rf -- "$tmp"
    trap - EXIT
    checkpoint_lines="$count"
}

print_checkpoint() {
    local status="$1"
    printf 'status=%s\ncheckpoint_id=%s\nrecord_id=%s\ndescription=%s\ncreated_utc=%s\ntarget=%s\nagent=%s\nagent_binary=%s\nbinary_resolution=%s\nsession_id=%s\npwd=%s\npublic_ip=%s\nip_location=%s\npath=%s\n' \
        "$status" "$checkpoint_id" "$checkpoint_record_id" "$checkpoint_description" "$checkpoint_created_utc" \
        "$checkpoint_target" "$checkpoint_agent" "$checkpoint_binary" \
        "$checkpoint_binary_resolution" "$checkpoint_session_id" \
        "$checkpoint_cwd" "$checkpoint_public_ip" \
        "$checkpoint_ip_location" "$checkpoint_destination"
    [[ -z "${checkpoint_lines:-}" ]] || printf 'lines=%s\n' "$checkpoint_lines"
}

auto_sync_storage_mode() {
    local mode="${1:-local}" checkpoint_root="${2:-}" remote_name
    [[ "$mode" != local ]] || return 0
    resolve_storage_mode "$mode"
    [[ "$resolved_storage_mode" == remote:* ]] ||
        die "automatic synchronization requires a named remote"
    remote_name="${resolved_storage_mode#remote:}"
    log "Updating $(storage_mode_label "$resolved_storage_mode")"
    (
        if [[ -n "$checkpoint_root" ]]; then
            export AGENT_SESSION_LOCAL_DIR="$checkpoint_root"
        fi
        sync_records sync "$remote_name"
    )
}

default_storage_mode() {
    local requested="${AGENT_SESSION_STORAGE_MODE:-}"
    local -a modes=()
    if [[ -n "$requested" ]]; then
        resolve_storage_mode "$requested"
        printf '%s\n' "$resolved_storage_mode"
        return
    fi
    mapfile -t modes < <(configured_storage_modes)
    (( ${#modes[@]} > 0 )) ||
        die "no storage configured; run ags init"
    printf '%s\n' "${modes[0]}"
}

queue_storage_sync_retry() {
    local mode="$1" reason="$2" identifier pending temporary remote_name created
    [[ "$mode" == remote:* ]] ||
        die "only named remotes can have a pending synchronization"
    resolve_storage_mode "$mode"
    mode="$resolved_storage_mode"
    [[ "$mode" == remote:* ]] ||
        die "pending synchronization no longer resolves to a named remote"
    remote_name="${mode#remote:}"
    lock_storage_consolidation
    lock_remote_operation "$remote_name"
    resolve_storage_mode "$mode"
    mode="$resolved_storage_mode"
    [[ "$mode" == "remote:$remote_name" ]] ||
        die "storage routing changed while queuing a synchronization retry"
    identifier="$(
        printf '%s' "$mode" | sha256sum | cut -d' ' -f1
    )" || die "cannot identify the pending synchronization"
    pending="$state/pending-sync/$identifier.json"
    temporary="$pending.tmp.$$"
    created="$(date -u +%FT%T.%3NZ)" ||
        die "cannot timestamp the pending synchronization"
    lock
    mkdir -p "${pending%/*}" ||
        die "cannot create pending synchronization directory"
    if ! jq -n --arg mode "$mode" --arg reason "$reason" \
        --arg created "$created" '{
          schema:1,
          storage_mode:$mode,
          reason:$reason,
          created_utc:$created
        }' > "$temporary"; then
        rm -f -- "$temporary" 2>/dev/null || true
        die "cannot stage pending synchronization"
    fi
    if ! chmod 600 "$temporary" || ! mv -- "$temporary" "$pending"; then
        rm -f -- "$temporary" 2>/dev/null || true
        die "cannot publish pending synchronization"
    fi
    unlock
    unlock_remote_operation
    unlock_storage_consolidation
    printf '%s\n' "$pending"
}

flush_pending_storage_syncs() {
    local pending mode sync_status failed=0
    local restore_errexit=0
    [[ "$-" == *e* ]] && restore_errexit=1
    [[ -d "$state/pending-sync" ]] || return 0
    # A successful sync and removal of the retry record are one storage
    # transaction. Otherwise a concurrent failed save/delete can replace the
    # same per-remote retry file after the sync and have its new retry removed.
    lock_storage_consolidation
    while IFS= read -r -d '' pending; do
        [[ -f "$pending" && ! -L "$pending" ]] || continue
        mode="$(jq -er '
            select(.schema == 1) |
            .storage_mode |
            select(type == "string" and startswith("remote:"))
        ' "$pending" 2>/dev/null)" || {
            log "invalid pending storage sync retained: $pending"
            failed=1
            continue
        }
        # Do not put auto_sync_storage_mode directly in an if/|| condition.
        # Bash otherwise disables errexit throughout its nested function calls,
        # which can turn a failed synchronization into a false success.
        set +e
        (
            set -e
            auto_sync_storage_mode "$mode"
        )
        sync_status=$?
        if (( restore_errexit == 1 )); then set -e; else set +e; fi
        if (( sync_status == 0 )); then
            if ! rm -f -- "$pending"; then
                log "synchronized retry could not be acknowledged: $pending"
                failed=1
            fi
        else
            log "pending storage sync retained: $pending"
            failed=1
        fi
    done < <(find "$state/pending-sync" -type f -name '*.json' -print0)
    unlock_storage_consolidation
    return "$failed"
}

verify_existing_pending_archive() {
    local expected_digest="${1:-}" manifest actual_digest
    [[ "$checkpoint_target" == local ]] ||
        die "only local pending archives can be retried after publication"
    checkpoint_destination="$checkpoint_destination_root/$checkpoint_agent/$checkpoint_record_id.checkpoint.tar.gz.age"
    [[ -f "$checkpoint_destination" && ! -L "$checkpoint_destination" ]] ||
        die "pending checkpoint archive is missing: $checkpoint_destination"
    actual_digest="$(sha256sum "$checkpoint_destination" | cut -d' ' -f1)"
    [[ -z "$expected_digest" || "$actual_digest" == "$expected_digest" ]] ||
        die "pending checkpoint archive changed after publication"
    manifest="$(age_decrypt "$checkpoint_destination" | tar -xzOf - manifest)" ||
        die "cannot verify the published pending checkpoint"
    [[ "$(sed -n 's/^checkpoint_id=//p' <<< "$manifest")" == "$checkpoint_id" &&
       "$(sed -n 's/^record_id=//p' <<< "$manifest")" == "$checkpoint_record_id" &&
       "$(sed -n 's/^agent=//p' <<< "$manifest")" == "$checkpoint_agent" &&
       "$(sed -n 's/^session_id=//p' <<< "$manifest")" == "$checkpoint_session_id" ]] ||
        die "published archive does not match its pending checkpoint"
    checkpoint_archive_sha256="$actual_digest"
}

mark_pending_archived() {
    local pending="$1" temporary archive_digest
    archive_digest="$(sha256sum "$checkpoint_destination" | cut -d' ' -f1)"
    temporary="$pending.tmp.$$"
    jq --arg path "$checkpoint_destination" --arg digest "$archive_digest" '
        .archived = true |
        .archive_path = $path |
        .archive_sha256 = $digest
    ' "$pending" > "$temporary"
    chmod 600 "$temporary"
    mv -- "$temporary" "$pending"
}

save_checkpoint() {
    local storage_mode="${AGENT_SESSION_STORAGE_MODE:-local}"
    lock_storage_consolidation
    prepare_checkpoint "$@"
    if [[ "$checkpoint_target" == local ]]; then
        resolve_storage_mode "$storage_mode"
        storage_mode="$resolved_storage_mode"
    fi
    if checkpoint_id_exists "$checkpoint_target" "$checkpoint_id"; then
        die "checkpoint ID already exists for $checkpoint_target storage: $checkpoint_id"
    fi
    write_checkpoint_archive
    if [[ "$checkpoint_target" == local ]]; then
        auto_sync_storage_mode "$storage_mode" "$checkpoint_destination_root"
    fi
    print_checkpoint saved
    [[ "$checkpoint_target" != local ]] ||
        printf 'storage_mode=%s\n' "$storage_mode"
    unlock_storage_consolidation
}

queue_checkpoint() {
    local pending pending_tmp storage_mode="${AGENT_SESSION_STORAGE_MODE:-local}"
    need flock; need jq
    lock_storage_consolidation
    load_encryption_identity
    prepare_checkpoint "$@"
    if [[ "$checkpoint_target" == local ]]; then
        resolve_storage_mode "$storage_mode"
        storage_mode="$resolved_storage_mode"
    else
        storage_mode=local
    fi
    lock
    if [[ "$checkpoint_target" == local ]]; then
        # Close the race with a concurrent retirement marker written after the
        # first resolution but before this pending transaction acquired lock.
        resolve_storage_mode "$storage_mode"
        storage_mode="$resolved_storage_mode"
    fi
    if checkpoint_id_exists "$checkpoint_target" "$checkpoint_id"; then
        die "checkpoint ID already exists for $checkpoint_target storage: $checkpoint_id"
    fi
    pending="$state/pending/$checkpoint_agent/$checkpoint_session_id/$checkpoint_record_id.json"
    [[ ! -e "$pending" ]] || die "checkpoint is already pending: $checkpoint_id"
    mkdir -p "$(dirname "$pending")"
    pending_tmp="$pending.tmp.$$"
    jq -n \
        --arg target "$checkpoint_target" --arg agent "$checkpoint_agent" \
        --arg agent_binary "$checkpoint_binary" \
        --arg binary_invoked_path "$checkpoint_binary_invoked" \
        --arg binary_real_path "$checkpoint_binary_real" \
        --arg binary_version "$checkpoint_binary_version" \
        --arg binary_resolution "$checkpoint_binary_resolution" \
        --arg binary_sha256 "$checkpoint_binary_sha256" \
        --arg binary_os "$checkpoint_binary_os" --arg binary_arch "$checkpoint_binary_arch" \
        --arg session_id "$checkpoint_session_id" --arg description "$checkpoint_description" \
        --arg checkpoint_id "$checkpoint_id" --arg record_id "$checkpoint_record_id" \
        --arg created_utc "$checkpoint_created_utc" \
        --arg source "$checkpoint_source" \
        --arg source_home "$checkpoint_source_home" --arg relative "$checkpoint_relative" \
        --arg destination_root "$checkpoint_destination_root" \
        --arg cwd "$checkpoint_cwd" --arg public_ip "$checkpoint_public_ip" \
        --arg ip_location "$checkpoint_ip_location" --arg geo_provider "$checkpoint_geo_provider" \
        --arg storage_mode "$storage_mode" \
        --argjson launch_args "$checkpoint_launch_args" \
        '{target:$target,agent:$agent,agent_binary:$agent_binary,binary_invoked_path:$binary_invoked_path,binary_real_path:$binary_real_path,binary_version:$binary_version,binary_resolution:$binary_resolution,binary_sha256:$binary_sha256,binary_os:$binary_os,binary_arch:$binary_arch,session_id:$session_id,description:$description,checkpoint_id:$checkpoint_id,record_id:$record_id,created_utc:$created_utc,source:$source,source_home:$source_home,relative:$relative,destination_root:$destination_root,cwd:$cwd,public_ip:$public_ip,ip_location:$ip_location,geo_provider:$geo_provider,storage_mode:$storage_mode,launch_args:$launch_args,archived:false}' \
        > "$pending_tmp"
    mv -- "$pending_tmp" "$pending"
    unlock
    print_checkpoint pending
    [[ "$checkpoint_target" != local ]] ||
        printf 'storage_mode=%s\n' "$storage_mode"
    unlock_storage_consolidation
}

finalize_pending_file() {
    local pending="$1" hook_transcript="${2:-}" hook_cwd="${3:-}"
    local storage_mode archived archive_digest
    lock_storage_consolidation
    checkpoint_target="$(jq -er .target "$pending")"
    checkpoint_agent="$(jq -er .agent "$pending")"
    checkpoint_binary="$(jq -r '.agent_binary // empty' "$pending")"
    checkpoint_binary_invoked="$(jq -r '.binary_invoked_path // .agent_binary // empty' "$pending")"
    checkpoint_binary_real="$(jq -r '.binary_real_path // empty' "$pending")"
    checkpoint_binary_version="$(jq -r '.binary_version // empty' "$pending")"
    checkpoint_binary_resolution="$(jq -r '.binary_resolution // "unknown"' "$pending")"
    checkpoint_binary_sha256="$(jq -r '.binary_sha256 // empty' "$pending")"
    checkpoint_binary_os="$(jq -r '.binary_os // empty' "$pending")"
    checkpoint_binary_arch="$(jq -r '.binary_arch // empty' "$pending")"
    checkpoint_session_id="$(jq -er .session_id "$pending")"
    checkpoint_description="$(jq -er .description "$pending")"
    checkpoint_id="$(jq -er .checkpoint_id "$pending")"
    checkpoint_record_id="$(jq -r '.record_id // .checkpoint_id' "$pending")"
    checkpoint_created_utc="$(jq -r '.created_utc // empty' "$pending")"
    [[ -n "$checkpoint_created_utc" ]] || checkpoint_created_utc="$(date -u +%FT%T.%3NZ)"
    checkpoint_source="$(jq -er .source "$pending")"
    checkpoint_source_home="$(jq -er .source_home "$pending")"
    checkpoint_relative="$(jq -er .relative "$pending")"
    checkpoint_destination_root="$(jq -r '.destination_root // empty' "$pending")"
    checkpoint_cwd="$(jq -er .cwd "$pending")"
    checkpoint_public_ip="$(jq -r '.public_ip // "unknown"' "$pending")"
    checkpoint_ip_location="$(jq -r '.ip_location // "unknown"' "$pending")"
    checkpoint_geo_provider="$(jq -r '.geo_provider // "unknown"' "$pending")"
    checkpoint_launch_args="$(jq -c '.launch_args // []' "$pending")"
    decode_launch_args "$checkpoint_launch_args" || checkpoint_launch_args='[]'
    storage_mode="$(jq -r '.storage_mode // "local"' "$pending")"
    archived="$(jq -r '(.archived // false) | select(type == "boolean")' "$pending")" ||
        die "pending checkpoint has an invalid archive state"
    if [[ "$checkpoint_agent" == claude && -n "$hook_transcript" ]]; then
        validate_claude_transcript_source "$hook_transcript" \
            "$checkpoint_source_home" "$checkpoint_session_id"
        checkpoint_source="$hook_transcript"
        checkpoint_relative="${hook_transcript#"$checkpoint_source_home"/}"
        if [[ -n "$hook_cwd" ]]; then
            [[ "$hook_cwd" == /* && -d "$hook_cwd" &&
               "$hook_cwd" != *$'\n'* && "$hook_cwd" != *$'\r'* ]] ||
                die "Claude hook supplied an invalid cwd"
            checkpoint_cwd="$(cd -- "$hook_cwd" && pwd -P)"
        fi
    fi
    checkpoint_lines=""
    if [[ "$checkpoint_target" == local ]]; then
        resolve_storage_mode "$storage_mode"
        storage_mode="$resolved_storage_mode"
        archive_digest="$(jq -r '.archive_sha256 // empty' "$pending")"
        if [[ "$archived" == true ]]; then
            [[ "$archive_digest" =~ ^[0-9a-f]{64}$ ]] ||
                die "pending checkpoint has an invalid archive digest"
            verify_existing_pending_archive "$archive_digest"
        elif [[ -f "$checkpoint_destination_root/$checkpoint_agent/$checkpoint_record_id.checkpoint.tar.gz.age" ]]; then
            verify_existing_pending_archive
            mark_pending_archived "$pending"
        else
            write_checkpoint_archive
            mark_pending_archived "$pending"
        fi
        auto_sync_storage_mode "$storage_mode" "$checkpoint_destination_root"
    else
        write_checkpoint_archive
    fi
    rm -f -- "$pending"
    unlock_storage_consolidation
}

save_active_checkpoint() {
    local target="${1:-}" agent="${AGENT_SESSION_AGENT:-}" session_id="${AGENT_SESSION_ID:-}"
    local selected_provider selected_session_id
    shift || true
    [[ "$target" == local || "$target" == cloud ]] || die "target must be local or cloud"
    # 明确点名一个会话。这是 `ags ls` 里按 s 走的同一条路，也是在任何地方导出一个
    # 早就结束了的会话的方式——`ags save` 以前只认「AGS 起的、此刻正在跑的」那个，
    # 而列表里的会话绝大多数两条都不满足。
    if [[ "${1:-}" == --session ]]; then
        (( $# >= 2 )) || die "--session 需要 <provider>/<session_id>"
        split_live_selector "live:$2"
        shift 2
        save_live_session "$selected_provider" "$selected_session_id" "$*"
        return
    fi
    # 会话 ID 在**启动时**就定好了（见 `prepare_session_identity`），所以在一个 AGS
    # 起的会话里保存只需要给描述：`ags save "描述"`。
    #
    #   ags save "描述"              ID 用这个会话自己的
    #   ags save --id 别的名字 "描述"  显式换一个（分支一条新工作线）
    #   ags save <ID> "描述"          只在**没有** AGS_ID 时有效，即这个会话不是
    #                                 AGS 起的——那种会话没有自己的 ID 可用
    #
    # 刻意**不去猜**第一个参数是 ID 还是描述。猜过一版："长得像 ID 就当 ID"，于是
    # `ags save "fixed"` 这种单词英文描述被当成了 ID，描述变空，报出来的却是
    # "description must be 1-80 characters"——人明明给了描述。判据一旦是启发式的，
    # 错的那一侧就总会有人踩到。
    if [[ -n "${AGS_ID:-}" ]]; then
        if [[ "${1:-}" == --id ]]; then
            (( $# >= 2 )) || die "--id 需要一个会话 ID"
            shift
        else
            set -- "$AGS_ID" "$@"
        fi
    fi
    if [[ -z "$agent" || -z "$session_id" ]]; then
        if [[ -n "${CODEX_THREAD_ID:-}" ]]; then
            agent=codex session_id="$CODEX_THREAD_ID"
        elif [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
            agent=claude session_id="$CLAUDE_CODE_SESSION_ID"
        else
            die "save 需要知道存哪个会话：在 AGS 起的会话里直接 \`ags save 描述\`，在外面用 \`ags save --session <provider>/<id> 描述\`，或从 \`ags ls\` 里按 s"
        fi
    fi
    queue_checkpoint "$target" "$agent" "$session_id" "$@"
}

flush_pending() {
    local session_filter="${1:-}" hook_transcript="${2:-}" hook_cwd="${3:-}"
    local pending pending_session finalize_status sync_status failed=0
    local restore_errexit=0
    [[ "$-" == *e* ]] && restore_errexit=1
    if [[ -d "$state/pending" ]]; then
        while IFS= read -r -d '' pending; do
            pending_session="$(jq -r .session_id "$pending" 2>/dev/null || true)"
            [[ -z "$session_filter" ||
               "$pending_session" == "$session_filter" ]] || continue
            # A function invoked directly by if/|| runs with errexit ignored
            # throughout its entire call tree. Capture the status outside that
            # conditional context so an archive or manifest failure stops the
            # transaction before the pending record is acknowledged.
            set +e
            (
                set -e
                finalize_pending_file \
                    "$pending" "$hook_transcript" "$hook_cwd" >/dev/null
            )
            finalize_status=$?
            if (( restore_errexit == 1 )); then set -e; else set +e; fi
            if (( finalize_status != 0 )); then
                log "pending checkpoint retained: $pending"
                failed=1
            fi
        done < <(find "$state/pending" -type f -name '*.json' -print0)
    fi
    set +e
    flush_pending_storage_syncs
    sync_status=$?
    if (( restore_errexit == 1 )); then set -e; else set +e; fi
    (( sync_status == 0 )) || failed=1
    return "$failed"
}

run_hook() {
    local hook_status
    # Agent lifecycle hooks must never block the Agent. Parse and flush in an
    # isolated shell so both ordinary failures and die()'s explicit exit stay
    # contained. The child is deliberately not an if/|| condition: that would
    # suppress errexit throughout the transaction call tree.
    set +e
    (
        local input event session_id transcript_path hook_cwd
        set -e
        input="$(cat)"
        event="$(jq -r '.hook_event_name // empty' <<< "$input")"
        session_id="$(jq -r '.session_id // empty' <<< "$input")"
        transcript_path="$(jq -r '.transcript_path // empty' <<< "$input")"
        hook_cwd="$(jq -r '.cwd // empty' <<< "$input")"
        case "$event" in
            Stop) flush_pending "$session_id" "$transcript_path" "$hook_cwd" ;;
            SessionStart) flush_pending ;;
        esac
    )
    hook_status=$?
    set -e
    if (( hook_status != 0 )); then
        log "warning: hook processing failed; pending work was left for retry"
    fi
    return 0
}

push_sessions() {
    local tmp payload recipient archive partial host_id count

    need age; need flock; need jq; need pgrep; need rsync; need ssh-keygen; need tar
    load_encryption_identity
    if pgrep -u "$(id -u)" -x codex >/dev/null || pgrep -u "$(id -u)" -x claude >/dev/null; then
        die "Codex or Claude is still running; exit it before taking a snapshot"
    fi

    lock
    tmp="$(mktemp -d "$state/push.XXXXXX")"
    trap_cleanup_dirs "$tmp"
    payload="$tmp/payload"
    mkdir -p "$payload"

    copy_jsonl_tree "$codex_home/sessions" "$payload/codex/sessions"
    copy_jsonl_tree "$codex_home/archived_sessions" "$payload/codex/archived_sessions"
    copy_jsonl_tree "$claude_home/projects" "$payload/claude/projects"
    count="$(validate_jsonl "$payload")"

    host_id="$(hostname -s)-$(machine_id_fragment)"
    {
        printf 'format=1\ncreated_utc=%s\nhost_id=%s\n' "$(date -u +%FT%TZ)" "$host_id"
        printf 'codex_version=%s\n' "$(codex --version 2>/dev/null || printf unknown)"
        printf 'claude_version=%s\n' "$(claude --version 2>/dev/null || printf unknown)"
    } > "$payload/manifest"

    recipient="$tmp/recipient.pub"
    write_age_recipient_file "$recipient"
    archive="$tmp/$host_id.sessions.tar.gz.age"
    tar -C "$payload" -czf - . | age -R "$recipient" -o "$archive"

    mkdir -p "$store"
    partial="$store/.$host_id.partial.$$"
    cp -- "$archive" "$partial"
    mv -f -- "$partial" "$store/$host_id.sessions.tar.gz.age"
    rm -rf -- "$tmp"
    trap - EXIT
    log "pushed $count sessions -> $store/$host_id.sessions.tar.gz.age"
}

validate_tar() {
    local archive="$1" entry line
    tar -tzf "$archive" >/dev/null
    while IFS= read -r entry; do
        case "$entry" in
            ''|'..'|../*|/*|*/../*|*/..) die "unsafe archive path: $entry" ;;
        esac
    done < <(tar -tzf "$archive")
    while IFS= read -r line; do
        case "${line:0:1}" in -|d) ;; *) die "archive contains a link or special file" ;; esac
    done < <(tar -tvzf "$archive")
}

path_owner_mode() {
    local path="$1"
    stat -c '%u %a' -- "$path" 2>/dev/null && return 0
    stat -f '%u %Lp' -- "$path" 2>/dev/null
}

# 还原路径上的一级目录：不是符号链接就原样返回，是的话解析并按 StrictModes 判。
#
# 允许链接本身，是因为把两个 `CODEX_HOME` 的 `sessions` 指到同一份是正当用法
# （共用一份会话历史）。但**解析之后**的目录必须归当前用户所有、且组和其他人都
# 不可写——否则别人改一下那个目录就能把还原写到任意位置，而那正是当初一律拒绝
# 符号链接要防的事。规则和 ssh 对 `authorized_keys` 的 StrictModes 同一套。
#
# 代价说清楚：解析和写入之间存在 TOCTOU 窗口，一律拒绝符号链接是**没有**这个
# 窗口的。换来的是这个用法能成立。
resolve_restore_component() {
    local path="$1" resolved owner mode
    if [[ ! -L "$path" ]]; then
        printf '%s\n' "$path"
        return 0
    fi
    resolved="$(readlink -f -- "$path" 2>/dev/null)" || {
        log "restore destination has an unresolvable symbolic link: $path"
        return 1
    }
    [[ -d "$resolved" ]] || {
        log "restore destination link does not lead to a directory: $path -> $resolved"
        return 1
    }
    read -r owner mode < <(path_owner_mode "$resolved") || {
        log "cannot inspect restore destination link target: $resolved"
        return 1
    }
    [[ "$owner" == "$(id -u)" ]] || {
        log "restore destination link target is not owned by this user: $resolved"
        return 1
    }
    (( (8#$mode & 8#022) == 0 )) || {
        log "restore destination link target is writable by others: $resolved ($mode)"
        return 1
    }
    printf '%s\n' "$resolved"
}

validate_restore_destination() {
    local root="$1" destination="$2" parent component current=/
    local -a components=()
    [[ "$root" == /* && "$root" != / && "$destination" == "$root/"* ]] || {
        log "restore destination escapes its canonical native home: $destination"
        return 1
    }
    parent="${destination%/*}"
    IFS=/ read -ra components <<< "${parent#/}"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        if [[ "$current" == / ]]; then
            current="/$component"
        else
            current="$current/$component"
        fi
        current="$(resolve_restore_component "$current")" || return 1
        if [[ -e "$current" && ! -d "$current" ]]; then
            log "restore destination has a non-directory ancestor: $current"
            return 1
        fi
    done
}

canonical_native_home() {
    local requested="$1" canonical
    [[ "$requested" == /* && "$requested" != / &&
       "$requested" != *$'\t'* && "$requested" != *$'\n'* &&
       "$requested" != *$'\r'* ]] || {
        log "invalid native home for restore: $requested"
        return 1
    }
    canonical="$(readlink -m -- "$requested")" || return 1
    [[ "$canonical" == /* && "$canonical" != / ]] || return 1
    [[ ! -e "$canonical" || -d "$canonical" ]] || {
        log "native home is not a directory: $canonical"
        return 1
    }
    printf '%s\n' "$canonical"
}

process_is_current_user_agent() {
    local pid="$1" agent="$2" expected_uid="$3" status process_uid process_name
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    if [[ -r "/proc/$pid/status" ]]; then
        status="$(<"/proc/$pid/status")"
        process_uid="$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<< "$status")"
        process_name="$(sed -n 's/^Name:[[:space:]]*//p' <<< "$status")"
    elif [[ "$platform" == Darwin ]]; then
        process_uid="$(ps -o uid= -p "$pid" 2>/dev/null | tr -d '[:space:]')"
        process_name="$(ps -o comm= -p "$pid" 2>/dev/null || true)"
        process_name="${process_name#"${process_name%%[![:space:]]*}"}"
        process_name="${process_name%"${process_name##*[![:space:]]}"}"
        process_name="${process_name##*/}"
    else
        return 1
    fi
    [[ "$process_uid" == "$expected_uid" && "$process_name" == "$agent" ]]
}

process_start_time() {
    local pid="$1" stat
    local -a fields=()
    if [[ -r "/proc/$pid/stat" ]]; then
        IFS= read -r stat < "/proc/$pid/stat" || return 1
        read -ra fields <<< "${stat##*) }"
        (( ${#fields[@]} >= 20 )) && [[ "${fields[19]}" =~ ^[0-9]+$ ]] || return 1
        printf '%s\n' "${fields[19]}"
    elif [[ "$platform" == Darwin ]]; then
        LC_ALL=C TZ=UTC ps -o lstart= -p "$pid" 2>/dev/null |
            sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
            grep -E '.'
    else
        return 1
    fi
}

codex_session_path_matches() {
    local native_home="$1" session_id="$2" target="$3" relative filename
    target="${target% (deleted)}"
    [[ "$target" == "$native_home/"* ]] || return 1
    relative="${target#"$native_home"/}"
    case "$relative" in
        sessions/*|archived_sessions/*)
            filename="${relative##*/}"
            [[ "$filename" == *-"$session_id".jsonl ||
               "$filename" == *-"$session_id".jsonl.zst ]]
            ;;
        *) return 1 ;;
    esac
}

active_native_session_pid() {
    local agent="$1" native_home="$2" session_id="$3"
    local current_uid process_dir pid fd target relative filename registry start_time
    current_uid="$(id -u)"
    case "$agent" in
        codex)
            if [[ "$platform" == Linux ]]; then
                for process_dir in /proc/[0-9]*; do
                    pid="${process_dir##*/}"
                    process_is_current_user_agent "$pid" codex "$current_uid" || continue
                    for fd in "$process_dir"/fd/*; do
                        target="$(readlink -- "$fd" 2>/dev/null || true)"
                        if codex_session_path_matches "$native_home" "$session_id" "$target"; then
                            printf '%s\n' "$pid"
                            return 0
                        fi
                    done
                done
            else
                need lsof
                while IFS= read -r pid; do
                    process_is_current_user_agent "$pid" codex "$current_uid" || continue
                    while IFS= read -r target; do
                        if codex_session_path_matches "$native_home" "$session_id" "$target"; then
                            printf '%s\n' "$pid"
                            return 0
                        fi
                    done < <(
                        lsof -a -p "$pid" -Fn 2>/dev/null |
                            sed -n 's/^n//p' || true
                    )
                done < <(pgrep -u "$current_uid" -x codex 2>/dev/null || true)
            fi
            ;;
        claude)
            [[ -d "$native_home/sessions" && ! -L "$native_home/sessions" ]] || return 1
            for registry in "$native_home"/sessions/[0-9]*.json; do
                [[ -f "$registry" && ! -L "$registry" ]] || continue
                pid="${registry##*/}"
                pid="${pid%.json}"
                process_is_current_user_agent "$pid" claude "$current_uid" || continue
                start_time="$(process_start_time "$pid")" || continue
                jq -e --argjson pid "$pid" --arg session_id "$session_id" \
                    --arg start_time "$start_time" '
                    type == "object" and
                    (.pid | type) == "number" and
                    (.procStart | type) == "string" and
                    (.sessionId | type) == "string" and
                    .pid == $pid and .pid == (.pid | floor) and
                    .sessionId == $session_id and
                    .procStart == $start_time
                ' "$registry" >/dev/null 2>&1 || continue
                process_is_current_user_agent "$pid" claude "$current_uid" || continue
                [[ "$(process_start_time "$pid" 2>/dev/null || true)" == "$start_time" ]] ||
                    continue
                printf '%s\n' "$pid"
                return 0
            done
            ;;
    esac
    return 1
}

assert_native_session_inactive() {
    local agent="$1" native_home="$2" session_id="$3" active_pid
    if active_pid="$(active_native_session_pid "$agent" "$native_home" "$session_id")"; then
        die "$agent session $session_id is already active in PID $active_pid; exit that session before resuming it"
    fi
}

ensure_restore_directory() {
    local directory="$1" component current=/
    local -a components=()
    IFS=/ read -ra components <<< "${directory#/}"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        if [[ "$current" == / ]]; then
            current="/$component"
        else
            current="$current/$component"
        fi
        current="$(resolve_restore_component "$current")" || return 1
        if [[ -e "$current" ]]; then
            [[ -d "$current" ]] || {
                log "restore destination has a non-directory ancestor: $current"
                return 1
            }
        else
            mkdir -- "$current" || return 1
            restore_created_dirs+=("$current")
        fi
    done
}

cleanup_restore_directories() {
    local i
    for ((i = ${#restore_created_dirs[@]} - 1; i >= 0; i--)); do
        rmdir -- "${restore_created_dirs[$i]}" 2>/dev/null || true
    done
}

stage_restore_file() {
    local source="$1" staged="$2" mode="$3" mtime="$4" actual_mode
    [[ "$mode" =~ ^[0-7]{3}$ ]] || return 1
    [[ -z "$mtime" ]] || validate_artifact_metadata "$mode" "$mtime" || return 1
    install -Dm600 "$source" "$staged" || return 1
    chmod "$mode" "$staged" || return 1
    if [[ -n "$mtime" ]]; then
        touch -d "@$mtime" -- "$staged" || return 1
    fi
    actual_mode="$(normalize_safe_artifact_mode "$(stat -c %a "$staged")")" || return 1
    [[ "$actual_mode" == "$mode" ]] || return 1
    [[ -z "$mtime" || "$(stat -c %Y "$staged")" == "$mtime" ]]
}

replace_file() {
    local source="$1" destination="$2" mode="${3:-600}" mtime="${4:-}"
    local destination_root="${5:-}" temporary
    if [[ -n "$destination_root" ]]; then
        validate_restore_destination "$destination_root" "$destination" || return 1
        [[ -d "${destination%/*}" ]] || {
            log "restore destination parent is unavailable: ${destination%/*}"
            return 1
        }
    else
        mkdir -p -- "${destination%/*}" || return 1
    fi
    if [[ -L "$destination" ]]; then
        log "restore destination is a symbolic link: $destination"
        return 1
    fi
    replace_file_attempt=$((${replace_file_attempt:-0} + 1))
    if [[ "${AGENT_SESSION_TEST_FAIL_REPLACE_AT:-}" =~ ^[1-9][0-9]*$ ]] &&
       (( replace_file_attempt == 10#$AGENT_SESSION_TEST_FAIL_REPLACE_AT )); then
        log "injected restore write failure at replacement $replace_file_attempt"
        return 1
    fi
    temporary="$destination.agent-session.$$.$RANDOM"
    if ! stage_restore_file "$source" "$temporary" "$mode" "$mtime"; then
        rm -f -- "$temporary"
        return 1
    fi
    if ! mv -f -- "$temporary" "$destination"; then
        rm -f -- "$temporary"
        return 1
    fi
}

replace_file_from_backup() {
    local source="$1" destination="$2" destination_root="$3" temporary
    validate_restore_destination "$destination_root" "$destination" || return 1
    [[ -d "${destination%/*}" && ! -L "$destination" ]] || return 1
    temporary="$destination.agent-session-rollback.$$.$RANDOM"
    if ! cp -p -- "$source" "$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    if ! mv -f -- "$temporary" "$destination"; then
        rm -f -- "$temporary"
        return 1
    fi
}

merge_one() {
    local source="$1" destination="$2" label="$3" source_size destination_size
    if [[ ! -e "$destination" ]]; then
        replace_file "$source" "$destination"
        added=$((added + 1))
    elif cmp -s "$source" "$destination"; then
        same=$((same + 1))
    else
        source_size="$(stat -c %s "$source")"
        destination_size="$(stat -c %s "$destination")"
        if (( source_size > destination_size )) &&
           cmp -s -n "$destination_size" "$source" "$destination"; then
            replace_file "$source" "$destination"
            updated=$((updated + 1))
        elif (( destination_size > source_size )) &&
             cmp -s -n "$source_size" "$source" "$destination"; then
            same=$((same + 1))
        else
            log "conflict kept local: $label"
            conflicts=$((conflicts + 1))
        fi
    fi
}

merge_tree() {
    local source_root="$1" destination_root="$2" label="$3"
    local source relative destination
    [[ -d "$source_root" ]] || return 0

    while IFS= read -r -d '' source; do
        relative="${source#"$source_root"/}"
        destination="$destination_root/$relative"
        merge_one "$source" "$destination" "$label/$relative"
    done < <(find "$source_root" -type f -name '*.jsonl' -print0)
}

pull_sessions() {
    local tmp archive unpack codex_version claude_version found=0

    need age; need cmp; need flock; need jq; need pgrep; need tar
    load_encryption_identity
    [[ -d "$store" ]] || die "snapshot directory not found: $store"
    if pgrep -u "$(id -u)" -x codex >/dev/null || pgrep -u "$(id -u)" -x claude >/dev/null; then
        die "Codex or Claude is still running; exit it before restoring sessions"
    fi

    lock
    added=0 updated=0 same=0 conflicts=0
    while IFS= read -r -d '' archive; do
        found=1
        tmp="$(mktemp -d "$state/pull.XXXXXX")"
        unpack="$tmp/unpack"
        mkdir -p "$unpack"
        age_decrypt -o "$tmp/archive.tar.gz" "$archive"
        validate_tar "$tmp/archive.tar.gz"
        tar --no-same-owner --no-same-permissions -xzf "$tmp/archive.tar.gz" -C "$unpack"

        codex_version="$(sed -n 's/^codex_version=//p' "$unpack/manifest" 2>/dev/null || true)"
        claude_version="$(sed -n 's/^claude_version=//p' "$unpack/manifest" 2>/dev/null || true)"
        [[ -z "$codex_version" || "$codex_version" == "$(codex --version 2>/dev/null || printf unknown)" ]] ||
            log "warning: Codex version differs in $(basename "$archive"): $codex_version"
        [[ -z "$claude_version" || "$claude_version" == "$(claude --version 2>/dev/null || printf unknown)" ]] ||
            log "warning: Claude version differs in $(basename "$archive"): $claude_version"

        merge_tree "$unpack/codex/sessions" "$codex_home/sessions" "codex/sessions"
        merge_tree "$unpack/codex/archived_sessions" "$codex_home/archived_sessions" "codex/archived_sessions"
        merge_tree "$unpack/claude/projects" "$claude_home/projects" "claude/projects"
        rm -rf -- "$tmp"
    done < <(find "$store" -maxdepth 1 -type f -name '*.sessions.tar.gz.age' -print0 | sort -z)

    (( found == 1 )) || die "no encrypted snapshots in $store"
    log "pulled: added=$added updated=$updated unchanged=$same conflicts=$conflicts"
    (( conflicts == 0 )) || return 2
}

checkpoint_id_valid() {
    local checkpoint_id="${1:-}"
    [[ -n "$checkpoint_id" && "$checkpoint_id" != *'/'* ]] &&
        text_has_no_control_characters "$checkpoint_id"
}

validate_checkpoint_id() {
    local checkpoint_id="${1:-}"
    need jq
    [[ -n "$checkpoint_id" ]] || die "checkpoint ID is required"
    checkpoint_id_valid "$checkpoint_id" ||
        die "invalid checkpoint ID"
}

parse_checkpoint_selector() {
    local selector="${1:-}"
    checkpoint_selector_agent=
    checkpoint_selector_record_id="$selector"
    case "$selector" in
        codex/*|claude/*)
            checkpoint_selector_agent="${selector%%/*}"
            checkpoint_selector_record_id="${selector#*/}"
            ;;
    esac
    validate_checkpoint_id "$checkpoint_selector_record_id"
}

find_local_checkpoint_archive() {
    local checkpoint_id="${1:-}" root file base record_id total agent
    local selector_agent selector_record_id
    local -a exact_matches=() id_matches=()
    parse_checkpoint_selector "$checkpoint_id"
    selector_agent="$checkpoint_selector_agent"
    selector_record_id="$checkpoint_selector_record_id"
    root="$local_checkpoints"
    [[ -d "$root" ]] || die "checkpoint directory not found: $root"
    if [[ -n "$selector_agent" ]]; then
        checkpoint_match="$root/$selector_agent/$selector_record_id.checkpoint.tar.gz.age"
        [[ -d "$root/$selector_agent" && ! -L "$root/$selector_agent" &&
           -f "$checkpoint_match" && ! -L "$checkpoint_match" ]] ||
            die "expected one checkpoint named $checkpoint_id; found 0"
        checkpoint_record_id="$selector_record_id"
        return
    fi
    while IFS= read -r -d '' file; do
        base="$(basename "$file")"
        record_id="${base%.checkpoint.tar.gz.age}"
        if [[ "$record_id" == "$checkpoint_id" ]]; then
            exact_matches+=("$file")
        elif record_matches_checkpoint_id "$record_id" "$checkpoint_id"; then
            id_matches+=("$file")
        fi
    done < <(find "$root" -mindepth 2 -maxdepth 2 -type f -name '*.checkpoint.tar.gz.age' -print0)
    total=$((${#exact_matches[@]} + ${#id_matches[@]}))
    if (( total == 1 &&
          ${#exact_matches[@]} == 1 )); then
        checkpoint_match="${exact_matches[0]}"
    else
        if (( ${#exact_matches[@]} == 0 && ${#id_matches[@]} == 1 )); then
            checkpoint_match="${id_matches[0]}"
        else
            if (( total > 1 )); then
                log "matching RECORD_ID values:"
                for file in "${exact_matches[@]}" "${id_matches[@]}"; do
                    agent="$(basename "$(dirname "$file")")"
                    base="$(basename "$file")"
                    log "  $agent/${base%.checkpoint.tar.gz.age}"
                done
            fi
            die "expected one checkpoint named $checkpoint_id; found $total"
        fi
    fi
    base="$(basename "$checkpoint_match")"
    checkpoint_record_id="${base%.checkpoint.tar.gz.age}"
}

print_checkpoint_row() {
    local target="$1" agent="$2" record_id="$3" manifest="${4:-}"
    local include_selector="${5:-0}"
    local checkpoint_id="$record_id"
    local saved_agent description created_utc saved_date launch_args='[]'
    [[ "$agent" == codex || "$agent" == claude ]] || return 0
    checkpoint_id_valid "$record_id" || return 0
    if [[ -n "$manifest" ]]; then
        checkpoint_id="$(sed -n 's/^checkpoint_id=//p' <<< "$manifest")"
        saved_agent="$(sed -n 's/^agent=//p' <<< "$manifest")"
        [[ "$saved_agent" == codex || "$saved_agent" == claude ]] && agent="$saved_agent"
        description="$(sed -n 's/^description=//p' <<< "$manifest")"
        created_utc="$(sed -n 's/^created_utc=//p' <<< "$manifest")"
        launch_args="$(sed -n 's/^launch_args=//p' <<< "$manifest")"
        # Anything that is not one bracketed line becomes "no arguments". A
        # value carrying a tab or a line break would not just render wrong, it
        # would break the row apart and pair a selector with another row's data.
        [[ "$launch_args" == '['*']' &&
           "$launch_args" != *$'\t'* &&
           "$launch_args" != *$'\n'* &&
           "$launch_args" != *$'\r'* ]] || launch_args='[]'
        [[ -n "$checkpoint_id" ]] || checkpoint_id="$record_id"
        [[ -n "$description" ]] || description=unknown
        [[ -n "$created_utc" ]] || created_utc=unknown
    else
        description=unavailable
        created_utc=unavailable
    fi
    saved_date="${created_utc%%T*}"
    [[ "$saved_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || saved_date=unknown
    checkpoint_id="${checkpoint_id//$'\t'/ }"; checkpoint_id="${checkpoint_id//$'\n'/ }"; checkpoint_id="${checkpoint_id//$'\r'/ }"
    description="${description//$'\t'/ }"; description="${description//$'\n'/ }"; description="${description//$'\r'/ }"
    text_has_no_control_characters "$checkpoint_id" || checkpoint_id=unknown
    text_has_no_control_characters "$description" || description=unavailable
    if [[ "$include_selector" == 1 ]]; then
        printf '%s\t%s\t%s\t%s\t%s/%s\t%s\n' \
            "$checkpoint_id" "${agent^^}" "$saved_date" "$description" \
            "$agent" "$record_id" "$launch_args"
    else
        printf '%s\t%s\t%s\t%s\n' \
            "$checkpoint_id" "${agent^^}" "$saved_date" "$description"
    fi
}

list_checkpoint_root() {
    local target="$1" root="$2" include_selector="${3:-0}"
    local file agent base record_id manifest
    [[ -d "$root" ]] || return 0
    while IFS= read -r -d '' file; do
        agent="$(basename "$(dirname "$file")")"
        base="$(basename "$file")"
        record_id="${base%.checkpoint.tar.gz.age}"
        [[ ! -f "$root/tombstones/$agent/$record_id.tombstone" ]] || continue
        # ponytail: decrypt each manifest; add an encrypted index only if listing becomes slow.
        if manifest="$(age_decrypt "$file" 2>/dev/null | tar -xzOf - manifest 2>/dev/null)"; then
            print_checkpoint_row \
                "$target" "$agent" "$record_id" "$manifest" "$include_selector"
        else
            print_checkpoint_row \
                "$target" "$agent" "$record_id" "" "$include_selector"
        fi
    done < <(find "$root" -mindepth 2 -maxdepth 2 -type f -name '*.checkpoint.tar.gz.age' -print0)
}

# Lay out a checkpoint table.
#
# `reserve` is the number of columns the caller draws outside the table itself —
# the menu's selection pointer — and `pad` asks `column` to fill the remaining
# width so every row comes back the same *display* width. That padding is the
# whole reason the menu renders through here: descriptions are routinely Chinese,
# where a character is two columns wide and one byte-counted `printf '%-*s'`
# would leave the table ragged and the highlight bar torn. `column` measures in
# characters, so it is the one thing on this machine that already knows.
# `truncate` 是**哪几列可以被砍**，逗号分隔，1 起数。
#
# 必须由调用者给，不能写死：它是列布局的函数，而这个渲染器现在服务两张列数不同的
# 表。写死成 `4` 的时候，存档表（ID/AGENT/SAVED/DESCRIPTION）第 4 列正好是最长的
# 描述，看起来一切正常；会话表多了 KIND 和 WORKSPACE 之后，第 4 列变成 ACTIVE ——
# 一个定宽日期，砍它一个字符都省不出来，而真正会撑爆宽度的 WORKSPACE 和
# DESCRIPTION 反而不在可砍名单里。`column` 于是按最宽内容给它们排版，整张表直接
# 超出 `-c` 给的宽度，中间拉出一大片空白。
render_checkpoint_table() {
    local reserve="${1:-0}" pad="${2:-0}" truncate="${3:-4}" width
    width="$(terminal_width)"
    (( width == 0 )) || width=$((width - reserve))
    if (( width >= 40 )) && column --help 2>&1 | grep -q -- '--table-truncate'; then
        if [[ "$pad" == 1 ]]; then
            render_columns -t -s $'\t' -T "$truncate" -c "$width" -m
        else
            render_columns -t -s $'\t' -T "$truncate" -c "$width"
        fi
    else
        render_columns -t -s $'\t'
    fi
}

load_local_checkpoint_menu() {
    local checkpoint_id agent saved_date description selector args
    local -a rows=() rendered=()
    terminal_menu_ids=()
    terminal_menu_labels=()
    terminal_menu_args=()
    terminal_menu_details=()
    terminal_menu_agents=()
    terminal_menu_header=
    while IFS=$'\t' read -r checkpoint_id agent saved_date description selector args; do
        [[ -n "$selector" ]] || continue
        [[ -n "$args" ]] || args='[]'
        terminal_menu_ids+=("$selector")
        terminal_menu_agents+=("${selector%%/*}")
        terminal_menu_args+=("$args")
        terminal_menu_details+=("$(format_launch_args "$args")")
        rows+=("$checkpoint_id"$'\t'"$agent"$'\t'"$saved_date"$'\t'"$description")
    done < <(
        list_checkpoint_root local "$local_checkpoints" 1 |
            LC_ALL=C sort -t $'\t' -k1,1 -k2,2 -k5,5
    )
    (( ${#rows[@]} > 0 )) || return 0
    # The menu draws through the same renderer the piped table uses, so the two
    # cannot drift apart in alignment or truncation. `column` emits rows in input
    # order, which is what keeps each label paired with the selector collected
    # for it above — the count check below is what makes that assumption fail
    # loudly rather than open somebody else's session.
    mapfile -t rendered < <(
        {
            printf 'ID\tAGENT\tSAVED\tDESCRIPTION\n'
            printf '%s\n' "${rows[@]}"
        } | render_checkpoint_table 2 1
    )
    if (( ${#rendered[@]} == ${#rows[@]} + 1 )); then
        terminal_menu_header="${rendered[0]}"
        terminal_menu_labels=("${rendered[@]:1}")
    else
        terminal_menu_labels=("${rows[@]//$'\t'/  }")
    fi
}

# ---------------------------------------------------------------------------
# 原生会话清单
# ---------------------------------------------------------------------------
#
# `ags ls` 列的是 **Agent 自己的会话**，不是 AGS 的存档。
#
# 每个 Agent 本来就在管自己的会话，恢复也是它自己的能力：同一个 Agent 要接着上次
# 干，正确的做法是把 `codex resume <id>` / `claude --resume <id>` 交给它，而不是
# 先把一份冻结的副本写回它的 home 再让它读。后者是 `ags save` 存下来的东西才需要
# 的动作，`restore_checkpoint_file` 那一整套覆盖 + 回滚日志只为它存在。
#
# 存档因此退成第二类：`ags ls -a` 才会把它们和活会话并排列出来，KIND 一列区分。
#
# 描述、启动参数、pin 这三样原生会话里没有，AGS 记在自己的状态目录下，键是
# `<provider>/<session_id>`。两个地方刻意不放：
#
# - **不写进 Agent 自己的会话文件。** 那是它的数据，往里塞字段等于让它自己的解析
#   器去猜我们的意思。
# - **不放进 ags 的 store。** 那里的规矩写在 `src/store.rs` 开头——除了 `Loss` /
#   `Fidelity` 这类「当时发生过、事后再也算不出来」的记录，其余一切都必须能从原生
#   字节重建，版本不认就删掉重建。人手写的描述既不能重建，也不该在版本升级时被
#   当成缓存丢掉。

# 一个注解键是否可以直接当路径用。
#
# 会话 ID 来自 ags，不同 Agent 的形状不一样（Codex 是 UUID，别家可能是文件名），
# 所以这里不能用 `validate_session_id` 那条 UUID 规则。要求的是「能安全地当一段
# 文件名」：没有分隔符、没有控制字符、不以点开头、有长度上限。不合格的会话仍然
# 照常列出，只是没有注解可存——注解是附加信息，不该让一个列不出的名字变成错误。
valid_annotation_key() {
    [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}$ ]]
}

session_annotation_file() {
    local provider="$1" session_id="$2"
    valid_annotation_key "$provider" && valid_annotation_key "$session_id" || return 1
    printf '%s\n' "$state/annotations/$provider/$session_id.json"
}

# 读注解到 `annotation_description` / `annotation_args` / `annotation_pinned`。
#
# 没有注解不是错误，是最常见的情况：绝大多数会话是直接用 Agent 起的，AGS 从没见过
# 它们。所以缺文件、坏 JSON 都退回默认值，不 die。
read_session_annotation() {
    local provider="$1" session_id="$2" file payload
    annotation_description=
    annotation_args='[]'
    annotation_pinned=0
    annotation_summary=
    annotation_summary_stamp=
    annotation_summary_at=0
    file="$(session_annotation_file "$provider" "$session_id")" || return 0
    [[ -f "$file" ]] || return 0
    payload="$(jq -c . "$file" 2>/dev/null)" || return 0
    annotation_description="$(jq -r '.description // "" | gsub("[\t\r\n]"; " ")' <<< "$payload" 2>/dev/null || printf '')"
    annotation_args="$(jq -c 'if (.args | type) == "array" then .args else [] end' <<< "$payload" 2>/dev/null || printf '[]')"
    decode_launch_args "$annotation_args" || annotation_args='[]'
    [[ "$(jq -r '.pinned // false' <<< "$payload" 2>/dev/null)" == true ]] && annotation_pinned=1
    annotation_summary="$(jq -r '.summary // "" | gsub("[\t\r\n]"; " ")' <<< "$payload" 2>/dev/null || printf '')"
    annotation_summary_stamp="$(jq -r '.summary_stamp // ""' <<< "$payload" 2>/dev/null || printf '')"
    annotation_summary_at="$(jq -r '.summary_at // 0' <<< "$payload" 2>/dev/null || printf 0)"
    [[ "$annotation_summary_at" =~ ^[0-9]+$ ]] || annotation_summary_at=0
    return 0
}

# 写注解。**已有的机器生成字段原样留着。**
#
# 这个函数的三个参数是人改的那些（描述、参数、置顶），而同一个文件里还存着总结
# 和它的指纹——那是 `ags ls --summarize` 花了一次模型调用换来的。整份覆盖的话，
# 在菜单里按一下置顶就会把总结抹掉，下次列表又变回没有名字，而且没有任何报错。
write_session_annotation() {
    local provider="$1" session_id="$2" description="$3" args="$4" pinned="$5"
    local file temporary kept='{}'
    file="$(session_annotation_file "$provider" "$session_id")" ||
        die "cannot record notes for $provider/$session_id"
    mkdir -p "$(dirname "$file")"
    if [[ -f "$file" ]]; then
        kept="$(jq -c '{summary: (.summary // ""), summary_stamp: (.summary_stamp // ""),
                        summary_at: (.summary_at // 0)}
                       | with_entries(select(.value != "" and .value != 0))' "$file" 2>/dev/null)" || kept='{}'
        [[ -n "$kept" ]] || kept='{}'
    fi
    temporary="$(mktemp "$file.XXXXXX")"
    jq -nc --arg description "$description" \
        --argjson args "$args" \
        --argjson pinned "$( ((pinned == 1)) && printf true || printf false )" \
        --argjson kept "$kept" \
        '$kept + {description: $description, args: $args, pinned: $pinned}' > "$temporary" ||
        { rm -f -- "$temporary"; die "cannot encode session notes"; }
    chmod 600 "$temporary"
    mv -- "$temporary" "$file"
}

# 只写总结和它的指纹，人改的那些不动。
#
# 和 `write_session_annotation` 分开是同一条理由反过来：总结是后台批量算出来的，
# 它不该有机会覆盖人刚刚在菜单里敲进去的描述或参数。
write_session_summary() {
    local provider="$1" session_id="$2" summary="$3" stamp="$4"
    local file temporary kept='{"description":"","args":[],"pinned":false}'
    file="$(session_annotation_file "$provider" "$session_id")" || return 1
    mkdir -p "$(dirname "$file")"
    if [[ -f "$file" ]]; then
        kept="$(jq -c '{description: (.description // ""),
                        args: (if (.args | type) == "array" then .args else [] end),
                        pinned: (.pinned // false)}' "$file" 2>/dev/null)" ||
            kept='{"description":"","args":[],"pinned":false}'
    fi
    temporary="$(mktemp "$file.XXXXXX")" || return 1
    if jq -nc --arg summary "$summary" --arg stamp "$stamp" --argjson kept "$kept" \
        --argjson at "$(date +%s)" \
        '$kept + {summary: $summary, summary_stamp: $stamp, summary_at: $at}' \
        > "$temporary" 2>/dev/null; then
        chmod 600 "$temporary"
        mv -- "$temporary" "$file"
    else
        rm -f -- "$temporary"
        return 1
    fi
}

# ---------------------------------------------------------------------------
# 会话总结
# ---------------------------------------------------------------------------
#
# 列表要认得出一条会话，靠的是"它在干什么"。这件事只有两个来源：
#
#   - **Agent 自己写的。** Claude Code 会给会话起名（ags 读出来叫 `native_name`），
#     一台机器上最近 40 条里 25 条有。这一份是白捡的，优先用。
#   - **我们自己算的。** Codex 一个字都不写——同一批 40 条里 0 条有——所以只能退回
#     "第一条用户消息"，而那条消息前面往往挂着客户端注入的一大块上下文。实测最近
#     14 条 codex 里 8 条的标题是 `# AGENTS.md instructions for /mnt/c/…`，其中 6
#     条一模一样。列表于是完全没法用来认会话。
#
# ags 那边已经把注入块跳掉了，所以标题现在是人写的话。但那是**原话的第一行**，
# 不是概括——"帮我看看codex和claude的近期会话 全部被杀死了 大概有5个…"这样的一行
# 塞不进一列。这里把它交给模型压成一句。
#
# 三条规矩：
#
#   1. **人写的永远赢。** 菜单里敲进去的描述优先于总结，总结优先于标题。模型不该
#      有机会覆盖人亲手起的名字。
#   2. **算过就不再算。** 总结连同会话文件的指纹（大小:mtime）一起存；文件没变就
#      直接用缓存。不然每次 `ls` 都要为几十条会话各调一次模型。
#   3. **不污染列表。** 见 `run_summary_model`。

# 会话文件此刻的指纹。文件没了就是空串——空串和任何存下来的指纹都不相等，于是
# 缓存自然失效，这正是想要的。
session_content_stamp() {
    local path="$1" size mtime
    [[ -n "$path" && -f "$path" ]] || { printf '\n'; return 0; }
    size="$(wc -c < "$path" 2>/dev/null | tr -d ' ')" || size=
    mtime="$(date -r "$path" +%s 2>/dev/null)" || mtime=
    [[ -n "$size" && -n "$mtime" ]] || { printf '\n'; return 0; }
    printf '%s:%s\n' "$size" "$mtime"
}

# 交给模型的原料：这段会话里人自己说过的话，掐头去尾。
#
# 不发整段会话——中间绝大部分是工具往返，既贵又不改变答案。ags 的 `--digest`
# 已经把注入块和非用户消息剔掉了。
session_digest_text() {
    local provider="$1" session_id="$2" path="$3" binary
    converter_cli --json info "$session_id" --from "$provider" --digest \
        ${path:+--source "$path"} 2>/dev/null |
        jq -r '(.digest // []) | .[]' 2>/dev/null
}

# 总结这一段话的命令。
#
# 默认走 `codex exec`，但**必须带 `--ephemeral`**：不带的话每总结一条会话，codex
# 就在 `~/.codex/sessions` 里新建一条 rollout——于是列表里多出一条它自己制造的、
# 同样没有名字的会话。实测过：一次 `codex exec` 让 rollout 从 2845 涨到 2846，
# `claude -p` 同理。`--ephemeral` 之后实测 delta 为 0。
#
# `--ignore-user-config` 顺带把 AGENTS.md 和插件目录挡在外面：同一句"回 PONG"
# 带用户配置是 21,034 token，不带是 5,818。总结几十条会话时这是四倍的差别。
#
# `AGS_SUMMARY_CMD` 可以换成任何"读 stdin、打印一行"的命令——自建的模型网关、
# 号池、或者别家的 CLI。换掉之后上面两件事由调用方自己负责。
ags_summary_supports_ephemeral() {
    [[ -n "${ags_summary_ephemeral_probe:-}" ]] && return "$ags_summary_ephemeral_probe"
    ags_summary_ephemeral_probe=1
    if codex exec --help 2>/dev/null | grep -q -- '--ephemeral'; then
        ags_summary_ephemeral_probe=0
    fi
    return "$ags_summary_ephemeral_probe"
}

# 跑一次模型，把 stdin 那段话变成一行。失败返回非零且不输出任何东西。
run_summary_model() {
    local prompt="$1" answer output status=0
    if [[ -n "${AGS_SUMMARY_CMD:-}" ]]; then
        # `sh -c` 而不是 `eval`：这条命令是环境变量给的（和 `$PAGER` 一个性质），
        # 但它没有理由能改到当前 shell 的变量。这个文件里对 `eval` 的禁令来自
        # "同步过来的数据绝不能当代码跑"，这里虽然不是那种数据，规矩照守。
        answer="$(printf '%s' "$prompt" | sh -c "$AGS_SUMMARY_CMD" 2>/dev/null)" || return 1
        printf '%s\n' "$answer" | tail -n 1
        return 0
    fi
    command -v codex >/dev/null 2>&1 || return 1
    ags_summary_supports_ephemeral ||
        { log "codex 太老，没有 --ephemeral；总结会污染会话列表，跳过。用 AGS_SUMMARY_CMD 指定别的命令"; return 1; }
    output="$(mktemp "${TMPDIR:-/tmp}/ags-summary.XXXXXX")" || return 1
    # `-o` 把最终答复单独写进文件：stdout 上还混着横幅和 token 统计，靠 `tail -1`
    # 去猜哪一行是答案，换个版本就会猜错。
    printf '%s' "$prompt" |
        codex exec --skip-git-repo-check --ephemeral --ignore-user-config \
            -o "$output" - >/dev/null 2>&1 || status=$?
    if (( status != 0 )); then
        rm -f -- "$output"
        return 1
    fi
    answer="$(tr '\r\n' '  ' < "$output" 2>/dev/null | sed 's/  */ /g; s/^ *//; s/ *$//')"
    rm -f -- "$output"
    [[ -n "$answer" ]] || return 1
    printf '%s\n' "$answer"
}

# 让模型往多少字上收。
#
# 这是**给模型的目标**，不是显示宽度。两者必须分开：显示宽度由终端决定、每次都
# 可能不一样，而总结是**存下来**的——按某一次的终端宽度砍完存进去，换一个更宽的
# 终端也长不回来了。所以这里只要求"短"，砍到具体宽度那一刀交给表格渲染去做。
ags_summary_max_chars() {
    local limit="${AGS_SUMMARY_MAX_CHARS:-24}"
    [[ "$limit" =~ ^[1-9][0-9]{0,2}$ ]] || limit=24
    printf '%s\n' "$limit"
}

# 存进注解的硬上限。只防"模型答了一整段"，不是排版。
ags_summary_store_limit() {
    printf '%s\n' "$(( $(ags_summary_max_chars) * 3 ))"
}

summary_prompt() {
    local limit="$1" digest="$2"
    cat <<PROMPT
下面是一段编码会话里**用户**说过的话（掐头去尾，中间省略）。

请用一句话概括这段会话在做什么，好让人在会话列表里一眼认出它。

要求：
- 不超过 ${limit} 个字符，宁可更短
- 只说做的事，不要"用户要求""这段会话"之类的开头，不要结尾标点
- 用和原文相同的语言
- 只输出这一句，不要解释、不要引号

---
${digest}
PROMPT
}

# 给一条会话算出总结并存起来。已经有的直接返回。
#
# 返回 0 表示这条现在有总结了（本来就有、或者刚算出来），非零表示没有。
ensure_session_summary() {
    local provider="$1" session_id="$2" path="$3" native_name="$4" force="${5:-0}"
    local stamp digest answer limit
    read_session_annotation "$provider" "$session_id"
    # 人自己写的描述、以及 Agent 自己起的名字，都不该被模型盖掉。
    [[ -z "$annotation_description" ]] || return 0
    (( force == 1 )) || [[ -z "$native_name" ]] || return 0
    stamp="$(session_content_stamp "$path")"
    # 判据是**指纹**，不是"有没有总结"。有些会话根本没有可总结的东西（整段都是
    # 客户端注入的上下文，人一个字没打），它算出来必然是空的——而按"有没有总结"
    # 判的话，这种会话每一轮都会被重算一次，为一个注定的空结果反复解析整个文件。
    # 有些文件是一 GiB 级的。
    if (( force == 0 )) && [[ -n "$stamp" && "$annotation_summary_stamp" == "$stamp" ]]; then
        return 0
    fi
    # 内容变了，但刚算过就先别重算。
    #
    # 一条**还在跑**的会话每一分钟内容都在变，按指纹判的话每一轮都要重算一次——
    # 而它恰恰是列表最上面、你最想认出来的那几条。全跳过（只补已经结束的）是另一
    # 个极端：正在干的活永远没有名字。折中就是这一条：照常补，但一小时内不重复。
    local refresh
    refresh="${AGS_SUMMARY_REFRESH_SECONDS:-3600}"
    [[ "$refresh" =~ ^[0-9]{1,7}$ ]] || refresh=3600
    if (( force == 0 && annotation_summary_at > 0 )) &&
       (( $(date +%s) - annotation_summary_at < refresh )); then
        return 0
    fi
    digest="$(session_digest_text "$provider" "$session_id" "$path")"
    if [[ -z "${digest//[[:space:]]/}" ]]; then
        # 记下"这份内容看过了，没什么可说的"，别下一轮再来一次。模型调用失败是另
        # 一回事（网络、超时），那种不记，因为它下次可能就成了。
        write_session_summary "$provider" "$session_id" "" "$stamp" || true
        return 1
    fi
    limit="$(ags_summary_max_chars)"
    answer="$(run_summary_model "$(summary_prompt "$limit" "$digest")")" || return 1
    # 只在模型答了一整段时兜底截一刀，**不按显示宽度砍**——存下来的东西要能在更宽
    # 的终端里显示得更全。用 bash 的子串而不是 `cut -c` 或 `awk substr`：那两个在
    # 这台机器上按字节算，一刀会切在一个汉字中间。
    local store_limit
    store_limit="$(ags_summary_store_limit)"
    if (( ${#answer} > store_limit )); then
        answer="${answer:0:${store_limit}}"
    fi
    [[ -n "${answer//[[:space:]]/}" ]] || return 1
    write_session_summary "$provider" "$session_id" "$answer" "$stamp" || return 1
    return 0
}

# 会话在列表里的短号，放进 `session_ordinals`（"provider/id" -> N）。
#
# 十六进制的会话 ID 认不出来。`01a0269a-094f` 里没有一个字符是给人读的，而一屏
# 十几行全长这样——列表于是只能靠描述认，短号那一列纯属占地方。
#
# 换成一个小整数。规矩只有两条，都来自它要顶替的那个东西的缺陷：
#
#   - **稳定**。按当前列表的第几行编号最省事，但那个号会在下一条会话起来之后
#     指向别的东西——人看完列表、过一会儿敲 `ags resume 7`，打开的不是他刚看
#     的那条。号一旦发出去就跟着这条会话不变。
#   - **一个文件**。给每条会话各写一个注解文件，意味着一次 `ls` 要写几十个文件，
#     而其中绝大多数人这辈子都不会去动。这里只有一份映射。
#
# 发出去的号不回收：一条会话被删掉之后它的号就空着。复用会让一个记在纸上（或者
# 记在脑子里）的号指向另一条会话，而这正是"稳定"要防的事。
session_ordinal_file() {
    printf '%s\n' "$state/ordinals.json"
}

load_session_ordinals() {
    local file payload
    session_ordinals_json='{"next":1,"ids":{}}'
    file="$(session_ordinal_file)"
    [[ -f "$file" ]] || return 0
    payload="$(jq -c 'if (.ids | type) == "object" then
                          {next: ((.next // 1) | if type == "number" then floor else 1 end),
                           ids: .ids}
                      else empty end' "$file" 2>/dev/null)" || return 0
    [[ -n "$payload" ]] && session_ordinals_json="$payload"
    return 0
}

# 给这一批里还没有号的会话发号，并把结果写回去。
#
# 一次写完而不是发一个写一次：`ls` 每次都会把整批过一遍，逐个落盘等于把一次
# 写变成几十次。
assign_session_ordinals() {
    local keys_json file temporary
    keys_json="$(printf '%s\n' "$@" | jq -R . | jq -sc .)" || return 0
    session_ordinals_json="$(jq -c --argjson keys "$keys_json" '
        reduce $keys[] as $key (.;
            if (.ids[$key] // null) == null
            then .ids[$key] = .next | .next = (.next + 1)
            else . end)
    ' <<< "$session_ordinals_json" 2>/dev/null)" || return 0
    file="$(session_ordinal_file)"
    mkdir -p "$(dirname "$file")"
    temporary="$(mktemp "$file.XXXXXX")" || return 0
    if printf '%s\n' "$session_ordinals_json" > "$temporary" 2>/dev/null; then
        chmod 600 "$temporary"
        mv -- "$temporary" "$file"
    else
        rm -f -- "$temporary"
    fi
    return 0
}

# 一个短号对应哪条会话，放进 `ordinal_selector`。认不出来就返回非零。
selector_for_ordinal() {
    local wanted="$1" key
    [[ "$wanted" =~ ^[0-9]{1,9}$ ]] || return 1
    load_session_ordinals
    key="$(jq -r --argjson n "$wanted" '
        (.ids | to_entries | map(select(.value == $n)) | .[0].key) // empty
    ' <<< "$session_ordinals_json" 2>/dev/null)" || return 1
    [[ -n "$key" ]] || return 1
    ordinal_selector="live:$key"
    return 0
}

# 一次把所有注解读进内存，别一行起一次 jq。
#
# 渲染一屏列表原来要为每条会话调 4~5 次 jq（描述、参数、置顶、总结、短号），一百
# 条会话就是五百多次进程启动——实测 `ags ls` 里 ags 只占 0.85 秒，剩下 1.85 秒
# 全花在这上面。这里一次 jq 读完全部注解文件。
#
# 一个文件坏了 jq 会整批失败，所以失败时返回非零、调用方退回逐条读。批量是优化，
# 不该变成一个新的失败点。
load_all_annotations() {
    local root="$state/annotations" key rest
    annotation_map=()
    [[ -d "$root" ]] || return 0
    while IFS=$'\x1f' read -r key rest; do
        [[ -n "$key" ]] || continue
        annotation_map["$key"]="$rest"
    done < <(
        find "$root" -mindepth 2 -maxdepth 2 -type f -name '*.json' -print0 2>/dev/null |
            xargs -0 -r jq -r '
                (input_filename | split("/") | .[-2:]
                 | .[1] |= sub("\\.json$"; "") | join("/")) as $key
                | [ $key,
                    ((.description // "") | tostring | gsub("[\t\r\n]"; " ")),
                    (if (.args | type) == "array" then (.args | tojson) else "[]" end),
                    (if (.pinned // false) then "1" else "0" end),
                    ((.summary // "") | tostring | gsub("[\t\r\n]"; " ")),
                    ((.summary_stamp // "") | tostring),
                    ((.summary_at // 0) | tostring)
                  ] | join("\u001f")' 2>/dev/null
    )
    # `done < <(...)` 里那条管道的退出码传不出来，所以判据是结果本身：注解目录
    # 存在、却一条都没读到，就是这批读失败了（某个文件坏了会让 jq 整批放弃）。
    # 这时候返回非零，调用方退回逐条读。
    if [[ -d "$root" ]] && (( ${#annotation_map[@]} == 0 )) &&
       [[ -n "$(find "$root" -mindepth 2 -maxdepth 2 -type f -name '*.json' -print -quit 2>/dev/null)" ]]; then
        return 1
    fi
    return 0
}

# 从批量结果里取一条，填进和 `read_session_annotation` 同一组变量。
#
# 取不到就是"这条会话没有注解"——那是最常见的情况（绝大多数会话是直接用 Agent 起
# 的，AGS 从没见过它们），所以填默认值，不报错。
annotation_from_map() {
    local key="$1" packed
    annotation_description=
    annotation_args='[]'
    annotation_pinned=0
    annotation_summary=
    annotation_summary_stamp=
    annotation_summary_at=0
    packed="${annotation_map[$key]:-}"
    [[ -n "$packed" ]] || return 0
    IFS=$'\x1f' read -r annotation_description annotation_args annotation_pinned \
        annotation_summary annotation_summary_stamp annotation_summary_at \
        <<< "$packed"
    [[ "$annotation_pinned" == 1 ]] || annotation_pinned=0
    [[ "$annotation_summary_at" =~ ^[0-9]+$ ]] || annotation_summary_at=0
    [[ -n "$annotation_args" ]] || annotation_args='[]'
    return 0
}

# 每个 Agent 最多取多少条。
#
# ags 的 `--limit` 是**按 provider** 算的，这里取完之后再全局按时间排一次，所以
# 这个数字是「每家最多贡献多少」，不是屏幕上最终看到多少。给得比一屏多，翻页才有
# 东西可翻。
native_session_limit() {
    local limit="${AGS_LIST_LIMIT:-50}"
    [[ "$limit" =~ ^[1-9][0-9]{0,3}$ ]] || limit=50
    printf '%s\n' "$limit"
}

# 跑转换那半边的 CLI。
#
# 二进制现在叫 `ags`，而它默认就是这个运行时——`ags ls`、`ags resume 7` 都是这里
# 的命令。跨 Agent 转换那套（原来的 `ags convert list` / `ags convert info` / `ags convert resume`）
# 收在 `ags convert` 底下，因为两边都想叫 `list` 和 `resume`，而日常敲的是这边。
#
# 收成一个函数而不是每处各写一遍 `convert`：这个前缀是命令布局的一部分，将来它
# 再变一次时，改一个地方比在脚本里找六处强。
converter_cli() {
    local binary
    binary="$(resolve_ags_converter_binary)"
    "$binary" convert "$@"
}

# 原生会话，最近的在前。
#
# 字段用 `\x1f`（US）分隔，**不用制表符**。bash 把制表符算作 IFS 空白字符，于是
# `IFS=$'\t' read` 把连续的制表符当成一个分隔符——一个空字段（Codex 没有
# `native_name`，那一列就是空的）会直接消失，后面所有字段整体左移一位。表现是
# 描述那列显示成了标题、标题列显示成了路径，而且不报任何错。`\x1f` 不是 IFS 空白
# 字符，空字段照样保留。
#
# 输出：provider · session_id · 时间 · 时间(epoch 秒) · 工作区 · Agent 自己起的名字 · 标题 · 路径
#
# 排序在 jq 里做而不是交给 `sort`：`ags convert list` 是按 provider 分组各自截断的，跨
# provider 的先后只有把两边合起来看才成立。
native_session_rows() {
    local binary
    converter_cli --json list --all-workspaces --sort date \
        --limit "$(native_session_limit)" 2>/dev/null |
        jq -r '
            # 一行给人看的标题。
            #
            # Codex 的标题是会话第一条用户消息，而那条消息在真正的问题前面往往
            # 先挂着客户端注入的一大块上下文——`<recommended_plugins>`、
            # `<user_instructions>`、`# AGENTS.md instructions for …`。照原样显示
            # 的结果是**整屏每一行都一样**（在一台真机上实测：11 行全是
            # `<recommended_plugins>`），列表于是完全没法用来认会话。
            #
            # 所以跳过开头这些包装，取第一段真正是人写的文字。只影响显示：
            # ags 那边的 `title` 一个字都不改，这里也不猜内容，只是不把注入块
            # 当成标题。跳完还是空的（整条消息都是注入的）就退回原文，因为
            # 「显示不出好的」不该变成「什么都不显示」。
            def human_line:
                  split("\n")
                | map(select(length > 0))
                | map(select(
                      (startswith("<") | not)
                      and (startswith("</") | not)
                      and (test("^#+ +AGENTS\\.md") | not)
                      and (test("^#+ +[A-Za-z.]+ instructions") | not)
                  ))
                | .[0] // "";
            def display_line:
                  tostring
                | gsub("\t"; " ")
                | gsub("\r"; "\n")
                | (human_line as $line
                   | if ($line | length) > 0 then $line else (gsub("\n"; " ")) end)
                | gsub("\n"; " ");
            # **按最后活动的日期排；同一天里按启动时间排。**
            #
            # 列表是「接着干」的入口，而要接的那条基本上就是刚才在动的那条，所以最
            # 近动过的排在最上面。
            #
            # 还有一个更硬的理由：上面那一刀 `--limit` **本来就是按最后活动时间切的**
            # （转换那边 `--sort date` 取的是 `last_active_at`）。按启动时间排的话，
            # 表的下半截是「在最近活动的这 N 条里，开得最早的几条」——那个集合本身
            # 是按另一个键截出来的，排出来的顺序看着稳定，其实成员一直在换。
            #
            # **同一天之内改用启动时间排，不再看几点几分。**
            #
            # 「哪天动过」是找会话真正用得上的粒度——你记得的是"今天还在弄的"和"前
            # 天那条"，不是"17:42 那条在 17:05 那条前面"。而在一天之内，分钟级的最后
            # 活动时间反而是有害的：它每被碰一次就变，同一天的几条会话每次 `ags ls`
            # 的相对位置都不一样，眼睛得重新找。启动时间在一天之内是固定的。
            #
            # 所以两级：先按最后活动的**日期**降序，同一天里按启动时间降序。
            #
            # 日期用本地时区的 `YYYYMMDD` 整数（`strflocaltime`），不是 `_when/86400`
            # ——后者切的是 UTC 的午夜，在东八区就是早上八点，于是"今天早上七点动
            # 过"的会话会被算进昨天。跨月跨年靠 `YYYYMMDD` 本身单调，不用另外处理。
            (.items // [])
            | map(. + {_when:    ((.last_active_at // .started_at // 0) | floor),
                       _started: ((.started_at // .last_active_at // 0) | floor)})
            | map(. + {_day: (if ._when > 0
                              then ((._when / 1000) | floor
                                    | strflocaltime("%Y%m%d") | tonumber)
                              else 0 end)})
            | sort_by([-._day, -._started])
            | .[]
            | [ .provider,
                .session_id,
                (if ._started > 0 then (._started / 1000 | floor | strflocaltime("%m-%d %H:%M")) else "" end),
                ((._started / 1000) | floor | tostring),
                (if ._when > 0 then (._when / 1000 | floor | strflocaltime("%m-%d %H:%M")) else "" end),
                ((._when / 1000) | floor | tostring),
                ((.workspace // .workspace_name // "") | tostring | gsub("[\t\r\n]"; " ")),
                ((.native_name // "") | tostring | gsub("[\t\r\n]"; " ")),
                ((.title // "") | display_line),
                ((.path // "") | tostring)
              ]
            | map(tostring) | join("\u001f")' 2>/dev/null
}

# provider slug -> AGS 自己会启动的那两个 Agent 的名字。
#
# 空字符串表示「这个 provider AGS 不负责启动」。列表照列——你在这台机器上有哪些
# 会话是一个事实，不该因为我们不会起它就不告诉你——但对它的动作只到「把它自己的
# 恢复命令显示出来」为止。
managed_agent_for_provider() {
    case "$1" in
        codex) printf 'codex\n' ;;
        claude-code) printf 'claude\n' ;;
        *) printf '\n' ;;
    esac
}

# 显示用的短 ID 要几位，放进 `short_id_length`。
#
# 8 位不够。Codex 的会话 ID 是 UUIDv7，前 8 个十六进制位是**毫秒时间戳**，所以同
# 一毫秒里起来的会话（并行的 subagent 就是这样）前 8 位完全一样——在一台真机上实
# 测有四条 `019fd39b`，列表里看起来是同一行出现了四次，而按下去打开的是其中随便
# 哪一个。
#
# 所以取「在这一批里刚好能区分开」的长度，和 git 的短哈希同一个做法：短到好读，
# 长到不会指错。
short_id_width() {
    local candidate id seen_duplicate
    local -A seen=()
    short_id_length=8
    (( $# > 0 )) || return 0
    # 落在 UUID 的连字符边界上，不在中间截断：`01a02646-8` 读起来像残缺，
    # `01a02646-8385` 是一段完整的字段。
    for candidate in 8 13 18 36; do
        seen=()
        seen_duplicate=0
        for id in "$@"; do
            if [[ -n "${seen[${id:0:$candidate}]:-}" ]]; then
                seen_duplicate=1
                break
            fi
            seen["${id:0:$candidate}"]=1
        done
        short_id_length="$candidate"
        (( seen_duplicate == 1 )) || return 0
    done
    return 0
}

# 把 workspace 收进一个上限，超出的从**左边**砍。
#
# 一个离群值会毁掉整张表：本机有一条 Cursor 会话的 workspace 是它那个数据库的完整
# 路径（88 字），`column` 于是按 88 给整列定宽，剩下的空间不够 DESCRIPTION 显示，
# 中间拉出一大片空白——而 DESCRIPTION 才是用来认会话的那一列。
#
# 上限跟着终端宽度走，不写死：窄终端下 workspace 让位给描述，宽终端下多给一点。
# 砍左边不砍右边，因为路径越靠后越能区分（`…/06_WithCao/02_AdaND` 比
# `/mnt/c/Users/Alg…` 有用）。
workspace_cell() {
    local value="$1" width="${2:-0}" cap
    cap=28
    if (( width >= 40 )); then
        cap=$(( width / 5 ))
        (( cap >= 12 )) || cap=12
        (( cap <= 28 )) || cap=28
    fi
    if (( ${#value} > cap )); then
        printf '…%s\n' "${value: -$((cap - 1))}"
    else
        printf '%s\n' "$value"
    fi
}

load_native_session_menu() {
    local include_archives="${1:-0}" for_menu="${2:-1}" table_width
    local provider session_id started started_epoch when when_epoch
    local workspace native_name title path
    local now
    table_width="$(terminal_width)"
    local checkpoint_id agent saved_date description selector args
    local marker kind label_id archive_agent
    local -a rows=() rendered=()
    terminal_menu_ids=()
    terminal_menu_labels=()
    terminal_menu_args=()
    terminal_menu_details=()
    terminal_menu_agents=()
    terminal_menu_header=
    # 这一屏里有多少条只能显示"原话第一行"——也就是还没有任何像样的名字。自动补
    # 描述看的就是这个数，为零就不起后台进程。
    native_menu_missing=0

    # 先把整批读进来：短号要一次性发完（一次写，不是几十次），而每行显示什么也
    # 要等这一批都在手里才定得下来。
    local -a live_provider=() live_id=() live_when=() live_workspace=() live_title=()
    local -a live_path=() live_key=() live_native=() live_when_epoch=()
    local -a live_started=()
    local -A annotation_map=() ordinal_map=()
    local annotations_batched=1
    while IFS=$'\x1f' read -r provider session_id started started_epoch \
                              when when_epoch workspace \
                              native_name title path; do
        [[ -n "$provider" && -n "$session_id" ]] || continue
        live_provider+=("$provider")
        live_when_epoch+=("$when_epoch")
        live_id+=("$session_id")
        live_started+=("$started")
        live_when+=("$when")
        live_workspace+=("$workspace")
        live_native+=("$native_name")
        live_title+=("$title")
        live_path+=("$path")
        live_key+=("$provider/$session_id")
    done < <(native_session_rows)
    load_session_ordinals
    now="$(date +%s)"
    # 一次读完，别一行起一次 jq。读不动就退回逐条，批量只是优化。
    load_all_annotations || annotations_batched=0
    # **先剔掉不显示的，再发短号。**
    #
    # 短号发出去就不收回（那正是它作为坐标的价值）。所以给一条永远不会显示的空
    # 会话发一个号，等于把后面每一条可见会话的号往后推一格——而 Codex 每起一次
    # 就落一条 rollout，用不了多久 `ags ls` 的第一列就变成四位数了。
    #
    # 这一趟只是查一遍注解表（内存里的 map），不额外读盘。
    local scan probe
    local -a numbered_key=()
    for scan in "${!live_id[@]}"; do
        if (( annotations_batched == 1 )); then
            annotation_from_map "${live_key[$scan]}"
        else
            read_session_annotation "${live_provider[$scan]}" "${live_id[$scan]}"
        fi
        probe="${annotation_description:-${live_native[$scan]:-${annotation_summary:-${live_title[$scan]}}}}"
        [[ -n "$probe" ]] || (( annotation_pinned == 1 )) || continue
        numbered_key+=("${live_key[$scan]}")
    done
    (( ${#numbered_key[@]} == 0 )) || assign_session_ordinals "${numbered_key[@]}"
    local ordinal_key ordinal_value
    while IFS=$'\t' read -r ordinal_key ordinal_value; do
        [[ -n "$ordinal_key" ]] || continue
        ordinal_map["$ordinal_key"]="$ordinal_value"
    done < <(jq -r '.ids | to_entries[] | "\(.key)\t\(.value)"' \
        <<< "$session_ordinals_json" 2>/dev/null || true)

    local index ordinal started
    for index in "${!live_id[@]}"; do
        provider="${live_provider[$index]}"
        session_id="${live_id[$index]}"
        started="${live_started[$index]}"
        when="${live_when[$index]}"
        workspace="${live_workspace[$index]}"
        native_name="${live_native[$index]}"
        title="${live_title[$index]}"
        if (( annotations_batched == 1 )); then
            annotation_from_map "${live_key[$index]}"
        else
            read_session_annotation "$provider" "$session_id"
        fi
        marker=' '
        (( annotation_pinned == 0 )) || marker='*'
        # 人写的 > Agent 自己起的 > 我们总结的 > 原话第一行。
        #
        # Agent 自己起的名字排在我们的总结**前面**：那一份是它在会话里边干边起的，
        # 通常更准，而且不花钱。顺序反过来的话，`ags summarize --force` 会给一条
        # 本来就有好名字的 Claude 会话生成一份总结，然后**永久压住**那个好名字。
        # `title` 是原话的第一行、不是概括，所以垫底。
        description="${annotation_description:-${native_name:-${annotation_summary:-$title}}}"
        # 四个来源全空 = 这条会话里一个字都没有。Codex 只要起来就落一个 rollout
        # 文件，于是每次误敲、每个开完就关的窗口都在列表里占一行，而那一行**没有
        # 任何能用来认它的东西**——短号、时间、工作目录都指不出它是哪一条。列出来
        # 只会把真正干过活的会话往下挤。
        #
        # 置顶过的留着：那是明确说过「这条我要」的，藏起来就再也没有入口了。
        [[ -n "$description" ]] || (( annotation_pinned == 1 )) || continue
        ordinal="${ordinal_map[${live_key[$index]}]:--}"
        [[ -n "$ordinal" ]] || ordinal='-'
        terminal_menu_ids+=("live:$provider/$session_id")
        terminal_menu_agents+=("$(managed_agent_for_provider "$provider")")
        terminal_menu_args+=("$annotation_args")
        terminal_menu_details+=("$(format_launch_args "$annotation_args")")
        if [[ -z "$annotation_description" && -z "$native_name" &&
              -z "$annotation_summary" ]] &&
           [[ -z "$annotation_summary_stamp" ]]; then
            native_menu_missing=$((native_menu_missing + 1))
        fi
        rows+=("$marker$ordinal"$'\t'"live"$'\t'"$provider"$'\t'"$started"$'\t'"$when"$'\t'"$(workspace_cell "$workspace" "$table_width")"$'\t'"$description")
    done

    if (( include_archives == 1 )); then
        while IFS=$'\t' read -r checkpoint_id agent saved_date description selector args; do
            [[ -n "$selector" ]] || continue
            [[ -n "$args" ]] || args='[]'
            archive_agent="${selector%%/*}"
            terminal_menu_ids+=("saved:$selector")
            terminal_menu_agents+=("$archive_agent")
            terminal_menu_args+=("$args")
            terminal_menu_details+=("$(format_launch_args "$args")")
            # 存档没有短号：那一列的含义是"敲这个数字能打开它"，而存档要用它自己
            # 的检查点 ID。ID 挪到工作区那一栏，因为存档本来就不显示工作区。
            rows+=(" -"$'\t'"saved"$'\t'"$archive_agent"$'\t'"$saved_date"$'\t'"$checkpoint_id"$'\t'"$description")
        done < <(list_checkpoint_root local "$local_checkpoints" 1)
    fi

    (( ${#rows[@]} > 0 )) || return 0
    # 和存档菜单同一个渲染器，理由也一样：描述常是中文，一个汉字两列宽，靠
    # `printf '%-*s'` 数字节会把高亮条撕开。
    if (( for_menu == 1 )); then
        mapfile -t rendered < <(
            {
                printf '#\tKIND\tAGENT\tSTARTED\tACTIVE\tWORKSPACE\tDESCRIPTION\n'
                printf '%s\n' "${rows[@]}"
            } | render_checkpoint_table 2 1 7
        )
    else
        mapfile -t rendered < <(
            {
                printf '#\tKIND\tAGENT\tSTARTED\tACTIVE\tWORKSPACE\tDESCRIPTION\n'
                printf '%s\n' "${rows[@]}"
            } | render_checkpoint_table 0 0 7
        )
    fi
    if (( ${#rendered[@]} == ${#rows[@]} + 1 )); then
        terminal_menu_header="${rendered[0]}"
        terminal_menu_labels=("${rendered[@]:1}")
    else
        terminal_menu_labels=("${rows[@]//$'\t'/  }")
    fi
}

# 接着上次干：直接把恢复交给 Agent 自己。
#
# 会话还活着的时候，什么都不用还原。AGS 存档的那条路要解包、要把字节写回 Agent 的
# home、要留回滚日志，全是因为那份副本是**冻结**的；活会话就在原地，`codex resume`
# / `claude --resume` 本来就能打开它。
#
# 这里仍然做的三件事，都是 AGS 比 Agent 多知道的：会话在哪个目录里干活、上次带的
# 是什么参数、以及这个会话是不是已经在另一个进程里开着。
resume_live_session() {
    local provider="$1" session_id="$2" agent launch_binary session_path workspace
    local -a client_args=()
    agent="$(managed_agent_for_provider "$provider")"
    if [[ -z "$agent" ]]; then
        show_foreign_resume_command "$provider" "$session_id"
        return 0
    fi
    read_session_annotation "$provider" "$session_id"
    # `--agent-args` 之后那一段是这次显式给的，**哪怕是空的**——`ags resume … --`
    # 的意思是"这次不要参数"，和"没说"必须分得开，否则会被记下来的参数覆盖回去。
    # 这和存档那条路的 `client_args_explicit` 是同一条规矩。
    if [[ "${3:-}" == --agent-args ]]; then
        shift 3
        client_args=("$@")
    else
        decode_launch_args "$annotation_args" ||
            die "saved Agent arguments are unreadable; resume with -- ARGS"
        client_args=(${launch_args_decoded[@]+"${launch_args_decoded[@]}"})
    fi
    # 和存档恢复同一条规矩，理由也一样：AGS 马上就要自己拼出 `resume <id>` /
    # `--resume <id>`，记录里再带一个选择，两个客户端都让**后面**那个赢，于是打开
    # 的是另一个会话。菜单里手敲进去的参数也走这里。
    strip_session_selection_args "$agent" "${client_args[@]}"
    if (( ${#client_args[@]} != ${#stripped_launch_args[@]} )); then
        client_args=("${stripped_launch_args[@]}")
        log "dropped native session selection from $agent arguments"
    fi
    if [[ "$agent" == codex ]]; then
        validate_codex_context_args "${client_args[@]}"
    else
        validate_claude_context_args "${client_args[@]}"
    fi
    session_path="$(find_session_file "$agent" "$session_id")"
    workspace="$(native_session_workspace "$provider" "$session_id")"
    resolve_resume_cwd "${ags_cwd_option:-}" "${workspace:-unknown}"
    cd -- "$resolved_resume_cwd"
    if [[ "$agent" == codex ]]; then
        assert_native_session_inactive "$agent" "$codex_home" "$session_id"
    else
        assert_native_session_inactive "$agent" "$claude_home" "$session_id"
    fi
    launch_binary="$(resolve_agent_binary "$agent")"
    export_launch_args "${client_args[@]}"
    launch_terminal_title_mode=resume
    launch_terminal_title="${session_id:0:8}"
    case "$agent" in
        codex)
            launch_managed_agent "$launch_binary" "$agent" \
                resume "$session_id" ${client_args[@]+"${client_args[@]}"}
            ;;
        claude)
            launch_managed_agent "$launch_binary" "$agent" \
                --resume "$session_id" ${client_args[@]+"${client_args[@]}"}
            ;;
    esac
}

# 这个会话的工作目录。
#
# 从 ags 现读一次而不是在列表里带着走：列表那行是给人看的（可能只有仓库名），
# 而 `cd` 需要的是完整路径。
native_session_workspace() {
    local provider="$1" session_id="$2" binary
    converter_cli --json list --all-workspaces --sort date \
        --limit "$(native_session_limit)" 2>/dev/null |
        jq -r --arg provider "$provider" --arg id "$session_id" '
            (.items // [])
            | map(select(.provider == $provider and .session_id == $id))
            | (.[0].workspace // "") | tostring' 2>/dev/null
}

# AGS 不负责启动的 Agent：把它自己的恢复命令说出来，不代跑。
#
# 代跑要么 `eval` 一个字符串，要么在这里替十几个 Agent 各写一遍它们的命令行规则。
# 前者是这个文件到处在躲的东西，后者是把 ags 已经知道的事再抄一份。
show_foreign_resume_command() {
    local provider="$1" session_id="$2" binary command
    binary="$(resolve_ags_converter_binary)"
    command="$(converter_cli --json info "$session_id" 2>/dev/null |
        jq -r '.resume_command // ""' 2>/dev/null)"
    if [[ -n "$command" ]]; then
        log "$provider 会话要用它自己的命令打开："
        printf '  %s\n' "$command"
    else
        log "AGS 不启动 ${provider}；用它自己的客户端打开 $session_id"
    fi
}

# 把这个原生会话导出成一份存档。
#
# `ags save` 一直做的就是「把这个会话的全部数据抄一份压缩存起来」，改的只是它接受
# 谁：以前只认自己起的、正在跑的那个会话（从环境变量里读），现在从列表里挑一个就
# 行——列表里的会话多半早就结束了，也多半不是 AGS 起的。
save_live_session() {
    local provider="$1" session_id="$2" description="${3:-}" agent archive_id native_home
    agent="$(managed_agent_for_provider "$provider")"
    [[ -n "$agent" ]] ||
        die "AGS 只导出 Codex 和 Claude 的会话；${provider} 不在其中"
    if [[ -z "$description" ]]; then
        read_session_annotation "$provider" "$session_id"
        description="${annotation_description:-$session_id}"
    fi
    # 存档 ID 带上时刻。同一个会话在两个时间点各存一份是这个功能存在的理由——
    # 「回到我按过 save 的那些点」——所以拿会话 ID 本身当存档 ID 会让第二次保存被
    # `checkpoint ID already exists` 顶回去，把唯一的用法挡在门外。
    archive_id="${session_id:0:8}-$(date +%y%m%d-%H%M%S)"
    if [[ "$agent" == codex ]]; then native_home="$codex_home"; else native_home="$claude_home"; fi
    # 会话还开着的时候不能立刻抄。
    #
    # 归档抄的是原生字节本身，而一个正在跑的会话此刻可能正写到一行 JSONL 的一半；
    # 抄下来的那份就带着半行，恢复时才发现。`queue_checkpoint` 存在就是为了这个：
    # 记一条待办，等 Agent 的 Stop 钩子落地后再真正写归档。
    #
    # 会话已经结束的（列表里绝大多数都是）没有这个问题，也没有任何钩子会来替它
    # 落地——所以那条路必须是立刻写完，否则「按了 s 却什么都没出现」。
    if active_native_session_pid "$agent" "$native_home" "$session_id" >/dev/null; then
        queue_checkpoint local "$agent" "$session_id" "$archive_id" "$description"
        log "会话正在运行；归档已排队，等它这一轮结束后落地"
    else
        save_checkpoint local "$agent" "$session_id" "$archive_id" "$description"
    fi
}

# 删掉一个原生会话。
#
# 删的是 **Agent 自己 home 里的文件**，所以规矩比删存档严：
#
# - pin 住的不删。pin 的意思就是「别动它」，而这是唯一一个不可逆的动作。
# - Claude 的会话不只是那个 `.jsonl`：`file-history/<id>`、`tasks/<id>`、
#   `session-env/<id>` 三棵子树也是它的。删主文件不删它们，留下的是一堆没有会话
#   指向的孤儿目录。这里删的范围和 `ags save` 抄的范围**是同一份清单**，两边不能
#   各写各的。
# - 存档不受影响：那是另一个目录里的另一份字节。先 `s` 导出再删，就是安全的删法。
delete_live_session() {
    local provider="$1" session_id="$2" agent session_path session_tree
    agent="$(managed_agent_for_provider "$provider")"
    [[ -n "$agent" ]] ||
        die "AGS 只删 Codex 和 Claude 的会话；${provider} 的会话请用它自己的客户端删"
    read_session_annotation "$provider" "$session_id"
    (( annotation_pinned == 0 )) ||
        die "会话 ${session_id} 被 pin 住了；先取消 pin 再删"
    assert_native_session_inactive "$agent" \
        "$( [[ "$agent" == codex ]] && printf '%s' "$codex_home" || printf '%s' "$claude_home" )" \
        "$session_id"
    session_path="$(find_session_file "$agent" "$session_id")"
    rm -f -- "$session_path"
    if [[ "$agent" == claude ]]; then
        session_tree="${session_path%.jsonl}"
        rm -rf -- "$session_tree" \
            "$claude_home/file-history/$session_id" \
            "$claude_home/tasks/$session_id" \
            "$claude_home/session-env/$session_id"
    fi
    rm -f -- "$(session_annotation_file "$provider" "$session_id" || true)"
    printf 'status=deleted\nprovider=%s\nsession_id=%s\npath=%s\n' \
        "$provider" "$session_id" "$session_path"
}

toggle_session_pin() {
    local provider="$1" session_id="$2"
    read_session_annotation "$provider" "$session_id"
    if (( annotation_pinned == 1 )); then
        write_session_annotation "$provider" "$session_id" \
            "$annotation_description" "$annotation_args" 0
        printf 'unpinned\n'
    else
        write_session_annotation "$provider" "$session_id" \
            "$annotation_description" "$annotation_args" 1
        printf 'pinned\n'
    fi
}

split_live_selector() {
    local body="${1#live:}"
    selected_provider="${body%%/*}"
    selected_session_id="${body#*/}"
    [[ -n "$selected_provider" && -n "$selected_session_id" &&
       "$selected_provider" != "$body" ]] ||
        die "unreadable session selector: $1"
}

# 这条会话是不是已经不写了。
#
# 判据就是文件多久没被动过。没有比这更准的信号：ags 启动 Agent 是 `exec` 过去的，
# 进程被顶掉、再也回不来，所以"会话结束了"这件事 ags 根本收不到通知。
#
# 为什么要这个判据：总结的缓存按 `(大小, mtime)` 失效，而**一条还在写的会话每次都
# 会重算**——文件一直在长，指纹一直在变。自动补描述如果不挡住活会话，就会对着同
# 几条会话反复付钱，而且算出来的东西下一分钟就过期。
session_is_settled() {
    local last="$1" now="$2" idle="${3:-}"
    [[ -n "$idle" ]] || idle="${AGS_SUMMARY_IDLE_SECONDS:-600}"
    [[ "$idle" =~ ^[0-9]{1,6}$ ]] || idle=600
    [[ "$last" =~ ^[0-9]+$ ]] || return 1
    (( last > 0 )) || return 1
    (( now - last >= idle ))
}

# 该不该在这次 `ags ls` 之后顺手补一轮描述。
#
# 三道闸，缺一不可：
#
#   - `AGS_AUTO_SUMMARY=0` 直接关掉。这件事要花钱，必须留一个不用读文档就能想到
#     的开关。
#   - 有节流。`ls` 是随手就敲的命令，每次都起一轮后台任务等于给自己开了个循环。
#   - 真的有活要干。没有缺描述的会话就不起进程——起一个只为了发现无事可做，是
#     纯粹的浪费。
auto_summary_should_run() {
    local stamp interval now last
    [[ "${AGS_AUTO_SUMMARY:-1}" != 0 ]] || return 1
    interval="${AGS_AUTO_SUMMARY_INTERVAL:-900}"
    [[ "$interval" =~ ^[0-9]{1,7}$ ]] || interval=900
    now="$(date +%s 2>/dev/null)" || return 1
    stamp="$state/auto-summary.stamp"
    if [[ -f "$stamp" ]]; then
        last="$(cat "$stamp" 2>/dev/null || printf 0)"
        [[ "$last" =~ ^[0-9]+$ ]] || last=0
        (( now - last >= interval )) || return 1
    fi
    mkdir -p "$state" 2>/dev/null || true
    printf '%s\n' "$now" > "$stamp" 2>/dev/null || true
    return 0
}

# 看完列表之后，顺手把没名字的补上——如果值得。
#
# 为什么挂在 `ls` 上而不是定时任务：ags 没有常驻进程，装一个 cron/systemd timer
# 意味着一套新的安装、卸载、状态查询接口，而"看列表"本来就是唯一会在意名字好不好
# 认的时刻。看得越勤，补得越勤；不看就不花钱。
maybe_start_background_summary() {
    (( ${native_menu_missing:-0} > 0 )) || return 0
    auto_summary_should_run || return 0
    log "后台补 ${native_menu_missing} 条描述（AGS_AUTO_SUMMARY=0 关掉）"
    start_background_summary
}

# 起一轮后台补描述。
#
# 后台而不是当场做：一条会话一次模型调用，几十条就是几十次往返，而 `ls` 应该是
# 秒回的。输出全部丢进日志文件——交互菜单此刻正占着终端，往 stderr 写一行就会把
# 画面撕开。
start_background_summary() {
    local log="$state/auto-summary.log"
    mkdir -p "$state" 2>/dev/null || true
    # `setsid` 而不是一个裸 `&`：裸 `&` 起的活儿和 `ags ls` 在同一个进程组里，
    # `ls` 一退出它就跟着没了——实测只写下第一行日志就断了。补描述要跑几十秒，
    # 必须活得比起它的那条命令长，所以单独开一个会话组。
    #
    # 走 `ags checkpoint` 这个入口而不是在本进程里起子 shell：那样新进程有自己
    # 干净的一份状态，不会因为父进程正占着终端而互相干扰。
    local binary
    binary="$(resolve_ags_converter_binary 2>/dev/null)" || return 0
    if command -v setsid >/dev/null 2>&1; then
        setsid "$binary" checkpoint summarize \
            >"$log" 2>&1 </dev/null &
    else
        # 没有 setsid（部分 macOS）就退回本进程后台，并挡住挂断信号。
        ( trap '' HUP INT; summarize_native_sessions 0 0 ) \
            >"$log" 2>&1 </dev/null &
    fi
    disown 2>/dev/null || true
    return 0
}

# 把缺总结的会话补齐。
#
# 单独一个动作而不是 `ls` 顺手做掉：每条要调一次模型，几十条就是几十次往返，
# 而 `ls` 是这个工具里最该秒回的命令。列表平时用缓存里的总结，缓存里没有就退回
# 标题——那已经比十六进制 ID 好认得多。
#
# 一条失败不影响别条：模型超时、这条会话人一句话没说、`codex` 太老，都只是这一行
# 继续用标题而已。
summarize_native_sessions() {
    local force="${1:-0}" settled_only="${2:-0}"
    local provider session_id started started_epoch when when_epoch
    local workspace native_name title path
    local made=0 kept=0 failed=0 busy=0 now
    local -a queue_provider=() queue_id=() queue_path=() queue_title=() queue_native=()
    local -a queue_when=()
    need jq
    while IFS=$'\x1f' read -r provider session_id started started_epoch \
                              when when_epoch workspace \
                              native_name title path; do
        [[ -n "$provider" && -n "$session_id" ]] || continue
        # 这里要的是**最后活动**时间，不是启动时间：`--settled` 判的是"这条会话安静
        # 了多久"，拿启动时间去判会把一条开了三天、五分钟前还在写的会话当成静止的。
        queue_when+=("$when_epoch")
        queue_provider+=("$provider")
        queue_id+=("$session_id")
        queue_path+=("$path")
        queue_title+=("$title")
        queue_native+=("$native_name")
    done < <(native_session_rows)
    (( ${#queue_id[@]} > 0 )) || { log "没有会话"; return 0; }
    now="$(date +%s)"
    log "总结 ${#queue_id[@]} 条会话（已有的跳过）…"
    local index
    for index in "${!queue_id[@]}"; do
        provider="${queue_provider[$index]}"
        session_id="${queue_id[$index]}"
        # 名字直接从行里取。以前这里为每条会话单独跑一次 `ags convert info`——上百条会话
        # 就是上百次进程启动，而这个值列表本来就已经拿到了。
        native_name="${queue_native[$index]}"
        # 还在写的会话跳过：它的总结下一分钟就过期，而缓存指纹一定不命中，等于
        # 每一轮都为同一条会话再付一次钱。
        if (( settled_only == 1 )) && ! session_is_settled "${queue_when[$index]}" "$now"; then
            busy=$((busy + 1)); continue
        fi
        # 一个字都没有的会话不总结：模型没有任何输入可读，只会回一句废话，而每一
        # 条都要花钱。这些会话在 `ags ls` 里本来也不显示。
        if [[ -z "$native_name" && -z "${queue_title[$index]}" ]]; then
            kept=$((kept + 1)); continue
        fi
        read_session_annotation "$provider" "$session_id"
        if [[ -n "$annotation_description" ]] ||
           { (( force == 0 )) && [[ -n "$native_name" ]]; }; then
            kept=$((kept + 1)); continue
        fi
        if (( force == 0 )) && [[ -n "$annotation_summary_stamp" ]] &&
           [[ "$annotation_summary_stamp" == "$(session_content_stamp "${queue_path[$index]}")" ]]; then
            kept=$((kept + 1)); continue
        fi
        if (( force == 0 && annotation_summary_at > 0 )) &&
           (( now - annotation_summary_at < ${AGS_SUMMARY_REFRESH_SECONDS:-3600} )); then
            kept=$((kept + 1)); continue
        fi
        if ensure_session_summary "$provider" "$session_id" \
               "${queue_path[$index]}" "$native_name" "$force"; then
            read_session_annotation "$provider" "$session_id"
            made=$((made + 1))
            log "  ${provider}/${session_id:0:8} → ${annotation_summary}"
        else
            failed=$((failed + 1))
        fi
    done
    if (( busy > 0 )); then
        log "总结完成：新增 ${made}，跳过 ${kept}，还在写的 ${busy}，没算出来 ${failed}"
    else
        log "总结完成：新增 ${made}，跳过 ${kept}，没算出来 ${failed}"
    fi
    push_pool_descriptions || true
}

# 把算好的描述推给凭据池，让后台的会话列表也能看懂。
#
# neburst 那一页显示的是 `cwd` 或者 `device_id`——一个说不出这条会话在干什么，另一
# 个是 `Algorithm-fd30aaf8…` 这样的哈希。这里推上去的就是本地列表里那一列。
#
# **怎么把本地的 rollout 和服务端那一行对上。** 问服务端要这把密钥自己的活会话，
# 它连 `device_id`、`ags_id`、`cwd`、`started_at` 一起发回来，然后两条规则依次试：
#
#   1. **`ags_id` 恰好就是 rollout ID。** 实测七条里有五条是这样（会话从
#      `ags resume <id>` 起来，名字就是那个 ID）。这一条是精确匹配，没有猜的成分。
#   2. **同一个目录、几乎同一个时刻。** 另外两条的名字是自动生成的
#      `<目录>-<年.月.日>-<时.分.秒>`，和 rollout ID 无关。ags 上报完立刻 `exec`
#      成 codex，所以那条 rollout 的开始时刻就落在上报之后的几秒内。
#
# 两条都对不上就不推。宁可后台少一句描述，也不能把 A 会话的描述挂到 B 会话上——
# 那比没有描述糟得多，因为它看起来是对的。
#
# 之前这里是靠 ags 自己在启动时留一份本地记录来配对的。不需要了：服务端本来就
# 存着 cwd 和起始时刻，问它要比自己记一份更准，也少一份会过期的状态。
#
# 全程不报错：这是一件锦上添花的事，没有理由让它拦住任何东西。
push_pool_descriptions() {
    local config url key remote local_rows pairs
    local device_id session_id description pushed=0 skipped=0
    command -v jq >/dev/null 2>&1 || return 0
    command -v curl >/dev/null 2>&1 || return 0
    config="$(codex_pool_config_path)"
    [[ -s "$config" ]] || return 0
    url="$(jq -er '.base_url' "$config" 2>/dev/null)" || return 0
    key="$(jq -er '.key' "$config" 2>/dev/null)" || return 0

    remote="$(curl -sS $codex_pool_curl_redirect --connect-timeout 6 --max-time 15 -X POST \
        -H "X-Codex-Pool-Token: $key" "$url$codex_pool_prefix/sessions" 2>/dev/null |
        jq -c '[(.data.sessions // [])[] | select((.device_id // "") != "")]' 2>/dev/null)" || return 0
    [[ -n "$remote" && "$remote" != "[]" ]] || return 0

    local_rows="$(converter_cli --json list --all-workspaces \
        --sort date --limit "$(native_session_limit)" 2>/dev/null |
        jq -c '[(.items // [])[]
               | select(.provider == "codex")
               | {session_id, workspace: (.workspace // ""),
                  started_at: (((.started_at // 0) / 1000) | floor)}]' 2>/dev/null)" || return 0
    [[ -n "$local_rows" ]] || return 0

    # 服务端发的是北京时间的裸字符串（见 CodexSession.timestamp），本地是 epoch。
    # 补上 +08:00 再转，这样两边比的是同一条时间轴上的秒数。
    pairs="$(jq -rn --argjson remote "$remote" --argjson local "$local_rows" '
        def window: 180;
        def epoch($text): ($text + "+08:00")
            | try (strptime("%Y-%m-%d %H:%M:%S%z") | mktime) catch null;
        $remote[]
        | . as $row
        | ((($local | map(select(.session_id == $row.ags_id)) | .[0])
            // (epoch($row.started_at // "") as $started
                | if $started == null then null
                  else ($local
                        | map(select(.workspace == ($row.cwd // "")
                                     and .started_at >= ($started - 5)
                                     and .started_at <= ($started + window)))
                        | sort_by(.started_at) | .[0])
                  end))) as $match
        | select($match != null)
        | [$row.device_id, $match.session_id] | @tsv
    ' 2>/dev/null)" || return 0
    [[ -n "$pairs" ]] || { log "凭据池里的会话没有一条能和本地对上，没推描述"; return 0; }

    while IFS=$'\t' read -r device_id session_id; do
        [[ -n "$device_id" && -n "$session_id" ]] || continue
        read_session_annotation codex "$session_id"
        description="${annotation_description:-${annotation_summary:-}}"
        if [[ -z "$description" ]]; then
            skipped=$((skipped + 1))
            continue
        fi
        if curl -sS $codex_pool_curl_redirect --connect-timeout 4 --max-time 8 -X POST \
            -H "X-Codex-Pool-Token: $key" -H 'Content-Type: application/json' \
            -d "$(jq -nc --arg d "$device_id" --arg t "$description" \
                  '{device_id: $d, description: $t}')" \
            "$url$codex_pool_prefix/session/description" >/dev/null 2>&1; then
            pushed=$((pushed + 1))
        fi
    done <<< "$pairs"
    (( pushed == 0 && skipped == 0 )) ||
        log "描述已同步到凭据池：推了 ${pushed} 条，${skipped} 条还没有描述"
    return 0
}

# Agent 自己给这条会话起的名字，没有就是空串。
native_session_name() {
    local provider="$1" session_id="$2" path="$3" binary
    converter_cli --json info "$session_id" --from "$provider" \
        ${path:+--source "$path"} 2>/dev/null |
        jq -r '.native_name // ""' 2>/dev/null
}

list_native_sessions() {
    local include_archives=0 menu_status selector action_output summarize=0
    local selected_provider selected_session_id
    while (( $# > 0 )); do
        case "$1" in
            -a|--all) include_archives=1; shift ;;
            -s|--summarize) summarize=1; shift ;;
            *) die "usage: ags ls [-a] [--summarize]" ;;
        esac
    done
    need column; need jq
    (( summarize == 0 )) || summarize_native_sessions
    if (( include_archives == 1 )); then
        load_local_storage
        need age; need tar
        load_encryption_identity
    fi

    if [[ ! -t 0 || ! -t 1 ]]; then
        load_native_session_menu "$include_archives" 0
        (( ${#terminal_menu_labels[@]} > 0 )) || return 0
        printf '%s\n' "$terminal_menu_header" "${terminal_menu_labels[@]}"
        maybe_start_background_summary
        return 0
    fi

    terminal_menu_notice=
    load_native_session_menu "$include_archives" 1
    maybe_start_background_summary
    if (( ${#terminal_menu_ids[@]} == 0 )); then
        log "no sessions"
        return 0
    fi
    while (( ${#terminal_menu_ids[@]} > 0 )); do
        if terminal_menu "Sessions" 1 1; then
            selector="$terminal_menu_selected"
            # 回车之后先问权限。忘记开 yolo / bypass 是这套工具里最常见的一次返工，
            # 而它只在**这个时刻**还来得及修——进程一交出去就晚了。
            #
            # Esc 是"我改主意了"，不是"用默认的"：退回列表，一个字都不改。
            if ! pick_permission_mode "$terminal_menu_selected_agent" \
                    "$terminal_menu_selected_args"; then
                terminal_menu_notice=
                continue
            fi
            terminal_menu_selected_args="$permission_pick_args_json"
            decode_launch_args "$terminal_menu_selected_args" ||
                die "saved Agent arguments are unreadable; resume with -- ARGS"
            case "$selector" in
                live:*)
                    split_live_selector "$selector"
                    # 菜单里改过的参数在这里落盘——包括刚选的那一档权限，所以下次
                    # 打开同一个会话，光标就停在你上次用的那一档上。改完直接回车
                    # 走人是最常见的用法，不写就等于没改。
                    read_session_annotation "$selected_provider" "$selected_session_id"
                    write_session_annotation "$selected_provider" "$selected_session_id" \
                        "$annotation_description" "$terminal_menu_selected_args" \
                        "$annotation_pinned"
                    resume_live_session "$selected_provider" "$selected_session_id" \
                        --agent-args ${launch_args_decoded[@]+"${launch_args_decoded[@]}"}
                    ;;
                saved:*)
                    # 菜单里的参数就是这次的决定，哪怕它是空的。走和命令行
                    # `--` 同一个开关，别再传一个位置参数——`--` 现在是 ags 自己
                    # 的参数区，`resume_checkpoint` 会把它当成第二个检查点标识
                    # 拒掉（`ags resume 只接受一个检查点标识：--`）。
                    ags_agent_args_given=1
                    ags_agent_args=(${launch_args_decoded[@]+"${launch_args_decoded[@]}"})
                    resume_checkpoint local "${selector#saved:}"
                    ;;
                *) die "unreadable session selector: $selector" ;;
            esac
            return
        else
            menu_status=$?
        fi
        case "$menu_status" in
            1) return 0 ;;
            2)
                selector="$terminal_menu_selected"
                case "$selector" in
                    live:*)
                        split_live_selector "$selector"
                        if action_output="$(
                            delete_live_session "$selected_provider" "$selected_session_id"
                        )"; then
                            terminal_menu_notice="Deleted ${selected_session_id:0:8}; any archive of it is untouched."
                        else
                            terminal_menu_notice="Not deleted: $(printf '%s' "$action_output" | tail -n 1)"
                        fi
                        ;;
                    saved:*)
                        if action_output="$(
                            delete_local_checkpoint "${selector#saved:}"
                        )" && grep -Fqx 'status=deleted' <<< "$action_output"; then
                            terminal_menu_notice="Deleted ${selector#saved:}; it remains recoverable."
                        else
                            terminal_menu_notice="Not deleted."
                        fi
                        ;;
                esac
                ;;
            3)
                selector="$terminal_menu_selected"
                case "$selector" in
                    live:*)
                        split_live_selector "$selector"
                        terminal_menu_notice="$(
                            toggle_session_pin "$selected_provider" "$selected_session_id"
                        ) ${selected_session_id:0:8}"
                        ;;
                    *) terminal_menu_notice='Only a live session can be pinned.' ;;
                esac
                ;;
            4)
                selector="$terminal_menu_selected"
                case "$selector" in
                    live:*)
                        split_live_selector "$selector"
                        if save_live_session "$selected_provider" "$selected_session_id" \
                            >/dev/null 2>&1; then
                            terminal_menu_notice="Saved ${selected_session_id:0:8}."
                        else
                            terminal_menu_notice="Could not save ${selected_session_id:0:8}."
                        fi
                        ;;
                    *) terminal_menu_notice='That one is already an archive.' ;;
                esac
                ;;
            *) die "session selector failed" ;;
        esac
        load_native_session_menu "$include_archives" 1
        if (( ${#terminal_menu_ids[@]} == 0 )); then
            printf '%s\n' "$terminal_menu_notice"
            return 0
        fi
    done
    return 0
}


# ---------------------------------------------------------------------------
# 保留期
# ---------------------------------------------------------------------------
#
# 两个 Agent 在这件事上**不对称**，所以 AGS 对它们做的事也不一样：
#
# - **Claude Code 自己会删。** 它有 `cleanupPeriodDays`，到期就把会话文件删掉。
#   AGS 因此**不自己删 Claude 的会话**，只把统一的期限写进它自己的设置，让它按这个
#   数字清。两套 GC 同时删同一批文件，出了问题没人能查清是谁删的。
# - **Codex 没有任何清理。** 它的 rollout 会一直堆下去（写这段时本机 2769 个、
#   13.7 GB）。这一半由 AGS 接管，真删。
#
# 三条硬规矩，写在这里而不是散在下面：
#
# 1. **没配置就不删。** 「保留期」这个概念以前在这套工具里不存在，任何默认值都会
#    在某个人的机器上删掉他没打算删的东西。
# 2. **手敲的那次只说不做，自动的那次会删。** `ags gc` 是 dry-run，真删要 `--yes`。
#    配了保留期之后，启动 Agent 会在后台跑一轮真删（每 `AGS_AUTO_GC_INTERVAL` 秒
#    最多一次，`AGS_AUTO_GC=0` 关掉）。
#
#    这里原来写的是"不挂任何自动触发——删别人 home 里的文件必须是有人按下去的"。
#    改掉它的理由是：Codex 的 rollout 一天堆几百兆而它自己从不清理，一个"要人记得
#    每周敲一次"的清理等于没有清理。**按下去的那一下改成了 `ags set retention`**
#    ——配置保留期本身就是那个授权动作，一台没配过的机器行为一个字都没变。
#
#    代价是必须说话：删完写一行进 report，下一次启动打出来（`announce_auto_gc`）。
#    自动删而不说，比不自动删糟得多。
# 3. **三类永不删**：pin 住的、已经导出过存档的、以及 AGS 认不出来的。「认不出来
#    就不动」是底线：这里动的是 Agent 自己的数据。
# 4. **一个字都没有的会话不等保留期。** Codex 只要起来就落一个 rollout 文件，于是
#    误敲、开完就关、起来发现走错目录的窗口全都留下一条会话。它们在 `ags ls` 里
#    已经不显示（四个描述来源全空，没有任何能用来认它的东西），留在磁盘上就只是
#    垃圾，等三十天没有意义。
#
#    两道闸和上面一样：pin 住的、存过档的不动。再加一道 `AGS_GC_EMPTY_IDLE_SECONDS`
#    （默认 3600 秒）——你正开着还没说话的那个窗口就是一条"空会话"，不能因为你还没
#    敲第一句话就把它的文件删了。
retention_config="$state/retention.json"

read_retention_days() {
    local agent="$1"
    [[ -s "$retention_config" ]] || return 1
    jq -er --arg agent "$agent" '
        .[$agent] | select(type == "number" and . >= 1 and . <= 3650) | floor
    ' "$retention_config" 2>/dev/null
}

# 到点了就在后台按保留期清一次。
#
# 挂在"启动 Agent"上而不是 cron / systemd timer / launchd：ags 没有常驻进程，装一个
# 定时器意味着一套新的安装、卸载、状态查询接口，还要在四个平台上各做一遍——而"启动
# Agent"是这台机器上一定会发生、频率又恰好合适的事件。每天开工一次，正好清一次。
#
# 三道闸门，任何一道不过就什么都不做：
#
# 1. `AGS_AUTO_GC=0` 关掉。
# 2. **codex 没配保留期就不跑。** Claude 那半是它自己按 `cleanupPeriodDays` 删的，
#    ags 一个文件都不碰，所以只有 codex 配了才有活儿干。这同时保住了那条老规矩：
#    没配置就不删。
# 3. 距上次不足 `AGS_AUTO_GC_INTERVAL`（默认 86400 秒）就不跑。
#
# 闸门通过就先写时间戳再干活，不是干完再写：后台那一轮可能失败、可能被 kill，如果
# 等它成功才记时间，一台每次都失败的机器会在**每一次启动**上都重跑一遍。
auto_gc_should_run() {
    local interval now last
    [[ "${AGS_AUTO_GC:-1}" != 0 ]] || return 1
    read_retention_days codex >/dev/null 2>&1 || return 1
    interval="${AGS_AUTO_GC_INTERVAL:-86400}"
    [[ "$interval" =~ ^[0-9]{1,9}$ ]] || interval=86400
    now="$(date +%s 2>/dev/null)" || return 1
    last=0
    if [[ -f "$auto_gc_stamp" && ! -L "$auto_gc_stamp" ]]; then
        last="$(cat -- "$auto_gc_stamp" 2>/dev/null)" || last=0
    fi
    [[ "$last" =~ ^[0-9]+$ ]] || last=0
    (( now - last >= interval )) || return 1
    mkdir -p "$state" 2>/dev/null || true
    printf '%s\n' "$now" > "$auto_gc_stamp" 2>/dev/null || true
    return 0
}

# 起一轮后台 gc。
#
# 后台而不是当场做：它要把整台机器的会话列一遍，还要解密存档核对哪些已经存过档
# （那是"永不删"的三类之一），几秒起步。而这条路一步之外就是 `exec` 进 Agent，
# 没有任何东西该挡在一次验证通过的启动和 Agent 之间。
#
# `setsid` 的理由和后台补描述那处一样：裸 `&` 起的活儿和当前进程同组，这个进程马上
# 要 `exec` 换成 Agent，同组的后台活儿会被一起带走。
#
# 走 `ags checkpoint gc` 这个入口而不是在本进程里起子 shell：本运行时给自己的工作
# 目录注册了 `rm -rf` 的 EXIT trap，fork 出来的子进程退出时会去跑那些 trap，把父
# 进程还在用的目录删掉。
start_background_gc() {
    local binary
    binary="$(resolve_ags_converter_binary 2>/dev/null)" || return 0
    mkdir -p "$state" 2>/dev/null || true
    if command -v setsid >/dev/null 2>&1; then
        setsid "$binary" checkpoint gc --agent codex --yes --auto \
            >"$auto_gc_log" 2>&1 </dev/null &
    else
        # 没有 setsid（部分 macOS）就退回本进程后台，并挡住挂断信号。
        ( trap '' HUP INT; ags_gc --agent codex --yes --auto ) \
            >"$auto_gc_log" 2>&1 </dev/null &
    fi
    disown 2>/dev/null || true
    return 0
}

maybe_start_background_gc() {
    auto_gc_should_run || return 0
    start_background_gc
}

# 把上一次自动 gc 删掉的东西报出来。
#
# **自动删而不说，是这套工具最不该有的行为。** 后台那一轮删完写一行进 report，
# 下一次启动打出来就把它删掉——报一次，不反复烦人。
#
# 和 update-check 同样的写法：读之前不测存在性，直接读并吞掉错误。这条路一步之外
# 就是 `exec` 进 Agent，`set -e` 下一个"测完到读之间文件没了"的竞态会直接终结它。
# 只认 `auto gc: ` 开头的行，别的一概不打——省得任何拿到这个文件的东西能借
# `[ags]` 这个前缀说话。
announce_auto_gc() {
    local recorded= line
    [[ "${AGS_AUTO_GC:-1}" != 0 ]] || return 0
    if [[ -f "$auto_gc_report" && ! -L "$auto_gc_report" ]]; then
        recorded="$(cat -- "$auto_gc_report" 2>/dev/null)" || recorded=
    fi
    [[ -n "$recorded" ]] || return 0
    rm -f -- "$auto_gc_report" 2>/dev/null || true
    while IFS= read -r line; do
        [[ "$line" == "auto gc: "* ]] || continue
        log "$line"
    done <<< "$recorded"
}

write_retention_days() {
    local agent="$1" days="$2" temporary existing='{}'
    [[ -s "$retention_config" ]] &&
        existing="$(jq -c 'if type == "object" then . else {} end' \
            "$retention_config" 2>/dev/null || printf '{}')"
    mkdir -p "$(dirname "$retention_config")"
    temporary="$(mktemp "$retention_config.XXXXXX")"
    jq -c --arg agent "$agent" --argjson days "$days" '.[$agent] = $days' \
        <<< "$existing" > "$temporary" ||
        { rm -f -- "$temporary"; die "cannot record the retention period"; }
    chmod 600 "$temporary"
    mv -- "$temporary" "$retention_config"
}

# 把期限交给 Claude 自己。
#
# 只改 `cleanupPeriodDays` 一个键，其余原样保留：这是**别人的**配置文件，里面还有
# 权限、钩子、MCP 服务器。整份重写会把它们一起赌上。
apply_claude_retention() {
    local days="$1" settings="$claude_home/settings.json" temporary existing='{}'
    mkdir -p "$claude_home"
    if [[ -s "$settings" ]]; then
        existing="$(jq -c . "$settings" 2>/dev/null)" ||
            die "Claude 的 settings.json 不是合法 JSON，先修好它再设保留期：$settings"
    fi
    temporary="$(mktemp "$settings.XXXXXX")"
    jq --argjson days "$days" '.cleanupPeriodDays = $days' <<< "$existing" \
        > "$temporary" ||
        { rm -f -- "$temporary"; die "cannot write $settings"; }
    # 权限跟随原文件，新建的走 600：这个文件里可能有别的东西。
    if [[ -f "$settings" ]]; then
        chmod --reference="$settings" "$temporary" 2>/dev/null || chmod 600 "$temporary"
    else
        chmod 600 "$temporary"
    fi
    mv -- "$temporary" "$settings"
}

configure_retention() {
    local agent= days= current
    while (( $# > 0 )); do
        case "$1" in
            --agent)
                (( $# >= 2 )) || die "--agent 需要 codex 或 claude"
                agent="$2"
                shift 2
                ;;
            *)
                [[ -z "$days" ]] || die "usage: ags set retention [--agent codex|claude] DAYS"
                days="$1"
                shift
                ;;
        esac
    done
    if [[ -z "$days" ]]; then
        for agent in codex claude; do
            if current="$(read_retention_days "$agent")"; then
                printf '%s=%s\n' "$agent" "$current"
            else
                printf '%s=unset\n' "$agent"
            fi
        done
        return 0
    fi
    [[ "$days" =~ ^[1-9][0-9]{0,3}$ ]] && (( days <= 3650 )) ||
        die "保留期要是 1 到 3650 之间的天数"
    if [[ -n "$agent" ]]; then
        [[ "$agent" == codex || "$agent" == claude ]] ||
            die "--agent 只接受 codex 或 claude"
        set -- "$agent"
    else
        set -- codex claude
    fi
    for agent in "$@"; do
        write_retention_days "$agent" "$days"
        if [[ "$agent" == claude ]]; then
            apply_claude_retention "$days"
            printf 'claude=%s (written to %s as cleanupPeriodDays)\n' \
                "$days" "$claude_home/settings.json"
        else
            printf 'codex=%s (ags gc deletes; a background sweep now runs at most once every %ss when an Agent starts — AGS_AUTO_GC=0 turns it off)\n' \
                "$days" "${AGS_AUTO_GC_INTERVAL:-86400}"
        fi
    done
}

# 已经导出过存档的会话 ID。
#
# 从存档本身读，不靠任何簿记：簿记会漏——在别处 `ags save` 过的、从别的机器同步
# 过来的，都不会在本机留下记号。存档是唯一权威的「这份数据我另外留了一份」。
saved_session_ids() {
    local file manifest
    [[ -d "${local_checkpoints:-}" ]] || return 0
    while IFS= read -r -d '' file; do
        if manifest="$(age_decrypt "$file" 2>/dev/null | tar -xzOf - manifest 2>/dev/null)"; then
            sed -n 's/^session_id=//p' <<< "$manifest"
        fi
    done < <(find "$local_checkpoints" -mindepth 2 -maxdepth 2 -type f \
        -name '*.checkpoint.tar.gz.age' -print0)
}

# 比这个时刻更早的都算过期。
retention_cutoff_millis() {
    local days="$1" now
    now="$(date +%s)"
    printf '%s\n' "$(( (now - days * 86400) * 1000 ))"
}

ags_gc() {
    local agent_filter= assume_yes=0 auto_mode=0 days agent cutoff
    local codex_days= removed_bytes=0
    local provider session_id when_ms workspace native_name title path
    local pinned_skipped=0 saved_skipped=0 removed=0 candidates=0 bytes=0
    local empty_candidates=0 empty_busy=0 empty_removed=0 reason now_s empty_idle
    local binary size
    local -a plan=()
    local -A saved=()
    while (( $# > 0 )); do
        case "$1" in
            --agent)
                (( $# >= 2 )) || die "--agent 需要 codex 或 claude"
                agent_filter="$2"
                [[ "$agent_filter" == codex || "$agent_filter" == claude ]] ||
                    die "--agent 只接受 codex 或 claude"
                shift 2
                ;;
            --yes) assume_yes=1; shift ;;
            --dry-run) shift ;;
            # 后台那一轮用的。它只改一件事：删完了往 report 里写一行，让**下一次
            # 启动 Agent** 把删了什么说出来。手敲 `ags gc` 的人当场就看见了输出，
            # 不需要这个。
            --auto) auto_mode=1; shift ;;
            *) die "usage: ags gc [--agent codex|claude] [--yes]" ;;
        esac
    done
    need jq
    now_s="$(date +%s)"
    empty_idle="${AGS_GC_EMPTY_IDLE_SECONDS:-3600}"
    [[ "$empty_idle" =~ ^[0-9]{1,6}$ ]] || empty_idle=3600
    # 先看有没有配置过保留期。没配置就什么都不做，而且**不该**在这之前去要求存储
    # 配置好——一台刚装完、还没 `ags set` 的机器上，`ags gc` 应该说"没配置保留期"，
    # 而不是报一个和保留期无关的存储错误。
    if ! read_retention_days codex >/dev/null && ! read_retention_days claude >/dev/null; then
        printf 'codex: 没有配置保留期，什么都不做（ags set retention --agent codex DAYS）\n'
        printf 'claude: 没有配置保留期，什么都不做（ags set retention --agent claude DAYS）\n'
        return 0
    fi
    load_local_storage
    need age; need tar
    load_encryption_identity
    binary="$(resolve_ags_converter_binary)"

    while IFS= read -r session_id; do
        [[ -n "$session_id" ]] || continue
        saved["$session_id"]=1
    done < <(saved_session_ids)

    for agent in codex claude; do
        [[ -z "$agent_filter" || "$agent_filter" == "$agent" ]] || continue
        if ! days="$(read_retention_days "$agent")"; then
            printf '%s: 没有配置保留期，什么都不做（ags set retention --agent %s DAYS）\n' \
                "$agent" "$agent"
            continue
        fi
        if [[ "$agent" == claude ]]; then
            # Claude 自己删。这里只核对一遍设置真的写进去了，然后把它会删掉什么
            # 报出来——**一个都不动**。
            printf 'claude: %s 天，由 Claude Code 自己按 cleanupPeriodDays 清理\n' "$days"
            printf 'claude: 当前设置 cleanupPeriodDays=%s\n' \
                "$(jq -r '.cleanupPeriodDays // "unset"' "$claude_home/settings.json" 2>/dev/null || printf 'unset')"
            continue
        fi
        codex_days="$days"
        cutoff="$(retention_cutoff_millis "$days")"
        printf 'codex: %s 天，早于这个时间的会话会被删；一个字都没有的会话不等保留期\n' "$days"
        while IFS=$'\x1f' read -r provider session_id when_ms workspace native_name title path; do
            [[ "$provider" == codex && -n "$session_id" && -n "$path" ]] || continue
            # 两个删的理由，先判便宜的那个。
            #
            # `expired` 和 `empty` 是互斥的分支而不是两个独立计数：一条又空又过期
            # 的会话只该在计划里出现一次，也只该被数一次。
            if (( when_ms < cutoff )); then
                reason=expired
            elif [[ -z "$native_name" && -z "$title" ]]; then
                reason=empty
            else
                continue
            fi
            read_session_annotation "$provider" "$session_id"
            if [[ "$reason" == empty ]]; then
                # 剩下两个描述来源在注解里。任何一个有值，这条会话就不是空的
                # ——`ags ls` 也还在显示它，删掉就是删一条你看得见的会话。
                [[ -z "$annotation_description" && -z "$annotation_summary" ]] || continue
                # 你正开着、还没敲第一句话的那个窗口，此刻就是一条"空会话"。
                if ! session_is_settled "$(( when_ms / 1000 ))" "$now_s" "$empty_idle"; then
                    empty_busy=$((empty_busy + 1))
                    continue
                fi
                empty_candidates=$((empty_candidates + 1))
            else
                candidates=$((candidates + 1))
            fi
            if (( annotation_pinned == 1 )); then
                pinned_skipped=$((pinned_skipped + 1))
                continue
            fi
            if [[ -n "${saved[$session_id]:-}" ]]; then
                saved_skipped=$((saved_skipped + 1))
                continue
            fi
            [[ -f "$path" ]] || continue
            size="$(stat -c %s -- "$path" 2>/dev/null || printf 0)"
            bytes=$((bytes + size))
            plan+=("$session_id"$'\t'"$path"$'\t'"$reason")
        done < <(gc_candidate_rows "$binary")
    done

    printf '过期 %s 个；空会话 %s 个（还在写的跳过 %s）；pin 跳过 %s，已存档跳过 %s；可删 %s，合计 %s MiB\n' \
        "$candidates" "$empty_candidates" "$empty_busy" \
        "$pinned_skipped" "$saved_skipped" "${#plan[@]}" \
        "$(( bytes / 1048576 ))"
    (( ${#plan[@]} > 0 )) || return 0
    if (( assume_yes == 0 )); then
        # 空会话在这一屏里要能一眼认出来：它没有描述，路径也长得和别的一样，不标
        # 出来的话看到的就是一串「这些是什么」。
        printf '%s\n' "${plan[@]}" |
            awk -F'\t' '{ printf "%s%s\n", $2, ($3 == "empty" ? "  ← 空会话" : "") }'
        printf '这是 dry-run，什么都没删。真要删：ags gc --yes（想留哪个先 ags ls 里按 p，或按 s 存一份）\n'
        return 0
    fi
    local entry
    for entry in "${plan[@]}"; do
        IFS=$'\t' read -r session_id path reason <<< "$entry"
        # 删之前再核一遍：dry-run 和真删之间可能过了很久，会话可能又活了。
        if active_native_session_pid codex "$codex_home" "$session_id" >/dev/null; then
            log "跳过 ${session_id}：它现在正在运行"
            continue
        fi
        read_session_annotation codex "$session_id"
        (( annotation_pinned == 0 )) || { log "跳过 ${session_id}：已 pin"; continue; }
        [[ -z "${saved[$session_id]:-}" ]] || { log "跳过 ${session_id}：已存档"; continue; }
        # 大小要在 rm **之前**取。计划阶段那次 stat 统计的是候选，而候选和真删
        # 之间会被上面三道复核刷掉一部分，拿它当"省下多少"会虚报。
        size="$(stat -c %s -- "$path" 2>/dev/null || printf 0)"
        rm -f -- "$path" || { log "删不掉：$path"; continue; }
        rm -f -- "$(session_annotation_file codex "$session_id" || true)"
        removed=$((removed + 1))
        [[ "$reason" != empty ]] || empty_removed=$((empty_removed + 1))
        removed_bytes=$((removed_bytes + size))
        printf 'deleted=%s\n' "$path"
    done
    printf '删了 %s 个（其中空会话 %s 个）\n' "$removed" "$empty_removed"
    if (( auto_mode == 1 && removed > 0 )); then
        mkdir -p "$state" 2>/dev/null || true
        printf 'auto gc: 按 %s 天的保留期删了 %s 个 Codex 会话（其中 %s 个是一个字都没有的空会话），省下 %s MiB（%s，AGS_AUTO_GC=0 关掉）\n' \
            "${codex_days:-?}" "$removed" "$empty_removed" "$(( removed_bytes / 1048576 ))" \
            "$auto_gc_log" > "$auto_gc_report" 2>/dev/null || true
    fi
}

# gc 用的会话清单。
#
# 和 `ags ls` 不一样：这里要的是**全部**，不是最近的一屏。`--limit` 给到上限，
# 因为过期的那些按定义就在列表的尾巴上，取前 50 条永远看不到它们。
#
# **分隔符是 `\x1f`，不是 tab。** 这里以前用 `@tsv`，能用是因为那时候没有一个字段
# 可能是空的。加进 `native_name` 之后就不行了：tab 是 IFS 里的空白字符，bash 的
# `read` 会把连着的两个 tab 当成一个分隔符，于是一条没有 `native_name` 的会话读出来
# 整行右移一格——`title` 落进 `native_name`、`path` 落进 `title`、`path` 是空的。
# 结果是 gc 一个文件都删不了，而且不报错。`native_session_rows` 早就是 `\x1f` 了，
# 同一个原因。
gc_candidate_rows() {
    local binary="$1"
    converter_cli --json list --all-workspaces --sort date --limit 9999 2>/dev/null |
        jq -r '
            (.items // [])
            | .[]
            | [ .provider,
                .session_id,
                (((.last_active_at // .started_at // 0) | floor) | tostring),
                ((.workspace // .workspace_name // "") | tostring | gsub("[\t\r\n]"; " ")),
                ((.native_name // "") | tostring | gsub("[\t\r\n]"; " ")),
                ((.title // "") | tostring | gsub("[\t\r\n]"; " ")),
                ((.path // "") | tostring)
              ]
            | map(tostring) | join("\u001f")' 2>/dev/null
}

list_local_checkpoints() {
    local menu_status delete_status delete_output
    (( $# == 0 )) || die "usage: ags list"
    load_local_storage
    need age; need column; need jq; need tar
    load_encryption_identity
    if [[ -t 0 && -t 1 ]]; then
        terminal_menu_notice=
        load_local_checkpoint_menu
        if (( ${#terminal_menu_ids[@]} == 0 )); then
            log "no local checkpoints"
            return 0
        fi
        while (( ${#terminal_menu_ids[@]} > 0 )); do
            if terminal_menu "Saved AGS sessions" 1; then
                # 和 `ags ls` 同一条路：还原出来的也是一个真的 Agent 进程，忘记开
                # 权限一样要重来一遍。
                if ! pick_permission_mode "$terminal_menu_selected_agent" \
                        "$terminal_menu_selected_args"; then
                    terminal_menu_notice=
                    continue
                fi
                terminal_menu_selected_args="$permission_pick_args_json"
                # Always explicit, including when the menu holds no arguments:
                # the flag is what tells resume the caller decided, so clearing
                # the arguments in the menu is honoured instead of being refilled
                # from the checkpoint.
                #
                # It travels as `ags_agent_args_given`, not as a positional
                # `--`: `--` is ags's own argument section now, so resume reads
                # a trailing one as a second checkpoint id and refuses the whole
                # launch. Opening an archive from this menu died that way —
                # invisibly, because the only test that drives it runs under a
                # pseudo-terminal and the failure was a bare exit code.
                decode_launch_args "$terminal_menu_selected_args" ||
                    die "saved Agent arguments are unreadable; resume with -- ARGS"
                ags_agent_args_given=1
                ags_agent_args=(${launch_args_decoded[@]+"${launch_args_decoded[@]}"})
                resume_checkpoint local "$terminal_menu_selected"
                return
            else
                menu_status=$?
            fi
            case "$menu_status" in
                1) return 0 ;;
                2)
                    delete_output=
                    delete_status=0
                    if delete_output="$(
                        delete_local_checkpoint "$terminal_menu_selected"
                    )"; then
                        delete_status=0
                    else
                        delete_status=$?
                    fi
                    if grep -Fqx 'status=deleted' <<< "$delete_output"; then
                        if grep -Fqx 'sync_status=pending' <<< "$delete_output"; then
                            terminal_menu_notice="Deleted locally; remote synchronization is queued."
                        else
                            terminal_menu_notice="Deleted $terminal_menu_selected; it remains recoverable."
                        fi
                        load_local_checkpoint_menu
                        if (( ${#terminal_menu_ids[@]} == 0 )); then
                            printf '%s\n' "$terminal_menu_notice"
                            return 0
                        fi
                    else
                        [[ -z "$delete_output" ]] || printf '%s\n' "$delete_output"
                        (( delete_status != 0 )) && return "$delete_status"
                        die "checkpoint deletion did not report a committed result"
                    fi
                    ;;
                *) die "checkpoint selector failed" ;;
            esac
        done
        return 0
    fi
    {
        printf 'ID\tAGENT\tSAVED\tDESCRIPTION\n'
        list_checkpoint_root local "$local_checkpoints" | LC_ALL=C sort -t $'\t' -k1,1 -k2,2
    } | render_checkpoint_table
}

show_local_checkpoint() {
    local checkpoint_id="${1:-}" tmp unpack manifest format kind saved_id saved_record_id
    local agent session_id description created_utc saved_pwd relative fidelity artifact_metadata
    local artifact_count artifact_size artifact_index_sha256 verified_count=0 verified_size=0
    local row_sha256 row_size row_relative row_mode row_mtime row_extra artifact actual_count checksum
    local binary_invoked binary_real binary_version binary_resolution
    local binary_sha binary_os binary_arch
    local selected_binary=unavailable configured_remotes=none archive_sha public_ip ip_location
    local launch_args launch_args_display
    local -A seen_artifacts=()

    (( $# == 1 )) || die "usage: ags show ID"
    load_local_storage
    find_local_checkpoint_archive "$checkpoint_id"
    need age; need jq; need sha256sum; need tar
    load_encryption_identity

    tmp="$(mktemp -d "$state/show.XXXXXX")"
    trap_cleanup_dirs "$tmp"
    unpack="$tmp/unpack"
    mkdir -p "$unpack"
    age_decrypt -o "$tmp/checkpoint.tar.gz" "$checkpoint_match"
    validate_tar "$tmp/checkpoint.tar.gz"
    tar --no-same-owner --no-same-permissions -xzf "$tmp/checkpoint.tar.gz" -C "$unpack"
    manifest="$unpack/manifest"
    [[ -f "$manifest" ]] || die "checkpoint payload is incomplete"

    format="$(sed -n 's/^format=//p' "$manifest")"
    kind="$(sed -n 's/^kind=//p' "$manifest")"
    saved_id="$(sed -n 's/^checkpoint_id=//p' "$manifest")"
    saved_record_id="$(sed -n 's/^record_id=//p' "$manifest")"
    agent="$(sed -n 's/^agent=//p' "$manifest")"
    session_id="$(sed -n 's/^session_id=//p' "$manifest")"
    description="$(sed -n 's/^description=//p' "$manifest")"
    created_utc="$(sed -n 's/^created_utc=//p' "$manifest")"
    saved_pwd="$(sed -n 's/^cwd=//p' "$manifest")"
    relative="$(sed -n 's/^relative_path=//p' "$manifest")"
    public_ip="$(sed -n 's/^public_ip=//p' "$manifest")"
    ip_location="$(sed -n 's/^ip_location=//p' "$manifest")"
    launch_args="$(sed -n 's/^launch_args=//p' "$manifest")"
    launch_args_display="$(format_launch_args "${launch_args:-[]}")"
    [[ -n "$launch_args_display" ]] || launch_args_display=none
    [[ "$kind" == checkpoint && ( "$agent" == codex || "$agent" == claude ) ]] ||
        die "checkpoint manifest is invalid"
    [[ "$(basename "$(dirname "$checkpoint_match")")" == "$agent" ]] ||
        die "checkpoint Agent does not match its storage path"
    validate_session_id "$session_id"
    validate_native_main_path "$agent" "$session_id" "$relative" ||
        die "checkpoint has an unsupported native transcript path"
    if [[ "$format" == 2 ]]; then
        [[ "$saved_id" == "$checkpoint_record_id" ]] ||
            die "checkpoint manifest does not match its filename"
    else
        [[ ( "$format" == 3 || "$format" == 4 ) &&
           "$saved_record_id" == "$checkpoint_record_id" ]] ||
            die "checkpoint manifest does not match its filename"
    fi

    if [[ "$format" == 4 ]]; then
        artifact_count="$(sed -n 's/^artifact_count=//p' "$manifest")"
        artifact_size="$(sed -n 's/^artifact_size=//p' "$manifest")"
        artifact_index_sha256="$(sed -n 's/^artifact_index_sha256=//p' "$manifest")"
        fidelity="$(sed -n 's/^capture_fidelity=//p' "$manifest")"
        artifact_metadata="$(sed -n 's/^artifact_metadata=//p' "$manifest")"
        [[ -f "$unpack/artifacts.tsv" && -d "$unpack/artifacts" &&
           "$artifact_count" =~ ^[1-9][0-9]*$ && "$artifact_size" =~ ^[0-9]+$ &&
           "$artifact_index_sha256" =~ ^[0-9a-f]{64}$ && "$fidelity" == full &&
           ( -z "$artifact_metadata" || "$artifact_metadata" == mode-mtime-v1 ) ]] ||
            die "format 4 checkpoint payload is incomplete"
        [[ "$artifact_index_sha256" == "$(sha256sum "$unpack/artifacts.tsv" | cut -d' ' -f1)" ]] ||
            die "checkpoint artifact index checksum mismatch"
        while IFS=$'\t' read -r row_sha256 row_size row_relative row_mode row_mtime row_extra; do
            [[ "$row_sha256" =~ ^[0-9a-f]{64}$ && "$row_size" =~ ^[0-9]+$ &&
               -n "$row_relative" && -z "$row_extra" ]] ||
                die "checkpoint artifact index is malformed"
            if [[ "$artifact_metadata" == mode-mtime-v1 ]]; then
                validate_artifact_metadata "$row_mode" "$row_mtime" ||
                    die "checkpoint artifact metadata is malformed"
            else
                [[ -z "$row_mode" && -z "$row_mtime" ]] ||
                    die "checkpoint artifact index is malformed"
            fi
            [[ -z "${seen_artifacts[$row_relative]+x}" ]] ||
                die "checkpoint artifact index contains a duplicate path"
            seen_artifacts["$row_relative"]=1
            validate_bundle_artifact_path "$agent" "$session_id" "$relative" "$row_relative" ||
                die "checkpoint contains an unsupported native artifact path"
            artifact="$unpack/artifacts/$row_relative"
            [[ -f "$artifact" && ! -L "$artifact" &&
               "$row_size" == "$(stat -c %s "$artifact")" ]] ||
                die "checkpoint artifact is missing or has the wrong size: $row_relative"
            checksum="$(sha256sum "$artifact" | cut -d' ' -f1)"
            [[ "$row_sha256" == "$checksum" ]] ||
                die "checkpoint artifact checksum mismatch: $row_relative"
            verified_count=$((verified_count + 1))
            verified_size=$((verified_size + row_size))
        done < "$unpack/artifacts.tsv"
        actual_count="$(find "$unpack/artifacts" -type f -printf x | wc -c)"
        (( verified_count == artifact_count && actual_count == artifact_count &&
           verified_size == artifact_size )) ||
            die "checkpoint artifact inventory mismatch"
    else
        [[ -f "$unpack/session.jsonl" ]] || die "checkpoint payload is incomplete"
        checksum="$(sed -n 's/^source_sha256=//p' "$manifest")"
        [[ "$checksum" == "$(sha256sum "$unpack/session.jsonl" | cut -d' ' -f1)" ]] ||
            die "checkpoint checksum mismatch"
        artifact_count=1
        artifact_size="$(stat -c %s "$unpack/session.jsonl")"
        fidelity=minimum
        artifact_metadata=
    fi

    binary_invoked="$(sed -n 's/^binary_invoked_path=//p' "$manifest")"
    [[ -n "$binary_invoked" ]] || binary_invoked="$(sed -n 's/^agent_binary=//p' "$manifest")"
    binary_real="$(sed -n 's/^binary_real_path=//p' "$manifest")"
    binary_version="$(sed -n 's/^binary_version=//p' "$manifest")"
    [[ -n "$binary_version" ]] || binary_version="$(sed -n 's/^cli_version=//p' "$manifest")"
    binary_resolution="$(sed -n 's/^binary_resolution=//p' "$manifest")"
    binary_sha="$(sed -n 's/^binary_sha256=//p' "$manifest")"
    binary_os="$(sed -n 's/^binary_os=//p' "$manifest")"
    binary_arch="$(sed -n 's/^binary_arch=//p' "$manifest")"
    if selected_binary="$(resolve_agent_binary "$agent" 2>/dev/null)"; then :; else selected_binary=unavailable; fi
    archive_sha="$(sha256sum "$checkpoint_match" | cut -d' ' -f1)"
    if [[ -s "$storage_config" ]]; then
        configured_remotes="$(jq -r '(.remotes // {}) | keys | join(", ") | select(length > 0)' \
            "$storage_config" 2>/dev/null || true)"
        [[ -n "$configured_remotes" ]] || configured_remotes=none
    fi

    printf '%-18s %s\n' \
        ID "${saved_id:-unknown}" \
        Record "$checkpoint_record_id" \
        Selector "$agent/$checkpoint_record_id" \
        Agent "$agent" \
        "Native session" "$session_id" \
        Description "${description:-unknown}" \
        Saved "${created_utc:-unknown}" \
        "Agent arguments" "$launch_args_display" \
        Workspace "${saved_pwd:-unknown}" \
        "Native path" "$relative" \
        Format "$format" \
        Completeness "$fidelity" \
        Artifacts "$artifact_count files, $artifact_size bytes" \
        "Artifact metadata" "${artifact_metadata:-not captured}" \
        "Binary invoked" "${binary_invoked:-unknown}" \
        "Binary real" "${binary_real:-unknown}" \
        "Binary version" "${binary_version:-unknown}" \
        "Binary source" "${binary_resolution:-unknown}" \
        "Binary SHA-256" "${binary_sha:-unknown}" \
        Platform "${binary_os:-unknown}/${binary_arch:-unknown}" \
        "Binary selected" "$selected_binary" \
        "Public IP" "${public_ip:-unknown}" \
        "IP location" "${ip_location:-unknown}" \
        "Archive SHA-256" "$archive_sha" \
        "Local integrity" verified \
        Remotes "$configured_remotes" \
        Path "$checkpoint_match"

    rm -rf -- "$tmp"
    trap - EXIT
}

validate_native_main_path() {
    local agent="$1" session_id="$2" relative="$3" remainder project_key
    safe_artifact_path "$relative" || return 1
    case "$agent" in
        codex)
            case "$relative" in sessions/*|archived_sessions/*) ;; *) return 1 ;; esac
            [[ "$relative" == *"-$session_id.jsonl" ||
               "$relative" == *"-$session_id.jsonl.zst" ]]
            ;;
        claude)
            remainder="${relative#projects/}"
            [[ "$remainder" != "$relative" && "$remainder" == */"$session_id.jsonl" ]] ||
                return 1
            project_key="${remainder%/"$session_id.jsonl"}"
            [[ -n "$project_key" && "$project_key" != */* ]]
            ;;
        *) return 1 ;;
    esac
}

validate_bundle_artifact_path() {
    local agent="$1" session_id="$2" main_relative="$3" relative="$4"
    safe_artifact_path "$relative" || return 1
    if [[ "$relative" == "$main_relative" ]]; then
        return 0
    fi
    [[ "$agent" == claude ]] || return 1
    case "$relative" in
        "${main_relative%.jsonl}"/*|\
        "file-history/$session_id"/*|\
        "tasks/$session_id"/*|\
        "session-env/$session_id"/*) return 0 ;;
        *) return 1 ;;
    esac
}

claude_project_key_for_cwd() {
    local cwd="$1" encoded sanitized unsigned_hash signed_hash absolute_hash suffix
    local alphabet=0123456789abcdefghijklmnopqrstuvwxyz digit
    need jq
    encoded="$(
        jq -Rr '
            def utf16_units:
                explode |
                map(
                    if . > 65535 then
                        (. - 65536) as $value |
                        [
                            55296 + (($value / 1024) | floor),
                            56320 + ($value % 1024)
                        ]
                    else [.] end
                ) |
                add;
            . as $input |
            ($input | utf16_units) as $units |
            (
                $units |
                map(
                    if ((. >= 48 and . <= 57) or
                        (. >= 65 and . <= 90) or
                        (. >= 97 and . <= 122))
                    then . else 45 end
                ) |
                implode
            ) as $sanitized |
            (
                reduce $units[] as $unit
                    (0; ((. * 31 + $unit) % 4294967296))
            ) as $hash |
            [$sanitized, $hash] |
            @tsv
        ' <<< "$cwd"
    )" || die "cannot encode the Claude project directory"
    IFS=$'\t' read -r sanitized unsigned_hash <<< "$encoded"
    [[ -n "$sanitized" && "$unsigned_hash" =~ ^[0-9]+$ ]] ||
        die "cannot encode the Claude project directory"
    if (( ${#sanitized} <= 200 )); then
        printf '%s\n' "$sanitized"
        return
    fi

    unsigned_hash=$((10#$unsigned_hash))
    if (( unsigned_hash >= 2147483648 )); then
        signed_hash=$((unsigned_hash - 4294967296))
    else
        signed_hash="$unsigned_hash"
    fi
    if (( signed_hash < 0 )); then
        absolute_hash=$((-signed_hash))
    else
        absolute_hash="$signed_hash"
    fi
    if (( absolute_hash == 0 )); then
        suffix=0
    else
        suffix=
        while (( absolute_hash > 0 )); do
            digit=$((absolute_hash % 36))
            suffix="${alphabet:digit:1}$suffix"
            absolute_hash=$((absolute_hash / 36))
        done
    fi
    printf '%s-%s\n' "${sanitized:0:200}" "$suffix"
}

artifact_merge_action() {
    local source="$1" destination="$2" appendable="$3"
    local source_size destination_size
    if [[ -L "$destination" || ( -e "$destination" && ! -f "$destination" ) ]]; then
        printf 'conflict\n'
    elif [[ ! -e "$destination" ]]; then
        printf 'add\n'
    elif cmp -s "$source" "$destination"; then
        printf 'same\n'
    elif [[ "$appendable" == 1 ]]; then
        source_size="$(stat -c %s "$source")"
        destination_size="$(stat -c %s "$destination")"
        if (( source_size > destination_size )) &&
           cmp -s -n "$destination_size" "$source" "$destination"; then
            printf 'update\n'
        elif (( destination_size > source_size )) &&
             cmp -s -n "$source_size" "$source" "$destination"; then
            printf 'keep\n'
        else
            printf 'conflict\n'
        fi
    else
        printf 'conflict\n'
    fi
}

restore_checkpoint_file() {
    local requested_id="$1" record_id="$2" file="$3" cleanup_dir="${4:-}" cwd_hint="${5:-}"
    local expected_agent="${6:-}" requested_target_agent="${7:-}"
    local profile="${8:-}" target_codex_provider= target_claude_settings=
    local tmp unpack manifest format kind saved_id saved_record_id agent id relative checksum
    local agent_binary saved_pwd public_ip ip_location target_cwd candidate_cwd
    local checkpoint_binary_invoked checkpoint_binary_real checkpoint_binary_version
    local checkpoint_binary_resolution
    local checkpoint_binary_sha256 checkpoint_binary_os checkpoint_binary_arch
    local artifact_index artifact_root artifact_count artifact_size artifact_index_sha256 fidelity
    local artifact_metadata row_sha256 row_size row_relative row_mode row_mtime row_extra
    local row_source row_checksum actual_count source_main source_session_id
    local verified_count=0 verified_size=0 main_found=0 main_size=0 source_project session_project
    local target_project destination_home destination_relative destination action appendable i j staged backup
    local active_pid active_commit_pid=
    local restore_agent cross_restore=0
    local commit_failed=0 rollback_failed=0 rollback_journal before_fingerprint
    local -a restore_sources=() restore_destinations=() restore_labels=() restore_appendable=()
    local -a restore_actions=() restore_modes=() restore_mtimes=()
    local -a restore_staged=() restore_backups=() committed_indexes=()
    local -a committed_fingerprints=() restore_created_dirs=()
    local -A seen_artifacts=()

    need age; need cmp; need flock; need jq; need readlink; need sha256sum; need tar
    load_encryption_identity
    lock
    tmp="$(mktemp -d "$state/restore.XXXXXX")"
    trap_cleanup_dirs "$tmp" "$cleanup_dir"
    unpack="$tmp/unpack"
    mkdir -p "$unpack"
    age_decrypt -o "$tmp/checkpoint.tar.gz" "$file"
    validate_tar "$tmp/checkpoint.tar.gz"
    tar --no-same-owner --no-same-permissions -xzf "$tmp/checkpoint.tar.gz" -C "$unpack"
    manifest="$unpack/manifest"
    [[ -f "$manifest" ]] || die "checkpoint payload is incomplete"

    format="$(sed -n 's/^format=//p' "$manifest")"
    kind="$(sed -n 's/^kind=//p' "$manifest")"
    saved_id="$(sed -n 's/^checkpoint_id=//p' "$manifest")"
    saved_record_id="$(sed -n 's/^record_id=//p' "$manifest")"
    agent="$(sed -n 's/^agent=//p' "$manifest")"
    agent_binary="$(sed -n 's/^agent_binary=//p' "$manifest")"
    checkpoint_binary_invoked="$(sed -n 's/^binary_invoked_path=//p' "$manifest")"
    checkpoint_binary_real="$(sed -n 's/^binary_real_path=//p' "$manifest")"
    checkpoint_binary_version="$(sed -n 's/^binary_version=//p' "$manifest")"
    checkpoint_binary_resolution="$(sed -n 's/^binary_resolution=//p' "$manifest")"
    checkpoint_binary_sha256="$(sed -n 's/^binary_sha256=//p' "$manifest")"
    checkpoint_binary_os="$(sed -n 's/^binary_os=//p' "$manifest")"
    checkpoint_binary_arch="$(sed -n 's/^binary_arch=//p' "$manifest")"
    id="$(sed -n 's/^session_id=//p' "$manifest")"
    relative="$(sed -n 's/^relative_path=//p' "$manifest")"
    checksum="$(sed -n 's/^source_sha256=//p' "$manifest")"
    saved_pwd="$(sed -n 's/^cwd=//p' "$manifest")"
    public_ip="$(sed -n 's/^public_ip=//p' "$manifest")"
    ip_location="$(sed -n 's/^ip_location=//p' "$manifest")"
    [[ -n "$saved_pwd" ]] || saved_pwd=unknown
    [[ -n "$public_ip" ]] || public_ip=unknown
    [[ -n "$ip_location" ]] || ip_location=unknown
    [[ ( "$format" == 2 || "$format" == 3 || "$format" == 4 ) &&
       "$kind" == checkpoint && ( "$agent" == codex || "$agent" == claude ) &&
       ( "$requested_id" == "$saved_id" || "$requested_id" == "$record_id" ||
         "$requested_id" == "$agent/$record_id" ) ]] ||
        die "checkpoint manifest does not match its filename"
    [[ -z "$expected_agent" || "$agent" == "$expected_agent" ]] ||
        die "checkpoint Agent does not match its storage path"
    if [[ "$format" == 2 ]]; then
        [[ "$saved_id" == "$record_id" ]] ||
            die "checkpoint manifest does not match its filename"
    else
        [[ "$saved_record_id" == "$record_id" ]] ||
            die "checkpoint manifest does not match its filename"
    fi
    if [[ "$format" == 3 ]]; then
        valid_agent_binary_path "$agent" "$agent_binary" ||
            die "checkpoint has an invalid agent binary"
        checkpoint_binary_invoked="$agent_binary"
        checkpoint_binary_real=unknown
        checkpoint_binary_version=unknown
        checkpoint_binary_resolution=unknown
        checkpoint_binary_sha256=unknown
        checkpoint_binary_os=unknown
        checkpoint_binary_arch=unknown
    elif [[ "$format" == 2 ]]; then
        checkpoint_binary_invoked=unknown
        checkpoint_binary_real=unknown
        checkpoint_binary_version=unknown
        checkpoint_binary_resolution=unknown
        checkpoint_binary_sha256=unknown
        checkpoint_binary_os=unknown
        checkpoint_binary_arch=unknown
    else
        [[ -n "$checkpoint_binary_invoked" ]] || checkpoint_binary_invoked="$agent_binary"
        validate_binary_provenance "$agent" 1
        [[ "$checkpoint_binary_os" == "$(uname -s | tr '[:upper:]' '[:lower:]')" ]] ||
            die "checkpoint platform does not match this machine"
        [[ "$checkpoint_binary_arch" == "$(uname -m)" ]] ||
            die "checkpoint architecture does not match this machine"
    fi
    validate_session_id "$id"
    validate_native_main_path "$agent" "$id" "$relative" ||
        die "checkpoint has an unsupported native transcript path"

    candidate_cwd="$cwd_hint"
    [[ -n "$candidate_cwd" ]] || candidate_cwd="$saved_pwd"
    [[ "$candidate_cwd" != unknown && "$candidate_cwd" == /* &&
       "$candidate_cwd" != *$'\n'* && "$candidate_cwd" != *$'\r'* &&
       -d "$candidate_cwd" ]] ||
        die "checkpoint needs an existing cwd; use --cwd PATH"
    target_cwd="$(cd -- "$candidate_cwd" && pwd -P)"

    restore_agent="${requested_target_agent:-$agent}"
    [[ "$restore_agent" == codex || "$restore_agent" == claude ]] ||
        die "conversion target must be codex or claude"
    source_session_id="$id"
    [[ "$restore_agent" == "$agent" ]] || cross_restore=1

    if [[ "$restore_agent" == claude ]]; then
        destination_home="$(canonical_native_home "$claude_home")" ||
            die "cannot canonicalize Claude native home"
        if [[ -n "$profile" ]]; then
            target_claude_settings="$(
                resolve_claude_profile_settings "$destination_home" "$profile"
            )"
        fi
        if (( cross_restore == 0 )); then
            source_project="${relative%/"$id.jsonl"}"
            if [[ "$target_cwd" == "$saved_pwd" ]]; then
                target_project="$source_project"
            else
                session_project="$(claude_project_key_for_cwd "$target_cwd")"
                [[ -n "$session_project" && "$session_project" != */* ]] ||
                    die "cannot map the target cwd to Claude project storage"
                target_project="projects/$session_project"
            fi
        else
            session_project="$(claude_project_key_for_cwd "$target_cwd")"
            [[ -n "$session_project" && "$session_project" != */* ]] ||
                die "cannot map the target cwd to Claude project storage"
            target_project="projects/$session_project"
        fi
    else
        destination_home="$(canonical_native_home "$codex_home")" ||
            die "cannot canonicalize Codex native home"
    fi
    if (( cross_restore == 1 )) && [[ "$restore_agent" == codex ]]; then
        target_codex_provider="$(
            resolve_codex_model_provider "$destination_home" "$profile"
        )"
    fi

    if [[ "$format" == 4 ]]; then
        artifact_index="$unpack/artifacts.tsv"
        artifact_root="$unpack/artifacts"
        artifact_count="$(sed -n 's/^artifact_count=//p' "$manifest")"
        artifact_size="$(sed -n 's/^artifact_size=//p' "$manifest")"
        artifact_index_sha256="$(sed -n 's/^artifact_index_sha256=//p' "$manifest")"
        fidelity="$(sed -n 's/^capture_fidelity=//p' "$manifest")"
        artifact_metadata="$(sed -n 's/^artifact_metadata=//p' "$manifest")"
        [[ -f "$artifact_index" && -d "$artifact_root" &&
           "$artifact_count" =~ ^[1-9][0-9]*$ && "$artifact_size" =~ ^[0-9]+$ &&
           "$artifact_index_sha256" =~ ^[0-9a-f]{64}$ && "$fidelity" == full &&
           ( -z "$artifact_metadata" || "$artifact_metadata" == mode-mtime-v1 ) ]] ||
            die "format 4 checkpoint payload is incomplete"
        [[ "$artifact_index_sha256" == "$(sha256sum "$artifact_index" | cut -d' ' -f1)" ]] ||
            die "checkpoint artifact index checksum mismatch"
        artifact_count=$((10#$artifact_count))
        artifact_size=$((10#$artifact_size))
        [[ -z "$(find "$artifact_root" -type l -print -quit)" ]] ||
            die "checkpoint artifacts contain a symbolic link"

        while IFS=$'\t' read -r row_sha256 row_size row_relative row_mode row_mtime row_extra; do
            [[ "$row_sha256" =~ ^[0-9a-f]{64}$ && "$row_size" =~ ^[0-9]+$ &&
               -n "$row_relative" && -z "$row_extra" ]] ||
                die "checkpoint artifact index is malformed"
            if [[ "$artifact_metadata" == mode-mtime-v1 ]]; then
                validate_artifact_metadata "$row_mode" "$row_mtime" ||
                    die "checkpoint artifact metadata is malformed"
            else
                [[ -z "$row_mode" && -z "$row_mtime" ]] ||
                    die "checkpoint artifact index is malformed"
                row_mode=600
            fi
            validate_bundle_artifact_path "$agent" "$id" "$relative" "$row_relative" ||
                die "checkpoint contains an unsupported native artifact path"
            [[ -z "${seen_artifacts[$row_relative]+x}" ]] ||
                die "checkpoint artifact index contains a duplicate path"
            seen_artifacts["$row_relative"]=1
            row_source="$artifact_root/$row_relative"
            [[ -f "$row_source" && ! -L "$row_source" ]] ||
                die "checkpoint artifact is missing: $row_relative"
            [[ "$row_size" == "$(stat -c %s "$row_source")" ]] ||
                die "checkpoint artifact size mismatch: $row_relative"
            row_checksum="$(sha256sum "$row_source" | cut -d' ' -f1)"
            [[ "$row_sha256" == "$row_checksum" ]] ||
                die "checkpoint artifact checksum mismatch: $row_relative"

            destination_relative="$row_relative"
            if (( cross_restore == 0 )) && [[ "$agent" == claude ]]; then
                if [[ "$row_relative" == "$relative" ]]; then
                    destination_relative="$target_project/$id.jsonl"
                elif [[ "$row_relative" == "${relative%.jsonl}/"* ]]; then
                    destination_relative="$target_project/$id/${row_relative#"${relative%.jsonl}/"}"
                fi
            fi
            safe_artifact_path "$destination_relative" ||
                die "unsafe mapped native artifact path"
            restore_sources+=("$row_source")
            restore_destinations+=("$destination_home/$destination_relative")
            restore_labels+=("$agent/$destination_relative")
            restore_modes+=("$row_mode")
            restore_mtimes+=("$row_mtime")
            if [[ "$row_relative" == "$relative" && "$row_relative" == *.jsonl ]]; then
                restore_appendable+=(1)
                main_found=1
                main_size="$row_size"
                source_main="$row_source"
                [[ "$checksum" == "$row_checksum" ]] ||
                    die "checkpoint main transcript checksum mismatch"
                tail -n 1 "$row_source" | jq -e . >/dev/null ||
                    die "checkpoint JSONL is incomplete"
            elif [[ "$row_relative" == "$relative" ]]; then
                restore_appendable+=(0)
                main_found=1
                main_size="$row_size"
                source_main="$row_source"
                [[ "$checksum" == "$row_checksum" ]] ||
                    die "checkpoint main transcript checksum mismatch"
                if command -v zstd >/dev/null; then
                    zstd -q -t -- "$row_source" ||
                        die "checkpoint compressed JSONL is invalid"
                fi
            else
                restore_appendable+=(0)
            fi
            verified_count=$((verified_count + 1))
            verified_size=$((verified_size + 10#$row_size))
        done < "$artifact_index"

        actual_count="$(find "$artifact_root" -type f -printf x | wc -c)"
        (( main_found == 1 && verified_count == artifact_count &&
           actual_count == artifact_count && verified_size == artifact_size )) ||
            die "checkpoint artifact inventory mismatch"
        [[ "$main_size" == "$(sed -n 's/^source_size=//p' "$manifest")" ]] ||
            die "checkpoint main transcript size mismatch"
    else
        [[ -f "$unpack/session.jsonl" ]] || die "checkpoint payload is incomplete"
        tail -n 1 "$unpack/session.jsonl" | jq -e . >/dev/null ||
            die "checkpoint JSONL is incomplete"
        [[ "$checksum" == "$(sha256sum "$unpack/session.jsonl" | cut -d' ' -f1)" ]] ||
            die "checkpoint checksum mismatch"
        source_main="$unpack/session.jsonl"
        destination_relative="$relative"
        if (( cross_restore == 0 )) && [[ "$agent" == claude ]]; then
            destination_relative="$target_project/$id.jsonl"
        fi
        restore_sources+=("$unpack/session.jsonl")
        restore_destinations+=("$destination_home/$destination_relative")
        restore_labels+=("$agent/$destination_relative")
        restore_appendable+=(1)
        restore_modes+=(600)
        restore_mtimes+=("")
        fidelity=minimum
        log "warning: format $format checkpoint has minimum fidelity; native sidecars were not captured"
    fi

    if (( cross_restore == 1 )); then
        [[ -n "${source_main:-}" && -f "$source_main" && ! -L "$source_main" ]] ||
            die "checkpoint main transcript is unavailable for conversion"
        prepare_cross_agent_restore \
            "$agent" "$source_session_id" "$source_main" "$restore_agent" \
            "$target_cwd" "$tmp" "$target_codex_provider"
        id="$conversion_result_session_id"
        destination_relative="$conversion_result_relative"
        validate_native_main_path "$restore_agent" "$id" "$destination_relative" ||
            die "converted transcript has an unsupported native path"
        restore_sources=("$conversion_result_main")
        restore_destinations=("$destination_home/$destination_relative")
        restore_labels=("$restore_agent/$destination_relative")
        restore_appendable=(0)
        restore_modes=(600)
        restore_mtimes=("")
        fidelity=converted-minimum
    fi

    added=0 updated=0 same=0 conflicts=0
    for ((i = 0; i < ${#restore_sources[@]}; i++)); do
        validate_restore_destination "$destination_home" "${restore_destinations[$i]}" ||
            die "unsafe restore destination: ${restore_labels[$i]}"
        action="$(artifact_merge_action "${restore_sources[$i]}" \
            "${restore_destinations[$i]}" "${restore_appendable[$i]}")"
        if [[ "$action" == same && -n "${restore_mtimes[$i]}" ]]; then
            row_mode="$(normalize_safe_artifact_mode \
                "$(stat -c %a "${restore_destinations[$i]}")")" ||
                die "cannot inspect restore destination metadata: ${restore_labels[$i]}"
            if [[ "$row_mode" != "${restore_modes[$i]}" ||
                  "$(stat -c %Y "${restore_destinations[$i]}")" != "${restore_mtimes[$i]}" ]]; then
                action=metadata
            fi
        fi
        restore_actions+=("$action")
        if [[ "$action" == conflict ]]; then
            log "conflict kept local: ${restore_labels[$i]}"
            conflicts=$((conflicts + 1))
        fi
    done
    if (( conflicts > 0 )); then
        unlock
        return 2
    fi

    assert_native_session_inactive "$restore_agent" "$destination_home" "$id"

    mkdir -p "$tmp/staged" "$tmp/backups"
    for ((i = 0; i < ${#restore_sources[@]}; i++)); do
        case "${restore_actions[$i]}" in
            add|update|metadata)
                staged="$tmp/staged/$i"
                stage_restore_file "${restore_sources[$i]}" "$staged" \
                    "${restore_modes[$i]}" "${restore_mtimes[$i]}" ||
                    die "cannot stage restore artifact: ${restore_labels[$i]}"
                restore_staged[$i]="$staged"
                if [[ "${restore_actions[$i]}" == update ||
                      "${restore_actions[$i]}" == metadata ]]; then
                    destination="${restore_destinations[$i]}"
                    [[ -f "$destination" && ! -L "$destination" ]] ||
                        die "restore destination changed during preflight: ${restore_labels[$i]}"
                    backup="$tmp/backups/$i"
                    cp -p -- "$destination" "$backup" ||
                        die "cannot create rollback backup: ${restore_labels[$i]}"
                    cmp -s "$destination" "$backup" ||
                        die "rollback backup verification failed: ${restore_labels[$i]}"
                    [[ "$(stat -c '%a:%Y' "$destination")" == \
                       "$(stat -c '%a:%Y' "$backup")" ]] ||
                        die "rollback backup metadata verification failed: ${restore_labels[$i]}"
                    restore_backups[$i]="$backup"
                fi
                ;;
            same|keep) ;;
            *) die "internal restore action is invalid: ${restore_actions[$i]}" ;;
        esac
    done

    for ((i = 0; i < ${#restore_sources[@]}; i++)); do
        case "${restore_actions[$i]}" in
            add|update|metadata)
                if ! ensure_restore_directory "${restore_destinations[$i]%/*}"; then
                    cleanup_restore_directories
                    die "cannot prepare restore destination: ${restore_labels[$i]}"
                fi
                validate_restore_destination "$destination_home" \
                    "${restore_destinations[$i]}" || {
                    cleanup_restore_directories
                    die "restore destination changed before commit: ${restore_labels[$i]}"
                }
                ;;
        esac
    done

    if active_pid="$(active_native_session_pid "$restore_agent" "$destination_home" "$id")"; then
        cleanup_restore_directories
        die "$restore_agent session $id is already active in PID $active_pid; exit that session before resuming it"
    fi

    rollback_journal="$tmp/rollback.tsv"
    : > "$rollback_journal"
    replace_file_attempt=0
    for ((i = 0; i < ${#restore_sources[@]}; i++)); do
        action="${restore_actions[$i]}"
        destination="${restore_destinations[$i]}"
        if active_commit_pid="$(
            active_native_session_pid "$restore_agent" "$destination_home" "$id"
        )"; then
            log "$restore_agent session $id became active in PID $active_commit_pid during restore"
            commit_failed=1
            break
        fi
        case "$action" in
            same|keep)
                same=$((same + 1))
                continue
                ;;
            add)
                if [[ -e "$destination" || -L "$destination" ]]; then
                    log "restore destination changed before commit: ${restore_labels[$i]}"
                    commit_failed=1
                fi
                ;;
            update|metadata)
                backup="${restore_backups[$i]}"
                if [[ ! -f "$destination" || -L "$destination" ]] ||
                   ! cmp -s "$destination" "$backup" ||
                   [[ "$(stat -c '%a:%Y' "$destination" 2>/dev/null || true)" != \
                      "$(stat -c '%a:%Y' "$backup")" ]]; then
                    log "restore destination changed before commit: ${restore_labels[$i]}"
                    commit_failed=1
                fi
                ;;
            *) die "internal restore action is invalid: $action" ;;
        esac
        (( commit_failed == 0 )) || break
        if ! replace_file "${restore_staged[$i]}" "$destination" \
            "${restore_modes[$i]}" "${restore_mtimes[$i]}" "$destination_home"; then
            log "restore commit failed at ${restore_labels[$i]}"
            commit_failed=1
            break
        fi
        committed_indexes+=("$i")
        committed_fingerprints[$i]="$(stat -c '%d:%i:%s:%Y:%a' "$destination")"
        printf '%s\t%s\t%s\n' "$action" "$destination" "${restore_backups[$i]:-}" \
            >> "$rollback_journal"
        case "$action" in
            add) added=$((added + 1)) ;;
            update|metadata) updated=$((updated + 1)) ;;
        esac
        if active_commit_pid="$(
            active_native_session_pid "$restore_agent" "$destination_home" "$id"
        )"; then
            log "$restore_agent session $id became active in PID $active_commit_pid during restore"
            commit_failed=1
            break
        fi
    done

    if (( commit_failed == 0 )) && [[ "$restore_agent" == codex ]]; then
        conversion_result_binary="${conversion_result_binary:-$(
            resolve_ags_converter_binary
        )}"
        if ! env CODEX_HOME="$destination_home" \
            "$conversion_result_binary" checkpoint-register-codex \
            "$id" "${restore_destinations[0]}" "$target_cwd" \
            8>&- 9>&- </dev/null; then
            log "cannot register restored Codex session in its thread index"
            commit_failed=1
        fi
    fi

    if (( commit_failed != 0 )); then
        log "restore commit failed; rolling back ${#committed_indexes[@]} committed artifact(s)"
        for ((j = ${#committed_indexes[@]} - 1; j >= 0; j--)); do
            i="${committed_indexes[$j]}"
            action="${restore_actions[$i]}"
            destination="${restore_destinations[$i]}"
            before_fingerprint="$(stat -c '%d:%i:%s:%Y:%a' "$destination" 2>/dev/null || true)"
            if [[ "$before_fingerprint" != "${committed_fingerprints[$i]}" ]]; then
                log "ROLLBACK FAILED: committed artifact changed: ${restore_labels[$i]}"
                rollback_failed=1
                continue
            fi
            case "$action" in
                add)
                    if ! validate_restore_destination "$destination_home" "$destination" ||
                       ! rm -f -- "$destination"; then
                        log "ROLLBACK FAILED: cannot remove added artifact: ${restore_labels[$i]}"
                        rollback_failed=1
                    else
                        log "rolled back added artifact: ${restore_labels[$i]}"
                    fi
                    ;;
                update|metadata)
                    if ! replace_file_from_backup "${restore_backups[$i]}" \
                        "$destination" "$destination_home" ||
                       ! cmp -s "${restore_backups[$i]}" "$destination" ||
                       [[ "$(stat -c '%a:%Y' "${restore_backups[$i]}")" != \
                          "$(stat -c '%a:%Y' "$destination" 2>/dev/null || true)" ]]; then
                        log "ROLLBACK FAILED: cannot restore original artifact: ${restore_labels[$i]}"
                        rollback_failed=1
                    else
                        log "rolled back original artifact: ${restore_labels[$i]}"
                    fi
                    ;;
            esac
        done
        cleanup_restore_directories
        unlock
        if (( rollback_failed != 0 )); then
            trap - EXIT
            die "RESTORE ROLLBACK FAILED; manual recovery data retained at $tmp"
        fi
        log "restore rollback complete; no artifact changes were retained"
        if [[ -n "$active_commit_pid" ]]; then
            die "$restore_agent session $id became active in PID $active_commit_pid during restore; committed artifacts were rolled back"
        fi
        die "checkpoint restore failed; committed artifacts were rolled back"
    fi

    unlock
    rm -rf -- "$tmp"
    [[ -z "$cleanup_dir" ]] || rm -rf -- "$cleanup_dir"
    trap - EXIT
    restored_agent="$restore_agent"
    restored_native_home="$destination_home"
    restored_claude_settings="$target_claude_settings"
    if (( cross_restore == 1 )); then
        restored_agent_binary=unknown
        restored_binary_invoked=unknown
        restored_binary_real=unknown
        restored_binary_version=unknown
        restored_binary_resolution=unknown
        restored_binary_sha256=unknown
        restored_binary_os=unknown
        restored_binary_arch=unknown
    else
        restored_agent_binary="$checkpoint_binary_invoked"
        restored_binary_invoked="$checkpoint_binary_invoked"
        restored_binary_real="$checkpoint_binary_real"
        restored_binary_version="$checkpoint_binary_version"
        restored_binary_resolution="${checkpoint_binary_resolution:-unknown}"
        restored_binary_sha256="$checkpoint_binary_sha256"
        restored_binary_os="$checkpoint_binary_os"
        restored_binary_arch="$checkpoint_binary_arch"
    fi
    restored_session_id="$id"
    restored_pwd="$target_cwd"
    printf 'checkpoint_id=%s\nrecord_id=%s\nagent=%s\nagent_binary=%s\nsession_id=%s\nsaved_pwd=%s\nrestore_pwd=%s\ncapture_fidelity=%s\npublic_ip=%s\nip_location=%s\nadded=%s\nupdated=%s\nunchanged=%s\nconflicts=%s\n' \
        "$saved_id" "$record_id" "$restore_agent" "${restored_agent_binary:-unavailable}" "$id" \
        "$saved_pwd" "$target_cwd" "$fidelity" "$public_ip" "$ip_location" \
        "$added" "$updated" "$same" "$conflicts"
    if (( cross_restore == 1 )); then
        printf 'source_agent=%s\nsource_session_id=%s\nconversion=ags-%s\n' \
            "$agent" "$source_session_id" "$ags_converter_version"
    fi
}

restore_checkpoint() {
    local target="${1:-}" checkpoint_id="${2:-}" cwd_hint="${3:-}"
    local target_agent="${4:-}" profile="${5:-}"
    [[ "$target" == local ]] || die "target must be local"
    parse_checkpoint_selector "$checkpoint_id"
    load_local_storage
    find_local_checkpoint_archive "$checkpoint_id"
    restore_checkpoint_file "$checkpoint_id" "$checkpoint_record_id" "$checkpoint_match" \
        "" "$cwd_hint" "$(basename "$(dirname "$checkpoint_match")")" \
        "$target_agent" "$profile"
}

# Which directory the resumed session works in, into `resolved_resume_cwd`.
#
# The checkpoint records where its session was working, and that is usually
# still the right answer. It stops being one as soon as the record arrives from
# somewhere else — these records synchronize between machines, where the saved
# path may not exist at all, or may exist and hold something unrelated. Neither
# directory is safe to assume when they differ, so this asks. When they are the
# same absolute path there is nothing to ask about and nothing is printed.
resolve_resume_cwd() {
    local requested="$1" saved="$2" here choice pad
    local saved_usable=0
    resolved_resume_cwd=
    here="$(pwd -P)"

    # `--cwd` is already a decision.
    if [[ -n "$requested" ]]; then
        resolved_resume_cwd="$requested"
        return 0
    fi
    if [[ "$saved" != unknown && "$saved" == /* &&
          "$saved" != *$'\n'* && "$saved" != *$'\r'* && -d "$saved" ]]; then
        saved="$(cd -- "$saved" && pwd -P)"
        saved_usable=1
    fi
    if (( saved_usable == 1 )) && [[ "$saved" == "$here" ]]; then
        resolved_resume_cwd="$saved"
        return 0
    fi
    # Nobody to ask. A script keeps the behaviour it was written against, which
    # includes failing the same way when the recorded directory is gone.
    if [[ ! -t 0 || ! -t 1 ]]; then
        (( saved_usable == 1 )) ||
            die "checkpoint needs an existing cwd; use --cwd PATH"
        resolved_resume_cwd="$saved"
        return 0
    fi

    init_terminal_style
    if (( saved_usable == 0 )); then
        # The cross-machine case. This used to be fatal, which made a
        # synchronized checkpoint unresumable anywhere but the machine that
        # wrote it — but proceeding elsewhere is a real change of workspace, so
        # say which directory is missing rather than quietly substituting one.
        printf '\n  %sThis session was saved in a directory that does not exist here:%s\n' \
            "$style_bold" "$style_reset" >&2
        printf '    %s%s%s\n\n' "$style_dim" "$2" "$style_reset" >&2
        printf '  Open it in %s instead? [Y/n] ' "$here" >&2
        IFS= read -r choice || choice=
        printf '\n' >&2
        case "${choice,,}" in
            ''|y|yes) resolved_resume_cwd="$here" ;;
            *) die "resume cancelled; use --cwd PATH to name a directory" ;;
        esac
        return 0
    fi

    pad=${#here}
    (( pad >= ${#saved} )) || pad=${#saved}
    printf '\n  %sThis session was saved in a different directory.%s\n\n' \
        "$style_bold" "$style_reset" >&2
    printf '    1) %-*s  %shere%s\n' "$pad" "$here" "$style_dim" "$style_reset" >&2
    printf '    2) %-*s  %ssaved with the session%s\n\n' \
        "$pad" "$saved" "$style_dim" "$style_reset" >&2
    printf '  Open in [1]: ' >&2
    IFS= read -r choice || choice=
    printf '\n' >&2
    case "${choice:-1}" in
        1) resolved_resume_cwd="$here" ;;
        2) resolved_resume_cwd="$saved" ;;
        *) die "invalid directory selection" ;;
    esac
}

resume_checkpoint() {
    local target="$1"
    shift
    # `live:<provider>/<id>` 走活会话那条路。
    #
    # 这个前缀就是 `ags ls` 内部用的选择器，原样接受它有两个理由：菜单里能干的事
    # 命令行也要能干（否则接着上次干这件事只有一条交互路径，脚本和测试都够不着），
    # 以及它和存档 ID 不会撞——存档的选择器是 `<agent>/<record_id>`，没有前缀。
    # 纯数字是 `ags ls` 里那一列短号。人看完列表要接着干的时候，敲的是他刚在屏幕
    # 上看到的那个数字，而不是一串十六进制。
    #
    # 只在本地这条路上认：短号是这台机器发的，云端存档没有这个概念。数字认不出来
    # 就报错而不是当成检查点 ID 继续——一个叫 `42` 的检查点确实可能存在，但把"短号
    # 没找到"悄悄变成"去找一个叫 42 的存档"会让人打开完全不相干的东西。
    if [[ "$target" == local && "${1:-}" =~ ^[0-9]{1,9}$ ]]; then
        local ordinal_selector
        if selector_for_ordinal "$1"; then
            shift
            set -- "$ordinal_selector" "$@"
        else
            die "没有第 ${1} 号会话；先跑 ags ls 看看现在有哪些"
        fi
    fi
    if [[ "${1:-}" == live:* ]]; then
        local selected_provider selected_session_id
        local -a live_client_args=()
        split_live_selector "$1"
        shift
        (( $# == 0 )) ||
            die "ags resume 只接受一个会话标识：$1（给 Agent 的参数写在 -- 之后）"
        # 给 Agent 的参数在顶层就被 `--` 摘进 `ags_agent_args` 了，不会以位置参数
        # 的形式走到这里。和存档那条路取的是同一个来源，两条入口才不会一个认
        # `--model o3`、另一个不认。
        if (( ${ags_agent_args_given:-0} == 1 )); then
            live_client_args=(${ags_agent_args[@]+"${ags_agent_args[@]}"})
            resume_live_session "$selected_provider" "$selected_session_id" \
                --agent-args ${live_client_args[@]+"${live_client_args[@]}"}
        else
            resume_live_session "$selected_provider" "$selected_session_id"
        fi
        return
    fi
    local checkpoint_id="${1:-}" launch_binary resume_cwd= resume_target_agent=
    local profile= agent_profile= effective_profile=
    local runtime_manifest runtime_checkpoint_id runtime_source_agent runtime_record_id
    local runtime_saved_cwd
    local runtime_selected_record_id
    local runtime_effective_agent runtime_effective_cwd
    local storage_reconciled=0
    local runtime_saved_args client_args_explicit=0
    local -a client_args=()
    scrub_transport_password_environment
    (( $# >= 1 )) || {
        if [[ "$target" == cloud ]]; then
            die "usage: ags cloud resume ID|AGENT/RECORD_ID [--to codex|claude] [--cwd PATH] [--profile PROFILE] [-- CLIENT_ARGS...]"
        else
            die "usage: ags resume ID|AGENT/RECORD_ID [--to codex|claude] [--cwd PATH] [--profile PROFILE] [-- CLIENT_ARGS...]"
        fi
    }
    shift
    # ags 自己的参数（`--to` / `--cwd` / `--profile` / `--no-agent-args` …）由顶层
    # 的两个参数区解析完了，这里只取结果。检查点 ID 之后剩下的一律是 agent 的参数
    # ——`--` 之后那一段属于 ags，不会流到这里。
    if [[ -n "${ags_to:-}" ]]; then
        [[ "$ags_to" == codex || "$ags_to" == claude ]] ||
            die "--to requires codex or claude"
        resume_target_agent="$ags_to"
    fi
    if [[ -n "${ags_cwd_option:-}" ]]; then
        [[ -d "$ags_cwd_option" ]] || die "--cwd is not a directory: $ags_cwd_option"
        resume_cwd="$(cd -- "$ags_cwd_option" && pwd -P)"
    fi
    if [[ -n "${ags_profile_option:-}" ]]; then
        profile="$ags_profile_option"
        validate_profile_name "$profile"
    fi
    # 「这次就是不要 agent 参数」必须能和「没说」区分开，否则会被检查点里存的参数
    # 覆盖回去。以前靠单独一个 `--` 表达，而 `--` 现在是 ags 的参数区，所以给了它
    # 一个名字。
    if (( ${ags_no_agent_args:-0} == 1 )); then
        client_args_explicit=1
    fi
    (( $# == 0 )) ||
        die "ags resume 只接受一个检查点标识：$1（给 Agent 的参数写在 -- 之后）"
    if (( ${ags_agent_args_given:-0} == 1 )); then
        # `--` 出现过就是一个决定：哪怕后面什么都没有，也表示"这次不要 Agent
        # 参数"，而不是"没说"——否则会被检查点里存的参数覆盖回去。
        client_args_explicit=1
        client_args+=(${ags_agent_args[@]+"${ags_agent_args[@]}"})
    fi
    if [[ "$target" == local ]]; then
        load_local_storage
        if ! local_checkpoint_selector_exists "$local_checkpoints" "$checkpoint_id"; then
            # A new machine may have no local copy yet. Only that case needs
            # reconciliation before the formal resolve, so an existing local
            # record still resumes without touching the network.
            prepare_storage_for_launch
            storage_reconciled=1
        fi
    fi
    if [[ -n "$profile" ]]; then
        for argument in "${client_args[@]}"; do
            [[ "$argument" == -- ]] && break
            case "$argument" in
                --settings|--settings=*)
                    die "do not combine --profile with Claude --settings"
                    ;;
            esac
        done
    fi
    resolve_checkpoint_record_for_live "$target" "$checkpoint_id"
    runtime_manifest="$(read_checkpoint_runtime_manifest "$target")" ||
        die "cannot read checkpoint manifest for managed resume"
    runtime_checkpoint_id="$(sed -n 's/^checkpoint_id=//p' <<< "$runtime_manifest")"
    runtime_source_agent="$(sed -n 's/^agent=//p' <<< "$runtime_manifest")"
    runtime_record_id="$(sed -n 's/^record_id=//p' <<< "$runtime_manifest")"
    [[ -n "$runtime_record_id" ]] ||
        runtime_record_id="$(sed -n 's/^checkpoint_id=//p' <<< "$runtime_manifest")"
    runtime_saved_cwd="$(sed -n 's/^cwd=//p' <<< "$runtime_manifest")"
    [[ ( "$runtime_source_agent" == codex || "$runtime_source_agent" == claude ) &&
       "$runtime_record_id" == "$checkpoint_record_id" ]] ||
        die "checkpoint manifest does not match its managed resume identity"
    if (( client_args_explicit == 0 )); then
        # Replay what the session was started with. These records synchronize
        # between machines, so this is another machine's command line being run
        # here: it goes through the same validators a typed one does, and the
        # line is printed below so it is never applied silently.
        runtime_saved_args="$(sed -n 's/^launch_args=//p' <<< "$runtime_manifest")"
        decode_launch_args "${runtime_saved_args:-[]}" ||
            die "saved Agent arguments are unreadable; resume with -- ARGS"
        client_args=("${launch_args_decoded[@]}")
    fi
    # 回放的参数按**源** Agent 的规矩剥，因为那本来就是它的命令行；手敲的按**真正
    # 要启动**的那个 Agent 的规矩剥。这两件事以前是对同一组参数把两套规矩都跑一遍。
    #
    # 那样有一个具体的后果：`ags resume <claude 的记录> --to codex -- -c model_provider=…`
    # 里的 `-c` 是 Codex 的 `--config`，但第一遍用的是 Claude 的规矩，那里 `-c` 是
    # `--continue`（选会话），于是它被剥掉、只留下一个孤零零的值。结果有两个，都不好：
    # 「不许改工作区/配置」那道防护看不到 `-c`，因此不拦；而那个值还是原样传给了
    # codex。手敲的参数不该被另一个 Agent 的规矩解释。
    runtime_effective_agent="${resume_target_agent:-$runtime_source_agent}"
    if (( client_args_explicit == 1 )); then
        strip_session_selection_args "$runtime_effective_agent" "${client_args[@]}"
    else
        strip_session_selection_args "$runtime_source_agent" "${client_args[@]}"
        strip_session_selection_args "$runtime_effective_agent" "${stripped_launch_args[@]}"
    fi
    if (( ${#client_args[@]} != ${#stripped_launch_args[@]} )); then
        client_args=("${stripped_launch_args[@]}")
        # Said out loud rather than dropped quietly: something in that
        # command line asked for a session, and this is AGS declining to let a
        # second one be named alongside the checkpoint being restored.
        log "dropped native session selection from $runtime_effective_agent arguments"
    fi
    if [[ "$runtime_effective_agent" == codex ]]; then
        validate_codex_context_args "${client_args[@]}"
        agent_profile="$codex_audit_profile"
        [[ -z "$profile" || -z "$agent_profile" ]] ||
            die "do not combine AGS --profile with Codex -p/--profile after --"
        effective_profile="${profile:-$agent_profile}"
        if [[ "$resume_target_agent" == codex &&
              "$runtime_source_agent" != codex ]]; then
            validate_cross_codex_client_args "${client_args[@]}"
        fi
    else
        effective_profile="$profile"
        validate_claude_context_args "${client_args[@]}"
    fi
    resolve_resume_cwd "$resume_cwd" "$runtime_saved_cwd"
    runtime_effective_cwd="$resolved_resume_cwd"
    [[ "$runtime_effective_cwd" != unknown &&
       "$runtime_effective_cwd" == /* &&
       "$runtime_effective_cwd" != *$'\n'* &&
       "$runtime_effective_cwd" != *$'\r'* &&
       -d "$runtime_effective_cwd" ]] ||
        die "checkpoint needs an existing cwd; use --cwd PATH"
    runtime_effective_cwd="$(cd -- "$runtime_effective_cwd" && pwd -P)"
    [[ "$runtime_effective_agent" == codex || "$runtime_effective_agent" == claude ]] ||
        die "conversion target must be codex or claude"
    if [[ "$target" == local && "$storage_reconciled" == 0 ]]; then
        runtime_selected_record_id="$checkpoint_record_id"
        prepare_storage_for_launch
        # Resolve again after reconciliation so a tombstone or a newly ambiguous
        # logical ID cannot restore the stale pre-sync selection.
        resolve_checkpoint_record_for_live "$target" "$checkpoint_id"
        [[ "$checkpoint_record_id" == "$runtime_selected_record_id" ]] ||
            die "checkpoint selection changed during storage reconciliation"
    fi
    launch_binary="$(resolve_agent_binary "$runtime_effective_agent")"
    # Resuming inherits `ags restore`'s machine-readable record, and on a
    # terminal it lands as fourteen key=value lines directly above the Agent's
    # own banner — for a person who just picked a session, that is noise. It is
    # not noise to a caller capturing it: scripts and the test suite read these
    # fields, so the record survives wherever stdout is not a terminal. Warnings
    # go through `log` to stderr either way, and every value used below comes
    # from the variables restore sets, never from what it printed.
    # The resolved directory, not `$resume_cwd`: restore places a Claude session
    # under the project key of the directory it is given, so answering the
    # question above has to reach this call or the transcript lands under the
    # directory that was declined.
    local -a restore_call=(
        "$target" "$checkpoint_id" "$runtime_effective_cwd"
        "$resume_target_agent" "$effective_profile"
    )
    if [[ -t 1 ]]; then
        restore_checkpoint "${restore_call[@]}" > /dev/null
    else
        restore_checkpoint "${restore_call[@]}"
    fi
    [[ "$restored_pwd" != unknown && -d "$restored_pwd" ]] ||
        die "checkpoint restored, but saved PWD is unavailable: $restored_pwd"
    cd -- "$restored_pwd"
    compare_binary_provenance "$restored_agent" "$launch_binary" \
        "${restored_binary_invoked:-}" "${restored_binary_real:-}" \
        "${restored_binary_version:-}" "${restored_binary_sha256:-}" \
        "${restored_binary_os:-}" "${restored_binary_arch:-}"
    assert_native_session_inactive \
        "$restored_agent" "$restored_native_home" "$restored_session_id"
    # Carry the arguments into the resumed session so the next `ags save` records
    # the command line this session is actually running under, rather than losing
    # it at the first resume. The AGS-injected `resume`/`--settings` arguments
    # below stay out of it: they belong to this launch, not to the session.
    export_launch_args "${client_args[@]}"
    # Announced only when they were replayed. Arguments the caller typed need no
    # echo, and the picker has already shown the ones it is opening with — this
    # line exists for the case where a command line takes effect that nobody
    # chose here, which is what a synchronized checkpoint can carry.
    (( client_args_explicit == 1 || ${#client_args[@]} == 0 )) ||
        log "$restored_agent arguments: $(format_launch_args "$AGS_LAUNCH_ARGS")"
    launch_terminal_title_mode=resume
    launch_terminal_title="$runtime_checkpoint_id"
    case "$restored_agent" in
        codex)
            if [[ -n "$profile" ]]; then
                launch_managed_agent "$launch_binary" "$restored_agent" \
                    resume "$restored_session_id" \
                    --profile "$profile" "${client_args[@]}"
            fi
            launch_managed_agent "$launch_binary" "$restored_agent" \
                resume "$restored_session_id" "${client_args[@]}"
            ;;
        claude)
            if [[ -n "$profile" ]]; then
                launch_managed_agent "$launch_binary" "$restored_agent" \
                    --resume "$restored_session_id" \
                    --settings "$restored_claude_settings" "${client_args[@]}"
            fi
            launch_managed_agent "$launch_binary" "$restored_agent" \
                --resume "$restored_session_id" "${client_args[@]}"
            ;;
        *) die "unsupported restored agent: $restored_agent" ;;
    esac
}

validate_sync_record_id() {
    local record_id="${1:-}"
    local LC_ALL=C
    need jq
    [[ -n "$record_id" && "$record_id" != */* &&
       ${#record_id} -le 200 ]] &&
        text_has_no_control_characters "$record_id" ||
        die "record has an unsafe ID"
}

sync_record_id_has_v1_marker_path() {
    [[ "${1:-}" =~ ^([0-9a-f]{24}@)?[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

sync_marker_stem() {
    local record_id="$1"
    if sync_record_id_has_v1_marker_path "$record_id"; then
        printf '%s\n' "$record_id"
    else
        printf 'id-%s\n' "$(printf '%s' "$record_id" | sha256sum | cut -d' ' -f1)"
    fi
}

validate_sync_digest() {
    [[ "${1:-}" =~ ^[0-9a-f]{64}$ ]] || die "record has an invalid SHA-256 digest"
}

record_object_path() {
    local digest="$1"
    printf 'objects/%s/%s.checkpoint.tar.gz.age\n' "${digest:0:2}" "$digest"
}

record_marker_path() {
    local record_id="$1" agent="$2" digest="$3" stem
    stem="$(sync_marker_stem "$record_id")"
    printf 'records/%s/%s.%s.record\n' "$agent" "$stem" "$digest"
}

tombstone_marker_path() {
    local record_id="$1" agent="$2" digest="$3" stem
    stem="$(sync_marker_stem "$record_id")"
    printf 'tombstones/%s/%s.%s.tombstone\n' "$agent" "$stem" "$digest"
}

write_record_marker() {
    local destination="$1" record_id="$2" agent="$3" size="$4" digest="$5" object
    object="$(record_object_path "$digest")"
    printf 'ags-record-v1\t%s\t%s\t%s\t%s\t%s\n' \
        "$record_id" "$agent" "$size" "$digest" "$object" > "$destination"
}

write_tombstone() {
    local destination="$1" record_id="$2" agent="$3" record_digest="$4"
    printf 'ags-tombstone-v1\t%s\t%s\t%s\n' \
        "$record_id" "$agent" "$record_digest" > "$destination"
}

reset_sync_catalogs() {
    declare -gA local_record_agent=() local_record_path=() local_record_digest=() local_record_size=()
    declare -gA remote_record_agent=() remote_record_path=() remote_record_digest=() remote_record_size=()
    declare -gA remote_record_legacy_path=()
    declare -gA local_tomb_agent=() local_tomb_path=() local_tomb_digest=() local_tomb_record_digest=()
    declare -gA remote_tomb_agent=() remote_tomb_path=() remote_tomb_digest=() remote_tomb_record_digest=()
    declare -ga plan_push_records=() plan_pull_records=() plan_push_tombstones=() plan_pull_tombstones=()
    sync_same_records=0
    sync_same_tombstones=0
}

catalog_add_record() {
    local side="$1" record_id="$2" agent="$3" path="$4" digest="$5" size="$6"
    local -n agents="${side}_record_agent"
    local -n paths="${side}_record_path"
    local -n digests="${side}_record_digest"
    local -n sizes="${side}_record_size"
    validate_sync_record_id "$record_id"
    [[ "$agent" == codex || "$agent" == claude ]] ||
        die "record $record_id has an invalid Agent"
    validate_sync_digest "$digest"
    [[ "$size" =~ ^[0-9]+$ ]] || die "record $record_id has an invalid size"
    if [[ ${agents[$record_id]+present} ]]; then
        [[ "${agents[$record_id]}" == "$agent" &&
           "${digests[$record_id]}" == "$digest" &&
           "${sizes[$record_id]}" == "$size" ]] ||
            die "E_SYNC_CONFLICT: duplicate record ID has different content: $record_id"
        return
    fi
    agents["$record_id"]="$agent"
    paths["$record_id"]="$path"
    digests["$record_id"]="$digest"
    sizes["$record_id"]="$size"
}

catalog_add_tombstone() {
    local side="$1" record_id="$2" agent="$3" path="$4" digest="$5" record_digest="$6"
    local -n agents="${side}_tomb_agent"
    local -n paths="${side}_tomb_path"
    local -n digests="${side}_tomb_digest"
    local -n record_digests="${side}_tomb_record_digest"
    validate_sync_record_id "$record_id"
    [[ "$agent" == codex || "$agent" == claude ]] ||
        die "tombstone $record_id has an invalid Agent"
    validate_sync_digest "$digest"
    validate_sync_digest "$record_digest"
    if [[ ${agents[$record_id]+present} ]]; then
        [[ "${agents[$record_id]}" == "$agent" &&
           "${digests[$record_id]}" == "$digest" &&
           "${record_digests[$record_id]}" == "$record_digest" ]] ||
            die "E_SYNC_CONFLICT: duplicate tombstone differs for record $record_id"
        return
    fi
    agents["$record_id"]="$agent"
    paths["$record_id"]="$path"
    digests["$record_id"]="$digest"
    record_digests["$record_id"]="$record_digest"
}

parse_tombstone_file() {
    local side="$1" file="$2" expected_path="${3:-}" line
    local tag record_id agent record_digest extra digest expected
    local -a tombstone_lines=()
    mapfile -t tombstone_lines < "$file"
    (( ${#tombstone_lines[@]} == 1 )) || die "invalid tombstone: $file"
    line="${tombstone_lines[0]}"
    IFS=$'\t' read -r tag record_id agent record_digest extra <<< "$line"
    [[ "$tag" == ags-tombstone-v1 && -z "${extra:-}" ]] ||
        die "invalid tombstone: $file"
    digest="$(sha256sum "$file" | cut -d' ' -f1)"
    if [[ "$side" == local ]]; then
        expected="$record_id.tombstone"
        [[ "$(basename "$file")" == "$expected" ]] ||
            die "tombstone filename does not match record ID: $file"
    else
        expected="$(tombstone_marker_path "$record_id" "$agent" "$digest")"
        [[ "$expected_path" == "$expected" ]] ||
            die "remote tombstone path does not match its content: $expected_path"
    fi
    catalog_add_tombstone "$side" "$record_id" "$agent" "$file" "$digest" "$record_digest"
}

parse_remote_record_marker() {
    local marker="$1" marker_path="$2" verify_object="$3" line
    local tag record_id agent size digest object extra expected actual_size actual_digest
    local -a marker_lines=()
    mapfile -t marker_lines < "$marker"
    (( ${#marker_lines[@]} == 1 )) || die "invalid remote record marker: $marker_path"
    line="${marker_lines[0]}"
    IFS=$'\t' read -r tag record_id agent size digest object extra <<< "$line"
    [[ "$tag" == ags-record-v1 && -z "${extra:-}" ]] ||
        die "invalid remote record marker: $marker_path"
    validate_sync_record_id "$record_id"
    [[ "$agent" == codex || "$agent" == claude ]] ||
        die "remote marker has an invalid Agent: $marker_path"
    validate_sync_digest "$digest"
    [[ "$size" =~ ^[0-9]+$ ]] || die "remote marker has an invalid size: $marker_path"
    [[ "$object" == "$(record_object_path "$digest")" ]] ||
        die "remote marker has an unsafe object path: $marker_path"
    expected="$(record_marker_path "$record_id" "$agent" "$digest")"
    [[ "$marker_path" == "$expected" ]] ||
        die "remote marker path does not match its content: $marker_path"
    if [[ "$verify_object" == yes ]]; then
        [[ -f "$sync_remote_root/$object" ]] ||
            die "remote record is missing its object: $record_id"
        actual_size="$(stat -c %s "$sync_remote_root/$object")"
        actual_digest="$(sha256sum "$sync_remote_root/$object" | cut -d' ' -f1)"
        [[ "$actual_size" == "$size" && "$actual_digest" == "$digest" ]] ||
            die "E_INTEGRITY: remote object does not match marker for $record_id"
    else
        [[ ${sync_remote_files[$object]+present} ]] ||
            die "remote record is missing its object: $record_id"
    fi
    catalog_add_record remote "$record_id" "$agent" "$object" "$digest" "$size"
}

load_local_sync_catalog() {
    local agent directory file base record_id digest size tombstone_dir
    need find; need sha256sum; need stat
    for agent in codex claude; do
        directory="$local_checkpoints/$agent"
        if [[ -d "$directory" ]]; then
            while IFS= read -r -d '' file; do
                base="$(basename "$file")"
                record_id="${base%.checkpoint.tar.gz.age}"
                digest="$(sha256sum "$file" | cut -d' ' -f1)"
                size="$(stat -c %s "$file")"
                catalog_add_record local "$record_id" "$agent" "$file" "$digest" "$size"
            done < <(find "$directory" -maxdepth 1 -type f -name '*.checkpoint.tar.gz.age' -print0)
        fi
        tombstone_dir="$local_checkpoints/tombstones/$agent"
        if [[ -d "$tombstone_dir" ]]; then
            while IFS= read -r -d '' file; do
                parse_tombstone_file local "$file"
            done < <(find "$tombstone_dir" -maxdepth 1 -type f -name '*.tombstone' -print0)
        fi
    done
}

prepare_git_sync_workspace() {
    local repo branch_status revision
    need git
    mkdir -p "$state"
    sync_workspace="$(mktemp -d "$state/sync-git.XXXXXX")"
    trap_cleanup_dirs "$sync_workspace"
    repo="$sync_workspace/repo"
    git init -q "$repo"
    git -C "$repo" remote add origin "$sync_remote_url"
    if git -C "$repo" ls-remote --exit-code --heads origin \
        "refs/heads/$sync_remote_branch" >/dev/null 2>&1; then
        git -C "$repo" fetch -q --no-tags origin \
            "refs/heads/$sync_remote_branch"
        git -C "$repo" checkout -q -B "$sync_remote_branch" FETCH_HEAD
    else
        branch_status=$?
        (( branch_status == 2 )) ||
            die "cannot read Git remote $sync_remote_name"
        git -C "$repo" checkout -q --orphan "$sync_remote_branch"
    fi
    git -C "$repo" config user.name AGS
    git -C "$repo" config user.email ags@localhost
    sync_git_repo="$repo"
    sync_remote_root="$repo/$remote_store_prefix"
    if git -C "$repo" rev-parse --verify HEAD >/dev/null 2>&1; then
        revision="git:$(git -C "$repo" rev-parse HEAD)"
    else
        revision=git:absent
    fi
    if [[ -n "${ags_expected_remote_revision:-}" &&
          "$revision" != "$ags_expected_remote_revision" ]]; then
        die "remote $sync_remote_name changed during storage consolidation"
    fi
    if [[ "${ags_allow_remote_retirement_marker:-0}" != 1 ]]; then
        local retirement_path
        for retirement_path in \
            "$repo/$remote_retirement_pending_marker" \
            "$repo/$remote_retirement_marker"; do
            if [[ -e "$retirement_path" || -L "$retirement_path" ]]; then
                [[ -f "$retirement_path" && ! -L "$retirement_path" ]] ||
                    die "remote $sync_remote_name has an unsafe retirement marker"
                die "remote $sync_remote_name has been retired and cannot be synchronized"
            fi
        done
    fi
}

load_git_sync_catalog() {
    local marker rel unsafe
    [[ -d "$sync_remote_root" ]] || return 0
    [[ ! -L "$sync_remote_root" ]] ||
        die "unsafe symlink at Git remote store root"
    unsafe="$(find "$sync_remote_root" -mindepth 1 \
        ! -type f ! -type d -print -quit)"
    [[ -z "$unsafe" ]] || die "unsafe file type in Git remote: $unsafe"
    while IFS= read -r -d '' marker; do
        rel="${marker#"$sync_remote_root"/}"
        parse_remote_record_marker "$marker" "$rel" yes
    done < <(find "$sync_remote_root/records" -mindepth 2 -maxdepth 2 \
        -type f -name '*.record' -print0 2>/dev/null)
    while IFS= read -r -d '' marker; do
        rel="${marker#"$sync_remote_root"/}"
        parse_tombstone_file remote "$marker" "$rel"
    done < <(find "$sync_remote_root/tombstones" -mindepth 2 -maxdepth 2 \
        -type f -name '*.tombstone' -print0 2>/dev/null)
}

prepare_sftp_sync_catalog() {
    local rel marker root_listing current_revision agent base record_id
    local legacy_file digest size legacy_index=0 had_record
    need rclone
    mkdir -p "$state"
    sync_workspace="$(mktemp -d "$state/sync-sftp.XXXXXX")"
    trap_cleanup_dirs "$sync_workspace"
    declare -gA sync_remote_files=()
    assert_sftp_remote_not_retired
    current_revision="$(selected_sftp_remote_revision)"
    if [[ -n "${ags_expected_remote_revision:-}" &&
          "$current_revision" != "$ags_expected_remote_revision" ]]; then
        die "remote $sync_remote_name changed during storage consolidation"
    fi
    root_listing="$(sync_sftp_run lsf --recursive --files-only "$sync_remote_fs")" ||
        die "cannot read SFTP catalog for remote $sync_remote_name"
    assert_sftp_remote_not_retired
    while IFS= read -r rel; do
        [[ "$rel" == "$remote_store_prefix/"* ]] || continue
        printf '%s\n' "${rel#"$remote_store_prefix/"}"
    done <<< "$root_listing" > "$sync_workspace/files"
    while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        case "$rel" in
            /*|'..'|../*|*/../*|*/..) die "unsafe path in SFTP remote: $rel" ;;
        esac
        sync_remote_files["$rel"]=1
    done < "$sync_workspace/files"
    while IFS= read -r rel; do
        case "$rel" in records/codex/*.record|records/claude/*.record) ;; *) continue ;; esac
        marker="$sync_workspace/marker"
        sync_sftp_run copyto "$sync_remote_fs/$remote_store_prefix/$rel" "$marker"
        parse_remote_record_marker "$marker" "$rel" no
    done < "$sync_workspace/files"
    while IFS= read -r rel; do
        case "$rel" in tombstones/codex/*.tombstone|tombstones/claude/*.tombstone) ;; *) continue ;; esac
        marker="$sync_workspace/$rel"
        mkdir -p "$(dirname "$marker")"
        sync_sftp_run copyto "$sync_remote_fs/$remote_store_prefix/$rel" "$marker"
        parse_tombstone_file remote "$marker" "$rel"
    done < "$sync_workspace/files"
    if [[ "${sync_remote_legacy_cloud:-0}" == 1 ]]; then
        while IFS= read -r rel; do
            case "$rel" in
                codex/*.checkpoint.tar.gz.age|claude/*.checkpoint.tar.gz.age) ;;
                *) continue ;;
            esac
            [[ "${rel#*/}" != */* ]] ||
                die "unsafe legacy cloud record path: $rel"
            agent="${rel%%/*}"
            base="${rel#*/}"
            record_id="${base%.checkpoint.tar.gz.age}"
            validate_sync_record_id "$record_id"
            legacy_file="$sync_workspace/legacy.$legacy_index"
            legacy_index=$((legacy_index + 1))
            sync_sftp_run copyto "$sync_remote_fs/$rel" "$legacy_file" ||
                die "cannot read legacy cloud record: $rel"
            digest="$(sha256sum "$legacy_file" | cut -d' ' -f1)"
            size="$(stat -c %s "$legacy_file")"
            had_record=0
            [[ ! ${remote_record_agent[$record_id]+present} ]] ||
                had_record=1
            catalog_add_record \
                remote "$record_id" "$agent" "$rel" "$digest" "$size"
            if (( had_record == 0 )); then
                remote_record_legacy_path["$record_id"]="$rel"
            fi
        done <<< "$root_listing"
    fi
    if [[ -n "${ags_expected_remote_revision:-}" &&
          "$(selected_sftp_remote_revision)" != \
          "$ags_expected_remote_revision" ]]; then
        die "remote $sync_remote_name changed while its catalog was being read"
    fi
}

prepare_remote_sync_catalog() {
    case "$sync_remote_type" in
        git)
            prepare_git_sync_workspace
            load_git_sync_catalog
            ;;
        sftp) prepare_sftp_sync_catalog ;;
    esac
}

sync_conflict() {
    local record_id="$1" reason="$2"
    die "E_SYNC_CONFLICT: remote=${sync_remote_name:-local} record_id=$record_id $reason"
}

validate_tombstone_binding() {
    local record_id="$1" tomb_agent="$2" tomb_record_digest="$3"
    local record_agent="$4" record_digest="$5"
    [[ "$tomb_agent" == "$record_agent" && "$tomb_record_digest" == "$record_digest" ]] ||
        sync_conflict "$record_id" "tombstone does not match record content"
}

build_sync_plan() {
    local record_id
    declare -A all_ids=()
    local -a sync_ids=()
    for record_id in "${!local_record_agent[@]}" "${!remote_record_agent[@]}" \
        "${!local_tomb_agent[@]}" "${!remote_tomb_agent[@]}"; do
        [[ -n "$record_id" ]] && all_ids["$record_id"]=1
    done
    if (( ${#all_ids[@]} )); then
        mapfile -t sync_ids < <(printf '%s\n' "${!all_ids[@]}" | sort)
    fi

    for record_id in "${sync_ids[@]}"; do
        if [[ ${local_record_agent[$record_id]+present} &&
              ${remote_record_agent[$record_id]+present} ]]; then
            [[ "${local_record_agent[$record_id]}" == "${remote_record_agent[$record_id]}" &&
               "${local_record_digest[$record_id]}" == "${remote_record_digest[$record_id]}" &&
               "${local_record_size[$record_id]}" == "${remote_record_size[$record_id]}" ]] ||
                sync_conflict "$record_id" "same record ID has different archive bytes"
        fi
        if [[ ${local_tomb_agent[$record_id]+present} &&
              ${remote_tomb_agent[$record_id]+present} ]]; then
            [[ "${local_tomb_agent[$record_id]}" == "${remote_tomb_agent[$record_id]}" &&
               "${local_tomb_digest[$record_id]}" == "${remote_tomb_digest[$record_id]}" &&
               "${local_tomb_record_digest[$record_id]}" == "${remote_tomb_record_digest[$record_id]}" ]] ||
                sync_conflict "$record_id" "same tombstone ID has different content"
        fi
        if [[ ${local_tomb_agent[$record_id]+present} ]]; then
            if [[ ${local_record_agent[$record_id]+present} ]]; then
                validate_tombstone_binding "$record_id" \
                    "${local_tomb_agent[$record_id]}" "${local_tomb_record_digest[$record_id]}" \
                    "${local_record_agent[$record_id]}" "${local_record_digest[$record_id]}"
            fi
            if [[ ${remote_record_agent[$record_id]+present} ]]; then
                validate_tombstone_binding "$record_id" \
                    "${local_tomb_agent[$record_id]}" "${local_tomb_record_digest[$record_id]}" \
                    "${remote_record_agent[$record_id]}" "${remote_record_digest[$record_id]}"
            fi
        fi
        if [[ ${remote_tomb_agent[$record_id]+present} ]]; then
            if [[ ${local_record_agent[$record_id]+present} ]]; then
                validate_tombstone_binding "$record_id" \
                    "${remote_tomb_agent[$record_id]}" "${remote_tomb_record_digest[$record_id]}" \
                    "${local_record_agent[$record_id]}" "${local_record_digest[$record_id]}"
            fi
            if [[ ${remote_record_agent[$record_id]+present} ]]; then
                validate_tombstone_binding "$record_id" \
                    "${remote_tomb_agent[$record_id]}" "${remote_tomb_record_digest[$record_id]}" \
                    "${remote_record_agent[$record_id]}" "${remote_record_digest[$record_id]}"
            fi
        fi

        if [[ ${local_tomb_agent[$record_id]+present} ]]; then
            if [[ ! ${remote_tomb_agent[$record_id]+present} ]]; then
                plan_push_tombstones+=("$record_id")
            else
                sync_same_tombstones=$((sync_same_tombstones + 1))
            fi
        elif [[ ${remote_tomb_agent[$record_id]+present} ]]; then
            plan_pull_tombstones+=("$record_id")
        elif [[ ${local_record_agent[$record_id]+present} &&
                ! ${remote_record_agent[$record_id]+present} ]]; then
            plan_push_records+=("$record_id")
        elif [[ ${remote_record_agent[$record_id]+present} &&
                ! ${local_record_agent[$record_id]+present} ]]; then
            plan_pull_records+=("$record_id")
        elif [[ ${local_record_agent[$record_id]+present} ]]; then
            sync_same_records=$((sync_same_records + 1))
        fi
    done
}

print_sync_plan() {
    printf 'remote=%s\ntype=%s\npush_records=%s\npull_records=%s\npush_tombstones=%s\npull_tombstones=%s\nunchanged_records=%s\nunchanged_tombstones=%s\n' \
        "$sync_remote_name" "$sync_remote_type" \
        "${#plan_push_records[@]}" "${#plan_pull_records[@]}" \
        "${#plan_push_tombstones[@]}" "${#plan_pull_tombstones[@]}" \
        "$sync_same_records" "$sync_same_tombstones"
}

publish_local_record() {
    local record_id="$1" source="$2" agent digest size directory destination partial actual
    agent="${remote_record_agent[$record_id]}"
    digest="${remote_record_digest[$record_id]}"
    size="${remote_record_size[$record_id]}"
    [[ ! ${local_tomb_agent[$record_id]+present} ]] ||
        sync_conflict "$record_id" "cannot restore a tombstoned record"
    directory="$local_checkpoints/$agent"
    destination="$directory/$record_id.checkpoint.tar.gz.age"
    mkdir -p "$directory"
    if [[ -e "$destination" ]]; then
        actual="$(sha256sum "$destination" | cut -d' ' -f1)"
        [[ "$actual" == "$digest" && "$(stat -c %s "$destination")" == "$size" ]] ||
            sync_conflict "$record_id" "local destination already contains different bytes"
        return
    fi
    partial="$directory/.$record_id.partial.$$.$RANDOM"
    cp -- "$source" "$partial"
    actual="$(sha256sum "$partial" | cut -d' ' -f1)"
    if [[ "$actual" != "$digest" || "$(stat -c %s "$partial")" != "$size" ]]; then
        rm -f -- "$partial"
        die "E_INTEGRITY: downloaded record failed SHA-256 verification: $record_id"
    fi
    if ! ln -- "$partial" "$destination"; then
        rm -f -- "$partial"
        actual="$(sha256sum "$destination" 2>/dev/null | cut -d' ' -f1 || true)"
        [[ "$actual" == "$digest" ]] ||
            sync_conflict "$record_id" "record appeared locally with different bytes"
        return
    fi
    rm -f -- "$partial"
}

publish_local_tombstone() {
    local record_id="$1" source="$2" agent directory destination partial created=0
    local trash_dir trash_path record_path
    agent="${remote_tomb_agent[$record_id]}"
    directory="$local_checkpoints/tombstones/$agent"
    destination="$directory/$record_id.tombstone"
    mkdir -p "$directory"
    if [[ -e "$destination" ]]; then
        cmp -s "$source" "$destination" ||
            sync_conflict "$record_id" "local tombstone already differs"
    else
        partial="$directory/.$record_id.partial.$$.$RANDOM"
        cp -- "$source" "$partial"
        [[ "$(sha256sum "$partial" | cut -d' ' -f1)" == "${remote_tomb_digest[$record_id]}" ]] ||
            { rm -f -- "$partial"; die "E_INTEGRITY: downloaded tombstone failed verification"; }
        ln -- "$partial" "$destination" ||
            { rm -f -- "$partial"; sync_conflict "$record_id" "local tombstone appeared concurrently"; }
        rm -f -- "$partial"
        created=1
    fi
    if [[ ${local_record_path[$record_id]+present} ]]; then
        record_path="${local_record_path[$record_id]}"
        trash_dir="$state/trash/sync/$agent"
        trash_path="$trash_dir/$(basename "$record_path").deleted.$(date -u +%Y%m%dT%H%M%S.%NZ)"
        mkdir -p "$trash_dir"
        if ! mv -- "$record_path" "$trash_path"; then
            (( created == 0 )) || rm -f -- "$destination"
            die "cannot move tombstoned record to recoverable trash: $record_id"
        fi
    fi
}

publish_imported_sftp_record() {
    local record_id="$1" source="$2" digest size agent object marker
    local marker_file marker_digest
    digest="${remote_record_digest[$record_id]}"
    size="${remote_record_size[$record_id]}"
    agent="${remote_record_agent[$record_id]}"
    object="$(record_object_path "$digest")"
    marker="$(record_marker_path "$record_id" "$agent" "$digest")"
    sftp_publish_verified "$source" "$object" "$digest" "$size"
    marker_file="$sync_workspace/legacy-record-marker.$RANDOM"
    write_record_marker "$marker_file" "$record_id" "$agent" "$size" "$digest"
    marker_digest="$(sha256sum "$marker_file" | cut -d' ' -f1)"
    sftp_publish_verified "$marker_file" "$marker" "$marker_digest" \
        "$(stat -c %s "$marker_file")"
}

pull_one_record() {
    local record_id="$1" tmp object
    case "$sync_remote_type" in
        git)
            publish_local_record "$record_id" \
                "$sync_remote_root/${remote_record_path[$record_id]}"
            ;;
        sftp)
            tmp="$sync_workspace/pull.$RANDOM"
            if [[ ${remote_record_legacy_path[$record_id]+present} ]]; then
                sync_sftp_run copyto \
                    "$sync_remote_fs/${remote_record_legacy_path[$record_id]}" \
                    "$tmp"
            else
                object="${remote_record_path[$record_id]}"
                sync_sftp_run copyto \
                    "$sync_remote_fs/$remote_store_prefix/$object" "$tmp"
            fi
            publish_local_record "$record_id" "$tmp"
            if [[ ${remote_record_legacy_path[$record_id]+present} &&
                  -z "${ags_expected_remote_revision:-}" ]]; then
                publish_imported_sftp_record "$record_id" "$tmp"
            fi
            rm -f -- "$tmp"
            ;;
    esac
}

pull_one_tombstone() {
    local record_id="$1"
    publish_local_tombstone "$record_id" "${remote_tomb_path[$record_id]}"
}

ensure_git_sync_metadata() {
    mkdir -p "$sync_remote_root"
    if [[ -e "$sync_remote_root/.gitattributes" ]]; then
        [[ "$(<"$sync_remote_root/.gitattributes")" == \
           '* -text -filter -diff -merge' ]] ||
            die "Git remote has conflicting $remote_store_prefix/.gitattributes"
    else
        printf '* -text -filter -diff -merge\n' \
            > "$sync_remote_root/.gitattributes"
    fi
}

push_git_record() {
    local record_id="$1" source digest size object marker destination marker_file
    source="${local_record_path[$record_id]}"
    digest="${local_record_digest[$record_id]}"
    size="${local_record_size[$record_id]}"
    object="$(record_object_path "$digest")"
    marker="$(record_marker_path "$record_id" "${local_record_agent[$record_id]}" "$digest")"
    destination="$sync_remote_root/$object"
    ensure_git_sync_metadata
    mkdir -p "$(dirname "$destination")" "$(dirname "$sync_remote_root/$marker")"
    if [[ -e "$destination" ]]; then
        [[ "$(sha256sum "$destination" | cut -d' ' -f1)" == "$digest" &&
           "$(stat -c %s "$destination")" == "$size" ]] ||
            sync_conflict "$record_id" "content-addressed Git object differs"
    else
        cp -- "$source" "$destination"
        [[ "$(sha256sum "$destination" | cut -d' ' -f1)" == "$digest" ]] ||
            die "E_INTEGRITY: copied Git object failed verification: $record_id"
    fi
    marker_file="$sync_workspace/record-marker"
    write_record_marker "$marker_file" "$record_id" \
        "${local_record_agent[$record_id]}" "$size" "$digest"
    if [[ -e "$sync_remote_root/$marker" ]]; then
        cmp -s "$marker_file" "$sync_remote_root/$marker" ||
            sync_conflict "$record_id" "Git record marker differs"
    else
        cp -- "$marker_file" "$sync_remote_root/$marker"
    fi
}

push_git_tombstone() {
    local record_id="$1" digest marker source
    digest="${local_tomb_digest[$record_id]}"
    source="${local_tomb_path[$record_id]}"
    marker="$(tombstone_marker_path "$record_id" "${local_tomb_agent[$record_id]}" "$digest")"
    ensure_git_sync_metadata
    mkdir -p "$(dirname "$sync_remote_root/$marker")"
    if [[ -e "$sync_remote_root/$marker" ]]; then
        cmp -s "$source" "$sync_remote_root/$marker" ||
            sync_conflict "$record_id" "Git tombstone marker differs"
    else
        cp -- "$source" "$sync_remote_root/$marker"
    fi
}

sftp_publish_verified() {
    local source="$1" relative="$2" digest="$3" size="$4"
    local upload_relative readback actual
    validate_sftp_relative_path "$relative"
    if [[ ${sync_remote_files[$relative]+present} ]]; then
        readback="$sync_workspace/existing.$RANDOM"
        sync_sftp_run copyto "$sync_remote_fs/$remote_store_prefix/$relative" "$readback"
        actual="$(sha256sum "$readback" | cut -d' ' -f1)"
        [[ "$actual" == "$digest" && "$(stat -c %s "$readback")" == "$size" ]] ||
            die "E_SYNC_CONFLICT: existing SFTP object differs: $relative"
        rm -f -- "$readback"
        return
    fi
    upload_relative=".ags-uploads/$(
        printf '%s\n' "$relative" "$(hostname -s)" "$$" "$RANDOM" |
            sha256sum | cut -d' ' -f1
    ).partial"
    readback="$sync_workspace/readback.$RANDOM"
    sync_sftp_run copyto "$source" \
        "$sync_remote_fs/$upload_relative"
    if ! sync_sftp_run copyto \
        "$sync_remote_fs/$upload_relative" "$readback"; then
        sync_sftp_run deletefile \
            "$sync_remote_fs/$upload_relative" >/dev/null 2>&1 || true
        die "SFTP read-back failed: $relative"
    fi
    actual="$(sha256sum "$readback" | cut -d' ' -f1)"
    if [[ "$actual" != "$digest" || "$(stat -c %s "$readback")" != "$size" ]]; then
        sync_sftp_run deletefile \
            "$sync_remote_fs/$upload_relative" >/dev/null 2>&1 || true
        die "E_INTEGRITY: SFTP read-back failed verification: $relative"
    fi
    if ! sftp_server_publish \
        "$upload_relative" "$remote_store_prefix/$relative" "$digest"; then
        if sync_sftp_run copyto \
            "$sync_remote_fs/$remote_store_prefix/$relative" "$readback" 2>/dev/null; then
            actual="$(sha256sum "$readback" | cut -d' ' -f1)"
            if [[ "$actual" != "$digest" ||
                  "$(stat -c %s "$readback")" != "$size" ]]; then
                sync_sftp_run deletefile \
                    "$sync_remote_fs/$upload_relative" >/dev/null 2>&1 || true
                die "E_SYNC_CONFLICT: SFTP destination appeared with different bytes: $relative"
            fi
        else
            sync_sftp_run deletefile \
                "$sync_remote_fs/$upload_relative" >/dev/null 2>&1 || true
            die "SFTP publish failed: $relative"
        fi
        sync_sftp_run deletefile \
            "$sync_remote_fs/$upload_relative" >/dev/null 2>&1 || true
    fi
    sync_sftp_run copyto \
        "$sync_remote_fs/$remote_store_prefix/$relative" "$readback" ||
        die "SFTP destination read-back failed: $relative"
    actual="$(sha256sum "$readback" | cut -d' ' -f1)"
    [[ "$actual" == "$digest" && "$(stat -c %s "$readback")" == "$size" ]] ||
        die "E_INTEGRITY: published SFTP object failed verification: $relative"
    rm -f -- "$readback"
    sync_remote_files["$relative"]=1
}

push_sftp_record() {
    local record_id="$1" digest size object marker marker_file marker_digest
    digest="${local_record_digest[$record_id]}"
    size="${local_record_size[$record_id]}"
    object="$(record_object_path "$digest")"
    marker="$(record_marker_path "$record_id" "${local_record_agent[$record_id]}" "$digest")"
    sftp_publish_verified "${local_record_path[$record_id]}" "$object" "$digest" "$size"
    marker_file="$sync_workspace/record-marker"
    write_record_marker "$marker_file" "$record_id" \
        "${local_record_agent[$record_id]}" "$size" "$digest"
    marker_digest="$(sha256sum "$marker_file" | cut -d' ' -f1)"
    sftp_publish_verified "$marker_file" "$marker" "$marker_digest" \
        "$(stat -c %s "$marker_file")"
}

push_sftp_tombstone() {
    local record_id="$1" marker digest source
    digest="${local_tomb_digest[$record_id]}"
    source="${local_tomb_path[$record_id]}"
    marker="$(tombstone_marker_path "$record_id" "${local_tomb_agent[$record_id]}" "$digest")"
    sftp_publish_verified "$source" "$marker" "$digest" "$(stat -c %s "$source")"
}

push_one_record() {
    local record_id="$1"
    case "$sync_remote_type" in
        git) push_git_record "$record_id" ;;
        sftp) push_sftp_record "$record_id" ;;
    esac
}

push_one_tombstone() {
    local record_id="$1"
    case "$sync_remote_type" in
        git) push_git_tombstone "$record_id" ;;
        sftp) push_sftp_tombstone "$record_id" ;;
    esac
}

finalize_git_sync_push() {
    local record_id digest object marker staged relative
    sync_git_push_rejected=0
    git -C "$sync_git_repo" add -f -- "$remote_store_prefix"
    staged="$sync_workspace/staged-readback"
    for record_id in "${plan_push_records[@]}"; do
        digest="${local_record_digest[$record_id]}"
        object="$(record_object_path "$digest")"
        marker="$(record_marker_path "$record_id" \
            "${local_record_agent[$record_id]}" "$digest")"
        for relative in "$object" "$marker"; do
            git -C "$sync_git_repo" show \
                ":$remote_store_prefix/$relative" > "$staged" ||
                die "Git index is missing a staged AGS record"
            cmp -s "$staged" "$sync_remote_root/$relative" ||
                die "Git attributes transformed an AGS record before commit"
        done
    done
    for record_id in "${plan_push_tombstones[@]}"; do
        digest="${local_tomb_digest[$record_id]}"
        marker="$(tombstone_marker_path "$record_id" \
            "${local_tomb_agent[$record_id]}" "$digest")"
        git -C "$sync_git_repo" show \
            ":$remote_store_prefix/$marker" > "$staged" ||
            die "Git index is missing a staged AGS tombstone"
        cmp -s "$staged" "$sync_remote_root/$marker" ||
            die "Git attributes transformed an AGS tombstone before commit"
    done
    git -C "$sync_git_repo" show \
        ":$remote_store_prefix/.gitattributes" > "$staged" ||
        die "Git index is missing AGS attribute protection"
    cmp -s "$staged" "$sync_remote_root/.gitattributes" ||
        die "Git attributes transformed AGS attribute protection"
    git -C "$sync_git_repo" diff --cached --quiet && return 0
    git -C "$sync_git_repo" commit -q -m "ags sync $sync_remote_name"
    if ! git -C "$sync_git_repo" push origin \
        "HEAD:refs/heads/$sync_remote_branch"; then
        sync_git_push_rejected=1
    fi
}

cleanup_sync_workspace() {
    [[ -z "${sync_workspace:-}" ]] || rm -rf -- "$sync_workspace"
    sync_workspace=
    trap - EXIT
}

run_record_sync_attempt() {
    local mode="$1" record_id pushed=0 pulled=0
    reset_sync_catalogs
    load_local_sync_catalog
    prepare_remote_sync_catalog
    build_sync_plan
    print_sync_plan
    [[ "$mode" == status ]] && return 0

    if [[ "$mode" == pull || "$mode" == sync ]]; then
        for record_id in "${plan_pull_tombstones[@]}"; do
            pull_one_tombstone "$record_id"
            pulled=$((pulled + 1))
        done
        for record_id in "${plan_pull_records[@]}"; do
            pull_one_record "$record_id"
            pulled=$((pulled + 1))
        done
    fi
    if [[ "$mode" == push || "$mode" == sync ]]; then
        for record_id in "${plan_push_tombstones[@]}"; do
            push_one_tombstone "$record_id"
            pushed=$((pushed + 1))
        done
        for record_id in "${plan_push_records[@]}"; do
            push_one_record "$record_id"
            pushed=$((pushed + 1))
        done
        if [[ "$sync_remote_type" == git && $pushed -gt 0 ]]; then
            finalize_git_sync_push
        fi
    fi
    [[ "${sync_git_push_rejected:-0}" == 0 ]] || return 0
    printf 'status=synchronized\npushed=%s\npulled=%s\n' "$pushed" "$pulled"
}

sync_records() {
    local mode="$1" requested="${2:-}" attempt
    (( $# <= 2 )) || die "usage: ags $mode [REMOTE]"
    [[ "$mode" == push || "$mode" == pull || "$mode" == sync || "$mode" == status ]] ||
        die "invalid synchronization mode"
    load_local_storage
    select_named_remote "$requested"
    # Consolidation owns the global storage transaction. Taking this gate
    # before a per-remote lock prevents a merge from racing an ordinary sync
    # while it freezes the canonical dedupe vault and commits redirects.
    lock_storage_consolidation
    # `ags set` shares the consolidation gate. Re-read the local vault after
    # acquiring it so a path change completed while this sync was waiting
    # cannot make the operation use a stale canonical root.
    load_local_storage
    lock_remote_operation "$sync_remote_name"
    # The remote may have been removed after the first name resolution but
    # before its operation lock became available. Re-read it under the lock.
    select_named_remote "$sync_remote_name"
    lock_checkpoint_root "$local_checkpoints"
    need cmp; need sha256sum; need stat
    if [[ "$sync_remote_type" == sftp &&
          -n "${ags_expected_remote_revision:-}" &&
          "$(selected_remote_revision)" != "$ags_expected_remote_revision" ]]; then
        die "remote $sync_remote_name changed during storage consolidation"
    fi
    for attempt in 1 2; do
        sync_workspace=
        sync_git_push_rejected=0
        run_record_sync_attempt "$mode"
        cleanup_sync_workspace
        if [[ "$sync_remote_type" == git && "$sync_git_push_rejected" == 1 &&
              "$attempt" == 1 ]]; then
            log "Git remote advanced during push; rebuilding the plan once"
            continue
        fi
        [[ "$sync_git_push_rejected" == 0 ]] ||
            die "Git push was rejected after one retry; no force push was attempted"
        unlock_checkpoint_root
        unlock_remote_operation
        unlock_storage_consolidation
        return 0
    done
}

selected_remote_revision() {
    local output status revision
    case "$sync_remote_type" in
        git)
            if output="$(git ls-remote --exit-code --heads "$sync_remote_url" \
                "refs/heads/$sync_remote_branch")"; then
                printf 'git:%s\n' "${output%%[[:space:]]*}"
            else
                status=$?
                (( status == 2 )) ||
                    die "cannot read Git revision for remote $sync_remote_name"
                printf 'git:absent\n'
            fi
            ;;
        sftp)
            assert_sftp_remote_not_retired
            revision="$(selected_sftp_remote_revision)"
            assert_sftp_remote_not_retired
            printf '%s\n' "$revision"
            ;;
    esac
}

storage_remote_revision() {
    local name="$1"
    select_named_remote "$name"
    selected_remote_revision
}

sync_plan_value() {
    local output="$1" key="$2"
    sed -n "s/^$key=//p" <<< "$output" | tail -n 1
}

verify_remote_fully_pulled() {
    local name="$1" expected="${2:-}" output
    output="$(
        ags_expected_remote_revision="$expected"
        sync_records status "$name"
    )"
    printf '%s\n' "$output"
    [[ "$(sync_plan_value "$output" pull_records)" == 0 &&
       "$(sync_plan_value "$output" pull_tombstones)" == 0 ]] ||
        die "merge verification failed while reading source $name"
}

verify_remote_fully_synchronized() {
    local name="$1" expected="${2:-}" output
    output="$(
        ags_expected_remote_revision="$expected"
        sync_records status "$name"
    )"
    printf '%s\n' "$output"
    [[ "$(sync_plan_value "$output" push_records)" == 0 &&
       "$(sync_plan_value "$output" pull_records)" == 0 &&
       "$(sync_plan_value "$output" push_tombstones)" == 0 &&
       "$(sync_plan_value "$output" pull_tombstones)" == 0 ]] ||
        die "merge verification failed for destination $name"
}

pull_remote_into_staging_vault() {
    local name="$1" expected="$2" root="$3" isolated_state="$4"
    (
        # This subprocess owns a different, disposable vault. Discard any
        # inherited canonical-vault descriptor before taking that vault's lock.
        ags_checkpoint_lock_depth=0
        ags_checkpoint_lock_root=
        exec 8>&-
        export AGENT_SESSION_LOCAL_DIR="$root"
        state="$isolated_state"
        local_checkpoints="$root"
        ags_expected_remote_revision="$expected"
        sync_records pull "$name" >/dev/null
    )
}

merge_storage_modes() {
    local destination="$1" prompt_retirement="$2" source requested answer
    local remote_name canonical_root merge_workspace staging_vault
    local revision
    local -a requested_sources=() sources=() retire_sources=()
    local -a preflight_remotes=()
    local -A seen=() seen_remote=()
    shift 2
    requested_sources=("$@")
    (( ags_consolidation_lock_depth > 0 )) ||
        die "internal error: storage merge requires the consolidation lock"
    # The caller holds the storage-consolidation gate. Keep configuration and
    # save/delete transactions frozen until the verified remote publish and
    # redirect are one committed result. sync_records() re-enters the gate,
    # then takes its remote and checkpoint locks without contending with
    # another storage operation.
    lock
    if (( ${#requested_sources[@]} == 0 )); then
        mapfile -t requested_sources < <(configured_storage_modes)
    fi
    for requested in "${requested_sources[@]}"; do
        resolve_storage_mode "$requested"
        source="$resolved_storage_mode"
        [[ "$source" != "$destination" ]] || continue
        [[ ! ${seen[$source]+present} ]] || continue
        seen["$source"]=1
        sources+=("$source")
        [[ "$source" != remote:* ]] || retire_sources+=("$source")
    done
    (( ${#sources[@]} > 0 )) ||
        die "merge needs at least one source different from its destination"

    load_local_storage
    canonical_root="$local_checkpoints"
    # Save/delete are blocked by the state transaction and every sync is
    # blocked by the consolidation gate. The checkpoint lock documents and
    # enforces the vault boundary while its staging snapshot is copied.
    lock_checkpoint_root "$canonical_root"
    merge_workspace="$(mktemp -d "$state/storage-merge.XXXXXX")"
    trap_cleanup_dirs "$merge_workspace"
    staging_vault="$merge_workspace/vault"
    mkdir -p "$staging_vault" "$merge_workspace/state"
    rsync -a --exclude=.ags.lock -- "$canonical_root/" "$staging_vault/"
    unlock_checkpoint_root

    if [[ "$destination" == remote:* ]]; then
        remote_name="${destination#remote:}"
        seen_remote["$remote_name"]=1
        preflight_remotes+=("$remote_name")
    fi
    for source in "${sources[@]}"; do
        if [[ "$source" == remote:* ]]; then
            remote_name="${source#remote:}"
            [[ ! ${seen_remote[$remote_name]+present} ]] || continue
            seen_remote["$remote_name"]=1
            preflight_remotes+=("$remote_name")
        fi
    done

    merge_verified_revision=()
    # Build the complete union in an isolated vault first. Any record-ID
    # conflict dies here, before the canonical local vault is touched.
    for remote_name in "${preflight_remotes[@]}"; do
        revision="$(storage_remote_revision "$remote_name")"
        merge_verified_revision["$remote_name"]="$revision"
        pull_remote_into_staging_vault "$remote_name" "$revision" \
            "$staging_vault" "$merge_workspace/state"
    done

    # Re-read the exact revisions that passed preflight into the canonical
    # vault. Git checks the fetched commit; SFTP holds its remote operation
    # lock while checking the catalog and copying.
    for remote_name in "${preflight_remotes[@]}"; do
        log "Merging $(storage_mode_label "remote:$remote_name") into the local dedupe vault"
        (
            ags_expected_remote_revision="${merge_verified_revision[$remote_name]}"
            sync_records pull "$remote_name"
        )
        verify_remote_fully_pulled \
            "$remote_name" "${merge_verified_revision[$remote_name]}"
    done
    if [[ "$destination" == remote:* ]]; then
        remote_name="${destination#remote:}"
        log "Publishing the merged vault to $(storage_mode_label "$destination")"
        (
            ags_expected_remote_revision="${merge_verified_revision[$remote_name]}"
            sync_records sync "$remote_name"
        )
        revision="$(storage_remote_revision "$remote_name")"
        merge_verified_revision["$remote_name"]="$revision"
        verify_remote_fully_synchronized "$remote_name" "$revision"
    fi
    rm -rf -- "$merge_workspace"
    trap - EXIT
    # Keep merged source replicas recoverable until the user retires them, but
    # immediately route every future save (including already-running Agent
    # sessions that still export the old mode) into the verified destination.
    redirect_merged_storage_sources "$destination" "${sources[@]}"
    promote_storage_mode "$destination"
    unlock
    printf 'status=merged\ndestination=%s\n' "$destination"
    for source in "${sources[@]}"; do
        printf 'source=%s\n' "$source"
    done

    (( ${#retire_sources[@]} > 0 )) || return 0
    [[ "$prompt_retirement" == 1 ]] || return 0
    if [[ "$prompt_retirement" == 1 && -t 0 && -t 1 ]]; then
        printf 'Retire the merged remote source replicas now? [y/N]: '
        IFS= read -r answer
        case "$answer" in
            y|Y|yes|YES)
                for source in "${retire_sources[@]}"; do
                    retire_remote_replica "$source" "$destination"
                done
                ;;
            *) printf 'retired=false\n' ;;
        esac
    else
        printf 'retired=false\n'
        for source in "${retire_sources[@]}"; do
            printf 'retire_command=ags storage retire %s --into %s\n' \
                "$source" "$destination"
        done
    fi
}

cancel_remote_retirement() {
    local name="$1" temporary
    lock
    [[ -s "$storage_config" ]] || die "remote configuration disappeared: $name"
    temporary="$storage_config.tmp.$$"
    jq --arg name "$name" '
        del(.remotes[$name].retiring) | .version = 4
    ' "$storage_config" > "$temporary"
    chmod 600 "$temporary"
    mv -- "$temporary" "$storage_config"
    unlock
}

write_retirement_marker() {
    local path="$1" source="$2" destination="$3" timestamp="$4" revision="$5"
    printf 'ags-storage-retired-v1\nsource=%s\ndestination=%s\ntimestamp=%s\nrevision=%s\n' \
        "$source" "$destination" "$timestamp" "$revision" > "$path"
    chmod 600 "$path"
}

verify_retirement_marker() {
    local actual="$1" expected="$2"
    [[ -f "$actual" && ! -L "$actual" ]] && cmp -s "$actual" "$expected"
}

validate_git_retirement_tree() {
    local repo="$1" timestamp="$2" retired_root timestamp_root marker destination
    local attributes
    valid_retirement_timestamp "$timestamp" ||
        die "Git retirement timestamp is unsafe"
    retired_root="$repo/.ags-retired"
    timestamp_root="$retired_root/$timestamp"
    marker="$repo/$remote_retirement_marker"
    destination="$timestamp_root/$remote_store_prefix"
    attributes="$retired_root/.gitattributes"

    if [[ -e "$retired_root" || -L "$retired_root" ]]; then
        [[ -d "$retired_root" && ! -L "$retired_root" ]] ||
            die "Git retirement root is not a regular directory"
    fi
    if [[ -e "$timestamp_root" || -L "$timestamp_root" ]]; then
        [[ -d "$timestamp_root" && ! -L "$timestamp_root" ]] ||
            die "Git retirement timestamp path is not a regular directory"
    fi
    if [[ -e "$marker" || -L "$marker" ]]; then
        [[ -f "$marker" && ! -L "$marker" ]] ||
            die "Git retirement marker is not a regular file"
    fi
    if [[ -e "$attributes" || -L "$attributes" ]]; then
        [[ -f "$attributes" && ! -L "$attributes" &&
           "$(<"$attributes")" == '* -text -filter -diff -merge' ]] ||
            die "Git retirement attributes are unsafe or conflicting"
    fi
    if [[ -e "$destination" || -L "$destination" ]]; then
        [[ -d "$destination" && ! -L "$destination" ]] ||
            die "Git retired replica is not a regular directory"
    fi
}

git_revision_has_verified_retirement() {
    local repo="$1" revision="$2" expected_marker="$3"
    local expected_revision="$4" relative="$5"
    local marker_entry marker_copy attributes_entry attributes_copy
    local expected_oid original_tree retired_tree
    marker_entry="$(git -C "$repo" ls-tree "$revision" -- \
        "$remote_retirement_marker" 2>/dev/null)" || return 1
    [[ "$marker_entry" == 100644\ blob\ *$'\t'"$remote_retirement_marker" ]] ||
        return 1
    marker_copy="$sync_workspace/retirement-marker-readback.$RANDOM"
    git -C "$repo" show "$revision:$remote_retirement_marker" \
        > "$marker_copy" 2>/dev/null || return 1
    cmp -s "$marker_copy" "$expected_marker" || return 1
    attributes_entry="$(git -C "$repo" ls-tree "$revision" -- \
        ".ags-retired/.gitattributes" 2>/dev/null)" || return 1
    [[ "$attributes_entry" == \
       100644\ blob\ *$'\t'.ags-retired/.gitattributes ]] || return 1
    attributes_copy="$sync_workspace/retirement-attributes-readback.$RANDOM"
    git -C "$repo" show "$revision:.ags-retired/.gitattributes" \
        > "$attributes_copy" 2>/dev/null || return 1
    [[ "$(<"$attributes_copy")" == '* -text -filter -diff -merge' ]] ||
        return 1
    ! git -C "$repo" cat-file -e \
        "$revision:$remote_store_prefix" 2>/dev/null || return 1

    expected_oid="${expected_revision#git:}"
    original_tree=
    if [[ "$expected_oid" != absent ]]; then
        original_tree="$(git -C "$repo" rev-parse \
            "$expected_oid:$remote_store_prefix" 2>/dev/null || true)"
    fi
    if [[ -n "$original_tree" ]]; then
        retired_tree="$(git -C "$repo" rev-parse \
            "$revision:$relative" 2>/dev/null)" || return 1
        [[ "$retired_tree" == "$original_tree" ]] || return 1
    else
        ! git -C "$repo" cat-file -e \
            "$revision:$relative" 2>/dev/null || return 1
    fi
}

set_git_retired_remote_path() {
    local repo="$1" expected_revision="$2" relative="$3" expected_oid
    expected_oid="${expected_revision#git:}"
    if [[ "$expected_oid" != absent ]] &&
       git -C "$repo" rev-parse \
           "$expected_oid:$remote_store_prefix" >/dev/null 2>&1; then
        retired_remote_path="$sync_remote_url#$sync_remote_branch:$relative"
    else
        retired_remote_path="$sync_remote_url#$sync_remote_branch:no-active-replica"
    fi
}

retire_git_replica() {
    local timestamp="$1" expected_revision="$2" source="$3" destination_mode="$4"
    local destination relative current_revision marker expected_marker expected_oid
    local retirement_attributes
    local candidate_oid remote_output remote_oid remote_status push_status
    local verified_remote=0
    relative=".ags-retired/$timestamp/$remote_store_prefix"
    ags_allow_remote_retirement_marker=1
    sync_workspace=
    prepare_git_sync_workspace
    destination="$sync_git_repo/$relative"
    marker="$sync_git_repo/$remote_retirement_marker"
    validate_git_retirement_tree "$sync_git_repo" "$timestamp"
    retirement_attributes="$sync_git_repo/.ags-retired/.gitattributes"
    expected_marker="$sync_workspace/retirement.marker"
    write_retirement_marker "$expected_marker" "$source" "$destination_mode" \
        "$timestamp" "$expected_revision"

    if [[ -e "$marker" || -L "$marker" ]]; then
        git_revision_has_verified_retirement \
            "$sync_git_repo" HEAD "$expected_marker" \
            "$expected_revision" "$relative" ||
            die "Git remote has a different retirement marker"
        set_git_retired_remote_path \
            "$sync_git_repo" "$expected_revision" "$relative"
        cleanup_sync_workspace
        return 0
    fi
    if git -C "$sync_git_repo" rev-parse --verify HEAD >/dev/null 2>&1; then
        current_revision="git:$(git -C "$sync_git_repo" rev-parse HEAD)"
    else
        current_revision=git:absent
    fi
    if [[ "$current_revision" != "$expected_revision" ]]; then
        cleanup_sync_workspace
        cancel_remote_retirement "$sync_remote_name"
        die "Git remote changed after merge verification; retirement was cancelled"
    fi
    mkdir -p "$(dirname "$marker")"
    if [[ ! -e "$retirement_attributes" &&
          ! -L "$retirement_attributes" ]]; then
        printf '* -text -filter -diff -merge\n' > "$retirement_attributes"
    fi
    cp -- "$expected_marker" "$marker"
    if [[ -d "$sync_remote_root" ]]; then
        mkdir -p "$(dirname "$destination")"
        [[ ! -e "$destination" && ! -L "$destination" ]] ||
            die "Git retirement destination already exists without its marker"
        mv -- "$sync_remote_root" "$destination"
        retired_remote_path="$sync_remote_url#$sync_remote_branch:$relative"
    else
        retired_remote_path="$sync_remote_url#$sync_remote_branch:no-active-replica"
    fi
    if [[ -n "$(git -C "$sync_git_repo" ls-files -- "$remote_store_prefix")" ]]; then
        git -C "$sync_git_repo" add -A -- "$remote_store_prefix"
    fi
    git -C "$sync_git_repo" add -f -- \
        ".ags-retired/.gitattributes" "$remote_retirement_marker"
    if [[ -e "$destination" || -L "$destination" ]]; then
        git -C "$sync_git_repo" add -f -- "$relative"
    fi
    git -C "$sync_git_repo" commit -q \
        -m "ags retire $sync_remote_name into merged storage"
    candidate_oid="$(git -C "$sync_git_repo" rev-parse HEAD)"
    git_revision_has_verified_retirement \
        "$sync_git_repo" "$candidate_oid" "$expected_marker" \
        "$expected_revision" "$relative" ||
        die "Git retirement candidate failed its pre-push integrity check"

    if git -C "$sync_git_repo" push origin \
        "HEAD:refs/heads/$sync_remote_branch"; then
        push_status=0
    else
        push_status=$?
    fi
    if remote_output="$(git -C "$sync_git_repo" ls-remote \
        --exit-code --heads origin "refs/heads/$sync_remote_branch")"; then
        remote_oid="${remote_output%%[[:space:]]*}"
    else
        remote_status=$?
        if (( remote_status == 2 )); then
            remote_oid=absent
        else
            cleanup_sync_workspace
            die "Git retirement push result is ambiguous; the local fail-closed transaction was retained"
        fi
    fi
    if [[ "$remote_oid" == "$candidate_oid" ]]; then
        verified_remote=1
    elif [[ "$remote_oid" != absent ]]; then
        git -C "$sync_git_repo" fetch -q --no-tags --force origin \
            "refs/heads/$sync_remote_branch"
        if git_revision_has_verified_retirement \
            "$sync_git_repo" FETCH_HEAD "$expected_marker" \
            "$expected_revision" "$relative"; then
            verified_remote=1
        fi
    fi
    if (( verified_remote == 1 )); then
        set_git_retired_remote_path \
            "$sync_git_repo" "$expected_revision" "$relative"
        cleanup_sync_workspace
        return 0
    fi

    expected_oid="${expected_revision#git:}"
    if (( push_status != 0 )) &&
       [[ "$remote_oid" == "$expected_oid" ||
          ( "$expected_oid" == absent && "$remote_oid" == absent ) ]]; then
        cleanup_sync_workspace
        cancel_remote_retirement "$sync_remote_name"
        die "Git retirement was not accepted and the remote remained unchanged; the transaction was cancelled"
    fi
    cleanup_sync_workspace
    die "Git remote changed ambiguously during retirement; no force push was attempted and the fail-closed transaction was retained"
}

sftp_path_listing() {
    local path="$1" listing relative
    listing="$(sync_sftp_run lsf --recursive --files-only "$sync_remote_fs")" ||
        die "cannot inspect SFTP retirement path: $path"
    while IFS= read -r relative; do
        [[ "$relative" == "$path/"* ]] || continue
        printf '%s\n' "${relative#"$path/"}"
    done <<< "$listing"
}

sftp_server_retire() {
    local timestamp="$1" expected_revision="$2" upload_relative="$3"
    local marker_digest="$4" include_legacy="${5:-0}" expected_digest
    valid_retirement_timestamp "$timestamp" ||
        die "SFTP retirement timestamp is unsafe"
    [[ "$expected_revision" =~ ^sftp:([0-9a-f]{64})$ ]] ||
        die "SFTP retirement revision is invalid"
    expected_digest="${BASH_REMATCH[1]}"
    [[ "$marker_digest" =~ ^[0-9a-f]{64}$ ]] ||
        die "SFTP retirement marker digest is invalid"
    [[ "$include_legacy" == 0 || "$include_legacy" == 1 ]] ||
        die "SFTP retirement legacy mode is invalid"
    validate_sftp_relative_path "$upload_relative"
    printf '%s\n%s\n%s\n%s\n%s\n%s\n' \
        "$sync_remote_path" "$timestamp" "$expected_digest" \
        "$upload_relative" "$marker_digest" "$include_legacy" |
        sync_sftp_ssh_run '
            set -eu
            umask 077
            IFS= read -r root
            IFS= read -r timestamp
            IFS= read -r expected_digest
            IFS= read -r upload_relative
            IFS= read -r marker_digest
            IFS= read -r include_legacy
            case "$root" in
                /*) ;;
                *) exit 64 ;;
            esac
            case "$timestamp" in
                ""|*[!0-9A-Za-z._-]*) exit 64 ;;
            esac
            case "$expected_digest" in
                *[!0-9a-f]*|"") exit 64 ;;
            esac
            [ "${#expected_digest}" -eq 64 ]
            case "$marker_digest" in
                *[!0-9a-f]*|"") exit 64 ;;
            esac
            [ "${#marker_digest}" -eq 64 ]
            case "$include_legacy" in 0|1) ;; *) exit 64 ;; esac
            case "$upload_relative" in
                ""|/*|*/|.|..|../*|*/../*|*/..) exit 64 ;;
            esac
            [ -d "$root" ] && [ ! -L "$root" ]
            lock_path="$root/.ags-transaction.lock"
            if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
                [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
            fi
            exec 9>>"$lock_path"
            chmod 600 "$lock_path"
            flock -w 300 9
            [ -d "$root" ] && [ ! -L "$root" ]
            [ -f "$lock_path" ] && [ ! -L "$lock_path" ]
            [ -z "$(find "$root" -type l -print -quit)" ]

            active="$root/ags-v1"
            retired_root="$root/.ags-retired"
            destination="$retired_root/$timestamp/ags-v1"
            legacy_destination="$retired_root/$timestamp/legacy-cloud"
            pending="$retired_root/ags-v1.retiring"
            final="$retired_root/ags-v1.retired"
            upload="$root/$upload_relative"
            [ -f "$upload" ] && [ ! -L "$upload" ]
            [ "$(sha256sum "$upload" | cut -d" " -f1)" = "$marker_digest" ]
            mkdir -p -- "$retired_root"
            [ -d "$retired_root" ] && [ ! -L "$retired_root" ]

            list_tree() {
                tree="$1"
                if [ -e "$tree" ] || [ -L "$tree" ]; then
                    [ -d "$tree" ] && [ ! -L "$tree" ]
                    [ -z "$(find "$tree" ! -type f ! -type d -print -quit)" ]
                    (
                        cd -- "$tree"
                        find . -type f -print |
                            LC_ALL=C sort |
                            while IFS= read -r entry; do
                                path="${entry#./}"
                                case "$path" in
                                    ""|*[!A-Za-z0-9._/@+-]*) exit 65 ;;
                                esac
                                size="$(stat -c %s -- "$entry")"
                                digest="$(sha256sum "$entry" | cut -d" " -f1)"
                                printf "%s\t%s\t%s\n" "$path" "$size" "$digest"
                            done
                    )
                fi
            }
            list_legacy_tree() {
                tree="$1"
                prefix="$2"
                if [ -e "$tree" ] || [ -L "$tree" ]; then
                    [ -d "$tree" ] && [ ! -L "$tree" ]
                    [ -z "$(
                        find "$tree" ! -type f ! -type d -print -quit
                    )" ]
                    (
                        cd -- "$tree"
                        find . -type f -print |
                            LC_ALL=C sort |
                            while IFS= read -r entry; do
                                path="${entry#./}"
                                [ -n "$path" ]
                                size="$(stat -c %s -- "$entry")"
                                digest="$(
                                    sha256sum "$entry" | cut -d" " -f1
                                )"
                                path_digest="$(
                                    printf "%s/%s" "$prefix" "$path" |
                                        sha256sum |
                                        cut -d" " -f1
                                )"
                                printf "%s\t%s\t%s\n" \
                                    "$path_digest" "$size" "$digest"
                            done
                    )
                fi
            }
            legacy_union_listing() {
                {
                    list_legacy_tree "$active" ags-v1
                    list_legacy_tree "$destination" ags-v1
                    list_legacy_tree "$root/codex" codex
                    list_legacy_tree "$legacy_destination/codex" codex
                    list_legacy_tree "$root/claude" claude
                    list_legacy_tree "$legacy_destination/claude" claude
                } |
                    sed "/^$/d" |
                    LC_ALL=C sort -u
            }
            retired_legacy_listing() {
                {
                    list_legacy_tree "$destination" ags-v1
                    list_legacy_tree "$legacy_destination/codex" codex
                    list_legacy_tree "$legacy_destination/claude" claude
                } |
                    LC_ALL=C sort
            }
            tree_revision() {
                listing="$1"
                printf "%s\n" "$listing" |
                    LC_ALL=C sort |
                    sha256sum |
                    cut -d" " -f1
            }

            if [ -e "$final" ] || [ -L "$final" ]; then
                [ -f "$final" ] && [ ! -L "$final" ]
                cmp -s -- "$final" "$upload"
                [ ! -e "$active" ] && [ ! -L "$active" ]
                if [ "$include_legacy" -eq 1 ]; then
                    destination_listing="$(retired_legacy_listing)"
                else
                    destination_listing="$(list_tree "$destination")"
                fi
                [ "$(tree_revision "$destination_listing")" = "$expected_digest" ]
                if [ "$include_legacy" -eq 1 ]; then
                    [ ! -e "$root/codex" ] && [ ! -L "$root/codex" ]
                    [ ! -e "$root/claude" ] && [ ! -L "$root/claude" ]
                fi
                exit 0
            fi
            pending_existed=0
            if [ -e "$pending" ] || [ -L "$pending" ]; then
                [ -f "$pending" ] && [ ! -L "$pending" ]
                cmp -s -- "$pending" "$upload"
                pending_existed=1
            fi

            active_listing="$(list_tree "$active")"
            destination_listing="$(list_tree "$destination")"
            if [ "$include_legacy" -eq 1 ]; then
                union_listing="$(legacy_union_listing)"
            else
                union_listing="$(
                    printf "%s\n%s\n" \
                        "$active_listing" "$destination_listing" |
                        sed "/^$/d" |
                        LC_ALL=C sort -u
                )"
            fi
            if [ "$(tree_revision "$union_listing")" != "$expected_digest" ]; then
                untouched=0
                if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
                    if [ "$include_legacy" -eq 0 ] ||
                       { [ ! -e "$legacy_destination" ] &&
                         [ ! -L "$legacy_destination" ]; }; then
                        untouched=1
                    fi
                fi
                if [ "$untouched" -eq 1 ]; then
                    if [ "$pending_existed" -eq 1 ]; then
                        rm -f -- "$pending"
                    fi
                    exit 75
                fi
                exit 76
            fi
            if [ "$pending_existed" -eq 0 ]; then
                mv -- "$upload" "$pending"
            fi
            if [ -e "$active" ] || [ -L "$active" ]; then
                [ ! -e "$destination" ] && [ ! -L "$destination" ]
                mkdir -p -- "$(dirname -- "$destination")"
                mv -- "$active" "$destination"
            fi
            if [ "$include_legacy" -eq 1 ]; then
                mkdir -p -- "$legacy_destination"
                [ -d "$legacy_destination" ] &&
                    [ ! -L "$legacy_destination" ]
                for legacy_agent in codex claude; do
                    legacy_source="$root/$legacy_agent"
                    legacy_target="$legacy_destination/$legacy_agent"
                    if [ -e "$legacy_source" ] || [ -L "$legacy_source" ]; then
                        [ -d "$legacy_source" ] && [ ! -L "$legacy_source" ]
                        [ -z "$(
                            find "$legacy_source" \
                                ! -type f ! -type d -print -quit
                        )" ]
                        [ ! -e "$legacy_target" ] &&
                            [ ! -L "$legacy_target" ]
                        mv -- "$legacy_source" "$legacy_target"
                    fi
                done
            fi
            [ ! -e "$active" ] && [ ! -L "$active" ]
            if [ "$include_legacy" -eq 1 ]; then
                destination_listing="$(retired_legacy_listing)"
            else
                destination_listing="$(list_tree "$destination")"
            fi
            [ "$(tree_revision "$destination_listing")" = "$expected_digest" ]
            mv -- "$pending" "$final"
            [ -f "$final" ] && [ ! -L "$final" ]
        '
}

retire_sftp_replica() {
    local timestamp="$1" expected_revision="$2" source="$3" destination_mode="$4"
    local relative active_after destination_after marker_file downloaded
    local upload_relative remote_marker marker_digest server_status
    local include_legacy="${sync_remote_legacy_cloud:-0}"
    relative=".ags-retired/$timestamp/$remote_store_prefix"
    marker_file="$state/sftp-retirement-marker.$$.$RANDOM"
    downloaded="$state/sftp-retirement-readback.$$.$RANDOM"
    write_retirement_marker "$marker_file" "$source" "$destination_mode" \
        "$timestamp" "$expected_revision"
    marker_digest="$(sha256sum "$marker_file" | cut -d' ' -f1)"
    remote_marker="$sync_remote_fs/$remote_retirement_marker"
    upload_relative=".ags-retired/.transaction-$(
        printf '%s\n' "$marker_digest" | sha256sum | cut -d' ' -f1
    ).$$.$RANDOM.partial"
    ags_allow_remote_retirement_marker=1
    sync_sftp_run copyto "$marker_file" \
        "$sync_remote_fs/$upload_relative" ||
        die "cannot stage the SFTP retirement marker"
    if sftp_server_retire \
        "$timestamp" "$expected_revision" "$upload_relative" "$marker_digest" \
        "$include_legacy"; then
        server_status=0
    else
        server_status=$?
        sync_sftp_run deletefile \
            "$sync_remote_fs/$upload_relative" >/dev/null 2>&1 || true
    fi
    if (( server_status == 75 )); then
        rm -f -- "$downloaded" "$marker_file"
        cancel_remote_retirement "$sync_remote_name"
        die "SFTP remote advanced before retirement; the untouched transaction was cancelled, so rerun the merge"
    elif (( server_status != 0 )); then
        die "SFTP retirement did not match its verified revision; the fail-closed transaction was retained"
    fi
    sync_sftp_run copyto "$remote_marker" "$downloaded" ||
        die "cannot read back the committed SFTP retirement marker"
    cmp -s "$downloaded" "$marker_file" ||
        die "SFTP retirement marker differs after commit"
    active_after="$(sftp_path_listing "$remote_store_prefix")"
    destination_after="$(sftp_path_listing "$relative")"
    [[ -z "$active_after" ]] ||
        die "SFTP retirement left files in the active replica"
    if [[ "$include_legacy" == 1 ]]; then
        [[ "$(
            sftp_server_legacy_revision \
                "$relative" ".ags-retired/$timestamp/legacy-cloud"
        )" == "$expected_revision" ]] ||
            die "SFTP retired legacy replica differs from its verified source revision"
        [[ -z "$(sftp_path_listing codex)" &&
           -z "$(sftp_path_listing claude)" ]] ||
            die "SFTP retirement left legacy cloud records active"
    else
        [[ "$(sftp_server_tree_revision "$relative")" == "$expected_revision" ]] ||
            die "SFTP retired replica differs from its verified source revision"
    fi
    if [[ -n "$destination_after" || "$include_legacy" == 1 ]]; then
        if [[ "$include_legacy" == 1 ]]; then
            retired_remote_path="$sync_remote_url/.ags-retired/$timestamp"
        else
            retired_remote_path="$sync_remote_url/$relative"
        fi
    else
        retired_remote_path="$sync_remote_url/no-active-replica"
    fi
    sync_sftp_run deletefile \
        "$sync_remote_fs/$upload_relative" >/dev/null 2>&1 || true
    rm -f -- "$downloaded" "$marker_file"
}

retire_remote_replica() {
    local source="$1" destination="$2" name removal recoverable_config revision
    mkdir -p "$state"
    exec 7>"$state/storage-retirement.lock"
    flock 7
    [[ "$source" == remote:* ]] ||
        die "local storage is required as AGS's dedupe vault and cannot be retired"
    [[ "$source" != "$destination" ]] ||
        die "cannot retire the merge destination"
    name="${source#remote:}"
    lock_remote_operation "$name"
    revision="${merge_verified_revision[$name]:-}"
    prepare_remote_retirement "$name" "$destination" "$revision"
    ags_allow_retiring_remote=1
    select_named_remote "$name"
    case "$sync_remote_type" in
        git)
            retire_git_replica "$retirement_timestamp" "$retirement_revision" \
                "$source" "$destination"
            ;;
        sftp)
            retire_sftp_replica "$retirement_timestamp" "$retirement_revision" \
                "$source" "$destination"
            ;;
    esac
    removal="$(remove_named_remote "$name" --retirement)"
    recoverable_config="$(sed -n 's/^recoverable_config=//p' <<< "$removal")"
    printf 'status=retired\nsource=%s\ndestination=%s\nrecoverable_replica=%s\nrecoverable_config=%s\n' \
        "$source" "$destination" "$retired_remote_path" "$recoverable_config"
    unlock_remote_operation
    flock -u 7
    exec 7>&-
}

merge_storage_command() {
    local destination_requested destination
    local -a sources=()
    [[ "${1:-}" == --into && -n "${2:-}" ]] ||
        die "usage: ags storage merge --into local|NAME [SOURCE...]"
    destination_requested="$2"
    shift 2
    sources=("$@")
    lock_storage_consolidation
    if [[ -s "$storage_config" ]] &&
       jq -e 'any((.remotes // {})[]; .retiring != null)' \
           "$storage_config" >/dev/null; then
        die "an interrupted storage retirement must be resumed before another consolidation"
    fi
    ags_ignore_storage_redirect=1
    resolve_storage_mode "$destination_requested"
    ags_ignore_storage_redirect=0
    destination="$resolved_storage_mode"
    merge_storage_modes "$destination" 1 "${sources[@]}"
    unlock_storage_consolidation
}

retire_storage_command() {
    local source_requested="${1:-}" destination_requested source destination name
    local retirement_pending=0
    (( $# == 3 )) && [[ "${2:-}" == --into ]] ||
        die "usage: ags storage retire SOURCE --into local|NAME"
    lock_storage_consolidation
    destination_requested="$3"
    # An interrupted retirement remains explicitly resumable, but no ordinary
    # sync or save may use that source while its transaction marker exists.
    ags_allow_retiring_remote=1
    ags_ignore_storage_redirect=1
    resolve_storage_mode "$source_requested"
    source="$resolved_storage_mode"
    ags_ignore_storage_redirect=0
    [[ "$source" == remote:* ]] ||
        die "local storage is required as AGS's dedupe vault and cannot be retired"
    ags_allow_retiring_remote=0
    resolve_storage_mode "$destination_requested"
    destination="$resolved_storage_mode"
    [[ "$source" != "$destination" ]] ||
        die "source and destination storage must differ"
    name="${source#remote:}"
    if jq -e --arg name "$name" --arg destination "$destination" '
        any(
            (.remotes // {}) | to_entries[];
            .value.retiring != null and (
                .key != $name or
                .value.retiring.destination != $destination
            )
        )
    ' "$storage_config" >/dev/null; then
        die "a different interrupted storage retirement must be resumed first"
    fi
    if jq -e --arg name "$name" '.remotes[$name].retiring != null' \
        "$storage_config" >/dev/null; then
        retirement_pending=1
    fi
    if (( retirement_pending == 0 )); then
        ags_allow_retiring_remote=0
        ags_ignore_storage_redirect=1
        merge_storage_modes "$destination" 0 "$source"
        ags_ignore_storage_redirect=0
    fi
    retire_remote_replica "$source" "$destination"
    unlock_storage_consolidation
}

delete_local_checkpoint() {
    local checkpoint_id="${1:-}" agent trash_dir trash_path digest
    local tombstone_dir tombstone_path tombstone_partial
    local storage_mode pending_sync timestamp
    (( $# == 1 )) || die "usage: ags delete ID"
    lock_storage_consolidation
    load_local_storage
    need sha256sum
    storage_mode="$(default_storage_mode)"
    lock
    lock_checkpoint_root "$local_checkpoints"
    find_local_checkpoint_archive "$checkpoint_id"
    agent="${checkpoint_match%/*}"
    agent="${agent##*/}"
    digest="$(
        sha256sum "$checkpoint_match" | cut -d' ' -f1
    )" || die "cannot hash checkpoint before deletion"
    timestamp="$(date -u +%Y%m%dT%H%M%S.%NZ)" ||
        die "cannot timestamp checkpoint deletion"
    trash_dir="$state/trash/local/$agent"
    trash_path="$trash_dir/${checkpoint_match##*/}.deleted.$timestamp"
    tombstone_dir="$local_checkpoints/tombstones/$agent"
    tombstone_path="$tombstone_dir/$checkpoint_record_id.tombstone"
    tombstone_partial="$tombstone_dir/.$checkpoint_record_id.partial.$$.$RANDOM"
    mkdir -p -- "$trash_dir" "$tombstone_dir" ||
        die "cannot create recoverable checkpoint deletion paths"
    [[ ! -e "$trash_path" ]] || die "trash destination already exists"
    write_tombstone \
        "$tombstone_partial" "$checkpoint_record_id" "$agent" "$digest" ||
        die "cannot stage tombstone for $checkpoint_record_id"
    if [[ -e "$tombstone_path" ]]; then
        cmp -s "$tombstone_partial" "$tombstone_path" ||
            { rm -f -- "$tombstone_partial"; die "E_SYNC_CONFLICT: record_id=$checkpoint_record_id local tombstone differs"; }
    fi
    if ! mv -- "$checkpoint_match" "$trash_path"; then
        rm -f -- "$tombstone_partial" 2>/dev/null || true
        die "cannot move checkpoint to recoverable trash: $checkpoint_record_id"
    fi
    if [[ ! -e "$tombstone_path" ]] && ! ln -- "$tombstone_partial" "$tombstone_path"; then
        mv -- "$trash_path" "$checkpoint_match" ||
            log "warning: failed to roll back record after tombstone publish failure"
        rm -f -- "$tombstone_partial" 2>/dev/null || true
        die "cannot publish tombstone for $checkpoint_record_id"
    fi
    rm -f -- "$tombstone_partial" ||
        log "warning: committed tombstone left a harmless staging file: $tombstone_partial"
    unlock_checkpoint_root
    unlock
    printf 'status=deleted\ntarget=%s\ncheckpoint_id=%s\nrecord_id=%s\nrecoverable_path=%s\n' \
        local "$checkpoint_id" "$checkpoint_record_id" "$trash_path"
    printf 'tombstone=%s\n' "$tombstone_path"
    if [[ "$storage_mode" == remote:* ]]; then
        if (auto_sync_storage_mode "$storage_mode"); then
            printf 'sync_status=synchronized\nstorage_mode=%s\n' "$storage_mode"
        else
            if ! pending_sync="$(
                queue_storage_sync_retry \
                    "$storage_mode" "delete:$checkpoint_record_id"
            )"; then
                die "checkpoint was deleted locally, but its remote retry could not be recorded; run ags sync $storage_mode"
            fi
            printf 'sync_status=pending\nstorage_mode=%s\npending_sync=%s\n' \
                "$storage_mode" "$pending_sync"
            unlock_storage_consolidation
            return 1
        fi
    else
        printf 'sync_status=local\nstorage_mode=local\n'
    fi
    unlock_storage_consolidation
}

status_sessions() {
    [[ -d "$store" ]] || { log "no snapshots: $store"; return; }
    find "$store" -maxdepth 1 -type f -name '*.sessions.tar.gz.age' \
        -printf '%TY-%Tm-%Td %TH:%TM  %10s bytes  %f\n' | sort
}

rehome_claude() {
    local id="${1:-}" cwd project_key destination
    local -a matches
    [[ "$id" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] ||
        die "expected a Claude session UUID"
    cwd="$(pwd -P)"
    project_key="$(claude_project_key_for_cwd "$cwd")"
    destination="$claude_home/projects/$project_key/$id.jsonl"
    [[ -f "$destination" ]] && { log "already mapped to $cwd"; return; }

    mapfile -d '' matches < <(find "$claude_home/projects" -type f -name "$id.jsonl" -print0 2>/dev/null)
    (( ${#matches[@]} == 1 )) || die "expected one local copy of $id; found ${#matches[@]}"
    replace_file "${matches[0]}" "$destination"
    log "mapped $id to $cwd; now run: claude --resume $id"
}

# 记录存放的地方，一套命令。
#
# 以前这是三家：`ags set DIR`（本地）、`ags remote *`（git/sftp）、`ags storage *`
# （在它们之间切换），外加 `ags cloud *`（sftp 的旧版重复实现）。而底下其实只有一个
# 概念——**一个 store 就是 `local` 或 `remote:<名字>`**：`storage list` 列的本来就是
# 这两者的并集，两个 `use` 更是同一行代码（都调 `promote_storage_mode`）。
#
# 后端在 `add` 的时候说清楚，之后每一条命令都只认名字。
store_command() {
    local command="${1:-}"
    shift || true
    case "$command" in
        ''|list|ls) list_storage_modes "$@" ;;
        add) store_add "$@" ;;
        use|default) use_storage_mode "$@" ;;
        show) store_show "$@" ;;
        remove|rm)
            [[ "${1:-}" != local ]] ||
                die "本地 store 删不掉；换一个用 ags store add local ABSOLUTE_DIR"
            remove_named_remote "$@"
            ;;
        merge) merge_storage_command "$@" ;;
        retire) retire_storage_command "$@" ;;
        -h|--help|help) usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

# `ags store add local DIR` 和 `ags store add NAME git|sftp LOCATION`。
#
# `local` 是保留名字：它不是一个远端，落到的是完全另一套代码（本地保险库的配置与
# 迁移）。分在这里而不是在 `add_named_remote` 里，是因为那个函数从第一行起就在做
# 只有远端才有的事——名字校验、远端锁、host key。
store_add() {
    local name="${1:-}"
    (( $# >= 2 )) ||
        die "usage: ags store add local ABSOLUTE_DIR | ags store add NAME git|sftp LOCATION [OPTIONS]"
    if [[ "$name" == local ]]; then
        (( $# == 2 )) || die "usage: ags store add local ABSOLUTE_DIR"
        configure_local_storage "$2"
        return
    fi
    add_named_remote "$@"
}

store_show() {
    local name="${1:-}"
    (( $# == 1 )) || die "usage: ags store show NAME|local"
    if [[ "$name" == local ]]; then
        need jq
        [[ -s "$storage_config" ]] || die "no storage configured; run ags init"
        # 读 `.local_path`，不是 `storage_mode_label` —— 后者返回的是列表里那一列的
        # 显示名（"Local"），而 `show` 问的是"它到底在哪"。
        printf 'store=local\ntype=local\npath=%s\n' \
            "$(jq -r '.local_path // .paths.local // "unset"' "$storage_config")"
        return
    fi
    show_named_remote "$name"
}

# 老名字还认，但从帮助里撤了。
#
# 写 stderr 不写 stdout：`ags remote list` 的输出有脚本在解析，一行提示混进 stdout
# 会把它们弄坏——而提示本身对着人说就够了。
deprecated_store_alias() {
    printf '[ags] `ags %s` 并进 `ags store` 了（%s）；老名字下个版本移除\n' \
        "$1" "$2" >&2
}

remote_command() {
    local command="${1:-}"
    shift || true
    case "$command" in
        add) add_named_remote "$@" ;;
        list|ls) list_named_remotes "$@" ;;
        show) show_named_remote "$@" ;;
        use|default) use_named_remote "$@" ;;
        remove) remove_named_remote "$@" ;;
        -h|--help|help|'') usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

storage_command() {
    local command="${1:-}"
    shift || true
    case "$command" in
        list|ls) list_storage_modes "$@" ;;
        use) use_storage_mode "$@" ;;
        merge) merge_storage_command "$@" ;;
        retire) retire_storage_command "$@" ;;
        -h|--help|help|'') usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

legacy_command() {
    local group="${1:-}" command="${2:-}"
    shift 2 2>/dev/null || true
    [[ "$group" == history ]] || die "usage: ags legacy history push|pull|status"
    case "$command" in
        push)
            (( $# == 0 )) || die "usage: ags legacy history push"
            push_sessions
            ;;
        pull)
            (( $# == 0 )) || die "usage: ags legacy history pull"
            pull_sessions
            ;;
        status)
            (( $# == 0 )) || die "usage: ags legacy history status"
            status_sessions
            ;;
        *) die "usage: ags legacy history push|pull|status" ;;
    esac
}

# Keep the installed codext current, as part of `ags update`.
#
# Separate from the ags update because they are separate release trains: the
# fork tracks upstream Codex, ags tracks AGS. Folding them into one version
# check would mean a Codex release could not reach a machine until AGS also
# cut one.
#
# Unlike the ags path there is no installer to hand over to — codext ships a
# single binary — so the download happens here. It is written beside the binary
# it replaces and moved into place, so an interrupted download never leaves a
# half-written executable on PATH.
# Asset names this machine can use, best first.
#
# musl first because it runs on any glibc vintage; gnu is listed as a fallback
# so a release cut from a workstation rather than from CI is still installable.
# Both contain the same binary — only the libc it is linked against differs.
# A token that can read the codext repository.
#
# The fork is private on purpose — it names the pool's endpoint prefix, and that
# prefix is part of how the endpoint stays unfound. So unlike a public release,
# reading it needs credentials. `gh` is the usual source; the env vars are for
# machines without it.
codext_update_token() {
    local token="${CODEXT_UPDATE_TOKEN:-${GH_TOKEN:-${GITHUB_TOKEN:-}}}"
    if [[ -z "$token" ]] && command -v gh >/dev/null 2>&1; then
        token="$(gh auth token 2>/dev/null || true)"
    fi
    printf '%s\n' "$token"
}

codext_asset_names() {
    local machine
    machine="$(uname -m)"
    case "$platform:$machine" in
        Linux:x86_64)
            printf 'codext-x86_64-unknown-linux-musl.tar.gz\n'
            printf 'codext-x86_64-unknown-linux-gnu.tar.gz\n'
            ;;
        Linux:aarch64)
            printf 'codext-aarch64-unknown-linux-musl.tar.gz\n'
            printf 'codext-aarch64-unknown-linux-gnu.tar.gz\n'
            ;;
        Darwin:arm64)   printf 'codext-aarch64-apple-darwin.tar.gz\n' ;;
        Darwin:x86_64)  printf 'codext-x86_64-apple-darwin.tar.gz\n' ;;
        *) return 1 ;;
    esac
}

# 上游那个「整包」的 target 名。
#
# codext 只是 codex 换掉了一个可执行文件，剩下的东西——`codex-code-mode-host`、
# `rg`、`bwrap`、自带的 zsh——我们一行都没改，所以不该由我们构建，也不该由我们
# 分发：直接用上游发布的整包，把里面的 entrypoint 换成我们的二进制就是 codext。
#
# 这样「ags 能不能 hold 住 codext 的下一次更新」就不再取决于我们维护的清单：包里
# 有什么由上游的 `codex-package.json` 说了算。上游哪天再拆出一个 sidecar、换掉
# `rg`、加一个新的 resources 目录，下一次更新自动带上，这里一个字都不用改。
#
# Linux 上游整包只发 musl，我们的 `codext` 目前是 gnu。混用没有问题：sidecar 是
# **独立进程**（`codex-code-mode-host` 走 WebSocket），resources 是数据和自带的
# 静态二进制，两边不共享 ABI。
codext_package_target() {
    local machine
    machine="$(uname -m)"
    case "$platform:$machine" in
        Linux:x86_64)   printf 'x86_64-unknown-linux-musl\n' ;;
        Linux:aarch64)  printf 'aarch64-unknown-linux-musl\n' ;;
        Darwin:arm64)   printf 'aarch64-apple-darwin\n' ;;
        Darwin:x86_64)  printf 'x86_64-apple-darwin\n' ;;
        *) return 1 ;;
    esac
}

# 把上游整包装成 codext：树整个是上游的，只有 entrypoint 换成我们的二进制。
#
# 这是 codext 应该长成的样子——上游分发的是一棵树（`bin/codex`、
# `bin/codex-code-mode-host`、`codex-path/rg`、`codex-resources/{bwrap,zsh}`，外加
# 一份自描述的 `codex-package.json`），而我们只改了其中一个文件。以前只发那一个
# 文件，等于把上游的其余部分整个丢掉：0.147.0 之后 code mode 只走独立 host，缺了
# 它就 fail closed，而 `rg`/`bwrap`/`zsh` 也一直在退回系统版本。
#
# 装成这个布局还有一层作用：`codex-package.json` 一旦在树里，`InstallContext` 就
# 认出这是一个包，从而去 `codex-resources` / `codex-path` 找东西——和官方安装的
# codex 走同一条路径解析。
#
# 版本对齐是天然的：codext 的版本号**就是**上游版本号，`v0.147.0` 直接对应上游
# `rust-v0.147.0`，不需要任何映射表。
#
# 失败一律返回非零，不 die：调用方会退回只装我们那一个二进制。
install_codext_package() {
    local workspace="$1" version="$2" binary="$3"
    local target url pkg entrypoint root dest staged
    need jq

    target="$(codext_package_target)" || return 1
    pkg="$workspace/pkg"
    mkdir -p -- "$pkg" || return 1

    # 上游仓库是公开的，这里**不带** token：把我们的凭据发给别人的仓库既无必要
    # 也不该做。
    url="https://github.com/openai/codex/releases/download/rust-v$version/codex-package-$target.tar.gz"
    curl -fsSL --connect-timeout 5 --max-time 900 "$url" -o "$workspace/pkg.tar.gz" || {
        log "取不到上游整包（rust-v$version / ${target}），这次只装 codext 本身"
        return 1
    }
    tar -xzf "$workspace/pkg.tar.gz" -C "$pkg" || {
        log "上游整包解包失败，这次只装 codext 本身"
        return 1
    }

    # entrypoint 从清单里读，不写死 `bin/codex`：上游换了位置我们跟着换。
    entrypoint="$(jq -er '.entrypoint | select(type == "string" and . != "")' \
        < "$pkg/codex-package.json" 2>/dev/null)" || {
        log "上游整包没有可用的 codex-package.json，这次只装 codext 本身"
        return 1
    }
    case "$entrypoint" in
        /*|*..*) log "上游整包的 entrypoint 不是包内相对路径，拒绝：$entrypoint"; return 1 ;;
    esac
    [[ -f "$pkg/$entrypoint" ]] || {
        log "上游整包里没有 ${entrypoint}，这次只装 codext 本身"
        return 1
    }

    # 换掉那一个文件。这就是 codext 与上游的全部差异。
    # 磁盘满就是在这里炸的（1.2G 的二进制）。不解释一句的话，用户看到的只有内核那行
    # 裸的 `cat: ... No space left on device`，然后是一句 "updated codext"——**装是装上
    # 了，但退成了单文件布局**，`codex-code-mode-host` / `rg` / `bwrap` / `zsh` 全部
    # 没有，而这件事没有任何提示。code mode 下一次就会失效，且看不出和这次更新有关。
    if ! cat -- "$workspace/codext" > "$pkg/$entrypoint"; then
        log "写入整包的 entrypoint 失败（多半是磁盘满），这次只装 codext 本身；"
        log "腾出空间后重跑 ags codext-update 可以恢复整包布局（code mode 需要它）"
        return 1
    fi
    chmod 755 "$pkg/$entrypoint" || return 1

    root="${AGS_CODEXT_PACKAGE_ROOT:-$HOME/.local/share/codext}"
    install -d -m755 "$root" 2>/dev/null || return 1
    dest="$root/$version"
    staged="$root/.staging.$$"
    rm -rf -- "$staged"
    mv -- "$pkg" "$staged" || return 1
    # 先把旧版挪开再落位：跨目录 rename 不是原子的，而一个跑到一半被覆盖的树比
    # 没有树更难查。旧版留着，回退只是改一个软链接。
    rm -rf -- "$dest.prev"
    [[ ! -e "$dest" ]] || mv -- "$dest" "$dest.prev" || { rm -rf -- "$staged"; return 1; }
    mv -- "$staged" "$dest" || {
        [[ ! -e "$dest.prev" ]] || mv -- "$dest.prev" "$dest"
        rm -rf -- "$staged"
        return 1
    }

    # `$binary` 变成指向包内 entrypoint 的软链接。先建后换，PATH 上那个名字不会有
    # 一瞬间是坏的。
    ln -sfn -- "$dest/$entrypoint" "$binary.new.$$" &&
        mv -- "$binary.new.$$" "$binary" || {
        rm -f -- "$binary.new.$$"
        return 1
    }
    rm -rf -- "$dest.prev"
    log "codext $version 按上游整包布局装在 ${dest}（entrypoint 已换成我们的构建）"
    return 0
}

update_codext() {
    local check_only="${1:-0}"
    local owner="${CODEXT_UPDATE_OWNER:-jk-zhang-meta}"
    local repo="${CODEXT_UPDATE_REPO:-codext}"
    local binary destination current tag response status asset url workspace stamp
    local token asset_id digest entry actual codex_binary fresh=0
    local -a candidates=() auth=()

    binary="$(command -v codext 2>/dev/null || true)"
    if [[ -z "$binary" ]]; then
        # Not installed yet: put it exactly where the native Codex lives.
        # `resolve_agent_binary` decides by nothing more than whether `codext`
        # is on PATH, so landing in that same directory is what makes every
        # launch path start going through the pool.
        #
        # The directory of the path `command -v` reported, deliberately not the
        # resolved one: Codex installs itself as a symlink into
        # ~/.codex/packages/standalone/current/bin, and that directory is not on
        # PATH. Following the link would install into a place nothing looks.
        codex_binary="$(command -v codex 2>/dev/null || true)"
        if [[ -n "$codex_binary" ]]; then
            binary="$(dirname "$codex_binary")/codext"
        else
            # No Codex at all on this host. codext is a complete Codex, so
            # installing it is still the right answer — next to ags, which is
            # the installer's --dest and the one directory install.sh's
            # maybe_add_path puts on PATH. Anywhere else and `codext` would not
            # be a command the user can type.
            binary="${AGS_CONVERTER_BINARY:-}"
            [[ -n "$binary" ]] || return 0
            binary="$(dirname "$binary")/codext"
        fi
        fresh=1
    fi
    destination="$(dirname "$binary")"
    [[ -w "$destination" ]] || {
        log "codext 的目标目录不可写，跳过：$destination"
        return 0
    }

    # The build we last installed, identified by the release asset's content
    # digest and deliberately not by the tag.
    #
    # codext's version is the upstream Codex version, exactly, and carries no
    # fork-local suffix — `codext --version` has to be readable as `codex
    # --version` by anything that reads either. So successive codext builds on
    # one upstream base all publish under the same tag, and the tag cannot say
    # whether this host has the current one. The digest is what moves when the
    # binary does, and it says "no change" for a rebuild of identical bytes.
    #
    # A first install ignores the stamp entirely. It outlives an uninstalled
    # binary, and trusting it there would report "already current" about a
    # codext that is not on the disk. So does a stamp from before this was a
    # digest, which costs exactly one re-download to correct itself.
    stamp="$state/codext-release"
    current=
    if (( fresh == 0 )) && [[ -s "$stamp" ]]; then
        IFS= read -r current < "$stamp" || current=
        [[ "$current" == sha256:* ]] || current=
    fi

    mapfile -t candidates < <(codext_asset_names) || true
    (( ${#candidates[@]} > 0 )) || {
        log "codext 没有为 $platform/$(uname -m) 发布的版本，跳过"
        return 0
    }

    token="$(codext_update_token)"
    auth=()
    [[ -z "$token" ]] || auth=(-H "Authorization: Bearer $token")
    response="$(curl -sSL --connect-timeout 5 --max-time 20 --max-filesize 1048576 \
        -H 'Accept: application/vnd.github+json' "${auth[@]}" -w '\n%{http_code}' \
        "https://api.github.com/repos/$owner/$repo/releases/latest" 2>/dev/null)" || {
        log "连不上 api.github.com，跳过 codext 更新"
        return 0
    }
    status="${response##*$'\n'}"
    response="${response%$'\n'*}"
    if [[ "$status" != 200 ]]; then
        if [[ "$status" == 404 && -z "$token" ]]; then
            log "读不到 $owner/${repo}（私有仓库需要授权）：装个 gh 并 gh auth login，或设 CODEXT_UPDATE_TOKEN"
        else
            log "$owner/$repo 查不到发布（状态 ${status}），跳过 codext 更新"
        fi
        return 0
    fi

    tag="$(jq -er '.tag_name | select(type == "string" and test("^v[0-9]"))' \
        <<< "$response" 2>/dev/null)" || {
        log "$owner/$repo 最新发布没有可用的版本号，跳过"
        return 0
    }
    # The API asset URL, not browser_download_url: the latter redirects to a
    # signed CDN link that a private repository will not issue without the
    # Authorization header, and curl drops that header across hosts.
    #
    # Resolved before the up-to-date check and not after it, because the digest
    # that answers that question belongs to this asset.
    asset_id=
    digest=
    for asset in "${candidates[@]}"; do
        if entry="$(jq -er --arg name "$asset" '
            .assets[] | select(.name == $name) | "\(.id) \(.digest // "")"
        ' <<< "$response" 2>/dev/null)"; then
            asset_id="${entry%% *}"
            digest="${entry#* }"
            break
        fi
    done
    [[ -n "$asset_id" ]] || {
        log "${tag#v} 里没有 ${candidates[0]}（或其它本机可用的包），跳过 codext 更新"
        return 0
    }
    url="https://api.github.com/repos/$owner/$repo/releases/assets/$asset_id"

    # An asset GitHub has not published a digest for cannot prove it is
    # unchanged, so it reinstalls rather than being assumed current.
    if [[ -n "$digest" && "$digest" == "$current" ]]; then
        log "already current: codext ${tag#v}"
        forget_update_notice "update available: codext"
        return 0
    fi
    if (( check_only == 1 )); then
        if (( fresh == 1 )); then
            log "codext 还没装；ags update 会把 ${tag#v} 装到 $destination"
        else
            log "update available: codext ${tag#v} 有新构建"
        fi
        return 0
    fi

    if (( fresh == 1 )); then
        log "installing codext ${tag#v} into $destination"
    else
        log "updating codext to ${tag#v}"
    fi
    workspace="$(mktemp -d "${TMPDIR:-/tmp}/codext-update.XXXXXX")" ||
        die "cannot create a temporary directory for the codext download"
    curl -fsSL --connect-timeout 5 --max-time 900 \
        -H 'Accept: application/octet-stream' "${auth[@]}" \
        "$url" -o "$workspace/$asset" || {
        rm -rf -- "$workspace"
        log "codext ${tag#v} 下载失败，现有版本没有变动"
        return 0
    }
    # The digest is about to be written down as "the build this host has", and
    # every later update check trusts that record. A truncated download would
    # make it a lie that never corrects itself — the check would keep answering
    # "already current" about bytes that are not there. Verifying here is what
    # makes the stamp mean anything, and it is also the only integrity check
    # standing between a mangled download and an executable on PATH.
    if [[ -n "$digest" ]]; then
        actual="$(sha256_file "$workspace/$asset")" || actual=
        if [[ "sha256:$actual" != "$digest" ]]; then
            rm -rf -- "$workspace"
            log "codext ${tag#v} 下载内容跟发布的 sha256 对不上，现有版本没有变动"
            return 0
        fi
    fi
    tar -xzf "$workspace/$asset" -C "$workspace" || {
        rm -rf -- "$workspace"
        log "codext ${tag#v} 解包失败，现有版本没有变动"
        return 0
    }
    [[ -f "$workspace/codext" ]] || {
        rm -rf -- "$workspace"
        log "codext ${tag#v} 的包里没有 codext 可执行文件，现有版本没有变动"
        return 0
    }
    chmod 755 "$workspace/codext"
    # 先按上游的整包装。装成了，`$binary` 已经是指向包内 entrypoint 的软链接。
    if ! install_codext_package "$workspace" "${tag#v}" "$binary"; then
        # 退回只装我们这一个二进制——codext 一直以来的形态。宁可暂时少 code mode，
        # 也不要让上游侧的一次抖动把这台机器上能跑的 codext 弄没。
        #
        # Same directory, so this is a rename and not a copy: the binary is never
        # observed half-written, and a running codext keeps its own inode.
        rm -f -- "$binary.new.$$"
        mv -- "$workspace/codext" "$binary.new.$$" &&
            mv -- "$binary.new.$$" "$binary" || {
            rm -f -- "$binary.new.$$"
            rm -rf -- "$workspace"
            die "cannot replace $binary"
        }
    fi
    rm -rf -- "$workspace"
    install -d -m700 "$state"
    # 写不进去就说出来。这一行失败而无人知晓的后果是**每次都重下一遍**：下一次检查
    # 读不到 stamp，就认定这台机器还没装过，于是又下 300MB、又失败、又不记账。磁盘满
    # 的时候这会变成一个自己不会停的循环。
    printf '%s\n' "$digest" > "$stamp" || {
        log "记不下这次安装的版本（$stamp 写失败，多半是磁盘满）；"
        log "下一次检查会当成没装过、再下一遍。先腾空间，再重跑 ags codext-update"
    }
    if (( fresh == 1 )); then
        # Without a pool configured codext is exactly stock Codex, and it says
        # nothing about it. Someone who never runs codex-init would keep using
        # their own account and never learn why.
        #
        # The directory is already on PATH — it is the one Codex itself is in,
        # or the one ags is in. What is not is zsh's command table: it is built
        # once and a binary that appears afterwards stays invisible until
        # `rehash`. AGS launches codext by absolute path and does not care, but
        # someone typing `codext` in the shell they ran this from does.
        log "installed codext ${tag#v} at ${binary}；跑 ags codex-init 配置凭据池"
        log "直接敲 codext 需要新开一个终端（zsh 里 rehash 也行）"
    else
        log "updated codext to ${tag#v}"
    fi
    forget_update_notice "update available: codext"
}


# `ags update` deliberately does not know how to update anything.
#
# install.sh already owns the hard parts — resolving the platform, verifying
# the checksum and the sigstore signature, swapping the binary through a
# journalled transaction that can roll back,
# the wrapper and the skills. A second, thinner implementation here would be
# the one users actually run, and it would be the one without the rollback.
#
# So this does the three things the installer cannot do for itself: read the
# version that is actually running, decide whether anything needs to happen at
# all, and hand over to the installer that shipped with the target release.
update_ags() {
    local check_only=0
    local owner="${AGS_UPDATE_OWNER:-jk-zhang-meta}"
    local repo="${AGS_UPDATE_REPO:-ags}"
    local binary destination current tag response status workspace

    while (( $# > 0 )); do
        case "$1" in
            --check) check_only=1; shift ;;
            *) die "usage: ags update [--check]" ;;
        esac
    done

    need curl; need jq

    # codext first, and never fatally: it is a separate release train, and a
    # machine that has not installed it at all is a normal machine. Running it
    # before the ags update means a failure here still leaves ags updatable.
    update_codext "$check_only" || true

    binary="$(resolve_ags_converter_binary)"
    destination="$(dirname "$binary")"
    current="$ags_converter_version"
    [[ "$current" != unknown ]] ||
        die "cannot read the installed ags version from $binary; reinstall ags"

    # Deliberately not `curl -f`: with it, "no such release", "this repository
    # is private and you are not authenticated", and "the network is down" all
    # arrive as the same non-zero exit and get the same wrong advice. Keep the
    # status code and say which one it was.
    response="$(curl -sSL --connect-timeout 5 --max-time 20 --max-filesize 1048576 \
        -H 'Accept: application/vnd.github+json' -w '\n%{http_code}' \
        "https://api.github.com/repos/$owner/$repo/releases/latest" 2>/dev/null)" ||
        die "cannot reach api.github.com; check network access"
    status="${response##*$'\n'}"
    response="${response%$'\n'*}"

    case "$status" in
        200) ;;
        404) die "$owner/$repo has no published release, or this host cannot see it — a private repository needs an authenticated download" ;;
        401|403) die "api.github.com refused the request for $owner/$repo (status $status); rate limiting or missing authorization" ;;
        *) die "api.github.com returned status $status for $owner/$repo" ;;
    esac

    tag="$(jq -er '.tag_name | select(type == "string" and test("^v[0-9]"))' \
        <<< "$response" 2>/dev/null)" ||
        die "the latest $owner/$repo release carries no usable version tag"

    # dist.yml refuses to publish a tag that disagrees with Cargo.toml, so the
    # tag is the crate version with a leading `v` and comparing the two as
    # strings is exact. Ordering is deliberately not computed: `ags update`
    # means "match the latest release", and a bash semver comparator that has
    # to understand `0.3.0-ags.1` is how install.sh grew its own version bug.
    # A move in either direction is printed, so a downgrade is never silent.
    if [[ "$tag" == "v$current" ]]; then
        log "already current: ags $current is the latest release ($tag)"
        forget_update_notice "update available: ags"
        return 0
    fi

    if (( check_only == 1 )); then
        log "update available: ags $current -> $tag"
        return 0
    fi

    log "updating ags $current -> $tag"

    workspace="$(mktemp -d "${TMPDIR:-/tmp}/ags-update.XXXXXX")" ||
        die "cannot create a temporary directory for the installer"
    trap_cleanup_dirs "$workspace"

    # Pinned to the tag rather than to a branch: the installer that runs is the
    # one that shipped with this release, so its verification rules and this
    # release's assets cannot drift apart.
    curl -fsSL --connect-timeout 5 --max-time 60 \
        "https://raw.githubusercontent.com/$owner/$repo/$tag/install.sh" \
        -o "$workspace/install.sh" ||
        die "cannot download the $tag installer"

    # `$BASH` rather than `bash`: the installer requires bash >= 4.4, this
    # runtime is already running under a bash that satisfies that, and on macOS
    # the `bash` first in PATH is the 3.2 system copy.
    # `--dest` keeps the binary where it already is; the installer's default is
    # ~/.local/bin, which on a host that installed elsewhere would leave the
    # old copy shadowing the new one.
    "${BASH:-bash}" "$workspace/install.sh" \
        --version "$tag" --dest "$destination" --yes ||
        die "the $tag installer failed; the previous installation is unchanged"

    # 更新完必须把提示清掉。以前只有"已是最新"那条早返回分支清，真正更新完的
    # 这条不清——于是升级之后每次启动还在提示同一个已经装好的版本，直到下一次
    # 后台检查碰巧跑过一遍才消失。实测：装到 0.4.27 之后，提示里还留着
    # `update available: ags 0.4.24 -> v0.4.27`。
    #
    # 清在这里而不是安装之前：安装失败时提示应当留着，那台机器确实还没更新。
    forget_update_notice "update available: ags"

    log "updated to $tag"
}

# One line per pending update, immediately before the Agent takes the terminal.
#
# Reads a file and prints it. No network call, no version comparison, no `jq` —
# a launch costs the same whether this host is online, offline, behind a proxy,
# or rate-limited by api.github.com, and nothing here can fail a launch that the
# validation already passed.
#
# The corollary is that the first launch after a release is silent: what gets
# printed is what the last *finished* check found. That is the trade, and it is
# the right way round — a release is worth knowing about within a day, and no
# release is worth making every `ags claude` wait on api.github.com.
# Offer a pending update before running whatever was asked for.
#
# Reads the record a background check already filled (see
# `announce_pending_updates`), so this touches no network and no command waits
# on it. A version that has to phone home before every invocation is a version
# people turn off.
#
# Asked once per pending release, not once per command. A prompt that returns on
# every invocation stops being a question and becomes a toll — declining writes
# the pending lines down and stays quiet until they change. That is also why the
# answer is remembered as *what* was declined rather than as a timestamp: a
# newer release is a different question and deserves to be asked again.
#
# Never asked when stdin or stdout is not a terminal. Several of these
# subcommands are driven by install.sh, which parses their stdout; a prompt
# there would corrupt the thing reading it.
offer_pending_update() {
    local recorded= pending= declined= line reply
    [[ "${AGS_UPDATE_CHECK:-1}" != 0 ]] || return 0
    [[ -t 0 && -t 1 ]] || return 0
    [[ -f "$update_check_lines" && ! -L "$update_check_lines" ]] || return 0
    recorded="$(cat -- "$update_check_lines" 2>/dev/null)" || return 0
    while IFS= read -r line; do
        [[ "$line" == "update available: "* ]] || continue
        pending+="${pending:+$'\n'}$line"
    done <<< "$recorded"
    [[ -n "$pending" ]] || return 0
    if [[ -f "$update_decline_file" && ! -L "$update_decline_file" ]]; then
        declined="$(cat -- "$update_decline_file" 2>/dev/null)" || declined=
    fi
    [[ "$declined" != "$pending" ]] || return 0

    while IFS= read -r line; do log "$line"; done <<< "$pending"
    printf '现在更新？[Y/n]: '
    IFS= read -r reply || reply=n
    case "${reply:-y}" in
        [Nn]*)
            install -d -m700 "$state" 2>/dev/null || true
            printf '%s\n' "$pending" > "$update_decline_file" 2>/dev/null || true
            log "跳过。想更新随时跑 ags update"
            return 0
            ;;
    esac
    rm -f -- "$update_decline_file"
    # 装完不重新 exec 自己：这一趟已经把旧的运行时读进内存了，中途换掉它需要
    # 把参数原样重建再交接，而那是一条只有更新路径会走、平时无人测试的分支。
    # 让它跑完，下一条命令就是新的。
    update_ags || log "更新失败；这次仍用当前版本继续"
    log "新版本从下一条 ags 命令起生效"
}

announce_pending_updates() {
    local line
    local recorded=
    [[ "${AGS_UPDATE_CHECK:-1}" != 0 ]] || return 0
    # Every read below is guarded rather than tested-then-read. Under `set -e` a
    # redirect from a file that vanished between the test and the read is an
    # error that ends this process — and this process is one `exec` away from
    # being the Agent.
    if [[ -f "$update_check_lines" && ! -L "$update_check_lines" ]]; then
        recorded="$(cat -- "$update_check_lines" 2>/dev/null)" || recorded=
    fi
    while IFS= read -r line; do
        # The refresh only ever writes lines of this shape, so re-checking it
        # costs nothing and keeps a record that acquired anything else from
        # printing whatever it likes behind the `[ags]` prefix.
        [[ "$line" == "update available: "* ]] || continue
        log "$line"
    done <<< "$recorded"
    maybe_refresh_update_check
}

# 刚刚实时查过了，把缓存里那条关于它的陈旧提示丢掉。
#
# `offer_pending_update` 读的是缓存文件，而缓存只由后台刷新覆盖、间隔默认 86400 秒。
# 于是"更新成功"之后接下来一整天，每一条 ags 命令都还在问"现在更新？"——用户刚跑完
# `ags codext-update` 看到 already current，下一条 `ags codex` 又被问一遍，看起来像是
# 更新根本没生效。
#
# 只删匹配的那一行，不清整个文件：另一个组件可能有一条**仍然有效**的提示等着报。
forget_update_notice() {
    local prefix="$1" temporary
    [[ -f "$update_check_lines" && ! -L "$update_check_lines" ]] || return 0
    temporary="$update_check_lines.tmp.$$"
    grep -vF -e "$prefix" -- "$update_check_lines" > "$temporary" 2>/dev/null || :
    mv -- "$temporary" "$update_check_lines" 2>/dev/null || rm -f -- "$temporary"
}

# 到点了就在后台补一次检查。
#
# 从 `announce_pending_updates` 里拆出来，因为**每一条命令**都该让它有机会跑。
# 原来只有启动 Agent 那条路会刷新，而报告那一半（`offer_pending_update`）是每条
# 命令都跑的——两边不对称的后果是：一台平时只用 `ags list` / `ags resume` /
# `ags sync` 的机器从来不去问有没有新版本，那个缓存文件从头到尾是空的，于是提醒
# 永远不出现。看起来像"提醒坏了"，其实是从来没人去拿答案。
#
# **仍然是后台异步的。** 同步查一次 GitHub 要几百毫秒，把它加到每一条 ags 命令上
# 是笔糟糕的买卖：代价是每条命令都变慢、离线时还要处理超时，换来的只是提醒早一条
# 命令出现。所以这条命令报的是上一次检查的结果，同时把下一次的答案准备好。
maybe_refresh_update_check() {
    local interval="${AGS_UPDATE_CHECK_INTERVAL:-86400}" now checked_at
    [[ "${AGS_UPDATE_CHECK:-1}" != 0 ]] || return 0
    [[ "$interval" =~ ^[0-9]+$ ]] || return 0
    now="$(date +%s 2>/dev/null)" || return 0
    checked_at=0
    if [[ -f "$update_check_stamp" && ! -L "$update_check_stamp" ]]; then
        checked_at="$(cat -- "$update_check_stamp" 2>/dev/null)" || checked_at=0
    fi
    [[ "$checked_at" =~ ^[0-9]+$ ]] || checked_at=0
    (( now - checked_at >= interval )) || return 0
    spawn_update_check_refresh "$now"
}

# Start the check that fills the file the next launch reads.
#
# A separate process, not a subshell: this runtime registers `rm -rf` EXIT traps
# for its working directories, and a forked child would run them on its way out
# and delete directories the launch it forked from is still using. `setsid` so
# closing the terminal does not take the check with it.
spawn_update_check_refresh() {
    local now="$1" binary
    # In a command substitution because `resolve_ags_converter_binary` reports a
    # missing installation with `die`; the subshell absorbs that exit, and a
    # host that cannot locate its own binary simply gets no update line.
    binary="$( (resolve_ags_converter_binary) 2>/dev/null )" || return 0
    [[ -n "$binary" ]] || return 0
    # Stamped before the check runs rather than after. Several terminals opened
    # at once would otherwise each start their own; the lines already recorded
    # stay untouched, so launches keep reporting the last finished answer until
    # this check replaces it.
    mkdir -p "$state" 2>/dev/null || return 0
    printf '%s\n' "$now" > "$update_check_stamp.tmp.$$" 2>/dev/null || return 0
    mv -- "$update_check_stamp.tmp.$$" "$update_check_stamp" 2>/dev/null || {
        rm -f -- "$update_check_stamp.tmp.$$" 2>/dev/null || true
        return 0
    }
    if command -v setsid >/dev/null 2>&1; then
        setsid "$binary" checkpoint update-check-refresh \
            </dev/null >/dev/null 2>&1 &
    else
        "$binary" checkpoint update-check-refresh \
            </dev/null >/dev/null 2>&1 &
    fi
    disown 2>/dev/null || true
}

# Record what `ags update --check` reports, for a later launch to print.
#
# Deliberately not a second version comparison. `update_ags --check` is the same
# code path `ags update` uses to decide whether anything needs to happen, across
# all three release trains; a thinner reimplementation here would be the one
# that runs unattended every day, and therefore the one whose disagreement with
# the real updater nobody would notice.
refresh_update_check_record() {
    local report status=0 lines
    (( $# == 0 )) || die "usage: ags update-check-refresh"
    need jq; need curl
    mkdir -p "$state" || die "cannot create AGS state directory: $state"
    # `--check` reports through `log`, so the answer arrives on stderr.
    report="$(update_ags --check 2>&1 >/dev/null)" || status=$?
    # A check that could not finish records nothing. Leaving the previous lines
    # in place says "this is what the last completed check found", which is
    # true; writing an empty list would claim every train is current, which on
    # an unreachable network is a guess dressed as an answer.
    (( status == 0 )) || die "the update check did not finish; the previous result is unchanged"
    lines="$(sed -n 's/^\[ags\] \(update available: .*\)$/\1/p' <<< "$report")"
    printf '%s' "${lines:+$lines$'\n'}" > "$update_check_lines.tmp.$$" ||
        die "cannot write $update_check_lines"
    mv -- "$update_check_lines.tmp.$$" "$update_check_lines" || {
        rm -f -- "$update_check_lines.tmp.$$"
        die "cannot replace $update_check_lines"
    }
}

# 任何 ags 命令之前都问一次，除了这几个：`update` 系列自己就是答案，其余四个
# 由 install.sh 驱动并且它要解析它们的 stdout。（`-t` 那道闸已经挡住非交互式
# 调用，这里是第二道——install.sh 也可能在终端里跑。）
#
# 刷新和报告在这里成对出现。只报告不刷新，等于一直读一个没人写过的文件：一台只跑
# `ags list` / `ags resume` / `ags sync` 的机器永远不会知道有新版本。刷新走后台，
# 所以这一对不给命令增加任何等待——报的是上一次的答案，同时备好下一次的。
#
# 排除的那四个也不刷新：`update` 自己就要联网查一遍，`update-check-refresh` 就是
# 那个后台检查本身，另外两个由 install.sh 驱动。
# ags 自己的参数区在**命令名之前**——位置本身就把两边分开了，和 sudo / env /
# timeout / docker run 同一个路子：解析到第一个非选项就停，之后的一切原样透传给
# agent。所以 `ags codex --model o3`、`ags codex resume <id>` 全都照旧可用，
# codex 将来新增任何同名参数也撞不着我们。
#
# `--` 只是**没有位置可以分界时**的补救（POSIX 的选项结束标记）：ags 参数的值
# 本身长得像命令名时用它收尾。用不上就不用写。
#
#   ags --account a@b.com codex --model o3     位置分界，不需要 --
#   ags --account a@b.com -- codex             显式收尾
#   ags codex --account a@b.com                --account 归 codex，报未知参数
ags_account=
ags_pick_account=0
ags_no_agent_args=0
ags_to=
ags_cwd_option=
ags_profile_option=
ags_id_option=
ags_consumed=0

# 参数归属只看一个分隔符：
#
#   ags [ags 参数] <命令> [ags 参数] [-- agent 参数]
#       └────────── 归 ags ─────────┘  └── 归 agent ──┘
#
# `--` **之前**的一切由 ags 解析（命令名前后都行）；`--` **之后**的一切原样交给
# Agent，ags 一个字都不碰。和 `cargo run --` / `npm run x --` / `kubectl exec pod --`
# 同一个约定，也和 `ags resume ID [--to …] [-- CLIENT_ARGS…]` 本来就有的约定一致
# ——同一个 `--` 在这个工具里只有一种含义。
#
# 代价说清楚：`ags codex --model o3` 这种写法从此要写成 `ags codex -- --model o3`。
# 换来的是"这个参数归谁"永远不用猜。
ags_account=
ags_pick_account=0
ags_no_agent_args=0
ags_to=
ags_cwd_option=
ags_profile_option=
ags_consumed=0
ags_id_option=
ags_agent_args=()
ags_agent_args_given=0
# 这次会话的 AGS ID，以及这把密钥此刻占用的 ID。都在 `prepare_session_identity`
# 里填；声明在这里是因为 `export_pool_device_id` 和 `report_pool_session` 也要读。
ags_session_id=
ags_pool_live_ids=()

ags_words=()
ags_separator_seen=0
for ags_word in "$@"; do
    if (( ags_separator_seen == 0 )) && [[ "$ags_word" == "--" ]]; then
        ags_separator_seen=1
        ags_agent_args_given=1
        continue
    fi
    if (( ags_separator_seen == 1 )); then
        ags_agent_args+=("$ags_word")
    else
        ags_words+=("$ags_word")
    fi
done
unset ags_word ags_separator_seen

# `--` 之前：ags 的参数和命令的位置参数混在一起，按顺序拆开。
#
# 下面每一次重切 `ags_words` 都必须带引号。不带的话数组展开会再走一遍词分割和通配符
# ——`ags save 'bad id' '描述'` 里的 `bad id` 被拆成两个词，于是 ID 成了 `bad`、
# 描述成了 `id 描述`，而校验 ID 字符集的那道闸门根本没看到那个空格。带 `*` 的参数
# 更糟：它会按当前目录展开。
#
# 末位参数看不出来，因为描述是 `"$*"` 拼回去的——所以这个 bug 只在非末位参数带空格
# 时才露头。
ags_positionals=()
while (( ${#ags_words[@]} > 0 )); do
    case "${ags_words[0]}" in
        -h|--help|help)
            ags_positionals+=("${ags_words[0]}")
            ags_words=("${ags_words[@]:1}")
            continue
            ;;
    esac
    if [[ "${ags_words[0]}" == -* ]]; then
        ags_consume_option "${ags_words[@]}"
        if (( ags_consumed > 0 )); then
            ags_words=("${ags_words[@]:$ags_consumed}")
            continue
        fi
        # 顶层不认识它，不代表它是错的：ags 的每个子命令都有自己的参数
        # （`init --identity`、`storage use`、`remote add` …）。原样往下传，由
        # 子命令去解析。真正没人认领的会在子命令那里报错——`codex`/`claude`
        # 不接受任何位置参数，所以 `ags codex --model o3` 会在分发处被挡下并
        # 指向 `--`。
    fi
    ags_positionals+=("${ags_words[0]}")
    ags_words=("${ags_words[@]:1}")
done
unset ags_words
set -- ${ags_positionals[@]+"${ags_positionals[@]}"}
unset ags_positionals

# ags 的参数用在不吃它的命令上，只会被解析走然后没人读——那是静默无视，比报错
# 糟得多：你以为设上了，其实什么都没发生。
if [[ -n "$ags_account" ]] || (( ags_pick_account == 1 )); then
    case "${1:-}" in
        codex|claude|resume|cloud) ;;
        *) die "--account / --pick-account 只对启动 Agent 的命令有意义（codex、claude、resume、cloud resume）" ;;
    esac
fi
# 同理，`--id` 用在别处会被解析走然后没人读——那是静默无视。`resume` 不在里面：恢复
# 一条工作线用的是检查点自己的 ID，再给一个只会矛盾。
if [[ -n "$ags_id_option" ]]; then
    case "${1:-}" in
        codex|claude|save) ;;
        *) die "--id 只对新起会话（codex、claude）和 ags save 有意义；ags resume 用检查点自己的 ID" ;;
    esac
fi
case "${1:-}" in
    resume|cloud) ;;
    *)
        [[ -z "$ags_to" ]] || die "--to 只对 resume / cloud resume 有意义"
        [[ -z "$ags_cwd_option" ]] || die "--cwd 只对 resume / cloud resume 有意义"
        [[ -z "$ags_profile_option" ]] || die "--profile 只对 resume / cloud resume 有意义"
        (( ags_no_agent_args == 0 )) ||
            die "--no-agent-args 只对 resume / cloud resume 有意义"
        ;;
esac

case "${1:-}" in
    update|update-check-refresh|codext-update|codex-name) ;;
    *)
        offer_pending_update || true
        maybe_refresh_update_check || true
        ;;
esac

case "${1:-}" in
    '') enter_ags ;;
    claude|codex)
        ags_agent_command="$1"
        shift
        if (( $# > 0 )); then
            # 分开两句：`--yolo` 不是"位置参数"，照那么说人会去找自己哪里写了个
            # 位置参数。既然已经知道该怎么改，就把改好的命令直接写出来。
            [[ "$1" != -* ]] ||
                die "ags $ags_agent_command 不认识 $1；给 Agent 的参数要写在 -- 之后：ags $ags_agent_command -- $*"
            die "ags $ags_agent_command 不接受位置参数：$1（给 Agent 的参数写在 -- 之后）"
        fi
        start_managed_agent "$ags_agent_command" \
            ${ags_agent_args[@]+"${ags_agent_args[@]}"}
        ;;
    init) shift; initialize_ags "$@" ;;
    codex-init)
        shift
        (( $# == 0 )) || die "usage: ags codex-init"
        configure_codex_pool
        ;;
    codex-pool)
        shift
        (( $# == 0 )) || die "usage: ags codex-pool"
        codex_pool_status
        ;;
    codext-update)
        # install.sh's hook into the same function `ags update` uses, so a
        # fresh install lands codext too. Deliberately not `ags update` itself:
        # that one would also self-update ags, and would therefore undo an
        # explicit `install.sh --version` seconds after it landed.
        shift
        (( $# == 0 )) || die "usage: ags codext-update"
        update_codext 0
        ;;
    codex-name)
        # 安装器专用。这是唯一会去问「要不要用 codext 取代现有 codex」并在
        # 允许时挪走对方二进制的入口，因为那是装一次就定下来的事，不该在
        # `ags init` 这种可以随手重跑的命令里发生。
        shift
        (( $# == 0 )) || die "usage: ags codex-name"
        reconcile_codex_binary_name install
        ;;
    set)
        shift
        # `ags set retention …` 和 `ags set ABSOLUTE_DIR` 是两件事，第一个词分开。
        if [[ "${1:-}" == retention ]]; then
            shift
            configure_retention "$@"
        else
            deprecated_store_alias 'set ABSOLUTE_DIR' 'ags store add local ABSOLUTE_DIR'
            configure_local_storage "$@"
        fi
        ;;
    gc) shift; ags_gc "$@" ;;
    store) shift; store_command "$@" ;;
    # `ags cloud` 整个删掉了（2026-08-27）。它是 sftp 的旧版重复实现，而
    # `ags store add NAME sftp://…` 覆盖了它的全部能力。老的 `.cloud` 配置**不会
    # 丢**：`ensure_legacy_cloud_remote` 照旧把它迁成一个具名 store。
    #
    # 留一条说清楚去哪，比让人对着 `unknown command` 猜要好。
    cloud)
        die "ags cloud 没有了；用 ags store add NAME sftp://USER@HOST:PORT/PATH，然后 ags store use NAME。老的 cloud 配置会自动迁成一个 store"
        ;;
    # 并进 `ags store` 之前的两个名字。还认，但帮助里没有了。
    remote) shift
        deprecated_store_alias remote 'ags store add|list|show|use|remove'
        remote_command "$@"
        ;;
    storage) shift
        deprecated_store_alias storage 'ags store list|use|merge|retire'
        storage_command "$@"
        ;;
    # `ls` 是 `list` 的别名。这是手上敲得最多的一个，而 `ls` 是所有人肌肉记忆里
    # "列出来"的那个词。只给这一个加别名：别名不减少复杂度，它增加表面积，只有
    # 高频那一个才划算。
    list|ls) shift; list_native_sessions "$@" ;;
    summarize) shift
        # `--force` 重算已经有的：换了模型、或者一条会话后来长出了完全不同的内容。
        case "${1:-}" in
            '') summarize_native_sessions 0 0 ;;
            --force) summarize_native_sessions 1 0 ;;
            # 只补已经不写的会话。`ags ls` 在后台起的就是这一条。
            --settled) summarize_native_sessions 0 1 ;;
            *) die "usage: ags summarize [--force|--settled]" ;;
        esac
        ;;
    archives) shift; list_local_checkpoints "$@" ;;
    show) shift; show_local_checkpoint "$@" ;;
    save) shift; save_active_checkpoint local "$@" ;;
    resume) shift; resume_checkpoint local "$@" ;;
    delete) shift; delete_local_checkpoint "$@" ;;
    queue) shift; queue_checkpoint "$@" ;;
    save-now) shift; save_checkpoint "$@" ;;
    hook) run_hook ;;
    flush) shift; flush_pending "${1:-}" ;;
    restore) shift; restore_checkpoint "$@" ;;
    push) shift; sync_records push "$@" ;;
    pull) shift; sync_records pull "$@" ;;
    # `ags status` 就是"只看计划的 sync"，所以它是 `sync` 的一个开关，不是第四个
    # 动词。老名字还认。
    sync) shift
        if [[ "${1:-}" == --dry-run ]]; then
            shift
            sync_records status "$@"
        else
            sync_records sync "$@"
        fi
        ;;
    status) shift; sync_records status "$@" ;;
    legacy) shift; legacy_command "$@" ;;
    rehome-claude) rehome_claude "${2:-}" ;;
    update) shift; update_ags "$@" ;;
    update-check-refresh) shift; refresh_update_check_record "$@" ;;
    -h|--help|help) shift || true; usage "${1:-}" ;;
    *) usage >&2; exit 2 ;;
esac
